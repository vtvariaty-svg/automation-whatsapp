e pode ou n\xe3o possuir Inscri\xe7\xe3o Estadual no Cadastro de Contribuintes do ICMS\\r\\nNota: No caso de Contribuinte Isento de Inscri\xe7\xe3o (indIEDest=2) informar a tag IE do destinat\xe1rio com o literal ISENTO.","nullable":true},"IE":{"type":"string","description":"Inscri\xe7\xe3o Estadual do destinat\xe1rio.","nullable":true},"IM":{"type":"string","description":"Inscri\xe7\xe3o Municipal.","maxLength":15,"minLength":1,"nullable":true},"enderDest":{"$ref":"#/components/schemas/NfcomSefazEndeDest"}},"required":["enderDest","indIEDest","xNome"]},"NfcomSefazEndeDest":{"type":"object","description":"Endere\xe7o do destinat\xe1rio / assinante.","properties":{"xLgr":{"type":"string","description":"Logradouro.","maxLength":60,"minLength":2,"nullable":true},"nro":{"type":"string","description":"N\xfamero.","maxLength":60,"minLength":1,"nullable":true},"xCpl":{"type":"string","description":"Complemento.","maxLength":60,"minLength":1,"nullable":true},"xBairro":{"type":"string","description":"Bairro.","maxLength":60,"minLength":2,"nullable":true},"cMun":{"type":"string","description":"C\xf3digo do munic\xedpio (utilizar a tabela do IBGE).","nullable":true},"xMun":{"type":"string","description":"Nome do munic\xedpio.","maxLength":60,"minLength":2,"nullable":true},"CEP":{"type":"string","description":"CEP.\\r\\nInformar zeros n\xe3o significativos.","nullable":true},"UF":{"type":"string","description":"Sigla da UF.","nullable":true},"cPais":{"type":"string","description":"C\xf3digo do pa\xeds.\\r\\nUtilizar a tabela do BACEN.","nullable":true},"xPais":{"type":"string","description":"Nome do pa\xeds.","maxLength":60,"minLength":2,"nullable":true},"fone":{"type":"string","description":"Telefone.","nullable":true},"email":{"type":"string","description":"Endere\xe7o de E-mail.","maxLength":60,"minLength":1,"nullable":true}},"required":["UF","CEP","xMun","cMun","xBairro","nro","xLgr"]},"NfcomSefazAssinante":{"type":"object","description":"Dados do assinante.","properties":{