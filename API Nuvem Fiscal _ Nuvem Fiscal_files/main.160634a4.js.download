escription":"Tipo do Emitente.\\r\\n* 1 - Prestador de servi\xe7o de transporte\\r\\n* 2 - Transportador de Carga Pr\xf3pria 3 - Prestador de servi\xe7o de transporte que emitir\xe1 CT-e Globalizado\\r\\nOBS: Deve ser preenchido com 2 para emitentes de NF-e e pelas transportadoras quando estiverem fazendo transporte de carga pr\xf3pria. Deve ser preenchido com 3 para transportador de carga que emitir\xe1 \xe0 posteriori CT-e Globalizado relacionando as NF-e.","nullable":true},"tpTransp":{"type":"integer","description":"Tipo do Transportador.\\r\\n* 1 - ETC\\r\\n* 2 - TAC\\r\\n* 3 - CTC","nullable":true},"mod":{"type":"integer","description":"Modelo do Manifesto Eletr\xf4nico.\\r\\nUtilizar o c\xf3digo 58 para identifica\xe7\xe3o do MDF-e.","nullable":true},"serie":{"type":"integer","description":"S\xe9rie do Manifesto.\\r\\nInformar a s\xe9rie do documento fiscal (informar zero se inexistente).\\r\\nS\xe9rie na faixa [920-969]: Reservada para emiss\xe3o por contribuinte pessoa f\xedsica com inscri\xe7\xe3o estadual.","maximum":999,"minimum":0,"nullable":true},"nMDF":{"type":"integer","description":"N\xfamero do Manifesto.\\r\\nN\xfamero que identifica o Manifesto. 1 a 999999999.","maximum":999999999,"minimum":1,"nullable":true},"cMDF":{"type":"string","description":"C\xf3digo num\xe9rico que comp\xf5e a Chave de Acesso.\\r\\nC\xf3digo aleat\xf3rio gerado pelo emitente, com o objetivo de evitar acessos indevidos ao documento.\\r\\n\\r\\n*Geramos automaticamente quando nenhum valor \xe9 informado.*","nullable":true},"cDV":{"type":"integer","description":"Digito verificador da chave de acesso do Manifesto.\\r\\nInformar o d\xedgito  de controle da chave de acesso do MDF-e, que deve ser calculado com a aplica\xe7\xe3o do algoritmo m\xf3dulo 11 (base 2,9) da chave de acesso.\\r\\n\\r\\n*Geramos automaticamente quando nenhum valor \xe9 informado.*","maximum":9,"minimum":0,"nullable":true},"modal":{"type":"integer","description":"Modalidade de transporte.\\r\\n* 1 - Rodovi\xe1rio\\r\\n* 2 - A\xe9reo\\r\\n* 3 - Aquavi\xe1rio\\r\\n* 4 - Ferrovi\xe1rio","nullable":true},"dhEmi":{"type":"string","format":"date-time","description":"Data e hora de emiss\xe3o do Manifesto.\\r\\nFormato AAAA-MM-DDTHH:MM:DD TZD.","nullable":true},"tpEmis":{"type":"integer","description":"Forma de emiss\xe3o do Manifesto.\\r\\n* 1 - Normal\\r\\n* 2 - Conting\xeancia\\r\\n* 3 - Regime Especial NFF","nullable":true},"procEmi":{"type":"string","description":"Identifica\xe7\xe3o do processo de emiss\xe3o do Manifesto.\\r\\n* 0 - emiss\xe3o de MDF-e com aplicativo do contribuinte","nullable":true},"verProc":{"type":"string","description":"Vers\xe3o do processo de emiss\xe3o.\\r\\nInformar a vers\xe3o do aplicativo emissor de MDF-e.","maxLength":20,"minLength":1,"nullable":true},"UFIni":{"type":"string","description":"Sigla da UF do Carregamento.\\r\\nUtilizar a Tabela do IBGE de c\xf3digo de unidades da federa\xe7\xe3o.\\r\\nInformar \'EX\' para opera\xe7\xf5es com o exterior.","nullable":true},"UFFim":{"type":"string","description":"Sigla da UF do Descarregamento.\\r\\nUtilizar a Tabela do IBGE de c\xf3digo de unidades da federa\xe7\xe3o.\\r\\nInformar \'EX\' para opera\xe7\xf5es com o exterior.","nullable":true},"infMunCarrega":{"type":"array","items":{"$ref":"#/components/schemas/MdfeSefazInfMunCarrega"},"maxItems":50,"minItems":1},"infPercurso":{"type":"array","items":{"$ref":"#/components/schemas/MdfeSefazInfPercurso"},"maxItems":25},"dhIniViagem":{"type":"string","format":"date-time","description":"Data e hora previstos de inicio da viagem.\\r\\nFormato AAAA-MM-DDTHH:MM:DD TZD.","nullable":true},"indCanalVerde":{"type":"integer","description":"Indicador de participa\xe7\xe3o do Canal Verde.","nullable":true},"indCarregaPosterior":{"type":"integer","description":"Indicador de MDF-e com inclus\xe3o da Carga posterior a emiss\xe3o por evento de inclus\xe3o de DF-e.","nullable":true}},"required":["infMunCarrega","UFFim","UFIni","verProc","procEmi","tpEmis","dhEmi","modal","nMDF","serie","tpEmit","cUF"]},"MdfeSefazInfMunCarrega":{"type":"object","description":"Informa\xe7\xf5es dos Munic\xedpios de Carregamento.","properties":{"cMunCarrega":{"type":"string","description":"C\xf3digo do Munic\xedpio de Carregamento.","nullable":true},"xMunCarrega":{"type":"string","description":"Nome do Munic\xedpio de Carregamento.","maxLength":60,"minLength":2,"nullable":true}},"required":["xMunCarrega","cMunCarrega"]},"MdfeSefazInfPercurso":{"type":"object","description":"Informa\xe7\xf5es do Percurso do MDF-e.","properties":{"UFPer":{"type":"string","description":"Sigla das Unidades da Federa\xe7\xe3o do percurso do ve\xedculo.\\r\\nN\xe3o \xe9 necess\xe1rio repetir as UF de In\xedcio e Fim.","nullable":true}},"required":["UFPer"]},"MdfeSefazEmit":{"type":"object","description":"Identifica\xe7\xe3o do Emitente do Manifesto.","properties":{"CNPJ":{"type":"string","description":"CNPJ do emitente.\\r\\nInformar zeros n\xe3o significativos.\\r\\n\\r\\n***Obrigat\xf3rio caso o emitente seja pessoa jur\xeddica***.","nullable":true},"CPF":{"type":"string","description":"CPF do emitente.\\r\\nInformar zeros n\xe3o significativos.\\r\\nUsar com s\xe9rie espec\xedfica 920-969 para emitente pessoa f\xedsica com inscri\xe7\xe3o estadual.\\r\\nPoder\xe1 ser usado tamb\xe9m para emiss\xe3o do Regime Especial da Nota Fiscal F\xe1cil.\\r\\n\\r\\n***Obrigatorio caso o emitente seja pessoa f\xedsica***.","nullable":true},"IE":{"type":"string","description":"Inscri\xe7\xe3o Estadual do emitemte.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","nullable":true},"xNome":{"type":"string","description":"Raz\xe3o social ou Nome do emitente.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":2,"nullable":true},"xFant":{"type":"string","description":"Nome fantasia do emitente.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":1,"nullable":true},"enderEmit":{"$ref":"#/components/schemas/MdfeSefazEndeEmi"}}},"MdfeSefazEndeEmi":{"type":"object","description":"Endere\xe7o do emitente.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","properties":{"xLgr":{"type":"string","description":"Logradouro.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":2,"nullable":true},"nro":{"type":"string","description":"N\xfamero.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":1,"nullable":true},"xCpl":{"type":"string","description":"Complemento.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":1,"nullable":true},"xBairro":{"type":"string","description":"Bairro.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":2,"nullable":true},"cMun":{"type":"string","description":"C\xf3digo do munic\xedpio (utilizar a tabela do IBGE), informar 9999999 para opera\xe7\xf5es com o exterior.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","nullable":true},"xMun":{"type":"string","description":"Nome do munic\xedpio, , informar EXTERIOR para opera\xe7\xf5es com o exterior.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":2,"nullable":true},"CEP":{"type":"string","description":"CEP.\\r\\nInformar zeros n\xe3o significativos.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","nullable":true},"UF":{"type":"string","description":"Sigla da UF, , informar EX para opera\xe7\xf5es com o exterior.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","nullable":true},"fone":{"type":"string","description":"Telefone.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","nullable":true},"email":{"type":"string","description":"Endere\xe7o de E-mail.","maxLength":60,"minLength":6,"nullable":true}}},"MdfeSefazInfModal":{"type":"object","description":"Informa\xe7\xf5es do modal.","properties":{"versaoModal":{"type":"string","description":"Vers\xe3o do leiaute espec\xedfico para o Modal.","nullable":true},"aereo":{"$ref":"#/components/schemas/MdfeSefazAereo"},"rodo":{"$ref":"#/components/schemas/MdfeSefazRodo"},"aquav":{"$ref":"#/components/schemas/MdfeSefazAquav"},"ferrov":{"$ref":"#/components/schemas/MdfeSefazFerrov"}},"required":["versaoModal"]},"MdfeSefazAereo":{"type":"object","description":"Informa\xe7\xf5es do modal A\xe9reo.","properties":{"nac":{"type":"string","description":"Marca da Nacionalidade da aeronave.","maxLength":4,"minLength":1,"nullable":true},"matr":{"type":"string","description":"Marca de Matr\xedcula da aeronave.","maxLength":6,"minLength":1,"nullable":true},"nVoo":{"type":"string","description":"N\xfamero do Voo.\\r\\nFormato = AB1234, sendo AB a designa\xe7\xe3o da empresa e 1234 o n\xfamero do voo. Quando n\xe3o for poss\xedvel incluir as marcas de nacionalidade e matr\xedcula sem h\xedfen.","maxLength":9,"minLength":5,"nullable":true},"cAerEmb":{"type":"string","description":"Aer\xf3dromo de Embarque.\\r\\nO c\xf3digo de tr\xeas letras IATA do aeroporto de partida dever\xe1 ser inclu\xeddo como primeira anota\xe7\xe3o. Quando n\xe3o for poss\xedvel, utilizar a sigla OACI.","maxLength":4,"minLength":3,"nullable":true},"cAerDes":{"type":"string","description":"Aer\xf3dromo de Destino.\\r\\nO c\xf3digo de tr\xeas letras IATA do aeroporto de destino dever\xe1 ser inclu\xeddo como primeira anota\xe7\xe3o. Quando n\xe3o for poss\xedvel, utilizar a sigla OACI.","maxLength":4,"minLength":3,"nullable":true},"dVoo":{"type":"string","format":"date","description":"Data do Voo.\\r\\nFormato AAAA-MM-DD.","nullable":true}},"required":["dVoo","cAerDes","cAerEmb","nVoo","matr","nac"]},"MdfeSefazRodo":{"type":"object","description":"Informa\xe7\xf5es do modal Rodovi\xe1rio.","properties":{"infANTT":{"$ref":"#/components/schemas/MdfeSefazInfANTT"},"veicTracao":{"$ref":"#/components/schemas/MdfeSefazVeicTracao"},"veicReboque":{"type":"array","items":{"$ref":"#/components/schemas/MdfeSefazVeicReboque"},"maxItems":3},"codAgPorto":{"type":"string","description":"C\xf3digo de Agendamento no porto.","maxLength":16,"minLength":0,"nullable":true},"lacRodo":{"type":"array","items":{"$ref":"#/components/schemas/MdfeSefazLacRodo"}}},"required":["veicTracao"]},"MdfeSefazInfANTT":{"type":"object","description":"Grupo de informa\xe7\xf5es para Ag\xeancia Reguladora.","properties":{"RNTRC":{"type":"string","description":"Registro Nacional de Transportadores Rodovi\xe1rios de Carga.\\r\\nRegistro obrigat\xf3rio do emitente do MDF-e junto \xe0 ANTT para exercer a atividade de transportador rodovi\xe1rio de cargas por conta de terceiros e mediante remunera\xe7\xe3o.","nullable":true},"infCIOT":{"type":"array","items":{"$ref":"#/components/schemas/MdfeSefazInfCIOT"}},"valePed":{"$ref":"#/components/schemas/MdfeSefazValePed"},"infContratante":{"type":"array","items":{"$ref":"#/components/schemas/MdfeSefazInfContratante"}},"infPag":{"type":"array","items":{"$ref":"#/components/schemas/MdfeSefazInfPag"}}}},"MdfeSefazInfCIOT":{"type":"object","description":"Dados do CIOT.","properties":{"CIOT":{"type":"string","description":"C\xf3digo Identificador da Opera\xe7\xe3o de Transporte.\\r\\nTamb\xe9m Conhecido como conta frete.","nullable":true},"CPF":{"type":"string","description":"N\xfamero do CPF respons\xe1vel pela gera\xe7\xe3o do CIOT.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true},"CNPJ":{"type":"string","description":"N\xfamero do CNPJ respons\xe1vel pela gera\xe7\xe3o do CIOT.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true}}},"MdfeSefazValePed":{"type":"object","description":"Informa\xe7\xf5es de Vale Ped\xe1gio.\\r\\nOutras informa\xe7\xf5es sobre Vale-Ped\xe1gio obrigat\xf3rio que n\xe3o tenham campos espec\xedficos devem ser informadas no campo de observa\xe7\xf5es gerais de uso livre pelo contribuinte, visando atender as determina\xe7\xf5es legais vigentes.","properties":{"disp":{"type":"array","items":{"$ref":"#/components/schemas/MdfeSefazDisp"},"minItems":1},"categCombVeic":{"type":"string","description":"Categoria de Combina\xe7\xe3o Veicular.\\r\\nPreencher com:\\r\\n02 Ve\xedculo Comercial 2 eixos\\r\\n0\\r\\n4 Ve\xedculo Comercial 3 eixos\\r\\n06 Ve\xedculo Comercial 4 eixos\\r\\n0\\r\\n7 Ve\xedculo Comercial 5 eixos\\r\\n0\\r\\n8 Ve\xedculo Comercial 6 eixos\\r\\n10 Ve\xedculo Comercial 7 eixos\\r\\n11 Ve\xedculo Comercial 8 eixos\\r\\n12 Ve\xedculo Comercial 9 eixos\\r\\n13 Ve\xedculo Comercial 10 eixos\\r\\n14 Ve\xedculo Comercial Acima de 10 eixos.","nullable":true}},"required":["disp"]},"MdfeSefazDisp":{"type":"object","description":"Informa\xe7\xf5es dos dispositivos do Vale Ped\xe1gio.","properties":{"CNPJForn":{"type":"string","description":"CNPJ da empresa fornecedora do Vale-Ped\xe1gio.\\r\\n* CNPJ da Empresa Fornecedora do Vale-Ped\xe1gio, ou seja, empresa que fornece ao Respons\xe1vel pelo Pagamento do Vale-Ped\xe1gio os dispositivos do Vale-Ped\xe1gio.\\r\\n* Informar os zeros n\xe3o significativos.","nullable":true},"CNPJPg":{"type":"string","description":"CNPJ do respons\xe1vel pelo pagamento do Vale-Ped\xe1gio.\\r\\n* respons\xe1vel pelo pagamento do Vale Ped\xe1gio. Informar somente quando o respons\xe1vel n\xe3o for o emitente do MDF-e.\\r\\n* Informar os zeros n\xe3o significativos.","nullable":true},"CPFPg":{"type":"string","description":"CNPJ do respons\xe1vel pelo pagamento do Vale-Ped\xe1gio.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true},"nCompra":{"type":"string","description":"Identificador do vale pedagio obrigat\xf3rio - IDVPO.","nullable":true},"vValePed":{"type":"number","description":"Valor do Vale-Pedagio.\\r\\nValor do Vale-Ped\xe1gio obrigat\xf3rio necess\xe1rio \xe0 livre circula\xe7\xe3o, desde a origem da opera\xe7\xe3o de transporte at\xe9 o destino, do transportador contratado.","minimum":0,"nullable":true},"tpValePed":{"type":"string","description":"Tipo do Vale Pedagio.\\r\\n* 01 - TAG; 04 - Leitura de placa (pela placa de identifica\xe7\xe3o veicular)","nullable":true}},"required":["vValePed","CNPJForn"]},"MdfeSefazInfContratante":{"type":"object","description":"Grupo de informa\xe7\xf5es dos contratantes do servi\xe7o de transporte.","properties":{"xNome":{"type":"string","description":"Raz\xe3o social ou Nome do contratante.","maxLength":60,"minLength":2,"nullable":true},"CPF":{"type":"string","description":"N\xfamero do CPF do contratante do servi\xe7o.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true},"CNPJ":{"type":"string","description":"N\xfamero do CNPJ do contratante do servi\xe7o.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true},"idEstrangeiro":{"type":"string","description":"Identificador do contratante em caso de contratante estrangeiro.","maxLength":20,"minLength":2,"nullable":true},"infContrato":{"$ref":"#/components/schemas/MdfeSefazInfContrato"}}},"MdfeSefazInfContrato":{"type":"object","description":"Grupo de informa\xe7\xf5es do contrato entre transportador e contratante.","properties":{"NroContrato":{"type":"string","description":"N\xfamero do contrato do transportador com o contratante quando este existir para presta\xe7\xf5es continuadas.","maxLength":20,"minLength":2,"nullable":true},"vContratoGlobal":{"type":"number","description":"Valor global do contrato.","minimum":0,"exclusiveMinimum":true,"nullable":true}},"required":["vContratoGlobal","NroContrato"]},"MdfeSefazInfPag":{"type":"object","description":"Informa\xe7\xf5es do Pagamento do Contrato.","properties":{"xNome":{"type":"string","description":"Raz\xe3o social ou Nome do respns\xe1vel pelo pagamento.","maxLength":60,"minLength":2,"nullable":true},"CPF":{"type":"string","description":"N\xfamero do CPF do respons\xe1vel pelo pgto.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true},"CNPJ":{"type":"string","description":"N\xfamero do CNPJ do respons\xe1vel pelo pgto.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true},"idEstrangeiro":{"type":"string","description":"Identificador do respons\xe1vel pelo pgto em caso de ser estrangeiro.","maxLength":20,"minLength":2,"nullable":true},"Comp":{"type":"array","items":{"$ref":"#/components/schemas/MdfeSefazComp"},"minItems":1},"vContrato":{"type":"number","description":"Valor Total do Contrato.","minimum":0,"nullable":true},"indAltoDesemp":{"type":"integer","description":"Indicador de opera\xe7\xe3o de transporte de alto desempenho.\\r\\nOpera\xe7\xe3o de transporte com utiliza\xe7\xe3o de ve\xedculos de frotas dedicadas ou fidelizadas.\\r\\nPreencher com \u201c1\u201d para indicar opera\xe7\xe3o de transporte de alto desempenho, demais casos n\xe3o informar a tag.","nullable":true},"indPag":{"type":"integer","description":"Indicador da Forma de Pagamento:0-Pagamento \xe0 Vista\\r\\n* 1 - Pagamento \xe0 Prazo","nullable":true},"vAdiant":{"type":"number","description":"Valor do Adiantamento (usar apenas em pagamento \xe0 Prazo.","minimum":0,"nullable":true},"indAntecipaAdiant":{"type":"integer","description":"Indicador para declarar concord\xe2ncia em antecipar o adiantamento.\\r\\nInformar a tag somente se for autorizado antecipar o adiantamento.","nullable":true},"infPrazo":{"type":"array","items":{"$ref":"#/components/schemas/MdfeSefazInfPrazo"}},"tpAntecip":{"type":"integer","description":"Tipo de Permiss\xe3o em rela\xe7\xe3o a antecipa\xe7\xe3o das parcelas.\\r\\n* 0 - N\xe3o permite antecipar\\r\\n* 1 - Permite antecipar as parcelas\\r\\n* 2 - Permite antecipar as parcelas mediante confirma\xe7\xe3o","nullable":true},"infBanc":{"$ref":"#/components/schemas/MdfeSefazInfBanc"}},"required":["infBanc","indPag","vContrato","Comp"]},"MdfeSefazComp":{"type":"object","description":"Componentes do Pagamentoi do Contrato.","properties":{"tpComp":{"type":"string","description":"Tipo do Componente.\\r\\nPreencher com:\\r\\n* 01 - Vale Ped\xe1gio\\r\\n* 02 - Impostos, taxas e contribui\xe7\xf5es\\r\\n* 03 - Despesas (banc\xe1rias, meios de pagamento, outras)\\r\\n* 04 - Frete\\r\\n* 99 - Outros","nullable":true},"vComp":{"type":"number","description":"Valor do componente.","minimum":0,"nullable":true},"xComp":{"type":"string","description":"Descri\xe7\xe3o do componente do tipo Outros.","maxLength":60,"minLength":2,"nullable":true}},"required":["vComp","tpComp"]},"MdfeSefazInfPrazo":{"type":"object","description":"Informa\xe7\xf5es do pagamento a prazo.\\r\\nInformar somente se indPag for \xe0 Prazo.","properties":{"nParcela":{"type":"integer","description":"N\xfamero da Parcela.","maximum":999,"minimum":0,"nullable":true},"dVenc":{"type":"string","format":"date","description":"Data de vencimento da Parcela (AAAA-MM-DD).","nullable":true},"vParcela":{"type":"number","description":"Valor da Parcela.","minimum":0,"exclusiveMinimum":true,"nullable":true}},"required":["vParcela","dVenc","nParcela"]},"MdfeSefazInfBanc":{"type":"object","description":"Informa\xe7\xf5es banc\xe1rias.","properties":{"codBanco":{"type":"string","description":"N\xfamero do banco.","maxLength":5,"minLength":3,"nullable":true},"codAgencia":{"type":"string","description":"N\xfamero da ag\xeancia banc\xe1ria.","maxLength":10,"minLength":1,"nullable":true},"CNPJIPEF":{"type":"string","description":"N\xfamero do CNPJ da Institui\xe7\xe3o de Pagamento Eletr\xf4nico do Frete.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true},"PIX":{"type":"string","description":"Chave PIX.\\r\\nInformar a chave PIX para recebimento do frete.\\r\\nPode ser email, CPF/ CNPJ (somente numeros), Telefone com a seguinte formata\xe7\xe3o (+5599999999999) ou a chave aleat\xf3ria gerada pela institui\xe7\xe3o.","maxLength":60,"minLength":2,"nullable":true}}},"MdfeSefazVeicTracao":{"type":"object","description":"Dados do Ve\xedculo com a Tra\xe7\xe3o.","properties":{"cInt":{"type":"string","description":"C\xf3digo interno do ve\xedculo.","maxLength":10,"minLength":1,"nullable":true},"placa":{"type":"string","description":"Placa do ve\xedculo.","nullable":true},"RENAVAM":{"type":"string","description":"RENAVAM do ve\xedculo.","maxLength":11,"minLength":9,"nullable":true},"tara":{"type":"integer","description":"Tara em KG.","maximum":999999,"minimum":0,"nullable":true},"capKG":{"type":"integer","description":"Capacidade em KG.","maximum":999999,"minimum":0,"nullable":true},"capM3":{"type":"integer","description":"Capacidade em M3.","maximum":999,"minimum":0,"nullable":true},"prop":{"$ref":"#/components/schemas/MdfeSefazProp"},"condutor":{"type":"array","items":{"$ref":"#/components/schemas/MdfeSefazCondutor"},"maxItems":10,"minItems":1},"tpRod":{"type":"string","description":"Tipo de Rodado.\\r\\nPreencher com:\\r\\n* 01 - Truck\\r\\n* 02 - Toco\\r\\n* 03 - Cavalo Mec\xe2nico\\r\\n* 04 - VAN\\r\\n* 05 - Utilit\xe1rio\\r\\n* 06 - Outros","nullable":true},"tpCar":{"type":"string","description":"Tipo de Carroceria.\\r\\nPreencher com:\\r\\n* 00 - n\xe3o aplic\xe1vel\\r\\n* 01 - Aberta\\r\\n* 02 - Fechada/Ba\xfa\\r\\n* 03 - Granelera\\r\\n* 04 - Porta Container\\r\\n* 05 - Sider","nullable":true},"UF":{"type":"string","description":"UF em que ve\xedculo est\xe1 licenciado.\\r\\nSigla da UF de licenciamento do ve\xedculo.","nullable":true}},"required":["tpCar","tpRod","condutor","tara","placa"]},"MdfeSefazProp":{"type":"object","description":"Propriet\xe1rio ou possuidor do Ve\xedculo.\\r\\nS\xf3 preenchido quando o ve\xedculo n\xe3o pertencer \xe0 empresa emitente do MDF-e.","properties":{"CPF":{"type":"string","description":"N\xfamero do CPF.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true},"CNPJ":{"type":"string","description":"N\xfamero do CNPJ.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true},"RNTRC":{"type":"string","descrip