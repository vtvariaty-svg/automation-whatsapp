e do logradouro da localiza\xe7\xe3o do im\xf3vel.","maxLength":255,"minLength":1,"nullable":true},"tpLgr":{"type":"string","description":"Tipo do Logradouro.\\r\\n\\r\\n**Aten\xe7\xe3o**: Para emiss\xf5es pelo Sistema Nacional NFS-e, esse campo \xe9 ignorado.","nullable":true},"nro":{"type":"string","description":"N\xfamero do im\xf3vel.","maxLength":60,"minLength":1,"nullable":true},"xCpl":{"type":"string","description":"Complemento do endere\xe7o.","maxLength":156,"minLength":1,"nullable":true},"xBairro":{"type":"string","description":"Bairro.","maxLength":60,"minLength":1,"nullable":true}},"required":["xBairro","nro","xLgr"]},"ExploracaoRodoviaria":{"type":"object","description":"Grupo de informa\xe7\xf5es relativas a ped\xe1gio.","properties":{"categVeic":{"type":"string","description":"Categorias de ve\xedculos para cobran\xe7a:\\r\\n* 00 - Categoria de ve\xedculos (tipo n\xe3o informado na nota de origem)\\r\\n* 01 - Autom\xf3vel, caminhonete e furg\xe3o\\r\\n* 02 - Caminh\xe3o leve, \xf4nibus, caminh\xe3o trator e furg\xe3o\\r\\n* 03 - Autom\xf3vel e caminhonete com semireboque\\r\\n* 04 - Caminh\xe3o, caminh\xe3o-trator, caminh\xe3o-trator com semi-reboque e \xf4nibus\\r\\n* 05 - Autom\xf3vel e caminhonete com reboque\\r\\n* 06 - Caminh\xe3o com reboque\\r\\n* 07 - Caminh\xe3o trator com semi-reboque\\r\\n* 08 - Motocicletas, motonetas e bicicletas motorizadas\\r\\n* 09 - Ve\xedculo especial\\r\\n* 10 - Ve\xedculo Isento","nullable":true},"nEixos":{"type":"string","description":"N\xfamero de eixos para fins de cobran\xe7a.","nullable":true},"rodagem":{"type":"integer","description":"Tipo de rodagem.","nullable":true},"sentido":{"type":"string","description":"Placa do ve\xedculo.","nullable":true},"placa":{"type":"string","description":"Placa do ve\xedculo.","nullable":true},"codAcessoPed":{"type":"string","description":"C\xf3digo de acesso gerado automaticamente pelo sistema emissor da concession\xe1ria.","nullable":true},"codContrato":{"type":"string","description":"C\xf3digo de contrato gerado automaticamente pelo sistema nacional no cadastro da concession\xe1ria.","nullable":true}},"required":["codContrato","codAcessoPed","placa","sentido","rodagem","nEixos","categVeic"]},"InfoCompl":{"type":"object","description":"Grupo de informa\xe7\xf5es complementares dispon\xedvel para todos os servi\xe7os prestados.","properties":{"idDocTec":{"type":"string","description":"Identificador de Documento de Responsabilidade T\xe9cnica: ART, RRT, DRT, Outros.","maxLength":40,"minLength":1,"nullable":true},"docRef":{"type":"string","description":"Chave da nota, n\xfamero identificador da nota, n\xfamero do contrato ou outro identificador de documento emitido pelo prestador de servi\xe7os, que subsidia a emiss\xe3o dessa nota pelo tomador do servi\xe7o ou intermedi\xe1rio (preenchimento obrigat\xf3rio caso a nota esteja sendo emitida pelo Tomador ou intermedi\xe1rio do servi\xe7o).","maxLength":255,"minLength":1,"nullable":true},"xPed":{"type":"string","description":"N\xfamero do  pedido/ordem de compra/ordem de servi\xe7o/projeto que autorize a presta\xe7\xe3o do servi\xe7o em opera\xe7\xf5es B2B - Informa\xe7\xe3o de interesse do tomador do servi\xe7o para controle e gest\xe3o da Negocia\xe7\xe3o.","maxLength":60,"minLength":1,"nullable":true},"gItemPed":{"$ref":"#/components/schemas/InfoItemPed"},"xInfComp":{"type":"string","description":"Informa\xe7\xf5es complementares.","maxLength":2000,"minLength":1,"nullable":true}}},"InfoItemPed":{"type":"object","description":"Grupo de itens do pedido/ordem de compra/ordem de servi\xe7o/projeto.","properties":{"xItemPed":{"type":"array","description":"N\xfamero do item do  pedido/ordem de compra/ordem de servi\xe7o/projeto - Identifica\xe7\xe3o do n\xfamero do item do pedido ou ordem de compra destacado e xPed.","items":{"type":"string"},"maxItems":99,"minItems":1}},"required":["xItemPed"]},"InfoValores":{"type":"object","description":"Grupo de informa\xe7\xf5es relativas \xe0 valores do s