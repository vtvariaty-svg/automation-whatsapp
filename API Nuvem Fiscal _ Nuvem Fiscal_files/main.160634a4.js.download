onfigNfse"}}}}}}},"/mdfe":{"get":{"tags":["Mdfe"],"summary":"Listar MDF-e","description":"Retorna a lista de manifestos de acordo com os crit\xe9rios de busca utilizados. Os manifestos s\xe3o retornados ordenados pela data da cria\xe7\xe3o, com os mais recentes aparecendo primeiro.","operationId":"ListarMdfe","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ do emitente.\\r\\n\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"referencia","description":"Seu identificador \xfanico para o documento.","schema":{"type":"string"}},{"in":"query","name":"ambiente","description":"Identifica\xe7\xe3o do Ambiente.\\r\\n\\r\\nValores aceitos: homologacao, producao","required":true,"schema":{"type":"string"}},{"in":"query","name":"chave","description":"Chave de acesso do DF-e.","schema":{"type":"string"}},{"in":"query","name":"serie","description":"S\xe9rie do DF-e.","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeListagem"}}}}}},"post":{"tags":["Mdfe"],"summary":"Emitir MDF-e","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"EmitirMdfe","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MdfePedidoEmissao"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Dfe"}}}}}}},"/mdfe/eventos/{id}":{"get":{"tags":["Mdfe"],"summary":"Consultar evento do MDF-e","operationId":"ConsultarEventoMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeEvento"}}}}}}},"/mdfe/eventos/{id}/pdf":{"get":{"tags":["Mdfe"],"summary":"Baixar PDF do evento","operationId":"BaixarPdfEventoMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/mdfe/eventos/{id}/xml":{"get":{"tags":["Mdfe"],"summary":"Baixar XML do evento","operationId":"BaixarXmlEventoMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/mdfe/lotes":{"get":{"tags":["Mdfe"],"summary":"Listar lotes de MDF-e","description":"Retorna a lista dos lotes de acordo com os crit\xe9rios de busca utilizados. Os lotes s\xe3o retornados ordenados pela data da cria\xe7\xe3o, com os mais recentes aparecendo primeiro.","operationId":"ListarLotesMdfe","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ do emitente.\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"referencia","schema":{"type":"string"}},{"in":"query","name":"ambiente","description":"Identifica\xe7\xe3o do Ambiente.\\r\\n\\r\\nValores aceitos: homologacao, producao","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeLoteListagem"}}}}}},"post":{"tags":["Mdfe"],"summary":"Emitir lote de MDF-e","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por MDF-e.","operationId":"EmitirLoteMdfe","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MdfePedidoEmissaoLote"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeLote"}}}}}}},"/mdfe/lotes/{id}":{"get":{"tags":["Mdfe"],"summary":"Consultar lote de MDF-e","description":"Consulta os detalhes de um lote j\xe1 existente. Forne\xe7a o ID \xfanico obtido de uma requisi\xe7\xe3o de emiss\xe3o ou de listagem de lotes e a API ir\xe1 retornar as informa\xe7\xf5es do lote correspondente.","operationId":"ConsultarLoteMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do lote gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeLote"}}}}}}},"/mdfe/nao-encerrados":{"get":{"tags":["Mdfe"],"summary":"Consulta MDF-e n\xe3o encerrados","operationId":"ConsultarMdfeNaoEncerrados","parameters":[{"in":"query","name":"cpf_cnpj","description":"CPF/CNPJ do emitente.\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MdfeNaoEncerrados"}}}}}}},"/mdfe/sefaz/status":{"get":{"tags":["Mdfe"],"summary":"Consulta do Status do Servi\xe7o na SEFAZ Autorizadora","description":"Consulta do status do servi\xe7o prestado pelo Portal da Secretaria de Fazenda Estadual.\\r\\n\\r\\nA API mant\xe9m a \xfaltima consulta em cache por 5 minutos, evitando sobrecarregar desnecessariamente os servidores da SEFAZ (conforme orienta\xe7\xe3o do MOC - vers\xe3o 3.0.0a, item 4.6.3). Dessa forma, voc\xea poder\xe1 chamar esse endpoint quantas vezes quiser, sem preocupar-se em ter o seu CNPJ bloqueado por consumo indevido (Rejei\xe7\xe3o 656).","operationId":"ConsultarStatusSefazMdfe","parameters":[{"in":"query","name":"cpf_cnpj","description":"CPF/CNPJ do emitente.\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"autorizador","description":"Ambiente Autorizador.\\r\\n\\r\\nAutorizadores dispon\xedveis: `SVRS`.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o ambiente autorizador da UF do emitente.*","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeSefazStatus"}}}}}}},"/mdfe/{id}":{"get":{"tags":["Mdfe"],"summary":"Consultar manifesto","description":"Consulta os detalhes de um manifesto j\xe1 existente. Forne\xe7a o ID \xfanico obtido de uma requisi\xe7\xe3o de emiss\xe3o ou de listagem de manifestos e a API ir\xe1 retornar as informa\xe7\xf5es do manifesto correspondente.","operationId":"ConsultarMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do MDF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Dfe"}}}}}}},"/mdfe/{id}/cancelamento":{"get":{"tags":["Mdfe"],"summary":"Consultar o cancelamento do MDF-e","operationId":"ConsultarCancelamentoMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do MDF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeCancelamento"}}}}}},"post":{"tags":["Mdfe"],"summary":"Cancelar um MDF-e autorizado","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"CancelarMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do MDF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MdfePedidoCancelamento"}}},"description":"Dados do cancelamento."},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeCancelamento"}}}}}}},"/mdfe/{id}/cancelamento/pdf":{"get":{"tags":["Mdfe"],"summary":"Baixar PDF do cancelamento","operationId":"BaixarPdfCancelamentoMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do MDF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/mdfe/{id}/cancelamento/xml":{"get":{"tags":["Mdfe"],"summary":"Baixar XML do cancelamento","operationId":"BaixarXmlCancelamentoMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do MDF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/mdfe/{id}/encerramento":{"get":{"tags":["Mdfe"],"summary":"Consultar encerramento do MDF-e","operationId":"ConsultarEncerramentoMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do MDF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MdfeEncerramento"}}}}}},"post":{"tags":["Mdfe"],"summary":"Encerrar um MDF-e autorizado","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"EncerrarMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do MDF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MdfePedidoEncerramento"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MdfeEncerramento"}}}}}}},"/mdfe/{id}/encerramento/pdf":{"get":{"tags":["Mdfe"],"summary":"Baixar PDF do encerramento","operationId":"BaixarPdfEncerramentoMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do MDF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/mdfe/{id}/encerramento/xml":{"get":{"tags":["Mdfe"],"summary":"Baixar XML do encerramento","operationId":"BaixarXmlEncerramentoMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do MDF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/mdfe/{id}/inclusao-condutor":{"post":{"tags":["Mdfe"],"summary":"Incluir um condutor em um MDF-e autorizado","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"IncluirCondutorMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do MDF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MdfePedidoInclusaoCondutor"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MdfeInclusaoCondutor"}}}}}}},"/mdfe/{id}/inclusao-dfe":{"post":{"tags":["Mdfe"],"summary":"Incluir um DF-e em um MDF-e autorizado","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"IncluirDfeMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do MDF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MdfePedidoInclusaoDfe"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MdfeInclusaoDfe"}}}}}}},"/mdfe/{id}/pdf":{"get":{"tags":["Mdfe"],"summary":"Baixar PDF do DAMDFE","operationId":"BaixarPdfMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do MDF-e gerado pela API.","required":true,"schema":{"type":"string"}},{"in":"query","name":"logotipo","description":"Imprime o documento com logotipo, desde que esteja cadastrado na empresa.","schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/mdfe/{id}/sincronizar":{"post":{"tags":["Mdfe"],"summary":"Sincroniza dados no MDF-e a partir da SEFAZ","description":"Realiza a sincroniza\xe7\xe3o dos dados a partir da consulta da situa\xe7\xe3o atual da MDF-e na Base de Dados do Portal da Secretaria de Fazenda Estadual.\\r\\n\\r\\n**Cen\xe1rios de uso**:\\r\\n* Sincronizar um manifesto que se encontra com o status `erro` na API, mas est\xe1 autorizado na SEFAZ (\xfatil em casos de erros de transmiss\xe3o com a SEFAZ, como instabilidades e timeouts).\\r\\n* Sincronizar um manifesto que se encontra com o status `autorizado`na API, mas est\xe1 cancelado ou encerrado na SEFAZ.\\r\\n* Sincronizar todos os eventos de Cancelamento, Encerramento, Inclus\xe3o de condutor e Inclus\xe3o de DF-e de um manifesto que porventura n\xe3o tenham sido feitos a partir da API.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por evento sincronizado ou requisi\xe7\xe3o.","operationId":"SincronizarMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do MDF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeSincronizacao"}}}}}}},"/mdfe/{id}/xml":{"get":{"tags":["Mdfe"],"summary":"Baixar XML do MDF-e processado","description":"Utilize esse endpoint para obter o XML do manifesto enviado para a SEFAZ, complementado com a informa\xe7\xe3o do protocolo de autoriza\xe7\xe3o ou denega\xe7\xe3o de uso (TAG raiz `mdfeProc`).\\r\\n\\r\\nO XML s\xf3 estar\xe1 dispon\xedvel nesse endpoint caso o manifesto tenha sido autorizado ou denegado pela SEFAZ. Para obter o XML nos demais casos, utilize o endpoint `GET /mdfe/{id}/xml/manifesto`.","operationId":"BaixarXmlMdfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do MDF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/mdfe/{id}/xml/manifesto":{"get":{"tags":["Mdfe"],"summary":"Baixar XML do MDF-e","description":"Utilize esse endpoint para obter o XML do manifesto enviado para a SEFAZ.\\r\\n\\r\\nO XML estar\xe1 dispon\xedvel nesse endpoint mesmo em casos que o manifesto tenha sido rejeitado.","operationId":"BaixarXmlMdfeManifesto","parameters":[{"in":"path","name":"id","description":"ID \xfanico da MDF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/mdfe/{id}/xml/protocolo":{"get":{"tags":["Mdfe"],"summary":"Baixar XML do Protocolo da SEFAZ","operationId":"BaixarXmlMdfeProtocolo","parameters":[{"in":"path","name":"id","description":"ID \xfanico da MDF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfce":{"get":{"tags":["Nfce"],"summary":"Listar NFC-e","description":"Retorna a lista de notas de acordo com os crit\xe9rios de busca utilizados. As notas s\xe3o retornadas ordenadas pela data da cria\xe7\xe3o, com as mais recentes aparecendo primeiro.","operationId":"ListarNfce","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ do emitente.\\r\\n\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"referencia","description":"Seu identificador \xfanico para o documento.","schema":{"type":"string"}},{"in":"query","name":"ambiente","description":"Identifica\xe7\xe3o do Ambiente.\\r\\n\\r\\nValores aceitos: homologacao, producao","required":true,"schema":{"type":"string"}},{"in":"query","name":"chave","description":"Chave de acesso do DF-e.","schema":{"type":"string"}},{"in":"query","name":"serie","description":"S\xe9rie do DF-e.","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeListagem"}}}}}},"post":{"tags":["Nfce"],"summary":"Emitir NFC-e","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"EmitirNfce","requestBody":{"$ref":"#/components/requestBodies/NfePedidoEmissao"},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Dfe"}}}}}}},"/nfce/eventos":{"get":{"tags":["Nfce"],"summary":"Listar eventos","description":"Retorna a lista de eventos vinculados a um documento fiscal de acordo com os crit\xe9rios de busca utilizados. Os eventos s\xe3o retornados ordenados pela data da cria\xe7\xe3o, com as mais recentes aparecendo primeiro.","operationId":"ListarEventosNfce","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"dfe_id","description":"ID \xfanico gerado pela API para o documento fiscal.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeEventoListagem"}}}}}}},"/nfce/eventos/{id}":{"get":{"tags":["Nfce"],"summary":"Consultar evento","operationId":"ConsultarEventoNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeEvento"}}}}}}},"/nfce/eventos/{id}/pdf":{"get":{"tags":["Nfce"],"summary":"Baixar PDF do evento","operationId":"BaixarPdfEventoNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfce/eventos/{id}/xml":{"get":{"tags":["Nfce"],"summary":"Baixar XML do evento","operationId":"BaixarXmlEventoNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfce/inutilizacoes":{"post":{"tags":["Nfce"],"summary":"Inutilizar uma sequ\xeancia de numera\xe7\xe3o de NFC-e","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"InutilizarNumeracaoNfce","requestBody":{"$ref":"#/components/requestBodies/DfePedidoInutilizacao"},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeInutilizacao"}}}}}}},"/nfce/inutilizacoes/{id}":{"get":{"tags":["Nfce"],"summary":"Consultar a inutiliza\xe7\xe3o de sequ\xeancia de numera\xe7\xe3o","operationId":"ConsultarInutilizacaoNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeInutilizacao"}}}}}}},"/nfce/inutilizacoes/{id}/pdf":{"get":{"tags":["Nfce"],"summary":"Baixar PDF da inutiliza\xe7\xe3o","operationId":"BaixarPdfInutilizacaoNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfce/inutilizacoes/{id}/xml":{"get":{"tags":["Nfce"],"summary":"Baixar XML da inutiliza\xe7\xe3o","operationId":"BaixarXmlInutilizacaoNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfce/lotes":{"get":{"tags":["Nfce"],"summary":"Listar lotes de NFC-e","description":"Retorna a lista dos lotes de acordo com os crit\xe9rios de busca utilizados. Os lotes s\xe3o retornados ordenados pela data da cria\xe7\xe3o, com os mais recentes aparecendo primeiro.","operationId":"ListarLotesNfce","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ do emitente.\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"referencia","schema":{"type":"string"}},{"in":"query","name":"ambiente","description":"Identifica\xe7\xe3o do Ambiente.\\r\\n\\r\\nValores aceitos: homologacao, producao","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeLoteListagem"}}}}}},"post":{"tags":["Nfce"],"summary":"Emitir lote de NFC-e","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por NFC-e.","operationId":"EmitirLoteNfce","requestBody":{"$ref":"#/components/requestBodies/NfePedidoEmissaoLote"},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeLote"}}}}}}},"/nfce/lotes/{id}":{"get":{"tags":["Nfce"],"summary":"Consultar lote de NFC-e","description":"Consulta os detalhes de um lote j\xe1 existente. Forne\xe7a o ID \xfanico obtido de uma requisi\xe7\xe3o de emiss\xe3o ou de listagem de lotes e a API ir\xe1 retornar as informa\xe7\xf5es do lote correspondente.","operationId":"ConsultarLoteNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico do lote gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeLote"}}}}}}},"/nfce/previa/pdf":{"post":{"tags":["Nfce"],"summary":"Pr\xe9via do PDF do DANFCE","description":"Atrav\xe9s desse endpoint, \xe9 poss\xedvel enviar os dados de uma NFC-e e gerar uma pr\xe9via do DANFCE.\\r\\n\\r\\nOs dados de entrada s\xe3o os mesmos do endpoint de emiss\xe3o de NFC-e (`POST /nfce`).\\r\\n\\r\\n**Aten\xe7\xe3o**: O DANFE gerado por este endpoint \xe9 apenas para fins de visualiza\xe7\xe3o e n\xe3o possui valor fiscal. Para a emiss\xe3o de uma NF-e com valor fiscal, utilize o processo de emiss\xe3o padr\xe3o descrito na documenta\xe7\xe3o.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"BaixarPreviaPdfNfce","parameters":[{"in":"query","name":"logotipo","description":"Imprime o documento com logotipo, desde que esteja cadastrado na empresa.","schema":{"type":"boolean","default":false}},{"in":"query","name":"nome_fantasia","description":"Exibe o nome fantasia do emitente, desde que esteja presente no XML da nota.","schema":{"type":"boolean","default":false}},{"in":"query","name":"mensagem_rodape","description":"Imprime mensagem no rodap\xe9 do documento.\\r\\n\\r\\nO caractere `|` (pipe) poder\xe1 ser utilizado para definir a quantidade e o alinhamento das mensagens.\\r\\n\\r\\n**Exemplos de Uso:**\\r\\n* `\\"esquerda\\"`\\r\\n* `\\"esquerda|centro\\"`\\r\\n* `\\"esquerda|centro|direita\\"`\\r\\n* `\\"|centro\\"`, `\\"|centro|\\"`\\r\\n* `\\"|centro|direita\\"`\\r\\n* `\\"||direita\\"`\\r\\n* `\\"esquerda||direita\\"`","schema":{"type":"string","maxLength":120,"default":""}},{"in":"query","name":"resumido","description":"Poder\xe1 ser impresso apenas o DANFE NFC-e resumido ou ecol\xf3gico, sem o detalhamento dos itens da venda, desde que a Unidade Federada permita esta op\xe7\xe3o em sua legisla\xe7\xe3o e o consumidor assim o solicite.","schema":{"type":"boolean","default":false}},{"in":"query","name":"qrcode_lateral","description":"Imprime o QRCode na lateral do DANFE NFC-e.\\r\\n\\r\\n*Dispon\xedvel apenas para DANFE com 80 mil\xedmetros de largura*.","schema":{"type":"boolean","default":false}},{"in":"query","name":"largura","description":"Largura do DANFE NFC-e (em mil\xedmetros).","schema":{"type":"integer","minimum":40,"maximum":80,"default":80}},{"in":"query","name":"margem","description":"Define as margens do DANFE NFC-e (em mil\xedmetros).\\r\\n\\r\\nEssa propriedade pode ser especificada usando um, dois, tr\xeas ou quatro valores (separados por v\xedrgulas). Cada valor deve ser um n\xfamero entre `0` e `9`.\\r\\n* Quando **um** valor \xe9 especificado, a mesma margem \xe9 aplicada para **todos os quatro lados**.\\r\\n* Quando **dois** valores s\xe3o especificados, a primeira margem \xe9 aplicada aos **lados esquerdo e direito**, e a segunda aos **lados superior e inferior**.\\r\\n* Quando **tr\xeas** valores s\xe3o especificados, a primeira margem \xe9 aplicada ao **lado esquerdo**, a segunda aos **lados superior e inferior**, e a terceira ao **lado direito**.\\r\\n* Quando **quatro** valores s\xe3o especificados, as margens s\xe3o aplicadas aos lados **esquerdo**, **superior**, **direito** e **inferior**, nesta ordem (sentido hor\xe1rio).\\r\\n\\r\\n**Exemplos de uso**:\\r\\n* `margem=1`\\r\\n  - Margem esquerda: 1mm\\r\\n  - Margem superior: 1mm\\r\\n  - Margem direita: 1mm\\r\\n  - Margem inferior: 1mm\\r\\n* `margem=1,2`\\r\\n  - Margem esquerda: 1mm\\r\\n  - Margem superior: 2mm\\r\\n  - Margem direita: 1mm\\r\\n  - Margem inferior: 2mm\\r\\n* `margem=1,2,3`\\r\\n  - Margem esquerda: 1mm\\r\\n  - Margem superior: 2mm\\r\\n  - Margem direita: 3mm\\r\\n  - Margem inferior: 2mm\\r\\n* `margem=1,2,3,4`\\r\\n  - Margem esquerda: 1mm\\r\\n  - Margem superior: 2mm\\r\\n  - Margem direita: 3mm\\r\\n  - Margem inferior: 4mm","schema":{"type":"string","default":"2"}}],"requestBody":{"$ref":"#/components/requestBodies/NfePedidoEmissao"},"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfce/previa/xml":{"post":{"tags":["Nfce"],"summary":"Pr\xe9via do XML da NFC-e","description":"Atrav\xe9s desse endpoint, \xe9 poss\xedvel enviar os dados de uma NFC-e e gerar uma pr\xe9via do XML, sem a assinatura digital.\\r\\n\\r\\nOs dados de entrada s\xe3o os mesmos do endpoint de emiss\xe3o de NFC-e (`POST /nfce`).\\r\\n\\r\\n**Aten\xe7\xe3o**: O XML gerado por este endpoint \xe9 apenas para fins de visualiza\xe7\xe3o e n\xe3o possui valor fiscal. Para a emiss\xe3o de uma NF-e com valor fiscal, utilize o processo de emiss\xe3o padr\xe3o descrito na documenta\xe7\xe3o.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"BaixarPreviaXmlNfce","requestBody":{"$ref":"#/components/requestBodies/NfePedidoEmissao"},"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfce/sefaz/status":{"get":{"tags":["Nfce"],"summary":"Consulta do Status do Servi\xe7o na SEFAZ Autorizadora","description":"Consulta do status do servi\xe7o prestado pelo Portal da Secretaria de Fazenda Estadual.\\r\\n\\r\\nA API mant\xe9m a \xfaltima consulta em cache por 5 minutos, evitando sobrecarregar desnecessariamente os servidores da SEFAZ (conforme orienta\xe7\xe3o do MOC - vers\xe3o 7.0, item 5.5.3). Dessa forma, voc\xea poder\xe1 chamar esse endpoint quantas vezes quiser, sem preocupar-se em ter o seu CNPJ bloqueado por consumo indevido (Rejei\xe7\xe3o 656).","operationId":"ConsultarStatusSefazNfce","parameters":[{"in":"query","name":"cpf_cnpj","description":"CPF/CNPJ do emitente.\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"autorizador","description":"Ambiente Autorizador.\\r\\n\\r\\nAutorizadores dispon\xedveis: `AM`, `BA`, `CE`, `GO`, `MG`, `MS`, `MT`, `PE`, `PR`, `RS`, `SP`, `SVRS`.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o ambiente autorizador da UF do emitente.*","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeSefazStatus"}}}}}}},"/nfce/{id}":{"get":{"tags":["Nfce"],"summary":"Consultar NFC-e","description":"Consulta os detalhes de uma NFC-e j\xe1 existente. Forne\xe7a o ID \xfanico obtido de uma requisi\xe7\xe3o de emiss\xe3o ou de listagem de notas e a API ir\xe1 retornar as informa\xe7\xf5es da nota correspondente.","operationId":"ConsultarNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFC-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Dfe"}}}}}}},"/nfce/{id}/cancelamento":{"get":{"tags":["Nfce"],"summary":"Consultar o cancelamento da NFC-e","operationId":"ConsultarCancelamentoNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFC-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeCancelamento"}}}}}},"post":{"tags":["Nfce"],"summary":"Cancelar uma NFC-e autorizada","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"CancelarNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFC-e gerado pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"$ref":"#/components/requestBodies/NfePedidoCancelamento"},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeCancelamento"}}}}}}},"/nfce/{id}/cancelamento/pdf":{"get":{"tags":["Nfce"],"summary":"Baixar PDF do cancelamento","operationId":"BaixarPdfCancelamentoNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFC-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfce/{id}/cancelamento/xml":{"get":{"tags":["Nfce"],"summary":"Baixar XML do cancelamento","operationId":"BaixarXmlCancelamentoNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFC-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfce/{id}/email":{"post":{"tags":["Nfce"],"summary":"Enviar e-mail","description":"Envia o XML e PDF da nota via email.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"EnviarEmailNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFC-e gerado pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"$ref":"#/components/requestBodies/DfePedidoEnvioEmail"},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EmailStatusResponse"}}}}}}},"/nfce/{id}/escpos":{"get":{"tags":["Nfce"],"summary":"Comandos ESC/POS para impress\xe3o do DANFCE","description":"ESC/POS \xe9 um sistema de comando criado pela Epson usado em diversos sistemas de impressoras POS.\\r\\n\\r\\nCom o formato ESC/POS, voc\xea poder\xe1 imprimir nativamente em uma vasta quantidade de modelos de impressora t\xe9rmicas utilizadas no Brasil e no mundo. Com ela, voc\xea consegue fazer o envio de comandos em ESC/POS direto para a porta da impressora.","operationId":"BaixarEscPosNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFC-e gerado pela API.","required":true,"schema":{"type":"string"}},{"in":"query","name":"modelo","description":"Modelo da impressora:\\r\\n* `0` - Texto\\r\\n* `1` - Epson\\r\\n* `2` - Bematech\\r\\n* `3` - Daruma\\r\\n* `4` - Vox\\r\\n* `5` - Diebold\\r\\n* `6` - Epson P2\\r\\n* `7` - CustomPos\\r\\n* `8` - Star\\r\\n* `9` - Zjiang\\r\\n* `10` - GPrinter\\r\\n* `11` - Datecs\\r\\n* `12` - Sunmi\\r\\n* `13` - Externo","schema":{"type":"integer","minimum":0,"maximum":13,"default":1}},{"in":"query","name":"colunas","description":"Define o m\xe1ximo de caracteres, em uma linha, usando a fonte normal.\\r\\n\\r\\nEx: 40, 42, 48, 58, 80.","schema":{"type":"integer","default":48}},{"in":"query","name":"qrcode_lateral","description":"Imprime o QRCode na lateral do DANFCe.\\r\\n\\r\\nOBS: n\xe3o suportado por alguns modelos de impressora.","schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfce/{id}/pdf":{"get":{"tags":["Nfce"],"summary":"Baixar PDF do DANFCE","operationId":"BaixarPdfNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFC-e gerado pela API.","required":true,"schema":{"type":"string"}},{"in":"query","name":"logotipo","description":"Imprime o documento com logotipo, desde que esteja cadastrado na empresa.","schema":{"type":"boolean","default":false}},{"in":"query","name":"nome_fantasia","description":"Exibe o nome fantasia do emitente, desde que esteja presente no XML da nota.","schema":{"type":"boolean","default":false}},{"in":"query","name":"mensagem_rodape","description":"Imprime mensagem no rodap\xe9 do documento.\\r\\n\\r\\nO caractere `|` (pipe) poder\xe1 ser utilizado para definir a quantidade e o alinhamento das mensagens.\\r\\n\\r\\n**Exemplos de Uso:**\\r\\n* `\\"esquerda\\"`\\r\\n* `\\"esquerda|centro\\"`\\r\\n* `\\"esquerda|centro|direita\\"`\\r\\n* `\\"|centro\\"`, `\\"|centro|\\"`\\r\\n* `\\"|centro|direita\\"`\\r\\n* `\\"||direita\\"`\\r\\n* `\\"esquerda||direita\\"`","schema":{"type":"string","maxLength":120,"default":""}},{"in":"query","name":"resumido","description":"Poder\xe1 ser impresso apenas o DANFE NFC-e resumido ou ecol\xf3gico, sem o detalhamento dos itens da venda, desde que a Unidade Federada permita esta op\xe7\xe3o em sua legisla\xe7\xe3o e o consumidor assim o solicite.","schema":{"type":"boolean","default":false}},{"in":"query","name":"qrcode_lateral","description":"Imprime o QRCode na lateral do DANFE NFC-e.\\r\\n\\r\\n*Dispon\xedvel apenas para DANFE com 80 mil\xedmetros de largura*.","schema":{"type":"boolean","default":false}},{"in":"query","name":"largura","description":"Largura do DANFE NFC-e (em mil\xedmetros).","schema":{"type":"integer","minimum":40,"maximum":80,"default":80}},{"in":"query","name":"margem","description":"Define as margens do DANFE NFC-e (em mil\xedmetros).\\r\\n\\r\\nEssa propriedade pode ser especificada usando um, dois, tr\xeas ou quatro valores (separados por v\xedrgulas). Cada valor deve ser um n\xfamero entre `0` e `9`.\\r\\n* Quando **um** valor \xe9 especificado, a mesma margem \xe9 aplicada para **todos os quatro lados**.\\r\\n* Quando **dois** valores s\xe3o especificados, a primeira margem \xe9 aplicada aos **lados esquerdo e direito**, e a segunda aos **lados superior e inferior**.\\r\\n* Quando **tr\xeas** valores s\xe3o especificados, a primeira margem \xe9 aplicada ao **lado esquerdo**, a segunda aos **lados superior e inferior**, e a terceira ao **lado direito**.\\r\\n* Quando **quatro** valores s\xe3o especificados, as margens s\xe3o aplicadas aos lados **esquerdo**, **superior**, **direito** e **inferior**, nesta ordem (sentido hor\xe1rio).\\r\\n\\r\\n**Exemplos de uso**:\\r\\n* `margem=1`\\r\\n  - Margem esquerda: 1mm\\r\\n  - Margem superior: 1mm\\r\\n  - Margem direita: 1mm\\r\\n  - Margem inferior: 1mm\\r\\n* `margem=1,2`\\r\\n  - Margem esquerda: 1mm\\r\\n  - Margem superior: 2mm\\r\\n  - Margem direita: 1mm\\r\\n  - Margem inferior: 2mm\\r\\n* `margem=1,2,3`\\r\\n  - Margem esquerda: 1mm\\r\\n  - Margem superior: 2mm\\r\\n  - Margem direita: 3mm\\r\\n  - Margem inferior: 2mm\\r\\n* `margem=1,2,3,4`\\r\\n  - Margem esquerda: 1mm\\r\\n  - Margem superior: 2mm\\r\\n  - Margem direita: 3mm\\r\\n  - Margem inferior: 4mm","schema":{"type":"string","default":"2"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfce/{id}/sincronizar":{"post":{"tags":["Nfce"],"summary":"Sincroniza dados na NFC-e a partir da SEFAZ","description":"Realiza a sincroniza\xe7\xe3o dos dados a partir da consulta da situa\xe7\xe3o atual da NFC-e na Base de Dados do Portal da Secretaria de Fazenda Estadual.\\r\\n\\r\\n**Cen\xe1rios de uso**:\\r\\n* Sincronizar uma nota que se encontra com o status `erro` na API, mas est\xe1 autorizada na SEFAZ (\xfatil em casos de erros de transmiss\xe3o com a SEFAZ, como instabilidades e timeouts).\\r\\n* Sincronizar uma nota que se encontra com o status `autorizado`na API, mas est\xe1 cancelada na SEFAZ.\\r\\n* Sincronizar todos os eventos de Cancelamento, Carta de Corre\xe7\xe3o e EPEC de uma nota que porventura n\xe3o tenham sido feitos a partir da API.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por evento sincronizado ou requisi\xe7\xe3o.","operationId":"SincronizarNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFC-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeSincronizacao"}}}}}}},"/nfce/{id}/xml":{"get":{"tags":["Nfce"],"summary":"Baixar XML da NFC-e processada","description":"Utilize esse endpoint para obter o XML da nota enviado para a SEFAZ, complementado com a informa\xe7\xe3o do protocolo de autoriza\xe7\xe3o ou denega\xe7\xe3o de uso (TAG raiz `nfeProc`).\\r\\n\\r\\nO XML s\xf3 estar\xe1 dispon\xedvel nesse endpoint caso a nota tenha sido autorizada ou denegada pela SEFAZ. Para obter o XML nos demais casos, utilize o endpoint `GET /nfce/{id}/xml/nota`.","operationId":"BaixarXmlNfce","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFC-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfce/{id}/xml/nota":{"get":{"tags":["Nfce"],"summary":"Baixar XML da NFC-e","description":"Utilize esse endpoint para obter o XML da nota enviado para a SEFAZ.\\r\\n\\r\\nO XML estar\xe1 dispon\xedvel nesse endpoint mesmo em casos que a nota tenha sido rejeitada.","operationId":"BaixarXmlNfceNota","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFC-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfce/{id}/xml/protocolo":{"get":{"tags":["Nfce"],"summary":"Baixar XML do Protocolo da SEFAZ","operationId":"BaixarXmlNfceProtocolo","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFC-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfcom":{"get":{"tags":["Nfcom"],"summary":"Listar NFCom","description":"Retorna a lista de NFCom de acordo com os crit\xe9rios de busca utilizados. As NFCom s\xe3o retornadas ordenadas pela data da cria\xe7\xe3o, com as mais recentes aparecendo primeiro.","operationId":"ListarNfcom","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ do emitente.\\r\\n\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"referencia","description":"Seu identificador \xfanico para o documento.","schema":{"type":"string"}},{"in":"query","name":"ambiente","description":"Identifica\xe7\xe3o do Ambiente.\\r\\n\\r\\nValores aceitos: homologacao, producao","required":true,"schema":{"type":"string"}},{"in":"query","name":"chave","description":"Chave de acesso do DF-e.","schema":{"type":"string"}},{"in":"query","name":"serie","description":"S\xe9rie do DF-e.","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeListagem"}}}}}},"post":{"tags":["Nfcom"],"summary":"Emitir NFCom","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"EmitirNfcom","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfcomPedidoEmissao"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Dfe"}}}}}}},"/nfcom/sefaz/status":{"get":{"tags":["Nfcom"],"summary":"Consulta do Status do Servi\xe7o na SEFAZ Autorizadora","description":"Consulta do status do servi\xe7o prestado pelo Portal da Secretaria de Fazenda Estadual.\\r\\n\\r\\nA API mant\xe9m a \xfaltima consulta em cache por 5 minutos, evitando sobrecarregar desnecessariamente os servidores da SEFAZ.","operationId":"ConsultarStatusSefazNfcom","parameters":[{"in":"query","name":"cpf_cnpj","description":"CPF/CNPJ do emitente.\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"autorizador","description":"Ambiente Autorizador.\\r\\n\\r\\nAutorizadores dispon\xedveis: `SVRS`.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o ambiente autorizador da UF do emitente.*","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeSefazStatus"}}}}}}},"/nfcom/{id}":{"get":{"tags":["Nfcom"],"summary":"Consultar NFCom","description":"Consulta os detalhes de uma NFCom j\xe1 existente. Forne\xe7a o ID \xfanico obtido de uma requisi\xe7\xe3o de emiss\xe3o ou de listagem de NFCom e a API ir\xe1 retornar as informa\xe7\xf5es da NFCom correspondente.","operationId":"ConsultarNfcom","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFCom gerada pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Dfe"}}}}}}},"/nfcom/{id}/cancelamento":{"get":{"tags":["Nfcom"],"summary":"Consultar o cancelamento da NFCom","operationId":"ConsultarCancelamentoNfcom","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFCom gerada pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeCancelamento"}}}}}},"post":{"tags":["Nfcom"],"summary":"Cancelar uma NFCom autorizada","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"CancelarNfcom","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFCom gerada pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfcomPedidoCancelamento"}}}},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeCancelamento"}}}}}}},"/nfcom/{id}/cancelamento/xml":{"get":{"tags":["Nfcom"],"summary":"Baixar XML do cancelamento","operationId":"BaixarXmlCancelamentoNfcom","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFCom gerada pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfcom/{id}/pdf":{"get":{"tags":["Nfcom"],"summary":"Baixar PDF do DANFE-COM","operationId":"BaixarPdfNfcom","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFCom gerado pela API.","required":true,"schema":{"type":"string"}},{"in":"query","name":"logotipo","description":"Imprime o documento com logotipo, desde que esteja cadastrado na empresa.","schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfcom/{id}/xml":{"get":{"tags":["Nfcom"],"summary":"Baixar XML da NFCom processada","description":"Utilize esse endpoint para obter o XML da nota enviada para a SEFAZ, complementado com a informa\xe7\xe3o do protocolo de autoriza\xe7\xe3o de uso (TAG raiz `nfcomProc`).\\r\\n\\r\\nO XML s\xf3 estar\xe1 dispon\xedvel nesse endpoint caso a nota tenha sido autorizada pela SEFAZ. Para obter o XML nos demais casos, utilize o endpoint `GET /nfcom/{id}/xml/nota`.","operationId":"BaixarXmlNfcom","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFCom gerada pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfcom/{id}/xml/nota":{"get":{"tags":["Nfcom"],"summary":"Baixar XML da NFCom","description":"Utilize esse endpoint para obter o XML da nota enviada para a SEFAZ.\\r\\n\\r\\nO XML estar\xe1 dispon\xedvel nesse endpoint mesmo em casos que a nota tenha sido rejeitada.","operationId":"BaixarXmlNfcomNota","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFCom gerada pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfcom/{id}/xml/protocolo":{"get":{"tags":["Nfcom"],"summary":"Baixar XML do Protocolo da SEFAZ","operationId":"BaixarXmlNfcomProtocolo","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFCom gerada pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfe":{"get":{"tags":["Nfe"],"summary":"Listar NF-e","description":"Retorna a lista de notas de acordo com os crit\xe9rios de busca utilizados. As notas s\xe3o retornadas ordenadas pela data da cria\xe7\xe3o, com as mais recentes aparecendo primeiro.","operationId":"ListarNfe","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ do emitente.\\r\\n\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"referencia","description":"Seu identificador \xfanico para o documento.","schema":{"type":"string"}},{"in":"query","name":"ambiente","description":"Identifica\xe7\xe3o do Ambiente.\\r\\n\\r\\nValores aceitos: homologacao, producao","required":true,"schema":{"type":"string"}},{"in":"query","name":"chave","description":"Chave de acesso do DF-e.","schema":{"type":"string"}},{"in":"query","name":"serie","description":"S\xe9rie do DF-e.","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeListagem"}}}}}},"post":{"tags":["Nfe"],"summary":"Emitir NF-e","description":"Este endpoint permite a emiss\xe3o de Notas Fiscais Eletr\xf4nicas (NF-e).\\r\\nA solicita\xe7\xe3o deve ser feita enviando os dados necess\xe1rios para a\\r\\nemiss\xe3o de uma NF-e. \\r\\n\\r\\nA estrutura do JSON utilizado na solicita\xe7\xe3o segue a hierarquia e\\r\\nnomenclatura de campos definidos no <a href=\\"https://www.nfe.fazenda.gov.br/portal/principal.aspx\\" target=\\"_blank\\">\\r\\nManual de Orienta\xe7\xe3o ao Contribuinte (MOC)</a>.\\r\\nEsta conformidade visa facilitar a integra\xe7\xe3o de novos usu\xe1rios que j\xe1\\r\\npossuem familiaridade com o padr\xe3o, al\xe9m de permitir a resolu\xe7\xe3o de\\r\\nd\xfavidas diretamente no MOC, com um profissional de contabilidade\\r\\nhabilitado ou em outras fontes confi\xe1veis que tratam do mesmo assunto.\\r\\n\\r\\n**Comportamento Ass\xedncrono**\\r\\n\\r\\nA resposta desse endpoint inclui a propriedade *status* no JSON.\\r\\nCaso o valor retornado seja *pendente*, significa que a solicita\xe7\xe3o est\xe1\\r\\nsendo realizada de forma ass\xedncrona pela API. Nesse caso, o usu\xe1rio dever\xe1\\r\\nadotar um fluxo que consiste em requisitar periodicamente o endpoint\\r\\n<a href=\\"#tag/Nfe/operation/ConsultarNfe\\">Consultar NF-e</a> at\xe9 que\\r\\nseja retornado um status indicando o fim da emiss\xe3o.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"EmitirNfe","requestBody":{"$ref":"#/components/requestBodies/NfePedidoEmissao"},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Dfe"}}}}}}},"/nfe/cadastro-contribuinte":{"get":{"tags":["Nfe"],"summary":"Consultar contribuinte","description":"Consulta o Cadastro Centralizado de Contribuintes (CCC) do ICMS da unidade federada.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"ConsultarContribuinteNfe","parameters":[{"in":"query","name":"cpf_cnpj","description":"CPF ou CNPJ da empresa.\\r\\n\\r\\n*Utilize o valor sem m\xe1scara*.","required":true,"schema":{"type":"string"}},{"in":"query","name":"uf","description":"Sigla da UF consultada.\\r\\n\\r\\n Utilize `SU` para SUFRAMA.\\r\\n\\r\\n*Caso n\xe3o seja informada, ser\xe1 utilizada a UF da empresa.*","schema":{"type":"string"}},{"in":"query","name":"argumento","description":"Argumento de pesquisa.\\r\\n\\r\\nValores v\xe1lidos:\\r\\n* `CNPJ`\\r\\n* `CPF`\\r\\n* `IE`","required":true,"schema":{"type":"string"}},{"in":"query","name":"documento","description":"Documento a ser consultado (CNPJ, CPF ou Inscri\xe7\xe3o Estadual).","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeContribuinteInfCons"}}}}}}},"/nfe/eventos":{"get":{"tags":["Nfe"],"summary":"Listar eventos","description":"Retorna a lista de eventos vinculados a um documento fiscal de acordo com os crit\xe9rios de busca utilizados. Os eventos s\xe3o retornados ordenados pela data da cria\xe7\xe3o, com as mais recentes aparecendo primeiro.","operationId":"ListarEventosNfe","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"dfe_id","description":"ID \xfanico gerado pela API para o documento fiscal.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeEventoListagem"}}}}}}},"/nfe/eventos/{id}":{"get":{"tags":["Nfe"],"summary":"Consultar evento","operationId":"ConsultarEventoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeEvento"}}}}}}},"/nfe/eventos/{id}/pdf":{"get":{"tags":["Nfe"],"summary":"Baixar PDF do evento","operationId":"BaixarPdfEventoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfe/eventos/{id}/xml":{"get":{"tags":["Nfe"],"summary":"Baixar XML do evento","operationId":"BaixarXmlEventoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfe/inutilizacoes":{"post":{"tags":["Nfe"],"summary":"Inutilizar uma sequ\xeancia de numera\xe7\xe3o de NF-e","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"InutilizarNumeracaoNfe","requestBody":{"$ref":"#/components/requestBodies/DfePedidoInutilizacao"},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeInutilizacao"}}}}}}},"/nfe/inutilizacoes/{id}":{"get":{"tags":["Nfe"],"summary":"Consultar a inutiliza\xe7\xe3o de sequ\xeancia de numera\xe7\xe3o","operationId":"ConsultarInutilizacaoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeInutilizacao"}}}}}}},"/nfe/inutilizacoes/{id}/pdf":{"get":{"tags":["Nfe"],"summary":"Baixar PDF da inutiliza\xe7\xe3o","operationId":"BaixarPdfInutilizacaoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfe/inutilizacoes/{id}/xml":{"get":{"tags":["Nfe"],"summary":"Baixar XML da inutiliza\xe7\xe3o","operationId":"BaixarXmlInutilizacaoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfe/lotes":{"get":{"tags":["Nfe"],"summary":"Listar lotes de NF-e","description":"Retorna a lista dos lotes de acordo com os crit\xe9rios de busca utilizados. Os lotes s\xe3o retornados ordenados pela data da cria\xe7\xe3o, com os mais recentes aparecendo primeiro.","operationId":"ListarLotesNfe","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ do emitente.\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"referencia","schema":{"type":"string"}},{"in":"query","name":"ambiente","description":"Identifica\xe7\xe3o do Ambiente.\\r\\n\\r\\nValores aceitos: homologacao, producao","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeLoteListagem"}}}}}},"post":{"tags":["Nfe"],"summary":"Emitir lote de NF-e","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por NF-e.","operationId":"EmitirLoteNfe","requestBody":{"$ref":"#/components/requestBodies/NfePedidoEmissaoLote"},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeLote"}}}}}}},"/nfe/lotes/{id}":{"get":{"tags":["Nfe"],"summary":"Consultar lote de NF-e","description":"Consulta os detalhes de um lote j\xe1 existente. Forne\xe7a o ID \xfanico obtido de uma requisi\xe7\xe3o de emiss\xe3o ou de listagem de lotes e a API ir\xe1 retornar as informa\xe7\xf5es do lote correspondente.","operationId":"ConsultarLoteNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do lote gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeLote"}}}}}}},"/nfe/previa/pdf":{"post":{"tags":["Nfe"],"summary":"Pr\xe9via do PDF do DANFE","description":"Atrav\xe9s desse endpoint, \xe9 poss\xedvel enviar os dados de uma NF-e e gerar uma pr\xe9via do DANFE.\\r\\n\\r\\nOs dados de entrada s\xe3o os mesmos do endpoint de emiss\xe3o de NF-e (`POST /nfe`).\\r\\n\\r\\n**Aten\xe7\xe3o**: O DANFE gerado por este endpoint \xe9 apenas para fins de visualiza\xe7\xe3o e n\xe3o possui valor fiscal. Para a emiss\xe3o de uma NF-e com valor fiscal, utilize o processo de emiss\xe3o padr\xe3o descrito na documenta\xe7\xe3o.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"BaixarPreviaPdfNfe","parameters":[{"in":"query","name":"logotipo","description":"Imprime o documento com logotipo, desde que esteja cadastrado na empresa.","schema":{"type":"boolean","default":false}},{"in":"query","name":"nome_fantasia","description":"Exibe o nome fantasia do emitente, desde que esteja presente no XML da nota.","schema":{"type":"boolean","default":false}},{"in":"query","name":"formato","description":"Formato de impress\xe3o do DANFE.\\r\\n\\r\\nValores dispon\xedveis:\\r\\n- `padrao`: ser\xe1 utilizado o formato definido no XML da NF-e (tag \\"tpImp\\");\\r\\n- `retrato`: tamanho A4 em modo retrato;\\r\\n- `paisagem`: tamanho A4 em modo paisagem;\\r\\n- `simplificado`: formato simplificado utilizado nas opera\xe7\xf5es realizadas fora do estabelecimento (Anexo II do MOC, item 3.11);\\r\\n- `etiqueta`: formato simplificado utilizado nas opera\xe7\xf5es em com\xe9rcio eletr\xf4nico (Anexo II do MOC, item 3.12 e NT 2020.004).","schema":{"type":"string","default":"padrao"}},{"in":"query","name":"mensagem_rodape","description":"Imprime mensagem no rodap\xe9 do documento.\\r\\n\\r\\nO caractere `|` (pipe) poder\xe1 ser utilizado para definir a quantidade e o alinhamento das mensagens.\\r\\n\\r\\n**Exemplos de Uso:**\\r\\n* `\\"esquerda\\"`\\r\\n* `\\"esquerda|centro\\"`\\r\\n* `\\"esquerda|centro|direita\\"`\\r\\n* `\\"|centro\\"`, `\\"|centro|\\"`\\r\\n* `\\"|centro|direita\\"`\\r\\n* `\\"||direita\\"`\\r\\n* `\\"esquerda||direita\\"`","schema":{"type":"string","maxLength":120,"default":""}},{"in":"query","name":"canhoto","description":"Imprime o documento com o bloco de canhoto.","schema":{"type":"boolean","default":true}}],"requestBody":{"$ref":"#/components/requestBodies/NfePedidoEmissao"},"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfe/previa/xml":{"post":{"tags":["Nfe"],"summary":"Pr\xe9via do XML da NF-e","description":"Atrav\xe9s desse endpoint, \xe9 poss\xedvel enviar os dados de uma NF-e e gerar uma pr\xe9via do XML, sem a assinatura digital.\\r\\n\\r\\nOs dados de entrada s\xe3o os mesmos do endpoint de emiss\xe3o de NF-e (`POST /nfe`).\\r\\n\\r\\n**Aten\xe7\xe3o**: O XML gerado por este endpoint \xe9 apenas para fins de visualiza\xe7\xe3o e n\xe3o possui valor fiscal. Para a emiss\xe3o de uma NF-e com valor fiscal, utilize o processo de emiss\xe3o padr\xe3o descrito na documenta\xe7\xe3o.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"BaixarPreviaXmlNfe","requestBody":{"$ref":"#/components/requestBodies/NfePedidoEmissao"},"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfe/sefaz/status":{"get":{"tags":["Nfe"],"summary":"Consulta do Status do Servi\xe7o na SEFAZ Autorizadora","description":"Consulta do status do servi\xe7o prestado pelo Portal da Secretaria de Fazenda Estadual.\\r\\n\\r\\nA API mant\xe9m a \xfaltima consulta em cache por 5 minutos, evitando sobrecarregar desnecessariamente os servidores da SEFAZ (conforme orienta\xe7\xe3o do MOC - vers\xe3o 7.0, item 5.5.3). Dessa forma, voc\xea poder\xe1 chamar esse endpoint quantas vezes quiser, sem preocupar-se em ter o seu CNPJ bloqueado por consumo indevido (Rejei\xe7\xe3o 656).","operationId":"ConsultarStatusSefazNfe","parameters":[{"in":"query","name":"cpf_cnpj","description":"CPF/CNPJ do emitente.\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"autorizador","description":"Ambiente Autorizador.\\r\\n\\r\\nAutorizadores dispon\xedveis: `AM`, `BA`, `GO`, `MG`, `MS`, `MT`, `PE`, `PR`, `RS`, `SP`, `SVAN`, `SVRS`, `SVCAN`, `SVCRS`, `AN`.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o ambiente autorizador da UF do emitente.*","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeSefazStatus"}}}}}}},"/nfe/{id}":{"get":{"tags":["Nfe"],"summary":"Consultar NF-e","description":"Consulta os detalhes de uma NF-e j\xe1 existente. Forne\xe7a o ID \xfanico obtido de uma requisi\xe7\xe3o de emiss\xe3o ou de listagem de notas e a API ir\xe1 retornar as informa\xe7\xf5es da nota correspondente.","operationId":"ConsultarNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Dfe"}}}}}}},"/nfe/{id}/cancelamento":{"get":{"tags":["Nfe"],"summary":"Consultar o cancelamento da NF-e","operationId":"ConsultarCancelamentoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeCancelamento"}}}}}},"post":{"tags":["Nfe"],"summary":"Cancelar uma NF-e autorizada","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"CancelarNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"$ref":"#/components/requestBodies/NfePedidoCancelamento"},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeCancelamento"}}}}}}},"/nfe/{id}/cancelamento/pdf":{"get":{"tags":["Nfe"],"summary":"Baixar PDF do cancelamento","operationId":"BaixarPdfCancelamentoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfe/{id}/cancelamento/xml":{"get":{"tags":["Nfe"],"summary":"Baixar XML do cancelamento","operationId":"BaixarXmlCancelamentoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfe/{id}/carta-correcao":{"get":{"tags":["Nfe"],"summary":"Consultar a solicita\xe7\xe3o de corre\xe7\xe3o da NF-e","operationId":"ConsultarCartaCorrecaoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeCartaCorrecao"}}}}}},"post":{"tags":["Nfe"],"summary":"Solicitar corre\xe7\xe3o da NF-e","description":"\xc9 poss\xedvel enviar at\xe9 20 corre\xe7\xf5es diferentes, sendo que ser\xe1 v\xe1lido sempre a \xfaltima corre\xe7\xe3o enviada.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"CriarCartaCorrecaoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfePedidoCartaCorrecao"}}},"description":"Cont\xe9m os dados do pedido para carta de corre\xe7\xe3o.","required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeCartaCorrecao"}}}}}}},"/nfe/{id}/carta-correcao/pdf":{"get":{"tags":["Nfe"],"summary":"Baixar PDF da carta de corre\xe7\xe3o","operationId":"BaixarPdfCartaCorrecaoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfe/{id}/carta-correcao/xml":{"get":{"tags":["Nfe"],"summary":"Baixar XML da carta de corre\xe7\xe3o","operationId":"BaixarXmlCartaCorrecaoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfe/{id}/email":{"post":{"tags":["Nfe"],"summary":"Enviar e-mail","description":"Envia o XML e PDF da nota via email.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"EnviarEmailNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"$ref":"#/components/requestBodies/DfePedidoEnvioEmail"},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EmailStatusResponse"}}}}}}},"/nfe/{id}/pdf":{"get":{"tags":["Nfe"],"summary":"Baixar PDF do DANFE","operationId":"BaixarPdfNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NF-e gerado pela API.","required":true,"schema":{"type":"string"}},{"in":"query","name":"logotipo","description":"Imprime o documento com logotipo, desde que esteja cadastrado na empresa.","schema":{"type":"boolean","default":false}},{"in":"query","name":"nome_fantasia","description":"Exibe o nome fantasia do emitente, desde que esteja presente no XML da nota.","schema":{"type":"boolean","default":false}},{"in":"query","name":"formato","description":"Formato de impress\xe3o do DANFE.\\r\\n\\r\\nValores dispon\xedveis:\\r\\n- `padrao`: ser\xe1 utilizado o formato definido no XML da NF-e (tag \\"tpImp\\");\\r\\n- `retrato`: tamanho A4 em modo retrato;\\r\\n- `paisagem`: tamanho A4 em modo paisagem;\\r\\n- `simplificado`: formato simplificado utilizado nas opera\xe7\xf5es realizadas fora do estabelecimento (Anexo II do MOC, item 3.11);\\r\\n- `etiqueta`: formato simplificado utilizado nas opera\xe7\xf5es em com\xe9rcio eletr\xf4nico (Anexo II do MOC, item 3.12 e NT 2020.004).","schema":{"type":"string","default":"padrao"}},{"in":"query","name":"mensagem_rodape","description":"Imprime mensagem no rodap\xe9 do documento.\\r\\n\\r\\nO caractere `|` (pipe) poder\xe1 ser utilizado para definir a quantidade e o alinhamento das mensagens.\\r\\n\\r\\n**Exemplos de Uso:**\\r\\n* `\\"esquerda\\"`\\r\\n* `\\"esquerda|centro\\"`\\r\\n* `\\"esquerda|centro|direita\\"`\\r\\n* `\\"|centro\\"`, `\\"|centro|\\"`\\r\\n* `\\"|centro|direita\\"`\\r\\n* `\\"||direita\\"`\\r\\n* `\\"esquerda||direita\\"`","schema":{"type":"string","maxLength":120,"default":""}},{"in":"query","name":"canhoto","description":"Imprime o documento com o bloco de canhoto.","schema":{"type":"boolean","default":true}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfe/{id}/sincronizar":{"post":{"tags":["Nfe"],"summary":"Sincroniza dados na NF-e a partir da SEFAZ","description":"Realiza a sincroniza\xe7\xe3o dos dados a partir da consulta da situa\xe7\xe3o atual da NF-e na Base de Dados do Portal da Secretaria de Fazenda Estadual.\\r\\n\\r\\n**Cen\xe1rios de uso**:\\r\\n* Sincronizar uma nota que se encontra com o status `erro` na API, mas est\xe1 autorizada na SEFAZ (\xfatil em casos de erros de transmiss\xe3o com a SEFAZ, como instabilidades e timeouts).\\r\\n* Sincronizar uma nota que se encontra com o status `autorizado`na API, mas est\xe1 cancelada na SEFAZ.\\r\\n* Sincronizar todos os eventos de Cancelamento, Carta de Corre\xe7\xe3o e EPEC de uma nota que porventura n\xe3o tenham sido feitos a partir da API.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por evento sincronizado ou requisi\xe7\xe3o.","operationId":"SincronizarNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeSincronizacao"}}}}}}},"/nfe/{id}/xml":{"get":{"tags":["Nfe"],"summary":"Baixar XML da NF-e processada","description":"Utilize esse endpoint para obter o XML da nota enviado para a SEFAZ, complementado com a informa\xe7\xe3o do protocolo de autoriza\xe7\xe3o ou denega\xe7\xe3o de uso (TAG raiz `nfeProc`).\\r\\n\\r\\nO XML s\xf3 estar\xe1 dispon\xedvel nesse endpoint caso a nota tenha sido autorizada ou denegada pela SEFAZ. Para obter o XML nos demais casos, utilize o endpoint `GET /nfe/{id}/xml/nota`.","operationId":"BaixarXmlNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfe/{id}/xml/nota":{"get":{"tags":["Nfe"],"summary":"Baixar XML da NF-e","description":"Utilize esse endpoint para obter o XML da nota enviado para a SEFAZ.\\r\\n\\r\\nO XML estar\xe1 dispon\xedvel nesse endpoint mesmo em casos que a nota tenha sido rejeitada.","operationId":"BaixarXmlNfeNota","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfe/{id}/xml/protocolo":{"get":{"tags":["Nfe"],"summary":"Baixar XML do Protocolo da SEFAZ","operationId":"BaixarXmlNfeProtocolo","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NF-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfse":{"get":{"tags":["Nfse"],"summary":"Listar NFS-e","description":"Retorna a lista de notas de acordo com os crit\xe9rios de busca utilizados. As notas s\xe3o retornadas ordenadas pela data da cria\xe7\xe3o, com as mais recentes aparecendo primeiro.","operationId":"ListarNfse","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ do emitente.\\r\\n\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"referencia","description":"Seu identificador \xfanico para o documento.","schema":{"type":"string"}},{"in":"query","name":"ambiente","description":"Identifica\xe7\xe3o do Ambiente.\\r\\n\\r\\nValores aceitos: homologacao, producao","required":true,"schema":{"type":"string"}},{"in":"query","name":"chave","description":"Chave de acesso do DF-e.","schema":{"type":"string"}},{"in":"query","name":"serie","description":"S\xe9rie do DF-e.","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseListagem"}}}}}},"post":{"tags":["Nfse"],"summary":"Emitir NFS-e","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"EmitirNfse","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfsePedidoEmissao"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Nfse"}}}}},"deprecated":true}},"/nfse/cidades":{"get":{"tags":["Nfse"],"summary":"Cidades atendidas","description":"Fornece uma rela\xe7\xe3o completa de todos os munic\xedpios atendidos pela API.","operationId":"CidadesAtendidas","responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseCidadesAtendidas"}}}}}}},"/nfse/cidades/{codigo_ibge}":{"get":{"tags":["Nfse"],"summary":"Consultar metadados","description":"Consulta a disponibilidade de emiss\xe3o e alguns metadados de um munic\xedpio.","operationId":"ConsultarMetadados","parameters":[{"in":"path","name":"codigo_ibge","description":"C\xf3digo IBGE do munic\xedpio.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseCidadeMetadados"}}}}}}},"/nfse/dps":{"post":{"tags":["Nfse"],"summary":"Emitir NFS-e","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"EmitirNfseDps","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseDpsPedidoEmissao"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Nfse"}}}}}}},"/nfse/dps/lotes":{"post":{"tags":["Nfse"],"summary":"Emitir lote de NFS-e","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por NFS-e.","operationId":"EmitirLoteNfseDps","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseLoteDpsPedidoEmissao"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RpsLote"}}}}}}},"/nfse/lotes":{"get":{"tags":["Nfse"],"summary":"Listar lotes de NFS-e","description":"Retorna a lista dos lotes de acordo com os crit\xe9rios de busca utilizados. Os lotes s\xe3o retornados ordenados pela data da cria\xe7\xe3o, com os mais recentes aparecendo primeiro.","operationId":"ListarLotesNfse","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ do emitente.\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"referencia","schema":{"type":"string"}},{"in":"query","name":"ambiente","description":"Identifica\xe7\xe3o do Ambiente.\\r\\n\\r\\nValores aceitos: homologacao, producao","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RpsLoteListagem"}}}}}},"post":{"tags":["Nfse"],"summary":"Emitir lote de NFS-e","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por NFS-e.","operationId":"EmitirLoteNfse","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RpsPedidoEmissaoLote"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RpsLote"}}}}},"deprecated":true}},"/nfse/lotes/{id}":{"get":{"tags":["Nfse"],"summary":"Consultar lote de NFS-e","description":"Consulta os detalhes de um lote j\xe1 existente. Forne\xe7a o ID \xfanico obtido de uma requisi\xe7\xe3o de emiss\xe3o ou de listagem de lotes e a API ir\xe1 retornar as informa\xe7\xf5es do lote correspondente.","operationId":"ConsultarLoteNfse","parameters":[{"in":"path","name":"id","description":"ID \xfanico do lote gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RpsLote"}}}}}}},"/nfse/{Id}/cancelamento/xml":{"get":{"tags":["Nfse"],"summary":"Baixar XML do evento de cancelamento","operationId":"BaixarXmlCancelamentoNfse","parameters":[{"in":"path","name":"Id","description":"ID \xfanico da NFS-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfse/{id}":{"get":{"tags":["Nfse"],"summary":"Consultar NFS-e","description":"Consulta os detalhes de uma NFS-e j\xe1 existente. Forne\xe7a o ID \xfanico obtido de uma requisi\xe7\xe3o de cria\xe7\xe3o ou de listagem de notas e a API ir\xe1 retornar as informa\xe7\xf5es da nota correspondente.","operationId":"ConsultarNfse","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFS-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Nfse"}}}}}}},"/nfse/{id}/cancelamento":{"get":{"tags":["Nfse"],"summary":"Consultar o cancelamento da NFS-e","operationId":"ConsultarCancelamentoNfse","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFS-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseCancelamento"}}}}}},"post":{"tags":["Nfse"],"summary":"Cancelar uma NFS-e autorizada","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"CancelarNfse","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFS-e gerado pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfsePedidoCancelamento"}}}},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseCancelamento"}}}}}}},"/nfse/{id}/pdf":{"get":{"tags":["Nfse"],"summary":"Baixar PDF do DANFSE","operationId":"BaixarPdfNfse","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFS-e gerado pela API.","required":true,"schema":{"type":"string"}},{"in":"query","name":"logotipo","description":"Imprime o documento com logotipo, desde que esteja cadastrado na empresa.","schema":{"type":"boolean","default":false}},{"in":"query","name":"mensagem_rodape","description":"Imprime mensagem no rodap\xe9 do documento.\\r\\n\\r\\nO caractere `|` (pipe) poder\xe1 ser utilizado para definir a quantidade e o alinhamento das mensagens.\\r\\n\\r\\n**Exemplos de Uso:**\\r\\n* `\\"esquerda\\"`\\r\\n* `\\"esquerda|centro\\"`\\r\\n* `\\"esquerda|centro|direita\\"`\\r\\n* `\\"|centro\\"`, `\\"|centro|\\"`\\r\\n* `\\"|centro|direita\\"`\\r\\n* `\\"||direita\\"`\\r\\n* `\\"esquerda||direita\\"`\\r\\n\\r\\nDefault: `\\"\\"`","schema":{"type":"string","maxLength":120}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfse/{id}/sincronizar":{"post":{"tags":["Nfse"],"summary":"Sincroniza dados na NFS-e a partir da Prefeitura","description":"Realiza a sincroniza\xe7\xe3o dos dados a partir da consulta da situa\xe7\xe3o atual da NFS-e na prefeitura.\\r\\n\\r\\n**Cen\xe1rios de uso**:\\r\\n* Sincronizar uma nota que se encontra com o status `processando` na API, mas est\xe1 autorizada na prefeitura;\\r\\n* Sincronizar uma nota que se encontra com o status `erro` na API, mas est\xe1 autorizada na prefeitura (\xfatil em casos de erros de transmiss\xe3o, como instabilidades e timeouts);\\r\\n* Sincronizar uma nota que se encontra com o status `autorizada`na API, mas est\xe1 cancelada na prefeitura.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por evento sincronizado ou requisi\xe7\xe3o.","operationId":"SincronizarNfse","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFS-e gerado pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfsePedidoSincronizacao"}}}},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseSincronizacao"}}}}}}},"/nfse/{id}/xml":{"get":{"tags":["Nfse"],"summary":"Baixar XML da NFS-e processada","operationId":"BaixarXmlNfse","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFS-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/nfse/{id}/xml/dps":{"get":{"tags":["Nfse"],"summary":"Baixar XML da DPS","operationId":"BaixarXmlDps","parameters":[{"in":"path","name":"id","description":"ID \xfanico da NFS-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}}},"security":[{"jwt":[]},{"oauth2":[]}],"x-tagGroups":[{"name":"Geral","tags":["Empresa","Conta"]},{"name":"Documentos Fiscais","tags":["CteOs","Nfse","Dce","Nfcom","Cte","Mdfe","Nfe","Nfce"]},{"name":"Distribui\xe7\xe3o DF-e","tags":["Distribui\xe7\xe3o NF-e"]},{"name":"Auxiliares","tags":["Debug","Email","Cnpj","Cep"]}],"servers":[{"url":"https://api.nuvemfiscal.com.br"}],"components":{"requestBodies":{"NfePedidoEmissaoLote":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfePedidoEmissaoLote"}}},"required":true},"Empresa":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Empresa"}}},"required":true},"NfePedidoEmissao":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfePedidoEmissao"}}},"required":true},"NfePedidoCancelamento":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfePedidoCancelamento"}}}},"EnviarCertificadoEmpresa":{"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"Input":{"type":"string","format":"binary"}}}}}},"DfePedidoInutilizacao":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfePedidoInutilizacao"}}},"required":true},"DfePedidoEnvioEmail":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfePedidoEnvioEmail"}}}}},"securitySchemes":{"jwt":{"type":"apiKey","name":"Authorization","in":"header"},"oauth2":{"type":"oauth2","description":"Autentica\xe7\xe3o via OAuth 2.0","flows":{"clientCredentials":{"tokenUrl":"https://auth.nuvemfiscal.com.br/oauth/token","scopes":{"conta":"","empresa":"","cep":"","cnpj":"","mdfe":"","cte":"","nfse":"","nfe":""}}}}},"schemas":{"Empresa":{"type":"object","properties":{"cpf_cnpj":{"type":"string","description":"CPF ou CNPJ da empresa.\\r\\n\\r\\n*Utilize o valor sem m\xe1scara*."},"created_at":{"type":"string","format":"date-time","description":"Data/hora em que o objeto foi criado na API. Representado no formato <a href=\\"https://en.wikipedia.org/wiki/ISO_8601\\" target=\\"blank\\">`ISO 8601`</a>.\\r\\n\\r\\n*A API gerencia esse campo automaticamente. Caso algum valor seja enviado, ele ser\xe1 ignorado*."},"updated_at":{"type":"string","format":"date-time","description":"Data e hora que o objeto foi alterado pela \xfaltima vez na API. Representado no formato <a href=\\"https://en.wikipedia.org/wiki/ISO_8601\\" target=\\"blank\\">`ISO 8601`</a>.\\r\\n\\r\\n*A API gerencia esse campo automaticamente. Caso algum valor seja enviado, ele ser\xe1 ignorado*."},"inscricao_estadual":{"type":"string","description":"Inscri\xe7\xe3o estadual da empresa.","maxLength":50},"inscricao_municipal":{"type":"string","description":"Inscri\xe7\xe3o municipal da empresa.","maxLength":50},"nome_razao_social":{"type":"string","description":"Raz\xe3o social da empresa.","maxLength":500},"nome_fantasia":{"type":"string","description":"Nome fantasia da empresa.","maxLength":500},"fone":{"type":"string","description":"Telefone da empresa."},"email":{"type":"string","description":"Email da empresa."},"endereco":{"$ref":"#/components/schemas/EmpresaEndereco"}},"required":["endereco","email","nome_razao_social","cpf_cnpj"]},"EmpresaEndereco":{"type":"object","description":"Endere\xe7o da empresa.","properties":{"logradouro":{"type":"string","description":"Logradouro.","maxLength":255},"numero":{"type":"string","description":"N\xfamero.","maxLength":255},"complemento":{"type":"string","description":"Complemento.","maxLength":500},"bairro":{"type":"string","description":"Bairro.","maxLength":255},"codigo_municipio":{"type":"string","description":"C\xf3digo IBGE do munic\xedpio."},"cidade":{"type":"string","description":"Cidade.","maxLength":255},"uf":{"type":"string","description":"Sigla do estado."},"codigo_pais":{"type":"string","description":"C\xf3digo do pa\xeds.","default":"1058"},"pais":{"type":"string","description":"Nome do pa\xeds.","default":"Brasil","maxLength":255},"cep":{"type":"string","description":"CEP.\\r\\n\\r\\n*Utilize o valor sem m\xe1scara*."}},"required":["cep","uf","codigo_municipio","bairro","numero","logradouro"]},"EmpresaListagem":{"type":"object","properties":{"@count":{"type":"integer"},"data":{"type":"array","items":{"$ref":"#/components/schemas/Empresa"}}}},"EmpresaCertificadoListagem":{"type":"object","properties":{"@count":{"type":"integer"},"data":{"type":"array","items":{"$ref":"#/components/schemas/EmpresaCertificado"}}}},"EmpresaCertificado":{"type":"object","properties":{"id":{"type":"string"},"created_at":{"type":"string","format":"date-time"},"serial_number":{"type":"string"},"issuer_name":{"type":"string"},"not_valid_before":{"type":"string","format":"date-time"},"not_valid_after":{"type":"string","format":"date-time"},"thumbprint":{"type":"string"},"subject_name":{"type":"string"},"cpf_cnpj":{"type":"string"},"nome_razao_social":{"type":"string"}}},"EmpresaPedidoCadastroCertificado":{"type":"object","properties":{"certificado":{"type":"string","format":"byte","description":"Bin\xe1rio do certificado digital (.pfx ou .p12) codificado em base64."},"password":{"type":"string","description":"Senha do certificado."}},"required":["password","certificado"]},"EmpresaConfigNfe":{"type":"object","properties":{"CRT":{"type":"integer","description":"C\xf3digo de Regime Tribut\xe1rio.\\r\\nEste campo ser\xe1 preenchido com:\\r\\n* 1 \u2013 Simples Nacional;\\r\\n* 2 \u2013 Simples Nacional \u2013 excesso de sublimite de receita bruta;\\r\\n* 3 \u2013 Regime Normal;\\r\\n* 4 - Simples Nacional - Microempreendedor individual (MEI).","default":3},"ambiente":{"type":"string","description":"Indica se a empresa ir\xe1 emitir em produ\xe7\xe3o ou homologa\xe7\xe3o.","enum":["homologacao","producao"]}},"required":["ambiente"]},"EmpresaConfigNfce":{"type":"object","properties":{"CRT":{"type":"integer","description":"C\xf3digo de Regime Tribut\xe1rio.\\r\\nEste campo ser\xe1 preenchido com:\\r\\n* 1 \u2013 Simples Nacional;\\r\\n* 2 \u2013 Simples Nacional \u2013 excesso de sublimite de receita bruta;\\r\\n* 3 \u2013 Regime Normal;\\r\\n* 4 - Simples Nacional - Microempreendedor individual (MEI).","default":3},"sefaz":{"$ref":"#/components/schemas/EmpresaConfigNfceSefaz"},"ambiente":{"type":"string","description":"Indica se a empresa ir\xe1 emitir em produ\xe7\xe3o ou homologa\xe7\xe3o.","enum":["homologacao","producao"]}},"required":["ambiente","sefaz"]},"EmpresaConfigNfceSefaz":{"type":"object","properties":{"id_csc":{"type":"integer","description":"N\xfamero de identifica\xe7\xe3o do CSC."},"csc":{"type":"string","description":"C\xf3digo do CSC.","maxLength":50}},"required":["csc","id_csc"]},"EmpresaConfigNfse":{"type":"object","properties":{"regTrib":{"$ref":"#/components/schemas/EmpresaConfigNfseRegTrib"},"rps":{"$ref":"#/components/schemas/EmpresaConfigRps"},"prefeitura":{"$ref":"#/components/schemas/EmpresaConfigPrefeitura"},"incentivo_fiscal":{"type":"boolean","description":"Indicador se a empresa possui algum tipo de incentivo fiscal.","default":false},"ambiente":{"type":"string","description":"Indica se a empresa ir\xe1 emitir em produ\xe7\xe3o ou homologa\xe7\xe3o.","enum":["homologacao","producao"]}},"required":["ambiente","rps"]},"EmpresaConfigNfseRegTrib":{"type":"object","description":"Grupo de informa\xe7\xf5es relativas aos regimes de tributa\xe7\xe3o do prestador de servi\xe7os.","properties":{"opSimpNac":{"type":"integer","description":"Situa\xe7\xe3o perante o Simples Nacional:\\r\\n* 1 - N\xe3o Optante;\\r\\n* 2 - Optante - Microempreendedor Individual (MEI);\\r\\n* 3 - Optante - Microempresa ou Empresa de Pequeno Porte (ME/EPP).","default":1,"nullable":true},"regApTribSN":{"type":"integer","description":"Op\xe7\xe3o para que o contribuinte optante pelo Simples Nacional ME/EPP (opSimpNac = 3) possa indicar, ao emitir o documento fiscal, em qual regime de apura\xe7\xe3o os tributos federais e municipal est\xe3o inseridos, caso tenha ultrapassado algum sublimite ou limite definido para o Simples Nacional.\\r\\n* 1 \u2013 Regime de apura\xe7\xe3o dos tributos federais e municipal pelo SN;\\r\\n* 2 \u2013 Regime de apura\xe7\xe3o dos tributos federais pelo SN e ISSQN  por fora do SN conforme respectiva legisla\xe7\xe3o municipal do tributo;\\r\\n* 3 \u2013 Regime de apura\xe7\xe3o dos tributos federais e municipal por fora do SN conforme respectivas legila\xe7\xf5es federal e municipal de cada tributo.","nullable":true},"regEspTrib":{"type":"integer","description":"Regime Especial de Tributa\xe7\xe3o (Padr\xe3o Nacional):\\r\\n* 0 - Nenhum;\\r\\n* 1 - Ato Cooperado (Cooperativa);\\r\\n* 2 - Estimativa;\\r\\n* 3 - Microempresa Municipal;\\r\\n* 4 - Not\xe1rio ou Registrador;\\r\\n* 5 - Profissional Aut\xf4nomo;\\r\\n* 6 - Sociedade de Profissionais.\\r\\n\\r\\n**Comportamento:**\\r\\n - Quando o envio for feito para o Ambiente Nacional, o valor \xe9 utilizado\\r\\n   exatamente como se apresenta, sem qualquer transforma\xe7\xe3o ou mapeamento.\\r\\n - Quando o envio for feito diretamente para a prefeitura, o valor ser\xe1\\r\\n   convertido internamente pela API para o c\xf3digo correspondente\\r\\n   esperado pela prefeitura, **se essa convers\xe3o for poss\xedvel**.\\r\\n\\r\\n **Observa\xe7\xe3o:** Em algumas prefeituras, existem c\xf3digos espec\xedficos que n\xe3o t\xeam\\r\\n correspond\xeancia direta no padr\xe3o nacional. Para lidar com esses casos, utilize\\r\\n o campo `prest.regTrib.regEspTrib` diretamente no endpoint de emiss\xe3o de NFS-e.","default":0,"nullable":true}}},"EmpresaConfigRps":{"type":"object","description":"Configura\xe7\xe3o de numera\xe7\xe3o de lote, s\xe9rie e RPS.","properties":{"lote":{"type":"integer","format":"int64","description":"N\xfamero do Lote de RPS.\\r\\nInforme o pr\xf3ximo n\xfamero do lote RPS a ser utilizado. Ap\xf3s isso, a Nuvem\\r\\nFiscal gerenciar\xe1 esse campo (a cada novo envio de lote o n\xfamero \xe9\\r\\nincrementado em + 1). Portanto, basta inform\xe1-lo no cadastro da empresa\\r\\numa \xfanica vez."},"serie":{"type":"string","description":"S\xe9rie do RPS.\\r\\nA s\xe9rie dos RPS varia de acordo com cada prefeitura, podendo ser\\r\\nn\xfamero (1, 2 ou 3, por exemplo) ou letras (A, S, NFS, por exemplo).\\r\\nPortanto, consulte-a com o munic\xedpio da empresa antes de iniciar a\\r\\nemiss\xe3o das notas.","maxLength":20},"numero":{"type":"integer","format":"int64","description":"N\xfamero do RPS.\\r\\nInforme o pr\xf3ximo n\xfamero de RPS a ser utilizado. Ap\xf3s isso, a Nuvem\\r\\nFiscal gerenciar\xe1 esse campo (a cada novo envio de RPS o n\xfamero \xe9\\r\\nincrementado em + 1). Portanto, basta inform\xe1-lo no cadastro da empresa\\r\\numa \xfanica vez."}},"required":["numero","serie","lote"]},"EmpresaConfigPrefeitura":{"type":"object","description":"Dados adicionais para comunica\xe7\xe3o com a prefeitura. Essa valida\xe7\xe3o \xe9\\r\\ndin\xe2mica, de acordo com a necessidade de cada munic\xedpio.","properties":{"login":{"type":"string","description":"Login de autentica\xe7\xe3o com a prefeitura, caso n\xe3o utilize certificado digital.","maxLength":255},"senha":{"type":"string","description":"Senha de autentica\xe7\xe3o com a prefeitura, caso n\xe3o utilize certificado digital.","maxLength":255},"token":{"type":"string","description":"Token de autentica\xe7\xe3o com a prefeitura, caso n\xe3o utilize certificado digital.","maxLength":255}}},"EmpresaConfigMdfe":{"type":"object","properties":{"ambiente":{"type":"string","description":"Indica se a empresa ir\xe1 emitir em produ\xe7\xe3o ou homologa\xe7\xe3o.","enum":["homologacao","producao"]}},"required":["ambiente"]},"EmpresaConfigCte":{"type":"object","properties":{"CRT":{"type":"integer","description":"C\xf3digo de Regime Tribut\xe1rio.\\r\\nEste campo ser\xe1 preenchido com:\\r\\n* 1 \u2013 Simples Nacional;\\r\\n* 2 \u2013 Simples Nacional \u2013 excesso de sublimite de receita bruta;\\r\\n* 3 \u2013 Regime Normal;\\r\\n* 4 - Simples Nacional - Microempreendedor Individual (MEI).","default":3},"ambiente":{"type":"string","description":"Indica se a empresa ir\xe1 emitir em produ\xe7\xe3o ou homologa\xe7\xe3o.","enum":["homologacao","producao"]}},"required":["ambiente"]},"EmpresaConfigCteOs":{"type":"object","properties":{"CRT":{"type":"integer","description":"C\xf3digo de Regime Tribut\xe1rio.\\r\\nEste campo ser\xe1 preenchido com:\\r\\n* 1 \u2013 Simples Nacional;\\r\\n* 2 \u2013 Simples Nacional \u2013 excesso de sublimite de receita bruta;\\r\\n* 3 \u2013 Regime Normal;\\r\\n* 4 - Simples Nacional - Microempreendedor Individual (MEI).","default":3},"ambiente":{"type":"string","description":"Indica se a empresa ir\xe1 emitir em produ\xe7\xe3o ou homologa\xe7\xe3o.","enum":["homologacao","producao"]}},"required":["ambiente"]},"EmpresaConfigNfcom":{"type":"object","properties":{"CRT":{"type":"integer","description":"C\xf3digo de Regime Tribut\xe1rio.\\r\\nEste campo ser\xe1 preenchido com:\\r\\n* 1 \u2013 Simples Nacional;\\r\\n* 2 \u2013 Simples Nacional \u2013 excesso de sublimite de receita bruta;\\r\\n* 3 \u2013 Regime Normal.","default":3},"ambiente":{"type":"string","description":"Indica se a empresa ir\xe1 emitir em produ\xe7\xe3o ou homologa\xe7\xe3o.","enum":["homologacao","producao"]}},"required":["ambiente"]},"EmpresaConfigDce":{"type":"object","properties":{"ambiente":{"type":"string","description":"Indica se a empresa ir\xe1 emitir em produ\xe7\xe3o ou homologa\xe7\xe3o.","enum":["homologacao","producao"]}},"required":["ambiente"]},"EmpresaConfigDistribuicaoNfe":{"type":"object","properties":{"distribuicao_automatica":{"type":"boolean","description":"Indica se a distribui\xe7\xe3o autom\xe1tica est\xe1 habilitada.\\r\\n\\r\\nQuando ativada, a API realizar\xe1 automaticamente pedidos de\\r\\ndistribui\xe7\xe3o de notas fiscais eletr\xf4nicas (NF-e) utilizando o \xfaltimo NSU.\\r\\n\\r\\nA frequ\xeancia dessas distribui\xe7\xf5es \xe9 controlada pelo campo `distribuicao_intervalo_horas`,\\r\\ncujo valor padr\xe3o \xe9 24 horas (uma vez ao dia).","default":false,"nullable":true},"distribuicao_intervalo_horas":{"type":"integer","description":"Define o intervalo m\xednimo, em horas, entre distribui\xe7\xf5es autom\xe1ticas de documentos.\\r\\n\\r\\nEsse valor determina com que frequ\xeancia a API executar\xe1 novas\\r\\nrequisi\xe7\xf5es autom\xe1ticas de distribui\xe7\xe3o de notas fiscais eletr\xf4nicas (NF-e).\\r\\n\\r\\nDeve ser um valor entre 1 e 24. Por exemplo, se configurado como 4, uma nova\\r\\ntentativa de distribui\xe7\xe3o s\xf3 ser\xe1 feita se pelo menos 4 horas tiverem se passado\\r\\ndesde a \xfaltima requisi\xe7\xe3o.\\r\\n\\r\\nEsse campo s\xf3 \xe9 relevante quando `distribuicao_automatica` estiver habilitado.","default":24,"maximum":24,"minimum":1,"nullable":true},"ciencia_automatica":{"type":"boolean","description":"Indica se a manifesta\xe7\xe3o de Ci\xeancia da Opera\xe7\xe3o (210210) deve ser feita\\r\\nautomaticamente pela API.\\r\\n\\r\\nCaso habilitada, a manifesta\xe7\xe3o de ci\xeancia ser\xe1 realizada para notas\\r\\nrecebidas por qualquer forma de consulta ou modo de distribui\xe7\xe3o (manual ou autom\xe1tico).","default":false,"nullable":true},"ambiente":{"type":"string","description":"Indica se a empresa ir\xe1 emitir em produ\xe7\xe3o ou homologa\xe7\xe3o.","enum":["homologacao","producao"]}},"required":["ambiente"]},"DfeSefazStatus":{"type":"object","properties":{"autorizador":{"type":"string","description":"SEFAZ autorizadora respons\xe1vel.","enum":["AM","BA","CE","GO","MG","MS","MT","PE","PR","RS","SP","SVAN","SVRS","SVCAN","SVCRS","AN","SVSP","SVCSP"]},"ambiente":{"type":"string","description":"Identifica\xe7\xe3o do Ambiente.","enum":["homologacao","producao"]},"data_hora_consulta":{"type":"string","format":"date-time","description":"Data e hora da consulta."},"codigo_status":{"type":"integer","description":"C\xf3digo do status da mensagem enviada."},"motivo_status":{"type":"string","description":"Descri\xe7\xe3o literal do status do servi\xe7o solicitado."},"tempo_medio_resposta":{"type":"integer","description":"Tempo m\xe9dio de resposta do servi\xe7o (em segundos) dos \xfaltimos 5 minutos.","nullable":true},"data_hora_retorno":{"type":"string","format":"date-time","description":"Data e hora prevista para o retorno dos servi\xe7os prestados.","nullable":true}}},"CteOsPedidoEmissao":{"type":"object","properties":{"infCte":{"$ref":"#/components/schemas/CteOsSefazInfCteOS"},"infCTeSupl":{"$ref":"#/components/schemas/CteOsSefazInfCTeSuplOS"},"ambiente":{"type":"string","description":"Identifica\xe7\xe3o do Ambiente.","enum":["homologacao","producao"]},"referencia":{"type":"string","description":"Seu identificador \xfanico para este documento. Opcional, ajuda a evitar o envio duplicado de um mesmo documento.","maxLength":50,"nullable":true}},"required":["ambiente","infCte"]},"CteOsSefazInfCteOS":{"type":"object","description":"Informa\xe7\xf5es do CT-e Outros Servi\xe7os.","properties":{"versao":{"type":"string","description":"Vers\xe3o do leiaute.\\r\\nEx: \\"4.00\\".","nullable":true},"Id":{"type":"string","description":"Identificador da tag a ser assinada.\\r\\nInformar a chave de acesso do CT-e OS e precedida do literal \\"CTe\\".\\r\\n\\r\\n*Geramos automaticamente quando nenhum valor \xe9 informado.*","nullable":true},"ide":{"$ref":"#/components/schemas/CteOsSefazIdeOS"},"compl":{"$ref":"#/components/schemas/CteOsSefazComplOS"},"emit":{"$ref":"#/components/schemas/CteOsSefazEmitOS"},"toma":{"$ref":"#/components/schemas/CteOsSefazTomaOS"},"vPrest":{"$ref":"#/components/schemas/CteOsSefazVPrestOS"},"imp":{"$ref":"#/components/schemas/CteOsSefazInfCte_ImpOS"},"infCTeNorm":{"$ref":"#/components/schemas/CteOsSefazInfCTeNormOS"},"infCteComp":{"type":"array","items":{"$ref":"#/components/schemas/CteOsSefazInfCteCompOS"},"maxItems":10},"autXML":{"type":"array","items":{"$ref":"#/components/schemas/CteOsSefazAutXMLOS"},"maxItems":10},"infRespTec":{"$ref":"#/components/schemas/CteOsSefazRespTecOS"}},"required":["imp","vPrest","emit","ide","versao"]},"CteOsSefazIdeOS":{"type":"object","description":"Identifica\xe7\xe3o do CT-e Outros Servi\xe7os.","properties":{"cUF":{"type":"integer","description":"C\xf3digo da UF do emitente do CT-e.\\r\\nUtilizar a Tabela do IBGE.","nullable":true},"cCT":{"type":"string","description":"C\xf3digo num\xe9rico que comp\xf5e a Chave de Acesso.\\r\\nN\xfamero aleat\xf3rio gerado pelo emitente para cada CT-e, com o objetivo de evitar acessos indevidos ao documento.\\r\\n\\r\\n*Geramos automaticamente quando nenhum valor \xe9 informado.*","nullable":true},"CFOP":{"type":"string","description":"C\xf3digo Fiscal de Opera\xe7\xf5es e Presta\xe7\xf5es.","nullable":true},"natOp":{"type":"string","description":"Natureza da Opera\xe7\xe3o.","maxLength":60,"minLength":1,"nullable":true},"mod":{"type":"integer","description":"Modelo do documento fiscal.\\r\\nUtilizar o c\xf3digo 67 para identifica\xe7\xe3o do CT-e Outros Servi\xe7os, emitido em substitui\xe7\xe3o a Nota Fiscal Modelo 7 para transporte de pessoas, valores e excesso de bagagem.","nullable":true},"serie":{"type":"integer","description":"S\xe9rie do CT-e OS.\\r\\nPreencher com \\"0\\" no caso de s\xe9rie \xfanica.","maximum":999,"minimum":0,"nullable":true},"nCT":{"type":"integer","description":"N\xfamero do CT-e OS.","maximum":999999999,"minimum":1,"nullable":true},"dhEmi":{"type":"string","format":"date-time","description":"Data e hora de emiss\xe3o do CT-e OS.\\r\\nFormato AAAA-MM-DDTHH:MM:DD TZD.","nullable":true},"tpImp":{"type":"integer","description":"Formato de impress\xe3o do DACTE:\\r\\n* 1 - Retrato\\r\\n* 2 - Paisagem","nullable":true},"tpEmis":{"type":"integer","description":"Forma de emiss\xe3o do CT-e.\\r\\nPreencher com:\\r\\n* 1 - Normal\\r\\n* 5 - Conting\xeancia FSDA\\r\\n* 7 - Autoriza\xe7\xe3o pela SVC-RS\\r\\n* 8 - Autoriza\xe7\xe3o pela SVC-SP","nullable":true},"cDV":{"type":"integer","description":"Digito Verificador da chave de acesso do CT-e.\\r\\nInformar o d\xedgito  de controle da chave de acesso do CT-e, que deve ser calculado com a aplica\xe7\xe3o do algoritmo m\xf3dulo 11 (base 2,9) da chave de acesso.\\r\\n\\r\\n*Geramos automaticamente quando nenhum valor \xe9 informado.*","maximum":9,"minimum":0,"nullable":true},"tpAmb":{"type":"integer","description":"Tipo do Ambiente:\\r\\n* 1 - Produ\xe7\xe3o\\r\\n* 2 - Homologa\xe7\xe3o","nullable":true},"tpCTe":{"type":"integer","description":"Tipo do CT-e OS.\\r\\nPreencher com:\\r\\n* 0 - CT-e Normal\\r\\n* 1 - CT-e Complementar\\r\\n* 3 - CT-e de Substitui\xe7\xe3o","nullable":true},"procEmi":{"type":"integer","description":"Identificador do processo de emiss\xe3o do CT-e OS.\\r\\nPreencher com:\\r\\n* 0 - emiss\xe3o de CT-e com aplicativo do contribuinte\\r\\n* 3 - emiss\xe3o CT-e pelo contribuinte com aplicativo fornecido pelo Fisco","nullable":true},"verProc":{"type":"string","description":"Vers\xe3o do processo de emiss\xe3o.\\r\\nIinformar a vers\xe3o do aplicativo emissor de CT-e.","maxLength":20,"minLength":1,"nullable":true},"cMunEnv":{"type":"string","description":"C\xf3digo do Munic\xedpio de envio do CT-e (de onde o documento foi transmitido).\\r\\nUtilizar a tabela do IBGE. Informar 9999999 para as opera\xe7\xf5es com o exterior.","nullable":true},"xMunEnv":{"type":"string","description":"Nome do Munic\xedpio de envio do CT-e (de onde o documento foi transmitido).\\r\\nInformar PAIS/Municipio para as opera\xe7\xf5es com o exterior.","maxLength":60,"minLength":2,"nullable":true},"UFEnv":{"type":"string","description":"Sigla da UF de envio do CT-e (de onde o documento foi transmitido).\\r\\nInformar \'EX\' para opera\xe7\xf5es com o exterior.","nullable":true},"modal":{"type":"string","description":"Modal. Preencher com:\\r\\n* 01 - Rodovi\xe1rio\\r\\n* 02 - A\xe9reo\\r\\n* 03 - Aquavi\xe1rio\\r\\n* 04 - Ferrovi\xe1rio","nullable":true},"tpServ":{"type":"integer","description":"Tipo do Servi\xe7o.\\r\\nPreencher com:\\r\\n* 6 - Transporte de Pessoas\\r\\n* 7 - Transporte de Valores\\r\\n* 8 - Excesso de Bagagem","nullable":true},"indIEToma":{"type":"integer","description":"Indicador da IE do tomador:\\r\\n* 1 - Contribuinte ICMS\\r\\n* 2 - Contribuinte isento de inscri\xe7\xe3o\\r\\n* 9 - N\xe3o Contribuinte\\r\\nAplica-se ao tomador que for indicado no toma3 ou toma4.","nullable":true},"cMunIni":{"type":"string","description":"C\xf3digo do Munic\xedpio de in\xedcio da presta\xe7\xe3o.\\r\\nUtilizar a tabela do IBGE. Informar 9999999 para opera\xe7\xf5es com o exterior.","nullable":true},"xMunIni":{"type":"string","description":"Nome do Munic\xedpio do in\xedcio da presta\xe7\xe3o.\\r\\nInformar \'EXTERIOR\' para opera\xe7\xf5es com o exterior.","maxLength":60,"minLength":2,"nullable":true},"UFIni":{"type":"string","description":"UF do in\xedcio da presta\xe7\xe3o.\\r\\nInformar \'EX\' para opera\xe7\xf5es com o exterior.","nullable":true},"cMunFim":{"type":"string","description":"C\xf3digo do Munic\xedpio de t\xe9rmino da presta\xe7\xe3o.\\r\\nUtilizar a tabela do IBGE. Informar 9999999 para opera\xe7\xf5es com o exterior.","nullable":true},"xMunFim":{"type":"string","description":"Nome do Munic\xedpio do t\xe9rmino da presta\xe7\xe3o.\\r\\nInformar \'EXTERIOR\' para opera\xe7\xf5es com o exterior.","maxLength":60,"minLength":2,"nullable":true},"UFFim":{"type":"string","description":"UF do t\xe9rmino da presta\xe7\xe3o.\\r\\nInformar \'EX\' para opera\xe7\xf5es com o exterior.","nullable":true},"infPercurso":{"type":"array","items":{"$ref":"#/components/schemas/CteOsSefazInfPercursoOS"},"maxItems":25},"dhCont":{"type":"string","format":"date-time","description":"Data e Hora da entrada em conting\xeancia.\\r\\nInformar a data e hora no formato AAAA-MM-DDTHH:MM:SS.","nullable":true},"xJust":{"type":"string","description":"Justificativa da entrada em conting\xeancia.","maxLength":256,"minLength":15,"nullable":true},"gCompraGov":{"$ref":"#/components/schemas/CteOsSefazCompraGovReduzidoOS"}},"required":["indIEToma","tpServ","modal","UFEnv","xMunEnv","cMunEnv","verProc","procEmi","tpCTe","tpEmis","tpImp","dhEmi","nCT","serie","natOp","CFOP","cUF"]},"CteOsSefazInfPercursoOS":{"type":"object","description":"Informa\xe7\xf5es do Percurso do CT-e Outros Servi\xe7os.","properties":{"UFPer":{"type":"string","description":"Sigla das Unidades da Federa\xe7\xe3o do percurso do ve\xedculo.\\r\\nN\xe3o \xe9 necess\xe1rio repetir as UF de In\xedcio e Fim.","nullable":true}},"required