ecial da NFF (tpEmis=3).\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","nullable":true},"IEST":{"type":"string","description":"Inscri\xe7\xe3o Estadual do Substituto Tribut\xe1rio.","nullable":true},"xNome":{"type":"string","description":"Raz\xe3o social ou Nome do emitente.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":2,"nullable":true},"xFant":{"type":"string","description":"Nome fantasia.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":2,"nullable":true},"enderEmit":{"$ref":"#/components/schemas/CteSimpSefazEndeEmiSimp"},"CRT":{"type":"integer","description":"C\xf3digo do Regime Tribut\xe1rio. Informar:\\r\\n* 1 - Simples Nacional;\\r\\n* 2 - Simples Nacional, excesso sublimite de receita bruta;\\r\\n* 3 - Regime Normal;\\r\\n* 4 - Simples Nacional - Microempreendedor Individual (MEI).\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","nullable":true}}},"CteSimpSefazEndeEmiSimp":{"type":"object","description":"Endere\xe7o do emitente.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","properties":{"xLgr":{"type":"string","description":"Logradouro.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":2,"nullable":true},"nro":{"type":"string","description":"N\xfamero.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":1,"nullable":true},"xCpl":{"type":"string","description":"Complemento.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":1,"nullable":true},"xBairro":{"type":"string","description":"Bairro.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":2,"nullable":true},"cMun":{"