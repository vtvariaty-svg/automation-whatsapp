 do IBS Municipal (em percentual).","minimum":0,"nullable":true},"gDif":{"$ref":"#/components/schemas/CteSefazDif"},"gDevTrib":{"$ref":"#/components/schemas/CteSefazDevTrib"},"gRed":{"$ref":"#/components/schemas/CteSefazRed"},"vIBSMun":{"type":"number","description":"Valor do IBS Municipal.","minimum":0,"nullable":true}},"required":["vIBSMun","pIBSMun"]},"CteSefazGCBS":{"type":"object","description":"Grupo de Tributa\xe7\xe3o da CBS.","properties":{"pCBS":{"type":"number","description":"Aliquota da CBS (em percentual).","minimum":0,"nullable":true},"gDif":{"$ref":"#/components/schemas/CteSefazDif"},"gDevTrib":{"$ref":"#/components/schemas/CteSefazDevTrib"},"gRed":{"$ref":"#/components/schemas/CteSefazRed"},"vCBS":{"type":"number","description":"Valor da CBS.","minimum":0,"nullable":true}},"required":["vCBS","pCBS"]},"CteSefazTribRegular":{"type":"object","description":"Grupo de informa\xe7\xf5es da Tributa\xe7\xe3o Regular. Informar como seria a tributa\xe7\xe3o caso n\xe3o cumprida a condi\xe7\xe3o resolut\xf3ria/suspensiva. Exemplo 1: Art. 442, \xa74. Opera\xe7\xf5es com ZFM e ALC. Exemplo 2: Opera\xe7\xf5es com suspens\xe3o do tributo.","properties":{"CSTReg":{"type":"string","description":"C\xf3digo da Situa\xe7\xe3o Tribut\xe1ria do IBS e CBS.\\r\\nInformar qual seria o CST caso n\xe3o cumprida a condi\xe7\xe3o resolut\xf3ria/suspensiva.","nullable":true},"cClassTribReg":{"type":"string","description":"Informar qual seria o cClassTrib caso n\xe3o cumprida a condi\xe7\xe3o resolut\xf3ria/suspensiva.","nullable":true},"pAliqEfetRegIBSUF":{"type":"number","description":"Al\xedquota do IBS da UF.\\r\\nInformar como seria a Al\xedquota caso n\xe3o cumprida a condi\xe7\xe3o resolut\xf3ria/suspensiva.","minimum":0,"nullable":true},"vTribRegIBSUF":{"type":"number","description":"Valor do IBS da UF.\\r\\nInformar como seria o valor do Tributo caso n\xe3o cumprida a condi\xe7\xe3o resolut\xf3ria/suspensiva.","minimum":0,"nullable":true},"pAliqEfetRegIBSMun":{"type":"number","description":"Al\xedquota do IBS do Munic\xedpio.\\r\\nInformar como seria a Al\xedquota caso n\xe3o cumprida a condi\xe7\xe3o resolut\xf3ria/suspensiva.","minimum":0,"nullable":true},"vTribRegIBSMun":{"type":"number","description":"Valor do IBS do Munic\xedpio.\\r\\nInformar como seria o valor do Tributo caso n\xe3o cumprida a condi\xe7\xe3o resolut\xf3ria/suspensiva.","minimum":0,"nullable":true},"pAliqEfetRegCBS":{"type":"number","description":"Al\xedquota da CBS.\\r\\nInformar como seria a Al\xedquota caso n\xe3o cumprida a condi\xe7\xe3o resolut\xf3ria/suspensiva.","minimum":0,"nullable":true},"vTribRegCBS":{"type":"number","description":"Valor da CBS.\\r\\nInformar como seria o valor do Tributo caso n\xe3o cumprida a condi\xe7\xe3o resolut\xf3ria/suspensiva.","minimum":0,"nullable":true}},"required":["vTribRegCBS","pAliqEfetRegCBS","vTribRegIBSMun","pAliqEfetRegIBSMun","vTribRegIBSUF","pAliqEfetRegIBSUF","cClassTribReg","CSTReg"]},"CteSefazTribCompraGov":{"type":"object","description":"Grupo de informa\xe7\xf5es da composi\xe7\xe3o do valor do IBS e da CBS em compras governamental.","properties":{"pAliqIBSUF":{"type":"number","minimum":0,"nullable":true},"vTribIBSUF":{"type":"number","description":"Valor que seria devido a UF, sem aplica\xe7\xe3o do Art. 473. da LC 214/2025.","minimum":0,"nullable":true},"pAliqIBSMun":{"type":"number","minimum":0,"nullable":true},"vTribIBSMun":{"type":"number","description":"Valor que seria devido ao munic\xedpio, sem aplica\xe7\xe3o do Art. 473. da LC 214/2025.","minimum":0,"nullable":true},"pAliqCBS":{"type":"number","minimum":0,"nullable":true},"vTribCBS":{"type":"number","description":"Valor que seria devido a CBS, sem aplica\xe7\xe3o do Art. 473. da LC 214/2025.","minimum":0,"nullable":true}},"required":["vTribCBS","vTribIBSMun","vTribIBSUF"]},"CteSefazEstornoCred":{"type":"object","description":"Informado conforme indicador no cClassTrib.","properties":{"vIBSEstCred":{"type":"number","description":"Valor do IBS a ser estornado.","minimum":0,"nullable":true},"vCBSEstCred":{"type":"number","description":"Valor da CBS a ser estornada.","minimum":0,"nullable":true}},"required":["vCBSEstCred","vIBSEstCred"]},"CteSefazInfCTeNorm":{"type":"object","description":"Grupo de informa\xe7\xf5es do CT-e Normal e Substituto.","properties":{"infCarga":{"$ref":"#/components/schemas/CteSefazInfCarga"},"infDoc":{"$ref":"#/components/schemas/CteSefazInfDoc"},"docAnt":{"$ref":"#/components/schemas/CteSefazDocAnt"},"infModal":{"$ref":"#/components/schemas/CteSefazInfModal"},"veicNovos":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazVeicNovos"}},"cobr":{"$ref":"#/components/schemas/CteSefazCobr"},"infCteSub":{"$ref":"#/components/schemas/CteSefazInfCteSub"},"infGlobalizado":{"$ref":"#/components/schemas/CteSefazInfGlobalizado"},"infServVinc":{"$ref":"#/components/schemas/CteSefazInfServVinc"}},"required":["infModal","infCarga"]},"CteSefazInfCarga":{"type":"object","description":"Informa\xe7\xf5es da Carga do CT-e.","properties":{"vCarga":{"type":"number","description":"Valor total da carga.\\r\\nDever ser informado para todos os modais, com exce\xe7\xe3o para o Dutovi\xe1rio.","minimum":0,"nullable":true},"proPred":{"type":"string","description":"Produto predominante.\\r\\nInformar a descri\xe7\xe3o do produto predominante.","maxLength":60,"minLength":1,"nullable":true},"xOutCat":{"type":"string","description":"Outras caracter\xedsticas da carga.\\r\\n\\"FRIA\\", \\"GRANEL\\", \\"REFRIGERADA\\", \\"Medidas: 12X12X12\\".","maxLength":30,"minLength":1,"nullable":true},"infQ":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazInfQ"},"minItems":1},"vCargaAverb":{"type":"number","description":"Valor da Carga para efeito de averba\xe7\xe3o.\\r\\nNormalmente igual ao valor declarado da mercadoria, diferente por exemplo, quando a mercadoria transportada \xe9 isenta de tributos nacionais para exporta\xe7\xe3o, onde \xe9 preciso averbar um valor maior, pois no caso de indeniza\xe7\xe3o, o valor a ser pago ser\xe1 maior.","minimum":0,"exclusiveMinimum":true,"nullable":true}},"required":["infQ","proPred"]},"CteSefazInfQ":{"type":"object","description":"Informa\xe7\xf5es de quantidades da Carga do CT-e.\\r\\nPara o A\xe9reo \xe9 obrigat\xf3rio o preenchimento desse campo da seguinte forma.\\r\\n* 1 - Peso Bruto, sempre em quilogramas (obrigat\xf3rio)\\r\\n* 2 - Peso Cubado\\r\\nsempre em quilogramas\\r\\n* 3 - Quantidade de volumes, sempre em unidades (obrigat\xf3rio)\\r\\n* 4 - Cubagem, sempre em metros c\xfabicos (obrigat\xf3rio apenas quando for imposs\xedvel preencher as dimens\xf5es da(s) embalagem(ens) na tag xDime do leiaute do A\xe9reo)","properties":{"cUnid":{"type":"string","description":"C\xf3digo da Unidade de Medida.\\r\\nPreencher com:\\r\\n* 00 - M3\\r\\n* 01 - KG\\r\\n* 02 - TON\\r\\n* 03 - UNIDADE\\r\\n* 04 - LITROS\\r\\n* 05 - MMBTU","nullable":true},"tpMed":{"type":"string","description":"Tipo da Medida.\\r\\nExemplos:\\r\\nPESO BRUTO, PESO DECLARADO, PESO CUBADO, PESO AFORADO, PESO AFERIDO, PESO BASE DE C\xc1LCULO, LITRAGEM, CAIXAS e etc.","maxLength":20,"minLength":1,"nullable":true},"qCarga":{"type":"number","description":"Quantidade.","minimum":0,"nullable":true}},"required":["qCarga","tpMed","cUnid"]},"CteSefazInfDoc":{"type":"object","description":"Informa\xe7\xf5es dos documentos transportados pelo CT-e\\r\\nOpcional para Redespacho Intermediario e Servi\xe7o vinculado a multimodal.\\r\\nPoder\xe1 n\xe3o ser informado para os CT-e de redespacho intermedi\xe1rio e servi\xe7o vinculado a multimodal. Nos demais casos dever\xe1 sempre ser informado.","properties":{"infNF":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazInfNF"}},"infNFe":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazInfNFe"}},"infOutros":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazInfOutros"}},"infDCe":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazInfDCe"}}}},"CteSefazInfNF":{"type":"object","description":"Informa\xe7\xf5es das NF.\\r\\nEste grupo deve ser informado quando o documento origin\xe1rio for NF.","properties":{"nRoma":{"type":"string","description":"N\xfamero do Romaneio da NF.","maxLength":20,"minLength":1,"nullable":true},"nPed":{"type":"string","description":"N\xfamero do Pedido da NF.","maxLength":20,"minLength":1,"nullable":true},"mod":{"type":"string","description":"Modelo da Nota Fiscal.\\r\\nPreencher com:\\r\\n* 01 - NF Modelo 01/1A e Avulsa\\r\\n* 04 - NF de Produtor","nullable":true},"serie":{"type":"string","description":"S\xe9rie.","maxLength":3,"minLength":1,"nullable":true},"nDoc":{"type":"string","description":"N\xfamero.","maxLength":20,"minLength":1,"nullable":true},"dEmi":{"type":"string","format":"date","description":"Data de Emiss\xe3o.\\r\\nFormato AAAA-MM-DD.","nullable":true},"vBC":{"type":"number","description":"Valor da Base de C\xe1lculo do ICMS.","minimum":0,"nullable":true},"vICMS":{"type":"number","description":"Valor Total do ICMS.","minimum":0,"nullable":true},"vBCST":{"type":"number","description":"Valor da Base de C\xe1lculo do ICMS ST.","minimum":0,"nullable":true},"vST":{"type":"number","description":"Valor Total do ICMS ST.","minimum":0,"nullable":true},"vProd":{"type":"number","description":"Valor Total dos Produtos.","minimum":0,"nullable":true},"vNF":{"type":"number","description":"Valor Total da NF.","minimum":0,"nullable":true},"nCFOP":{"type":"string","description":"CFOP Predominante.\\r\\nCFOP da NF ou, na exist\xeancia de mais de um, predomin\xe2ncia pelo crit\xe9rio de valor econ\xf4mico.","nullable":true},"nPeso":{"type":"number","description":"Peso total em Kg.","minimum":0,"exclusiveMinimum":true,"nullable":true},"PIN":{"type":"string","description":"PIN SUFRAMA.\\r\\nPIN atribu\xeddo pela SUFRAMA para a opera\xe7\xe3o.","maxLength":9,"minLength":2,"nullable":true},"dPrev":{"type":"string","format":"date","description":"Data prevista de entrega.\\r\\nFormato AAAA-MM-DD.","nullable":true},"infUnidCarga":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazUnidCarga"}},"infUnidTransp":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazUnidadeTransp"}}},"required":["nCFOP","vNF","vProd","vST","vBCST","vICMS","vBC","dEmi","nDoc","serie","mod"]},"CteSefazUnidCarga":{"type":"object","description":"Informa\xe7\xf5es das Unidades de Carga (Containeres/ULD/Outros).\\r\\nDispositivo de carga utilizada (Unit Load Device - ULD) significa todo tipo de cont\xeainer de carga, vag\xe3o, cont\xeainer de avi\xe3o, palete de aeronave com rede ou palete de aeronave com rede sobre um iglu.","properties":{"tpUnidCarga":{"type":"integer","description":"Tipo da Unidade de Carga.\\r\\n* 1 - Container\\r\\n* 2 - ULD\\r\\n* 3 - Pallet\\r\\n* 4 - Outros","nullable":true},"idUnidCarga":{"type":"string","description":"Identifica\xe7\xe3o da Unidade de Carga.\\r\\nInformar a identifica\xe7\xe3o da unidade de carga, por exemplo: n\xfamero do container.","maxLength":20,"minLength":1,"nullable":true},"lacUnidCarga":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazLacUnidCarga"}},"qtdRat":{"type":"number","description":"Quantidade rateada (Peso,Volume).","minimum":0,"nullable":true}},"required":["idUnidCarga","tpUnidCarga"]},"CteSefazLacUnidCarga":{"type":"object","description":"Lacres das Unidades de Carga.","properties":{"nLacre":{"type":"string","description":"N\xfamero do lacre.","maxLength":20,"minLength":1,"nullable":true}},"required":["nLacre"]},"CteSefazUnidadeTransp":{"type":"object","description":"Informa\xe7\xf5es das Unidades de Transporte (Carreta/Reboque/Vag\xe3o).\\r\\nDeve ser preenchido com as informa\xe7\xf5es das unidades de transporte utilizadas.","properties":{"tpUnidTransp":{"type":"integer","description":"Tipo da Unidade de Transporte.\\r\\n* 1 - Rodovi\xe1rio Tra\xe7\xe3o\\r\\n* 2 - Rodovi\xe1rio Reboque\\r\\n* 3 - Navio\\r\\n* 4 - Balsa\\r\\n* 5 - Aeronave\\r\\n* 6 - Vag\xe3o\\r\\n* 7 - Outros","nullable":true},"idUnidTransp":{"type":"string","description":"Identifica\xe7\xe3o da Unidade de Transporte.\\r\\nInformar a identifica\xe7\xe3o conforme o tipo de unidade de transporte.\\r\\nPor exemplo: para rodovi\xe1rio tra\xe7\xe3o ou reboque dever\xe1 preencher com a placa do ve\xedculo.","maxLength":20,"minLength":1,"nullable":true},"lacUnidTransp":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazLacUnidTransp"}},"infUnidCarga":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazUnidCarga"}},"qtdRat":{"type":"number","description":"Quantidade rateada (Peso,Volume).","minimum":0,"nullable":true}},"required":["idUnidTransp","tpUnidTransp"]},"CteSefazLacUnidTransp":{"type":"object","description":"Lacres das Unidades de Transporte.","properties":{"nLacre":{"type":"string","description":"N\xfamero do lacre.","maxLength":20,"minLength":1,"nullable":true}},"required":["nLacre"]},"CteSefazInfNFe":{"type":"object","description":"Informa\xe7\xf5es das NF-e.","properties":{"chave":{"type":"string","description":"Chave de acesso da NF-e.","maxLength":44,"nullable":true},"PIN":{"type":"string","description":"PIN SUFRAMA.\\r\\nPIN atribu\xeddo pela SUFRAMA para a opera\xe7\xe3o.","maxLength":9,"minLength":2,"nullable":true},"dPrev":{"type":"string","format":"date","description":"Data prevista de entrega.\\r\\nFormato AAAA-MM-DD.","nullable":true},"infUnidCarga":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazUnidCarga"}},"infUnidTransp":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazUnidadeTransp"}}},"required":["chave"]},"CteSefazInfOutros":{"type":"object","description":"Informa\xe7\xf5es dos demais documentos.","properties":{"tpDoc":{"type":"string","description":"Tipo de documento origin\xe1rio.\\r\\nPreencher com:\\r\\n* 00 - Declara\xe7\xe3o\\r\\n* 10 - Dutovi\xe1rio\\r\\n* 59 - CF-e SAT\\r\\n* 65 - NFC-e\\r\\n* 99 - Outros","nullable":true},"descOutros":{"type":"string","description":"Descri\xe7\xe3o do documento.","maxLength":100,"minLength":1,"nullable":true},"nDoc":{"type":"string","description":"N\xfamero.","maxLength":20,"minLength":1,"nullable":true},"dEmi":{"type":"string","format":"date","description":"Data de Emiss\xe3o.\\r\\nFormato AAAA-MM-DD.","nullable":true},"vDocFisc":{"type":"number","description":"Valor do documento.","minimum":0,"exclusiveMinimum":true,"nullable":true},"dPrev":{"type":"string","format":"date","description":"Data prevista de entrega.\\r\\nFormato AAAA-MM-DD.","nullable":true},"infUnidCarga":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazUnidCarga"}},"infUnidTransp":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazUnidadeTransp"}}},"required":["tpDoc"]},"CteSefazInfDCe":{"type":"object","description":"Informa\xe7\xf5es das DCe.","properties":{"chave":{"type":"string","description":"Chave de acesso da DCe.","maxLength":44,"nullable":true}},"required":["chave"]},"CteSefazDocAnt":{"type":"object","description":"Documentos de Transporte Anterior.","properties":{"emiDocAnt":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazEmiDocAnt"},"minItems":1}},"required":["emiDocAnt"]},"CteSefazEmiDocAnt":{"type":"object","description":"Emissor do documento anterior.","properties":{"CNPJ":{"type":"string","description":"N\xfamero do CNPJ.\\r\\nEm caso de empresa n\xe3o estabelecida no Brasil, ser\xe1 informado o CNPJ com zeros.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true},"CPF":{"type":"string","description":"N\xfamero do CPF.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true},"IE":{"type":"string","description":"Inscri\xe7\xe3o Estadual.","maxLength":14,"nullable":true},"UF":{"type":"string","description":"Sigla da UF.\\r\\nInformar EX para opera\xe7\xf5es com o exterior.","nullable":true},"xNome":{"type":"string","description":"Raz\xe3o Social ou Nome do expedidor.","maxLength":60,"minLength":1,"nullable":true},"idDocAnt":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazIdDocAnt"},"maxItems":2,"minItems":1}},"required":["idDocAnt","xNome"]},"CteSefazIdDocAnt":{"type":"object","description":"Informa\xe7\xf5es de identifica\xe7\xe3o dos documentos de Transporte Anterior.","properties":{"idDocAntPap":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazIdDocAntPap"}},"idDocAntEle":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazIdDocAntEle"}}}},"CteSefazIdDocAntPap":{"type":"object","description":"Documentos de transporte anterior em papel.","properties":{"tpDoc":{"type":"string","description":"Tipo do Documento de Transporte Anterior.\\r\\nPreencher com:\\r\\n* 07 - ATRE\\r\\n* 08 - DTA (Despacho de Transito Aduaneiro)\\r\\n* 09 - Conhecimento A\xe9reo Internacional\\r\\n* 10 - Conhecimento - Carta de Porte Internacional\\r\\n* 11 - Conhecimento Avulso\\r\\n* 12 - TIF (Transporte Internacional Ferrovi\xe1rio)\\r\\n* 13 - BL (Bill of Lading)","nullable":true},"serie":{"type":"string","description":"S\xe9rie do Documento Fiscal.","maxLength":3,"minLength":1,"nullable":true},"subser":{"type":"string","description":"S\xe9rie do Documento Fiscal.","maxLength":2,"minLength":1,"nullable":true},"nDoc":{"type":"string","description":"N\xfamero do Documento Fiscal.","maxLength":30,"minLength":1,"nullable":true},"dEmi":{"type":"string","format":"date","description":"Data de emiss\xe3o (AAAA-MM-DD).","nullable":true}},"required":["dEmi","nDoc","serie","tpDoc"]},"CteSefazIdDocAntEle":{"type":"object","description":"Documentos de transporte anterior eletr\xf4nicos.","properties":{"chCTe":{"type":"string","description":"Chave de acesso do CT-e.","maxLength":44,"nullable":true}},"required":["chCTe"]},"CteSefazInfModal":{"type":"object","description":"Informa\xe7\xf5es do modal.","properties":{"versaoModal":{"type":"string","description":"Vers\xe3o do leiaute espec\xedfico para o Modal.","nullable":true},"rodo":{"$ref":"#/components/schemas/CteSefazRodo"},"aereo":{"$ref":"#/components/schemas/CteSefazAereo"},"ferrov":{"$ref":"#/components/schemas/CteSefazFerrov"},"aquav":{"$ref":"#/components/schemas/CteSefazAquav"},"duto":{"$ref":"#/components/schemas/CteSefazDuto"},"multimodal":{"$ref":"#/components/schemas/CteSefazMultimodal"}},"required":["versaoModal"]},"CteSefazRodo":{"type":"object","description":"Informa\xe7\xf5es do modal Rodovi\xe1rio.","properties":{"RNTRC":{"type":"string","description":"Registro Nacional de Transportadores Rodovi\xe1rios de Carga.\\r\\nRegistro obrigat\xf3rio do emitente do CT-e junto \xe0 ANTT para exercer a atividade de transportador rodovi\xe1rio de cargas por conta de terceiros e mediante remunera\xe7\xe3o.","nullable":true},"occ":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazOcc"},"maxItems":10}},"required":["RNTRC"]},"CteSefazOcc":{"type":"object","description":"Ordens de Coleta associados.","properties":{"serie":{"type":"string","description":"S\xe9rie da OCC.","maxLength":3,"minLength":1,"nullable":true},"nOcc":{"type":"integer","description":"N\xfamero da Ordem de coleta.","maximum":999999,"minimum":1,"nullable":true},"dEmi":{"type":"string","format":"date","description":"Data de emiss\xe3o da ordem de coleta.\\r\\nFormato AAAA-MM-DD.","nullable":true},"emiOcc":{"$ref":"#/components/schemas/CteSefazEmiOcc"}},"required":["dEmi","nOcc"]},"CteSefazEmiOcc":{"type":"object","properties":{"CNPJ":{"type":"string","description":"N\xfamero do CNPJ.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true},"cInt":{"type":"string","description":"C\xf3digo interno de uso da transportadora.\\r\\nUso intermo das transportadoras.","maxLength":10,"minLength":1,"nullable":true},"IE":{"type":"string","description":"Inscri\xe7\xe3o Estadual.","maxLength":14,"nullable":true},"UF":{"type":"string","description":"Sigla da UF.\\r\\nInformar EX para opera\xe7\xf5es com o exterior.","nullable":true},"fone":{"type":"string","description":"Telefone.","nullable":true}},"required":["UF","IE","CNPJ"]},"CteSefazAereo":{"type":"object","description":"Informa\xe7\xf5es do modal A\xe9reo.","properties":{"nMinu":{"type":"integer","description":"N\xfamero da Minuta.\\r\\nDocumento que precede o CT-e, assinado pelo expedidor, esp\xe9cie de pedido de servi\xe7o.","maximum":999999999,"minimum":0,"nullable":true},"nOCA":{"type":"string","description":"N\xfamero Operacional do Conhecimento A\xe9reo.\\r\\nRepresenta o n\xfamero de controle comumente utilizado pelo conhecimento a\xe9reo composto por uma sequ\xeancia num\xe9rica de onze d\xedgitos. Os tr\xeas primeiros d\xedgitos representam um c\xf3digo que os operadores de transporte a\xe9reo associados \xe0 IATA possuem. Em seguida um n\xfamero de s\xe9rie de sete d\xedgitos determinados pelo operador de transporte a\xe9reo. Para finalizar, um d\xedgito verificador, que \xe9 um sistema de m\xf3dulo sete imponderado o qual divide o n\xfamero de s\xe9rie do conhecimento a\xe9reo por sete e usa o resto como d\xedgito de verifica\xe7\xe3o.","nullable":true},"dPrevAereo":{"type":"string","format":"date","description":"Data prevista da entrega.\\r\\nFormato AAAA-MM-DD.","nullable":true},"natCarga":{"$ref":"#/components/schemas/CteSefazNatCarga"},"tarifa":{"$ref":"#/components/schemas/CteSefazTarifa"},"peri":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazPeri"}}},"required":["tarifa","natCarga","dPrevAereo"]},"CteSefazNatCarga":{"type":"object","description":"Natureza da carga.","properties":{"xDime":{"type":"string","description":"Dimens\xe3o.\\r\\nFormato:1234X1234X1234 (cm). Esse campo deve sempre que poss\xedvel ser preenchido. Entretanto, quando for imposs\xedvel o preenchimento das dimens\xf5es, fica obrigat\xf3rio o preenchimento da cubagem em metro c\xfabico do leiaute do CT-e da estrutura gen\xe9rica (infQ).","maxLength":14,"minLength":5,"nullable":true},"cInfManu":{"type":"array","description":"Informa\xe7\xf5es de manuseio.\\r\\n* 01 - certificado do expedidor para embarque de animal vivo\\r\\n* 02 - artigo perigoso conforme Declara\xe7\xe3o do Expedidor anexa\\r\\n* 03 - somente em aeronave cargueira\\r\\n* 04 - artigo perigoso - declara\xe7\xe3o do expedidor n\xe3o requerida\\r\\n* 05 - artigo perigoso em quantidade isenta\\r\\n* 06 - gelo seco para refrigera\xe7\xe3o (especificar no campo observa\xe7\xf5es a quantidade)\\r\\n* 07 - n\xe3o restrito (especificar a Disposi\xe7\xe3o Especial no campo observa\xe7\xf5es)\\r\\n* 08 - artigo perigoso em carga consolidada (especificar a quantidade no campo observa\xe7\xf5es)\\r\\n* 09 - autoriza\xe7\xe3o da autoridade governamental anexa (especificar no campo observa\xe7\xf5es)\\r\\n* 10 - baterias de \xedons de l\xedtio em conformidade com a Se\xe7\xe3o II da PI965 - CAO\\r\\n* 11 - baterias de \xedons de l\xedtio em conformidade com a Se\xe7\xe3o II da PI966\\r\\n* 12 - baterias de \xedons de l\xedtio em conformidade com a Se\xe7\xe3o II da PI967\\r\\n* 13 - baterias de metal l\xedtio em conformidade com a Se\xe7\xe3o II da PI968 \u2014 CAO\\r\\n* 14 - baterias de metal l\xedtio em conformidade com a Se\xe7\xe3o II da PI969\\r\\n* 15 - baterias de metal l\xedtio em conformidade com a Se\xe7\xe3o II da PI970\\r\\n* 99 - outro (especificar no campo observa\xe7\xf5es)","items":{"type":"string"}}}},"CteSefazTarifa":{"type":"object","description":"Informa\xe7\xf5es de tarifa.","properties":{"CL":{"type":"string","description":"Classe.\\r\\nPreencher com:\\r\\n* M - Tarifa M\xednima\\r\\n* G - Tarifa Geral\\r\\n* E - Tarifa Espec\xedfica","maxLength":1,"nullable":true},"cTar":{"type":"string","description":"C\xf3digo da Tarifa.\\r\\nDever\xe3o ser inclu\xeddos os c\xf3digos de tr\xeas d\xedgitos, correspondentes \xe0 tarifa.","maxLength":4,"minLength":1,"nullable":true},"vTar":{"type":"number","description":"Valor da Tarifa.\\r\\nValor da tarifa por kg quando for o caso.","minimum":0,"nullable":true}},"required":["vTar","CL"]},"CteSefazPeri":{"type":"object","description":"Preenchido quando for  transporte de produtos classificados pela ONU como perigosos.\\r\\nO preenchimento desses campos n\xe3o desobriga a empresa a\xe9rea de emitir os demais documentos que constam na legisla\xe7\xe3o vigente.","properties":{"nONU":{"type":"string","description":"N\xfamero ONU/UN.\\r\\nVer a legisla\xe7\xe3o de transporte de produtos perigosos aplicadas ao modal.","nullable":true},"qTotEmb":{"type":"string","description":"Quantidade total de volumes contendo artigos perigosos.\\r\\nPreencher com o n\xfamero de volumes (unidades) de artigos perigosos, ou seja, cada embalagem devidamente marcada e etiquetada (por ex.: n\xfamero de caixas, de tambores, de bombonas, dentre outros). N\xe3o deve ser preenchido com o n\xfamero de ULD, pallets ou containers.","maxLength":20,"minLength":1,"nullable":true},"infTotAP":{"$ref":"#/components/schemas/CteSefazInfTotAP"}},"required":["infTotAP","qTotEmb","nONU"]},"CteSefazInfTotAP":{"type":"object","description":"Grupo de informa\xe7\xf5es das quantidades totais de artigos perigosos.\\r\\nPreencher conforme a legisla\xe7\xe3o de transporte de produtos perigosos aplicada ao modal.","properties":{"qTotProd":{"type":"number","description":"Quantidade total de artigos perigosos.\\r\\n15 posi\xe7\xf5es, sendo 11 inteiras e 4 decimais.\\r\\nDeve indicar a quantidade total do artigo perigoso, tendo como base a unidade referenciada na Tabela 3-1 do Doc 9284, por exemplo: litros\\r\\nquilogramas\\r\\nquilograma bruto etc. O preenchimento n\xe3o deve, entretanto, incluir a unidade de medida. No caso de transporte de material radioativo, deve-se indicar o somat\xf3rio dos \xcdndices de Transporte (TI). N\xe3o indicar a quantidade do artigo perigoso por embalagem.","minimum":0,"nullable":true},"uniAP":{"type":"integer","description":"Unidade de medida.\\r\\n* 1 - KG\\r\\n* 2 - KG G (quilograma bruto)\\r\\n* 3 - LITROS\\r\\n* 4 - TI (\xedndice de transporte para radioativos)\\r\\n* 5 - Unidades (apenas para artigos perigosos medidos em unidades que n\xe3o se enquadram nos itens acima. Exemplo: baterias, celulares, equipamentos, ve\xedculos, dentre outros)","nullable":true}},"required":["uniAP","qTotProd"]},"CteSefazFerrov":{"type":"object","description":"Informa\xe7\xf5es do modal Ferrovi\xe1rio.","properties":{"tpTraf":{"type":"integer","description":"Tipo de Tr\xe1fego.\\r\\nPreencher com:\\r\\n* 0 - Pr\xf3prio\\r\\n* 1 - M\xfatuo\\r\\n* 2 - Rodoferrovi\xe1rio\\r\\n* 3 - Rodovi\xe1rio","nullable":true},"trafMut":{"$ref":"#/components/schemas/CteSefazTrafMut"},"fluxo":{"type":"string","description":"Fluxo Ferrovi\xe1rio.\\r\\nTrata-se de um n\xfamero identificador do contrato firmado com o cliente.","maxLength":10,"minLength":1,"nullable":true}},"required":["fluxo","tpTraf"]},"CteSefazTrafMut":{"type":"object","description":"Detalhamento de informa\xe7\xf5es para o tr\xe1fego m\xfatuo.","properties":{"respFat":{"type":"integer","description":"Respons\xe1vel pelo Faturamento.\\r\\nPreencher com:\\r\\n* 1 - Ferrovia de origem\\r\\n* 2 - Ferrovia de destino","nullable":true},"ferrEmi":{"type":"integer","description":"Ferrovia Emitente do CTe.\\r\\nPreencher com:\\r\\n* 1 - Ferrovia de origem\\r\\n* 2 - Ferrovia de destino","nullable":true},"vFrete":{"type":"number","description":"Valor do Frete do Tr\xe1fego M\xfatuo.","minimum":0,"nullable":true},"chCTeFerroOrigem":{"type":"string","description":"Chave de acesso do CT-e emitido pelo ferrovia de origem.","maxLength":44,"nullable":true},"ferroEnv":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazFerroEnv"}}},"required":["vFrete","ferrEmi","respFat"]},"CteSefazFerroEnv":{"type":"object","description":"Informa\xe7\xf5es das Ferrovias Envolvidas.","properties":{"CNPJ":{"type":"string","description":"N\xfamero do CNPJ.\\r\\nInformar o CNPJ da Ferrovia Envolvida. Caso a Ferrovia envolvida n\xe3o seja inscrita no CNPJ o campo dever\xe1 preenchido com zeros.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true},"cInt":{"type":"string","description":"C\xf3digo interno da Ferrovia envolvida.\\r\\nUso da transportadora.","maxLength":10,"minLength":1,"nullable":true},"IE":{"type":"string","description":"Inscri\xe7\xe3o Estadual.","maxLength":14,"nullable":true},"xNome":{"type":"string","description":"Raz\xe3o Social ou Nome.","maxLength":60,"minLength":2,"nullable":true},"enderFerro":{"$ref":"#/components/schemas/CteSefazEnderFer"}},"required":["enderFerro","xNome","CNPJ"]},"CteSefazEnderFer":{"type":"object","description":"Dados do endere\xe7o da ferrovia envolvida.","properties":{"xLgr":{"type":"string","description":"Logradouro.","maxLength":255,"minLength":2,"nullable":true},"nro":{"type":"string","description":"N\xfamero.","maxLength":60,"minLength":1,"nullable":true},"xCpl":{"type":"string","description":"Complemento.","maxLength":60,"minLength":1,"nullable":true},"xBairro":{"type":"string","description":"Bairro.","maxLength":60,"minLength":2,"nullable":true},"cMun":{"type":"string","description":"C\xf3digo do munic\xedpio.\\r\\nUtilizar a tabela do IBGE\\r\\nInformar 9999999 para opera\xe7\xf5es com o exterior.","nullable":true},"xMun":{"type":"string","description":"Nome do munic\xedpio.\\r\\nInformar EXTERIOR para opera\xe7\xf5es com o exterior.","maxLength":60,"minLength":2,"nullable":true},"CEP":{"type":"string","description":"CEP.","nullable":true},"UF":{"type":"string","description":"Sigla da UF.\\r\\nInformar EX para opera\xe7\xf5es com o exterior.","nullable":true}},"required":["UF","CEP","xMun","cMun","xLgr"]},"CteSefazAquav":{"type":"object","description":"Informa\xe7\xf5es do modal Aquavi\xe1rio.","properties":{"vPrest":{"type":"number","description":"Valor da Presta\xe7\xe3o Base de C\xe1lculo do AFRMM.","minimum":0,"nullable":true},"vAFRMM":{"type":"number","description":"AFRMM (Adicional de Frete para Renova\xe7\xe3o da Marinha Mercante).","minimum":0,"nullable":true},"xNavio":{"type":"string","description":"Identifica\xe7\xe3o do Navio.","maxLength":60,"minLength":1,"nullable":true},"balsa":{"type":"array","items":{"$ref":"#/components/schemas/CteSefazBalsa"},"maxItems":3},"nViag":{"type":"string","description":"N\xfame