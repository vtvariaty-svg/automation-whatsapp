edquota do ICMS.","minimum":0,"nullable":true},"vICMS":{"type":"number","description":"Valor do ICMS.","minimum":0,"nullable":true},"vICMSDeson":{"type":"number","description":"Valor do ICMS de desonera\xe7\xe3o.","minimum":0,"nullable":true},"cBenef":{"type":"string","description":"C\xf3digo de Benef\xedcio Fiscal na UF.\\r\\nC\xf3digo de Benef\xedcio Fiscal utilizado pela UF.","maxLength":10,"nullable":true}},"required":["vICMS","pICMS","vBC","pRedBC","CST"]},"CteSefazICMS45":{"type":"object","description":"ICMS  Isento, n\xe3o Tributado ou diferido.","properties":{"CST":{"type":"string","description":"Classifica\xe7\xe3o Tribut\xe1ria do Servi\xe7o.\\r\\nPreencher com:\\r\\n* 40 - ICMS isen\xe7\xe3o\\r\\n* 41 - ICMS n\xe3o tributada\\r\\n* 51 - ICMS diferido","nullable":true},"vICMSDeson":{"type":"number","description":"Valor do ICMS de desonera\xe7\xe3o.","minimum":0,"nullable":true},"cBenef":{"type":"string","description":"C\xf3digo de Benef\xedcio Fiscal na UF.\\r\\nC\xf3digo de Benef\xedcio Fiscal utilizado pela UF.","maxLength":10,"nullable":true}},"required":["CST"]},"CteSefazICMS60":{"type":"object","description":"Tributa\xe7\xe3o pelo ICMS60 - ICMS cobrado por substitui\xe7\xe3o tribut\xe1ria.Responsabilidade do recolhimento do ICMS atribu\xeddo ao tomador ou 3\xba por ST.","properties":{"CST":{"type":"string","description":"Classifica\xe7\xe3o Tribut\xe1ria do Servi\xe7o.\\r\\n* 60 - ICMS cobrado por substitui\xe7\xe3o tribut\xe1ria","nullable":true},"vBCSTRet":{"type":"number","description":"Valor da BC do ICMS ST retido.\\r\\nValor do frete sobre o qual ser\xe1 calculado o ICMS a ser substitu\xeddo na Presta\xe7\xe3o.","minimum":0,"nullable":true},"vICMSSTRet":{"type":"number","description":"Valor do ICMS ST retido.\\r\\nResultado da multiplica\xe7\xe3o do \u201cvBCSTRet\u201d x \u201cpICMSSTRet\u201d - que ser\xe1 valor do ICMS a ser retido pelo Substituto. Podendo o valor do ICMS a ser retido efetivamente, sofrer ajustes conforme a op\xe7\xe3o tributaria do transportador substitu\xeddo.","minimum":0,"nullable":true},"pICMSSTRet":{"type":"number","description":"Al\xedquota do ICMS.\\r\\nPercentual de Al\xedquota incidente na presta\xe7\xe3o de servi\xe7o de transporte.","minimum":0,"nullable":true},"vCred":{"type":"number","description":"Valor do Cr\xe9dito outorgado/Presumido.\\r\\nPreencher somente quando o transportador substitu\xeddo, for optante pelo cr\xe9dito outorgado previsto no Conv\xeanio 106/96 e corresponde ao percentual de 20%% do valor do ICMS ST retido.","minimum":0,"nullable":true},"vICMSDeson":{"type":"number","description":"Valor do ICMS de desonera\xe7\xe3o.","minimum":0,"nullable":true},"cBenef":{"type":"string","description":"C\xf3digo de Benef\xedcio Fiscal na UF.\\r\\nC\xf3digo de Benef\xedcio Fiscal utilizado pela UF.","maxLength":10,"nullable":true}},"required":["pICMSSTRet","vICMSSTRet","vBCSTRet","CST"]},"CteSefazICMS90":{"type":"object","description":"ICMS Outros.","properties":{"CST":{"type":"string","description":"Classifica\xe7\xe3o Tribut\xe1ria do Servi\xe7o.\\r\\n* 90 - ICMS outros","nullable":true},"pRedBC":{"type":"number","description":"Percentual de redu\xe7\xe3o da BC.","minimum":0,"exclusiveMinimum":true,"nullable":true},"vBC":{"type":"number","description":"Valor da BC do ICMS.","minimum":0,"nullable":true},"pICMS":{"type":"number","description":"Al\xedquota do ICMS.","minimum":0,"nullable":true},"vICMS":{"type":"number","description":"Valor do ICMS.","minimum":0,"nullable":true},"vCred":{"type":"number","description":"Valor do Cr\xe9dito Outorgado/Presumido.","minimum":0,"nullable":true},"vICMSDeson":{"type":"number","description":"Valor do ICMS de desonera\xe7\xe3o.","minimum":0,"nullable":true},"cBenef":{"type":"string","description":"C\xf3digo de Benef\xedcio Fiscal na UF.\\r\\nC\xf3digo de Benef\xedcio Fiscal utilizado pela UF.","maxLength":10,"nullable":true}},"required":["vICMS","pICMS","vBC","CST"]},"CteSefazICMSOutraUF":{"type":"object","description":"ICMS devido \xe0 UF de origem da presta\xe7\xe3o, quando  diferente da UF do emitente.","properties":{"CST":{"type":"string","description":"Classifica\xe7\xe3o Tribut\xe1ria do Servi\xe7o.\\r\\n* 90 - ICMS Outra UF","nullable":true},"pRedBCOutraUF":{"type":"number","description":"Percentual de redu\xe7\xe3o da BC.","minimum":0,"exclusiveMinimum":true,"nullable":true},"vBCOutraUF":{"type":"number","description":"Valor da BC do ICMS.","minimum":0,"nullable":true},"pICMSOutraUF":{"type":"number","description":"Al\xedquota do ICMS.","minimum":0,"nullable":true},"vICMSOutraUF":{"type":"number","description":"Valor do ICMS devido outra UF.","minimum":0,"nullable":true},"vICMSDeson":{"type":"number","description":"Valor do ICMS de desonera\xe7\xe3o.","minimum":0,"nullable":true},"cBenef":{"type":"string","description":"C\xf3digo de Benef\xedcio Fiscal na UF.\\r\\nC\xf3digo de Benef\xedcio Fiscal utilizado pela UF.","maxLength":10,"nullable":true}},"required":["vICMSOutraUF","pICMSOutraUF","vBCOutraUF","CST"]},"CteSefazICMSSN":{"type":"object","description":"Simples Nacional.","properties":{"CST":{"type":"string","description":"Classifica\xe7\xe3o Tribut\xe1ria do Servi\xe7o.\\r\\n* 90 - ICMS Simples Nacional","nullable":true},"indSN":{"type":"integer","description":"Indica se o contribuinte \xe9 Simples Nacional\\t\\t\\t1=Sim.","nullable":true}},"required":["indSN","CST"]},"CteSefazICMSUFFim":{"type":"object","description":"Informa\xe7\xf5es do ICMS de partilha com a UF de t\xe9rmino do servi\xe7o de transporte na opera\xe7\xe3o interestadual.\\r\\nGrupo a ser informado nas presta\xe7\xf5es interestaduais para consumidor final, n\xe3o contribuinte do ICMS.","properties":{"vBCUFFim":{"type":"number","description":"Valor da BC do ICMS na UF de t\xe9rmino da presta\xe7\xe3o do servi\xe7o de transporte.","minimum":0,"nullable":true},"pFCPUFFim":{"type":"number","description":"Percentual do ICMS relativo ao Fundo de Combate \xe0 pobreza (FCP) na UF de t\xe9rmino da presta\xe7\xe3o do ser