imum":0,"nullable":true},"vTRec":{"type":"number","description":"Valor total a Receber.","minimum":0,"nullable":true},"vTotDFe":{"type":"number","description":"Valor total do documento fiscal\\r\\n(vTPrest + total do IBS + total da CBS).","minimum":0,"nullable":true}},"required":["vTRec","vTPrest"]},"CteSimpSefazAutXMLSimp":{"type":"object","description":"Autorizados para download do XML do DF-e.\\r\\nInformar CNPJ ou CPF. Preencher os zeros n\xe3o significativos.","properties":{"CNPJ":{"type":"string","description":"CNPJ do autorizado.\\r\\nInformar zeros n\xe3o significativos.","nullable":true},"CPF":{"type":"string","description":"CPF do autorizado.\\r\\nInformar zeros n\xe3o significativos.","nullable":true}}},"CteSimpSefazRespTecSimp":{"type":"object","description":"Informa\xe7\xf5es do Respons\xe1vel T\xe9cnico pela emiss\xe3o do DF-e.","properties":{"CNPJ":{"type":"string","description":"CNPJ da pessoa jur\xeddica respons\xe1vel t\xe9cnica pelo sistema utilizado na emiss\xe3o do documento fiscal eletr\xf4nico.\\r\\nInformar o CNPJ da pessoa jur\xeddica desenvolvedora do sistema utilizado na emiss\xe3o do documento fiscal eletr\xf4nico.","nullable":true},"xContato":{"type":"string","description":"Nome da pessoa a ser contatada.\\r\\nInformar o nome da pessoa a ser contatada na empresa desenvolvedora do sistema utilizado na emiss\xe3o do documento fiscal eletr\xf4nico. No caso de pessoa f\xedsica, informar o respectivo nome.","maxLength":60,"minLength":2,"nullable":true},"email":{"type":"string","description":"Email da pessoa jur\xeddica a ser contatada.","maxLength":60,"minLength":1,"nullable":true},"fone":{"type":"string","description":"Telefone da pessoa jur\xeddica a ser contatada.\\r\\nPreencher com o C\xf3digo DDD + n\xfamero do telefone.","nullable":true},"idCSRT":{"type":"integer","description":"Identificador do c\xf3digo de seguran\xe7a do respons\xe1vel t\xe9cnico.\\r\\nIdentificador do CSRT utilizado para gera\xe7\xe3o do hash.","maximum":999,"minimu