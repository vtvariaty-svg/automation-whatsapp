ifica\xe7\xe3o do Ambiente.","enum":["homologacao","producao"]},"chave_acesso":{"type":"string","description":"Chave de Acesso da NF-e."},"tipo_evento":{"type":"string","description":"Tipo do evento de manifesta\xe7\xe3o do destinat\xe1rio.\\r\\n\\r\\nValores dispon\xedveis:\\r\\n* `210200` - Confirma\xe7\xe3o da opera\xe7\xe3o;\\r\\n* `210210` - Ci\xeancia da opera\xe7\xe3o;\\r\\n* `210220` - Desconhecimento da opera\xe7\xe3o;\\r\\n* `210240` - Opera\xe7\xe3o n\xe3o realizada."},"justificativa":{"type":"string","description":"Justificativa para o desconhecimento ou n\xe3o-realiza\xe7\xe3o da opera\xe7\xe3o.\\r\\n\\r\\n**Nota**: Campo obrigat\xf3rio para o evento `210240` (opera\xe7\xe3o n\xe3o realizada).","maxLength":255,"minLength":15,"nullable":true}},"required":["tipo_evento","chave_acesso","ambiente","cpf_cnpj"]},"NfcomPedidoEmissao":{"type":"object","properties":{"infNFCom":{"$ref":"#/components/schemas/NfcomSefazInfNFCom"},"ambiente":{"type":"string","description":"Identifica\xe7\xe3o do Ambiente.","enum":["homologacao","producao"]},"referencia":{"type":"string","description":"Seu identificador \xfanico para este documento. Opcional, ajuda a evitar o envio duplicado de um mesmo documento.","maxLength":50,"nullable":true}},"required":["ambiente","infNFCom"]},"NfcomSefazInfNFCom":{"type":"object","description":"Informa\xe7\xf5es da NFCom.","properties":{"versao":{"type":"string","description":"Vers\xe3o do leiaute.","nullable":true},"Id":{"type":"string","description":"Identificador da tag a ser assinada.\\r\\nInformar a chave de acesso da NFCom e precedida do literal \\"NFCom\\".\\r\\n\\r\\n*Geramos automaticamente quando nenhum valor \xe9 informado.*","nullable":true},"ide":{"$ref":"#/components/schemas/NfcomSefazIde"},"emit":{"$ref":"#/components/schemas/NfcomSefazEmit"},"dest":{"$ref":"#/components/schemas/NfcomSefazDest"},"assinante":{"$ref":"#/components/schemas/NfcomSefazAssinante"},"gSub":{"$ref":"#/components/schemas/NfcomSefazGSub"},"gCofat":{"$ref":"#/components/schemas/NfcomSefazGCofat"},"det":{"type":"array","items":{"$ref":"#/components/schemas/NfcomSefazDet"},"maxItems":990,"minItems":1},"total":{"$ref":"#/components/schemas/NfcomSefazTotal"},"gFidelidade":{"$ref":"#/components/schemas/NfcomSefazGFidelidade"},"gFat":{"$ref":"#/components/schemas/NfcomSefazGFat"},"gFatCentral":{"$ref":"#/components/schemas/NfcomSefazGFatCentral"},"autXML":{"type":"array","items":{"$ref":"#/components/schemas/NfcomSefazAutXML"},"maxItems":10},"infAdic":{"$ref":"#/components/schemas/NfcomSefazInfAdic"},"gRespTec":{"$ref":"#/components/schemas/NfcomSefazRespTec"}},"required":["total","det","assinante","dest","emit","ide","versao"]},"NfcomSefazIde":{"type":"object","description":"Identifica\xe7\xe3o da NFCom.","properties":{"cUF":{"type":"integer","description":"C\xf3digo da UF de emiss\xe3o e autoriza\xe7\xe3o da NFCom.\\r\\nC\xf3digo da UF de emiss\xe3o e autoriza\xe7\xe3o do Documento Fiscal. Utilizar a\\r\\nTabela do IBGE de c\xf3digo de unidades da federa\xe7\xe3o.","nullable":true},"tpAmb":{"type":"integer","description":"Tipo do Ambiente:\\r\\n* 1 - Produ\xe7\xe3o\\r\\n* 2 - Homologa\xe7\xe3o","nullable":true},"mod":{"type":"integer","description":"Modelo da NFCom.\\r\\nUtilizar o c\xf3digo 62 para identifica\xe7\xe3o da NFCom.","nullable":true},"serie":{"type":"integer","description":"S\xe9rie do documento fiscal.\\r\\nInformar a s\xe9rie do documento fiscal (informar zero para s\xe9rie \xfanica).","maximum":999,"minimum":0,"nullable":true},"nNF":{"type":"integer","description":"N\xfamero do documento fiscal.\\r\\nN\xfamero que identifica o documento fiscal 1 a 999999999.","maximum":999999999,"minimum":1,"nullable":true},"cNF":{"type":"string","description":"C\xf3digo num\xe9rico que comp\xf5e a Chave de Acesso.\\r\\nC\xf3digo aleat\xf3rio gerado pelo emitente, com o objetivo de evitar acessos indevidos ao documento.\\r\\n\\r\\n*Geramos automaticamente quando nenhum valor \xe9 informado.*","nullable":true},"cDV":{"type":"integer","description":"Digito verificador da chave de acesso.\\r\\nInformar o d\xedgito  de controle da chave de acesso documento fiscal, que deve ser calculado com a aplica\xe7\xe3o do algoritmo m\xf3dulo 11 (base 2,9) da chave de acesso.\\r\\n\\r\\n*Geramos automaticamente quando nenhum valor \xe9 informado.*","maximum":9,"minimum":0,"nullable":true},"dhEmi":{"type":"string","format":"date-time","description":"Data e hora de emiss\xe3o do documento fiscal.\\r\\nFormato AAAA-MM-DDTHH:MM:DD TZD.","nullable":true},"tpEmis":{"type":"integer","description":"Forma de emiss\xe3o do Documento Fiscal.\\r\\n* 1 - Normal\\r\\n* 2 - Conting\xeancia","nullable":true},"nSiteAutoriz":{"type":"integer","description":"Identifica\xe7\xe3o do n\xfamero do Site do Autorizador de recep\xe7\xe3o da NFCom.\\r\\nSe o autorizador da NFCom possuir apenas um site dever\xe1 ser informado com Zero (0), em caso de Autorizador trabalhar com m\xfaltiplos sites indicar o n\xfamero do site para qual foi endere\xe7ada a NFCOM (1 a 9).\\r\\nObserva\xe7\xe3o: o ambiente autorizador que trabalhar com mais de um Site dever\xe1 divulgar para cada endere\xe7o de site qual n\xfamero correspondente de nSiteAutoriz o contribuinte pode usar.","maximum":9,"minimum":0,"nullable":true},"cMunFG":{"type":"string","description":"C\xf3digo do munic\xedpio de ocorr\xeancia do fato gerador.","nullable":true},"finNFCom":{"type":"integer","description":"Finalidade de emiss\xe3o da NFCom.\\r\\n* 0 - NFCom Normal\\r\\n* 3 - NFCom de Substitui\xe7\xe3o\\r\\n* 4 - NFCom de Ajuste","nullable":true},"tpFat":{"type":"integer","description":"Tipo de Faturamento da NFCom.\\r\\n* 0 - Faturamento Normal\\r\\n* 1 - Faturamento centralizado\\r\\n* 2 - Cofaturamento","nullable":true},"verProc":{"type":"string","description":"Vers\xe3o do processo de emiss\xe3o.\\r\\nInformar a vers\xe3o do aplicativo emissor de NFCom.","maxLength":20,"minLength":1,"nullable":true},"indPrePago":{"type":"integer","description":"Indicador de servi\xe7o pr\xe9-pago.\\r\\n* 1 - Servi\xe7o pr\xe9-pago (informar a tag somente se a nota for referente a um servi\xe7o exclusivamente pr\xe9-pago)","nullable":true},"indCessaoMeiosRede":{"type":"integer","description":"Indicador de Sess\xe3o de Meios de Rede.\\r\\nUma vez informado (valor = 1), essa tag dispensa gera\xe7\xe3o do grupo Fatura.\\r\\nApenas para notas dos tipos Normal e Substitui\xe7\xe3o com tipo de faturamento normal.","nullable":true},"indNotaEntrada":{"type":"integer","description":"Indicador de nota de entrada.\\r\\n* 1 - Informar quando for nota de ajuste e possuir itens com CFOP de entrada","nullable":true},"dhCont":{"type":"string","format":"date-time","description":"Data e Hora da entrada em conting\xeancia.\\r\\nInformar a data e hora no formato AAAA-MM-DDTHH:MM:SS.","nullable":true},"xJust":{"type":"string","description":"Justificativa da entrada em conting\xeancia.","maxLength":256,"minLength":15,"nullable":true},"gCompraGov":{"$ref":"#/components/schemas/NfcomSefazCompraGovReduzido"}},"required":["verProc","tpFat","finNFCom","cMunFG","nSiteAutoriz","tpEmis","dhEmi","nNF","serie","cUF"]},"NfcomSefazCompraGovReduzido":{"type":"object","description":"Grupo de Compras Governamentais.","properties":{"tpEnteGov":{"type":"integer","description":"Para administra\xe7\xe3o p\xfablica direta e suas autarquias e funda\xe7\xf5es:\\r\\n* 1 - Uni\xe3o\\r\\n* 2 - Estados\\r\\n* 3 - Distrito Federal\\r\\n* 4 - Munic\xedpios","nullable":true},"pRedutor":{"type":"number","description":"Percentual de redu\xe7\xe3o de aliquota em compra governamental.","minimum":0,"nullable":true}},"required":["pRedutor","tpEnteGov"]},"NfcomSefazEmit":{"type":"object","description":"Identifica\xe7\xe3o do Emitente do documento fiscal.","properties":{"CNPJ":{"type":"string","description":"CNPJ do emitente.\\r\\nInformar zeros n\xe3o significativos.","nullable":true},"IE":{"type":"string","description":"Inscri\xe7\xe3o Estadual do emitente.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","nullable":true},"IEUFDest":{"type":"string","description":"Inscri\xe7\xe3o Estadual Virtual do emitente na UF de Destino da partilha (IE Virtual).","nullable":true},"CRT":{"type":"integer","description":"C\xf3digo do Regime Tribut\xe1rio. Informar:\\r\\n* 1 - Simples Nacional;\\r\\n* 2 - Simples Nacional, excesso sublimite de receita bruta;\\r\\n* 3 - Regime Normal.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","nullable":true},"xNome":{"type":"string","description":"Raz\xe3o social ou Nome do emitente.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":2,"nullable":true},"xFant":{"type":"string","description":"Nome fantasia do emitente.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":1,"nullable":true},"enderEmit":{"$ref":"#/components/schemas/NfcomSefazEndeEmi"}},"required":["CNPJ"]},"NfcomSefazEndeEmi":{"type":"object","description":"Endere\xe7o do emitente.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","properties":{"xLgr":{"type":"string","description":"Logradouro.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":2,"nullable":true},"nro":{"type":"string","description":"N\xfamero.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":1,"nullable":true},"xCpl":{"type":"string","description":"Complemento.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":1,"nullable":true},"xBairro":{"type":"string","description":"Bairro.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":2,"nullable":true},"cMun":{"type":"string","description":"C\xf3digo do munic\xedpio (utilizar a tabela 