":{"type":"string","description":"Indicar o grupo de informa\xe7\xf5es que pertence o \\"campo_alterado\\". Ex: ide.","maxLength":20,"minLength":1},"campo_alterado":{"type":"string","description":"Nome do campo modificado do CT-e Original.","maxLength":20,"minLength":1},"valor_alterado":{"type":"string","description":"Valor correspondente \xe0 altera\xe7\xe3o.","maxLength":500,"minLength":1},"numero_item_alterado":{"type":"integer","description":"Preencher com o indice do item alterado caso a altera\xe7\xe3o ocorra em uma lista.\\r\\nOBS: O indice inicia sempre em 1.","nullable":true}},"required":["valor_alterado","campo_alterado","grupo_alterado"]},"CteCartaCorrecao":{"type":"object","properties":{"correcoes":{"type":"array","description":"Grupo de Informa\xe7\xf5es de Corre\xe7\xe3o.","items":{"$ref":"#/components/schemas/CteInfCorrecao"},"minItems":1},"id":{"type":"string","description":"ID \xfanico gerado pela API para este evento."},"ambiente":{"type":"string","description":"Identifica\xe7\xe3o do ambiente.","enum":["homologacao","producao"]},"status":{"type":"string","description":"Status do Evento.","enum":["pendente","registrado","rejeitado","erro"]},"autor":{"$ref":"#/components/schemas/DfeAutorEvento"},"chave_acesso":{"type":"string","description":"Chave de Acesso do documento vinculado ao evento."},"data_evento":{"type":"string","format":"date-time","description":"Data e hora do Evento."},"numero_sequencial":{"type":"integer","description":"Sequencial do evento para o mesmo tipo de evento."},"data_recebimento":{"type":"string","format":"date-time","description":"Data e hora do recebimento do Evento pela SEFAZ.","nullable":true},"codigo_status":{"type":"integer","description":"C\xf3digo do status de registro do Evento."},"motivo_status":{"type":"string","description":"Descri\xe7\xe3o literal do status do registro do Evento."},"numero_protocolo":{"type":"string","description":"N\xfamero do Protocolo de registro do Evento."},"codigo_mensagem":{"type":"integer","description":"C\xf3digo da Mensagem."},"mensagem":{"type":"string","description":"Mensagem da SEFAZ para o emissor."},"tipo_evento":{"type":"string"}},"required":["correcoes"]},"MdfeNaoEncerrados":{"type":"object","properties":{"tpAmb":{"type":"integer","description":"Identifica\xe7\xe3o do Ambiente:\\r\\n* 1 - Produ\xe7\xe3o\\r\\n* 2 - Homologa\xe7\xe3o","nullable":true},"verAplic":{"type":"string","description":"Vers\xe3o do Aplicativo que processou o MDF-e.","nullable":true},"cStat":{"type":"integer","description":"C\xf3digo do status da mensagem enviada.","nullable":true},"xMotivo":{"type":"string","description":"Descri\xe7\xe3o literal do status do servi\xe7o solicitado.","nullable":true},"cUF":{"type":"integer","description":"c\xf3digo da UF de atendimento.","nullable":true},"infMDFe":{"type":"array","items":{"$ref":"#/components/schemas/MdfeNaoEncerrado"}}},"required":["cStat"]},"MdfeNaoEncerrado":{"type":"object","properties":{"chMDFe":{"type":"string","description":"Chaves de acesso do MDF-e n\xe3o encerrado.","nullable":true},"nProt":{"type":"string","description":"N\xfamero do Protocolo de autoriza\xe7\xe3o do MDF-e n\xe3o encerrado.","nullable":true}},"required":["nProt","chMDFe"]},"MdfePedidoEmissaoLote":{"type":"object","properties":{"documentos":{"type":"array","items":{"$ref":"#/components/schemas/MdfePedidoEmissao"},"maxItems":1,"minItems":1},"ambiente":{"type":"string","description":"Identifica\xe7\xe3o do Ambiente.","enum":["homologacao","producao"]},"referencia":{"type":"string","description":"Seu identificador para este documento. Opcional, ajuda a evitar o envio duplicado de um mesmo documento.","maxLength":50},"id_lote":{"type":"string"}},"required":["id_lote","ambiente"]},"MdfePedidoEmissao":{"type":"object","properties":{"infMDFe":{"$ref":"#/components/schemas/MdfeSefazInfMDFe"},"infMDFeSupl":{"$ref":"#/components/schemas/MdfeSefazInfMDFeSupl"},"ambiente":{"type":"string","description":"Identifica\xe7\xe3o do Ambiente.","enum":["homologa