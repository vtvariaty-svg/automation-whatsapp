.","maximum":999,"minimum":0,"nullable":true},"nCT":{"type":"integer","description":"N\xfamero do CT-e.","maximum":999999999,"minimum":1,"nullable":true},"dhEmi":{"type":"string","format":"date-time","description":"Data e hora de emiss\xe3o do CT-e.\\r\\nFormato AAAA-MM-DDTHH:MM:DD TZD.","nullable":true},"tpImp":{"type":"integer","description":"Formato de impress\xe3o do DACTE:\\r\\n* 1 - Retrato\\r\\n* 2 - Paisagem","nullable":true},"tpEmis":{"type":"integer","description":"Forma de emiss\xe3o do CT-e.\\r\\nPreencher com:\\r\\n* 1 - Normal\\r\\n* 3 - Regime Especial NFF\\r\\n* 4 - EPEC pela SVC\\r\\n* 5 - Conting\xeancia FSDA\\r\\n* 7 - Autoriza\xe7\xe3o pela SVC-RS\\r\\n* 8 - Autoriza\xe7\xe3o pela SVC-SP","nullable":true},"cDV":{"type":"integer","description":"Digito Verificador da chave de acesso do CT-e.\\r\\nInformar o d\xedgito  de controle da chave de acesso do CT-e, que deve ser calculado com a aplica\xe7\xe3o do algoritmo m\xf3dulo 11 (base 2,9) da chave de acesso.\\r\\n\\r\\n*Geramos automaticamente quando nenhum valor \xe9 informado.*","maximum":9,"minimum":0,"nullable":true},"tpAmb":{"type":"integer","description":"Tipo do Ambiente:\\r\\n* 1 - Produ\xe7\xe3o\\r\\n* 2 - Homologa\xe7\xe3o","nullable":true},"tpCTe":{"type":"integer","description":"Tipo do CT-e.\\r\\nPreencher com:\\r\\n* 0 - CT-e Normal\\r\\n* 1 - CT-e de Complemento de Valores\\r\\n* 3 - CT-e de Substitui\xe7\xe3o","nullable":true},"procEmi":{"type":"integer","description":"Identificador do processo de emiss\xe3o do CT-e.\\r\\nPreencher com:\\r\\n* 0 - emiss\xe3o de CT-e com aplicativo do contribuinte\\r\\n* 3 - emiss\xe3o CT-e pelo contribuinte com aplicativo fornecido pelo SEBRAE","nullable":true},"verProc":{"type":"string","description":"Vers\xe3o do processo de emiss\xe3o.\\r\\nIinformar a vers\xe3o do aplicativo emissor de CT-e.","maxLength":20,"minLength":1,"nullable":true},"indGlobalizado":{"type":"integer","description":"Indicador de CT-e Globalizado.\\r\\nInformar valor 1 quando 