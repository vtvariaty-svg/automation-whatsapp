cription":"Grupo de informa\xe7\xf5es de documento utilizado para Dedu\xe7\xe3o/Redu\xe7\xe3o do valor do servi\xe7o.","properties":{"chNFSe":{"type":"string","description":"Chave de Acesso da NFS-e (Padr\xe3o Nacional).","maxLength":50,"nullable":true},"chNFe":{"type":"string","description":"Chave de Acesso da NF-e.","maxLength":44,"nullable":true},"NFSeMun":{"$ref":"#/components/schemas/DocOutNFSe"},"NFNFS":{"$ref":"#/components/schemas/DocNFNFS"},"nDocFisc":{"type":"string","description":"N\xfamero de documento fiscal.","maxLength":255,"minLength":1,"nullable":true},"nDoc":{"type":"string","description":"N\xfamero de documento n\xe3o fiscal.","maxLength":255,"minLength":1,"nullable":true},"tpDedRed":{"type":"integer","description":"Identifica\xe7\xe3o da Dedu\xe7\xe3o/Redu\xe7\xe3o:\\r\\n* 1 - Alimenta\xe7\xe3o e bebidas/frigobar\\r\\n* 2 - Materiais\\r\\n* 5 - Repasse consorciado\\r\\n* 6 - Repasse plano de sa\xfade\\r\\n* 7 - Servi\xe7os\\r\\n* 8 - Subempreitada de m\xe3o de obra\\r\\n* 99 - Outras dedu\xe7\xf5es","nullable":true},"xDescOutDed":{"type":"string","description":"Descri\xe7\xe3o da Dedu\xe7\xe3o/Redu\xe7\xe3o quando a op\xe7\xe3o \xe9 \\"99 - Outras Dedu\xe7\xf5es\\".","maxLength":150,"minLength":1,"nullable":true},"dtEmiDoc":{"type":"string","format":"date","description":"Data da emiss\xe3o do documento dedut\xedvel. Ano, m\xeas e dia (AAAA-MM-DD).","nullable":true},"vDedutivelRedutivel":{"type":"number","description":"Valor monet\xe1rio total dedut\xedvel/redut\xedvel no documento informado (R$).\\r\\nEste \xe9 o valor total no documento informado que \xe9 pass\xedvel de dedu\xe7\xe3o/redu\xe7\xe3o.","minimum":0,"nullable":true},"vDeducaoReducao":{"type":"number","description":"Valor monet\xe1rio utilizado para dedu\xe7\xe3o/redu\xe7\xe3o do valor do servi\xe7o da NFS-e que est\xe1 sendo emitida (R$).\\r\\nDeve ser menor ou igual ao valor deduz\xedvel/redut\xedvel (vDedutivelRedutivel).","minimum":0,"nullable":true},"fornec":{"$ref":"#/components/schemas/InfoFornecDocDedRed"}},"required":["vDeducaoReducao","vDedutivelRedutivel","dtEmiDoc","tpDedRed"]},"DocOutNFSe":{"type":"object","description":"Grupo de informa\xe7\xf5es de Outras NFS-e (Padr\xe3o anterior de NFS-e).","properties":{"cMunNFSeMun":{"type":"string","description":"C\xf3digo Munic\xedpio emissor da nota eletr\xf4nica municipal (Tabela do IBGE).","nullable":true},"nNFSeMun":{"type":"integer","format":"int64","description":"N\xfamero da nota eletr\xf4nica municipal.","nullable":true},"cVerifNFSeMun":{"type":"string","description":"C\xf3digo de Verifica\xe7\xe3o da nota eletr\xf4nica municipal.","maxLength":9,"minLength":1,"nullable":true}},"required":["cVerifNFSeMun","nNFSeMun","cMunNFSeMun"]},"DocNFNFS":{"type":"object","description":"Grupo de informa\xe7\xf5es de NF ou NFS (Modelo n\xe3o eletr\xf4nico).","properties":{"nNFS":{"type":"integer","description":"N\xfamero da Nota Fiscal NF ou NFS.","maximum":9999999,"minimum":0,"nullable":true},"modNFS":{"type":"integer","format":"int64","description":"Modelo da Nota Fiscal NF ou NFS.","nullable":true},"serieNFS":{"type":"string","description":"S\xe9rie Nota Fiscal NF ou NFS.","maxLength":15,"minLength":1,"nullable":true}},"required":["serieNFS","modNFS","nNFS"]},"InfoFornecDocDedRed":{"type":"object","description":"Grupo de informa\xe7\xf5es do Fornecedor em Dedu\xe7\xf5es de Servi\xe7os.","properties":{"CNPJ":{"type":"string","description":"N\xfamero do CNPJ.","maxLength":14,"nullable":true},"CPF":{"type":"string","description":"N\xfamero do CPF.","maxLength":11,"nullable":true},"NIF":{"type":"string","description":"N\xfamero de Identifica\xe7\xe3o Fiscal fornecido por \xf3rg\xe3o de administra\xe7\xe3o tribut\xe1ria no exterior.","maxLength":40,"minLength":1,"nullable":true},"cNaoNIF":{"type":"integer","description":"Motivo para n\xe3o informa\xe7\xe3o do NIF:\\r\\n* 0 - N\xe3o informado na nota de origem\\r\\n* 1 - Dispensado do NIF\\r\\n* 2 - N\xe3o exig\xeancia do NIF","nullable":true},"CAEPF":{"type":"string","description":"N\xfamero do Cadastro de Atividade Econ\xf4mica da Pessoa F\xedsica (CAEPF) do tomador, intermedi\xe1rio ou fornecedor do servi\xe7o.","maxLength":14,"nullable":true},"IM":{"type":"string","description":"N\xfamero da inscri\xe7\xe3o municipal.","maxLength":15,"minLength":1,"nullable":true},"IE":{"type":"string","description":"N\xfamero da inscri\xe7\xe3o estadual.\\r\\n\\r\\n**Aten\xe7\xe3o**: Para emiss\xf5es pelo Sistema Nacional NFS-e, esse campo \xe9 ignorado.","nullable":true},"xNome":{"type":"string","description":"Nome/Nome Empresarial.","maxLength":300,"minLength":1,"nullable":true},"end":{"$ref":"#/components/schemas/Endereco"},"fone":{"type":"string","description":"N\xfamero do telefone do prestador:\\r\\nPreencher com o C\xf3digo DDD + n\xfamero do telefone.\\r\\nNas opera\xe7\xf5es com exterior \xe9 permitido informar o c\xf3digo do pa\xeds + c\xf3digo da localidade + n\xfamero do telefone).","nullable":true},"email":{"type":"string","description":"* E-mail","maxLength":80,"minLength":1,"nullable":true}},"required":["xNome"]},"InfoTributacao":{"type":"object","description":"Grupo de informa\xe7\xf5es relacionados aos tributos relacionados ao servi\xe7o prestado.","properties":{"tribMun":{"$ref":"#/components/schemas/TribMunicipal"},"tribFed":{"$ref":"#/components/schemas/TribFederal"},"totTrib":{"$ref":"#/components/schemas/TribTotal"}},"required":["tribMun"]},"TribMunicipal":{"type":"object","description":"Grupo de informa\xe7\xf5es relacionados ao Imposto Sobre Servi\xe7os de Qualquer Natureza - ISSQN.","properties":{"tribISSQN":{"type":"integer","description":"Tributa\xe7\xe3o do ISSQN sobre o servi\xe7o prestado:\\r\\n* 1 - Opera\xe7\xe3o tribut\xe1vel\\r\\n* 2 - Imunidade\\r\\n* 3 - Exporta\xe7\xe3o de servi\xe7o\\r\\n* 4 - N\xe3o Incid\xeancia","nullable":true},"cPaisResult":{"type":"string","description":"C\xf3digo do pa\xeds onde se verficou o resultado da presta\xe7\xe3o do servi\xe7o para o caso de Exporta\xe7\xe3o de Servi\xe7o.(Tabela de Pa\xedses ISO).","nullable":true},"tpImunidade":{"type":"integer","description":"Identifica\xe7\xe3o da Imunidade do ISSQN - somente para o caso de Imunidade.\\r\\nTipos de Imunidades:\\r\\n* 0 - Imunidade (tipo n\xe3o informado na nota de origem)\\r\\n* 1 - Patrim\xf4nio, renda ou servi\xe7os, uns dos outros (CF88, Art 150, VI, a)\\r\\n* 2 - Templos de qualquer culto (CF88, Art 150, VI, b)\\r\\n* 3 - Patrim\xf4nio, renda ou servi\xe7os dos partidos pol\xedticos, inclusive suas funda\xe7\xf5es, das entidades sindicais dos trabalhadores, das institui\xe7\xf5es de educa\xe7\xe3o e de assist\xeancia social, sem fins lucrativos, atendidos os requisitos da lei (CF88, Art 150, VI, c)\\r\\n* 4 - Livros, jornais, peri\xf3dicos e o papel destinado a sua impress\xe3o (CF88, Art 150, VI, d)\\r\\n* 5 - Fonogramas e videofonogramas musicais produzidos no Brasil contendo obras musicais ou literomusicais de autores brasileiros e/ou obras em geral interpretadas por artistas brasileiros bem como os suportes materiais ou arquivos digitais que os contenham, salvo na etapa de replica\xe7\xe3o industrial de m\xeddias \xf3pticas de leitura a laser.   (CF88, Art 150, VI, e)","nullable":true},"exigSusp":{"$ref":"#/components/schemas/ExigSuspensa"},"BM":{"$ref":"#/components/schemas/BeneficioMunicipal"},"tpRetISSQN":{"type":"integer","description":"Tipo de retencao do ISSQN:\\r\\n* 1 - N\xe3o Retido\\r\\n* 2 - Retido pelo Tomador\\r\\n* 3 - Retido pelo Intermediario","default":1,"nullable":true},"pAliq":{"type":"number","description":"Valor da al\xedquota (%%) do servi\xe7o prestado relativo ao munic\xedpio sujeito ativo (munic\xedpio de incid\xeancia) do ISSQN.\\r\\n\\r\\n**Observa\xe7\xf5es**:\\r\\n* Se o munic\xedpio de incid\xeancia pertence ao Sistema Nacional NFS-e a al\xedquota estar\xe1 parametrizada e, portanto, ser\xe1 fornecida pelo sistema.\\r\\n* Se o munic\xedpio de incid\xeancia n\xe3o pertence ao Sistema Nacional NFS-e a al\xedquota n\xe3o estar\xe1 parametrizada e, por isso, dever\xe1 ser fornecida pelo emitente.","minimum":0,"nullable":true},"cLocIncid":{"type":"string","description":"C\xf3digo do munic\xedpio de incid\xeancia do ISSQN (tabela do IBGE).\\r\\n\\r\\nCaso o envio seja pelo Sistema Nacional NFS-e, essa propriedade \xe9 ignorada e o munic\xedpio de incid\xeancia do ISSQN \xe9 determinado automaticamente pela SEFIN nacional, conforme regras do aspecto espacial da lei complementar federal (LC 116/03) que s\xe3o v\xe1lidas para todos os munic\xedpios.","nullable":true},"vBC":{"type":"number","description":"Valor da Base de C\xe1lculo do ISSQN (R$).\\r\\n\\r\\nCaso voc\xea n\xe3o informe esse campo, vamos calcul\xe1-lo automaticamente.\\r\\n\\r\\n**Aten\xe7\xe3o**: Para emiss\xf5es pelo Sistema Nacional NFS-e, esse campo \xe9 ignorado e o valor \xe9 determinado automaticamente pela SEFIN nacional.","minimum":0,"nullable":true},"vISSQN":{"type":"number","description":"Valor do ISSQN (R$).\\r\\n\\r\\nCaso voc\xea n\xe3o informe esse campo, vamos calcul\xe1-lo automaticamente.\\r\\n\\r\\n**Aten\xe7\xe3o**: Para emiss\xf5es pelo Sistema Nacional NFS-e, esse campo \xe9 ignorado e o valor \xe9 determinado automaticamente pela SEFIN nacional.","minimum":0,"nullable":true},"vLiq":{"type":"number","description":"Valor L\xedquido (R$).\\r\\n\\r\\nCaso voc\xea n\xe3o informe esse campo, vamos calcul\xe1-lo automaticamente.\\r\\n\\r\\n**Aten\xe7\xe3o**: Para emiss\xf5es pelo Sistema Nacional NFS-e, esse campo \xe9 ignorado e o valor \xe9 determinado automaticamente pela SEFIN nacional.","minimum":0,"nullable":true}},"required":["tribISSQN"]},"ExigSuspensa":{"type":"object","description":"Informa\xe7\xf5es para a suspens\xe3o da Exigibilidade do ISSQN.","properties":{"tpSusp":{"type":"integer","description":"Op\xe7\xe3o para Exigibilidade Suspensa:\\r\\n* 1 - Exigibilidade Suspensa por Decis\xe3o Judicial\\r\\n* 2 - Exigibilidade Suspensa por Processo Administrativo","nullable":true},"nProcesso":{"type":"string","description":"N\xfamero do processo judicial ou administrativo de suspens\xe3o da exigibilidade.","nullable":true}},"required":["nProcesso","tpSusp"]},"BeneficioMunicipal":{"type":"object","description":"Benef\xedcio Municipal","properties":{"tpBM":{"type":"integer","description":"Tipo do Benef\xedcio Municipal:\\r\\n* 1 - Al\xedquota Diferenciada\\r\\n* 2 - Redu\xe7\xe3o da BC\\r\\n* 3 - Isen\xe7\xe3o\\r\\n\\r\\n**Aten\xe7\xe3o**: Para emiss\xf5es pelo Sistema Nacional NFS-e, esse campo \xe9 ignorado.","nullable":true},"nBM":{"type":"string","description":"Identificador do benef\xedcio parametrizado pelo munic\xedpio.\\r\\nTrata-se de um identificador \xfanico que foi gerado pelo Sistema Nacional no momento em que o munic\xedpio de incid\xeancia do ISSQN incluiu o benef\xedcio no sistema.\\r\\nCrit\xe9rio de forma\xe7\xe3o do n\xfamero de identifica\xe7\xe3o de par\xe2metros municipais:\\r\\n7 d\xedgitos - posi\xe7\xe3o 1 a 7: n\xfamero identificador do Munic\xedpio, conforme c\xf3digo IBGE\\r\\n2 d\xedgitos - posi\xe7\xf5es 8 e 9 : n\xfamero identificador do tipo de parametriza\xe7\xe3o (01-legisla\xe7\xe3o, 02-regimes especiais, 03-reten\xe7\xf5es, 04-outros benef\xedcios)\\r\\n5 d\xedgitos - posi\xe7\xe3o 10 a 14 : n\xfamero sequencial definido pelo sistema quando do registro espec\xedfico do par\xe2metro dentro do tipo de parametriza\xe7\xe3o no sistema.","nullable":true},"vRedBCBM":{"type":"number","description":"Valor monet\xe1rio informado pelo emitente para redu\xe7\xe3o da base de c\xe1lculo (BC) do ISSQN devido a um Benef\xedcio Municipal (BM).","minimum":0,"nullable":true},"pRedBCBM":{"type":"number","description":"Valor percentual informado pelo emitente para redu\xe7\xe3o da base de c\xe1lculo (BC) do ISSQN devido a um Benef\xedcio Municipal (BM).","minimum":0,"nullable":true}},"required":["nBM"]},"TribFederal":{"type":"object","description":"Grupo de informa\xe7\xf5es de outros tributos relacionados ao servi\xe7o prestado.","properties":{"piscofins":{"$ref":"#/components/schemas/TribOutrosPisCofins"},"vRetCP":{"type":"number","description":"Valor monet\xe1rio do CP(R$).","minimum":0,"nullable":true},"vRetIRRF":{"type":"number","description":"Valor monet\xe1rio do IRRF (R$).","minimum":0,"nullable":true},"vRetCSLL":{"type":"number","description":"Valor monet\xe1rio do CSLL (R$).","minimum":0,"nullable":true}}},"TribOutrosPisCofins":{"type":"object","description":"Grupo de informa\xe7\xf5es dos tributos PIS/COFINS.","properties":{"CST":{"type":"string","description":"C\xf3digo de Situa\xe7\xe3o Tribut\xe1ria do PIS/COFINS (CST):\\r\\n* 00 - Nenhum\\r\\n* 01 - Opera\xe7\xe3o Tribut\xe1vel com Al\xedquota B\xe1sica\\r\\n* 02 - Opera\xe7\xe3o Tribut\xe1vel com Al\xedquota Diferenciada\\r\\n* 03 - Opera\xe7\xe3o Tribut\xe1vel com Al\xedquota por Unidade de Medida de Produto\\r\\n* 04 - Opera\xe7\xe3o Tribut\xe1vel monof\xe1sica - Revenda a Al\xedquota Zero\\r\\n* 05 - Opera\xe7\xe3o Tribut\xe1vel por Substitui\xe7\xe3o Tribut\xe1ria\\r\\n* 06 - Opera\xe7\xe3o Tribut\xe1vel a Al\xedquota Zero\\r\\n* 07 - Opera\xe7\xe3o Tribut\xe1vel da Contribui\xe7\xe3o\\r\\n* 08 - Opera\xe7\xe3o sem Incid\xeancia da Contribui\xe7\xe3o\\r\\n* 09 - Opera\xe7\xe3o com Suspens\xe3o da Contribui\xe7\xe3o","nullable":true},"vBCPisCofins":{"type":"number","description":"Valor da Base de C\xe1lculo do PIS/COFINS (R$).","minimum":0,"nullable":true},"pAliqPis":{"type":"number","description":"Valor da Al\xedquota do PIS (%%).","minimum":0,"nullable":true},"pAliqCofins":{"type":"number","description":"Valor da Al\xedquota da COFINS (%%).","minimum":0,"nullable":true},"vPis":{"type":"number","description":"Valor monet\xe1rio do PIS (R$).","minimum":0,"nullable":true},"vCofins":{"type":"number","description":"Valor monet\xe1rio do COFINS (R$).","minimum":0,"nullable":true},"tpRetPisCofins":{"type":"integer","description":"Tipo de retencao do Pis/Cofins:\\r\\n* 1 - Retido\\r\\n* 2 - N\xe3o Retido","nullable":true}},"required":["CST"]},"TribTotal":{"type":"object","description":"Grupo de informa\xe7\xf5es para totais aproximados dos tributos relacionados ao servi\xe7o prestado.","properties":{"vTotTrib":{"$ref":"#/components/schemas/TribTotalMonet"},"pTotTrib":{"$ref":"#/components/schemas/TribTotalPercent"},"indTotTrib":{"type":"integer","description":"Indicador de informa\xe7\xe3o de valor total de tributos. Possui valor fixo igual a zero (indTotTrib=0).\\r\\nN\xe3o informar nenhum valor estimado para os Tributos (Decreto 8.264/2014).\\r\\n* 0 - N\xe3o","nullable":true},"pTotTribSN":{"type":"number","description":"Valor percentual aproximado do total dos tributos da al\xedquota do Simples Nacional (%%).","minimum":0,"nullable":true}}},"TribTotalMonet":{"type":"object","description":"Valor monet\xe1rio total aproximado dos tributos, em conformidade com o artigo 1o da Lei no 12.741/2012.","properties":{"vTotTribFed":{"type":"number","description":"Valor monet\xe1rio total aproximado dos tributos federais (R$).","minimum":0,"nullable":true},"vTotTribEst":{"type":"number","description":"Valor monet\xe1rio total aproximado dos tributos estaduais (R$).","minimum":0,"nullable":true},"vTotTribMun":{"type":"number","description":"Valor monet\xe1rio total aproximado dos tributos municipais (R$).","minimum":0,"nullable":true}},"required":["vTotTribMun","vTotTribEst","vTotTribFed"]},"TribTotalPercent":{"type":"object","description":"Valor percentual total aproximado dos tributos, em conformidade com o artigo 1o da Lei no 12.741/2012.","properties":{"pTotTribFed":{"type":"number","description":"Valor percentual total aproximado dos tributos federais (%%).","minimum":0,"nullable":true},"pTotTribEst":{"type":"number","description":"Valor percentual total aproximado dos tributos estaduais (%%).","minimum":0,"nullable":true},"pTotTribMun":{"type":"number","description":"Valor percentual total aproximado dos tributos municipais (%%).","minimum":0,"nullable":true}},"required":["pTotTribMun","pTotTribEst","pTotTribFed"]},"RTCInfoIBSCBS":{"type":"object","description":"Grupo de informa\xe7\xf5es declaradas pelo emitente referentes ao IBS e \xe0 CBS.","properties":{"finNFSe":{"type":"integer","description":"Indicador da finalidade da emiss\xe3o de NFS-e:\\r\\n* 0 - NFS-e regular.","nullable":true},"indFinal":{"type":"integer","description":"Indica opera\xe7\xe3o de uso ou consumo pessoal (art. 57):\\r\\n* 0 - N\xe3o;\\r\\n* 1 - Sim.","nullable":true},"cIndOp":{"type":"string","description":"C\xf3digo indicador da opera\xe7\xe3o de fornecimento, conforme tabela \\"c\xf3digo indicador de opera\xe7\xe3o\\".","nullable":true},"tpOper":{"type":"integer","description":"Tipo de Opera\xe7\xe3o com Entes Governamentais ou outros servi\xe7os sobre bens im\xf3veis:\\r\\n* 1 \u2013 Fornecimento com pagamento posterior;\\r\\n* 2 - Recebimento do pagamento com fornecimento j\xe1 realizado;\\r\\n* 3 \u2013 Fornecimento com pagamento j\xe1 realizado;\\r\\n* 4 \u2013 Recebimento do pagamento com fornecimento posterior;\\r\\n* 5 \u2013 Fornecimento e recebimento do pagamento concomitantes.","nullable":true},"gRefNFSe":{"$ref":"#/components/schemas/InfoRefNFSe"},"tpEnteGov":{"type":"integer","description":"Tipo de ente governamental\\r\\nPara administra\xe7\xe3o p\xfablica direta e suas autarquias e funda\xe7\xf5es:\\r\\n* 1 - Uni\xe3o;\\r\\n* 2 - Estado;\\r\\n* 3 - Distrito Federal;\\r\\n* 4 - Munic\xedpio.","nullable":true},"indDest":{"type":"integer","description":"A respeito do Destinat\xe1rio dos servi\xe7os:\\r\\n* 0 \u2013 O destinat\xe1rio \xe9 o pr\xf3prio tomador/adquirente identificado na NFS-e (tomador = adquirente = destinat\xe1rio);\\r\\n* 1 \u2013 O destinat\xe1rio n\xe3o \xe9 o pr\xf3prio adquirente, podendo ser outra pessoa, f\xedsica ou jur\xeddica (ou equiparada), ou um estabelecimento diferente do indicado como tomador (tomador = adquirente != destinat\xe1rio).","nullable":true},"dest":{"$ref":"#/components/schemas/RTCInfoDest"},"imovel":{"$ref":"#/components/schemas/RTCInfoImovel"},"valores":{"$ref":"#/components/schemas/RTCInfoValoresIBSCBS"}},"required":["valores","indDest","cIndOp","indFinal","finNFSe"]},"InfoRefNFSe":{"type":"object","description":"Grupo de NFS-e referenciadas.","properties":{"refNFSe":{"type":"array","description":"Chave da NFS-e referenciada.","items":{"type":"string"},"maxItems":99,"minItems":1}},"required":["refNFSe"]},"RTCInfoDest":{"type":"object","description":"Grupo de informa\xe7\xf5es relativas ao Destinat\xe1rio.","properties":{"CNPJ":{"type":"string","description":"N\xfamero da inscri\xe7\xe3o no Cadastro Nacional de Pessoa Jur\xeddica (CNPJ) do Destinat\xe1rio do servi\xe7o.","maxLength":14,"nullable":true},"CPF":{"type":"string","description":"N\xfamero da inscri\xe7\xe3o no Cadastro de Pessoa F\xedsica (CPF) do Destinat\xe1rio do servi\xe7o.","maxLength":11,"nullable":true},"NIF":{"type":"string","description":"N\xfamero de Identifica\xe7\xe3o Fiscal fornecido por \xf3rg\xe3o de administra\xe7\xe3o tribut\xe1ria no exterior.","maxLength":40,"minLength":1,"nullable":true},"cNaoNIF":{"type":"integer","description":"Motivo para n\xe3o informa\xe7\xe3o do NIF:\\r\\n* 0 - N\xe3o informado na nota de origem\\r\\n* 1 - Dispensado do NIF\\r\\n* 2 - N\xe3o exig\xeancia do NIF","nullable":true},"xNome":{"type":"string","description":"Nome / Nome Empresarial do do Destinat\xe1rio do servi\xe7o.","maxLength":150,"minLength":1,"nullable":true},"end":{"$ref":"#/components/schemas/Endereco"},"fone":{"type":"string","description":"N\xfamero do telefone do Destinat\xe1rio do servi\xe7o\\r\\n(Preencher com o C\xf3digo DDD + n\xfamero do telefone. Nas opera\xe7\xf5es com exterior \xe9 permitido informar o\\r\\nc\xf3digo do pa\xeds + c\xf3digo da localidade + n\xfamero do telefone).","nullable":true},"email":{"type":"string","description":"* E-mail do Destinat\xe1rio do servi\xe7o","maxLength":80,"minLength":1,"nullable":true}},"required":["xNome"]},"RTCInfoImovel":{"type":"object","description":"Grupo de informa\xe7\xf5es de opera\xe7\xf5es relacionadas a bens im\xf3veis, exceto obras.","properties":{"inscImobFisc":{"type":"string","description":"Inscri\xe7\xe3o imobili\xe1ria fiscal (c\xf3digo fornecido pela Prefeitura Municipal para a identifica\xe7\xe3o da obra ou para fins de recolhimento do IPTU).","maxLength":30,"minLength":1,"nullable":true},"cCIB":{"type":"string","description":"C\xf3digo do Cadastro Imobili\xe1rio Brasileiro - CIB.","maxLength":8,"nullable":true},"end":{"$ref":"#/components/schemas/EnderObraEvento"}}},"RTCInfoValoresIBSCBS":{"type":"object","description":"Grupo de informa\xe7\xf5es relativas aos valores do servi\xe7o prestado para IBS e CBS.","properties":{"gReeRepRes":{"$ref":"#/components/schemas/RTCInfoReeRepRes"},"trib":{"$ref":"#/components/schemas/RTCInfoTributosIBSCBS"}},"required":["trib"]},"RTCInfoReeRepRes":{"type":"object","description":"Grupo de informa\xe7\xf5es relativas a valores inclu\xeddos neste documento e recebidos por motivo de estarem relacionadas\\r\\na opera\xe7\xf5es de terceiros, objeto de reembolso, repasse ou ressarcimento pelo recebedor, j\xe1 tributados e aqui referenciados.","properties":{"documentos":{"type":"array","items":{"$ref":"#/components/schemas/RTCListaDoc"},"maxItems":1000,"minItems":1}},"required":["documentos"]},"RTCListaDoc":{"type":"object","description":"Grupo relativo aos documentos referenciados nos casos de reembolso, repasse e ressarcimento que ser\xe3o\\r\\nconsiderados na base de c\xe1lculo do ISSQN, do IBS e da CBS.","properties":{"dFeNacional":{"$ref":"#/components/schemas/RTCListaDocDFe"},"docFiscalOutro":{"$ref":"#/components/schemas/RTCListaDocFiscalOutro"},"docOutro":{"$ref":"#/components/schemas/RTCListaDocOutro"},"fornec":{"$ref":"#/components/schemas/RTCListaDocFornec"},"dtEmiDoc":{"type":"string","format":"date","description":"Data da emiss\xe3o do documento dedut\xedvel\\r\\nAno, m\xeas e dia (AAAA-MM-DD).","nullable":true},"dtCompDoc":{"type":"string","format":"date","description":"Data da compet\xeancia do documento dedut\xedvel\\r\\nAno, m\xeas e dia (AAAA-MM-DD).","nullable":true},"tpReeRepRes":{"type":"string","description":"Tipo de valor inclu\xeddo neste documento, recebido por motivo de estarem relacionadas a opera\xe7\xf5es de terceiros,\\r\\nobjeto de reembolso, repasse ou ressarcimento pelo recebedor, j\xe1 tributados e aqui referenciados.","nullable":true},"xTpReeRepRes":{"type":"string","description":"Descri\xe7\xe3o do reembolso ou ressarcimento quando a op\xe7\xe3o \xe9\\r\\n\\"99 - Outros reembolsos ou ressarcimentos recebidos por valores pagos relativos a opera\xe7\xf5es por conta e ordem de terceiro\\".","maxLength":150,"minLength":1,"nullable":true},"vlrReeRepRes":{"type":"number","description":"Valor monet\xe1rio (total ou parcial, conforme documento informado) utilizado para n\xe3o inclus\xe3o na base de c\xe1lculo\\r\\ndo ISS e do IBS e da CBS da NFS-e que est\xe1 sendo emitida (R$).","minimum":0,"nullable":true}},"required":["vlrReeRepRes","tpReeRepRes","dtCompDoc","dtEmiDoc"]},"RTCListaDocDFe":{"type":"object","description":"Grupo de informa\xe7\xf5es de documentos fiscais eletr\xf4nicos que se encontram no reposit\xf3rio nacional.","properties":{"tipoChaveDFe":{"type":"integer","description":"Documento fiscal a que se refere a chaveDfe que seja um dos documentos do Reposit\xf3rio Nacional.","nullable":true},"xTipoChaveDFe":{"type":"string","description":"Descri\xe7\xe3o da DF-e a que se refere a chaveDfe que seja um dos documentos do Reposit\xf3rio Nacional\\r\\nDeve ser preenchido apenas quando \\"tipoChaveDFe = 9 (Outro)\\".","maxLength":255,"minLength":1,"nullable":true},"chaveDFe":{"type":"string","description":"Chave do Documento Fiscal eletr\xf4nico do reposit\xf3rio nacional referenciado para os casos de opera\xe7\xf5es j\xe1 tributadas.","maxLength":50,"minLength":1,"nullable":true}},"required":["chaveDFe","tipoChaveDFe"]},"RTCListaDocFiscalOutro":{"type":"object","description":"Grupo de informa\xe7\xf5es de documento fiscais, eletr\xf4nicos ou n\xe3o, que n\xe3o se encontram no reposit\xf3rio nacional.","properties":{"cMunDocFiscal":{"type":"integer","description":"C\xf3digo do munic\xedpio emissor do documento fiscal que n\xe3o se encontra no reposit\xf3rio nacional.","maximum":9999999,"minimum":0,"nullable":true},"nDocFiscal":{"type":"string","description":"N\xfamero do documento fiscal que n\xe3o se encontra no reposit\xf3rio nacional.","maxLength":255,"minLength":1,"nullable":true},"xDocFiscal":{"type":"string","description":"Descri\xe7\xe3o do documento fiscal.","maxLength":255,"minLength":1,"nullable":true}},"required":["xDocFiscal","nDocFiscal","cMunDocFiscal"]},"RTCListaDocOutro":{"type":"object","description":"Grupo de informa\xe7\xf5es de documento n\xe3o fiscal.","properties":{"nDoc":{"type":"string","description":"N\xfamero do documento n\xe3o fiscal.","maxLength":255,"minLength":1,"nullable":true},"xDoc":{"type":"string","description":"Descri\xe7\xe3o do documento n\xe3o fiscal.","maxLength":255,"minLength":1,"nullable":true}},"required":["xDoc","nDoc"]},"RTCListaDocFornec":{"type":"object","description":"Grupo de informa\xe7\xf5es do fornecedor do documento referenciado.","properties":{"CNPJ":{"type":"string","description":"N\xfamero da inscri\xe7\xe3o no Cadastro Nacional de Pessoa Jur\xeddica (CNPJ) do Fornecedor do servi\xe7o.","maxLength":14,"nullable":true},"CPF":{"type":"string","description":"N\xfamero da inscri\xe7\xe3o no Cadastro de Pessoa F\xedsica (CPF) do Fornecedor do servi\xe7o.","maxLength":11,"nullable":true},"NIF":{"type":"string","description":"Este elemento s\xf3 dever\xe1 ser preenchido para fornecedores n\xe3o residentes no Brasil.","maxLength":40,"minLength":1,"nullable":true},"cNaoNIF":{"type":"integer","description":"Motivo para n\xe3o informa\xe7\xe3o do NIF:\\r\\n* 0 - N\xe3o informado na nota de origem\\r\\n* 1 - Dispensado do NIF\\r\\n* 2 - N\xe3o exig\xeancia do NIF","nullable":true},"xNome":{"type":"string","description":"Nome / Raz\xe3o Social do do Fornecedor do servi\xe7o.","maxLength":150,"minLength":1,"nullable":true}},"required":["xNome"]},"RTCInfoTributosIBSCBS":{"type":"object","description":"Grupo de informa\xe7\xf5es relacionados aos tributos IBS e CBS.","properties":{"gIBSCBS":{"$ref":"#/components/schemas/RTCInfoTributosSitClas"}},"required":["gIBSCBS"]},"RTCInfoTributosSitClas":{"type":"object","description":"Grupo de informa\xe7\xf5es relacionadas ao IBS e \xe0 CBS.","properties":{"CST":{"type":"string","description":"C\xf3digo de Situa\xe7\xe3o Tribut\xe1ria do IBS e da CBS.","nullable":true},"cClassTrib":{"type":"string","description":"C\xf3digo de Classifica\xe7\xe3o Tribut\xe1ria do IBS e da CBS.","nullable":true},"cCredPres":{"type":"string","description":"C\xf3digo e Classifica\xe7\xe3o do Cr\xe9dito Presumido: IBS e CBS.","nullable":true},"gTribRegular":{"$ref":"#/components/schemas/RTCInfoTributosTribRegular"},"gDif":{"$ref":"#/components/schemas/RTCInfoTributosDif"}},"required":["cClassTrib","CST"]},"RTCInfoTributosTribRegular":{"type":"object","description":"Grupo de informa\xe7\xf5es da Tributa\xe7\xe3o Regular.","properties":{"CSTReg":{"type":"string","description":"C\xf3digo de Situa\xe7\xe3o Tribut\xe1ria do IBS e da CBS de tributa\xe7\xe3o regular.","nullable":true},"cClassTribReg":{"type":"string","description":"C\xf3digo da Classifica\xe7\xe3o Tribut\xe1ria do IBS e da CBS de tributa\xe7\xe3o regular.","nullable":true}},"required":["cClassTribReg","CSTReg"]},"RTCInfoTributosDif":{"type":"object","description":"Grupo de informa\xe7\xf5es relacionadas ao diferimento para IBS e CBS.","properties":{"pDifUF":{"type":"number","description":"Percentual de diferimento para o IBS estadual.","minimum":0,"nullable":true},"pDifMun":{"type":"number","description":"Percentual de diferimento para o IBS municipal.","minimum":0,"nullable":true},"pDifCBS":{"type":"number","description":"Percentual de diferimento para a CBS.","minimum":0,"nullable":true}},"required":["pDifCBS","pDifMun","pDifUF"]},"RpsLoteListagem":{"type":"object","properties":{"@count":{"type":"integer"},"data":{"type":"array","items":{"$ref":"#/components/schemas/RpsLote"}}}},"NfsePedidoEmissao":{"type":"object","properties":{"ambiente":{"type":"string","description":"Identifica\xe7\xe3o do Ambiente.","enum":["homologacao","producao"]},"rps":{"$ref":"#/components/schemas/RpsPedidoEmissao"}},"required":["rps","ambiente"]},"NfseListagem":{"type":"object","properties":{"@count":{"type":"integer"},"data":{"type":"array","items":{"$ref":"#/components/schemas/Nfse"}}}},"NfsePedidoCancelamento":{"type":"object","properties":{"codigo":{"type":"string","description":"C\xf3digo de cancelamento, exigido por algumas prefeituras.\\r\\nPara saber quais valores s\xe3o aceitos, consulte o manual da prefeitura."},"motivo":{"type":"string","description":"Motivo de cancelamento, exigido por algumas prefeituras."}}},"NfsePedidoSincronizacao":{"type":"object","properties":{"identificador":{"type":"string","description":"Identificador utilizado na consulta da situa\xe7\xe3o atual da NFS-e.\\r\\n\\r\\nO valor desse campo \xe9 opcional para as prefeituras que suportem consultas por n\xfamero e s\xe9rie do RPS.\\r\\nPara as demais, esse campo torna-se obrigat\xf3rio e o seu valor pode ser a chave de acesso, n\xfamero da NFS-e, chave de verifica\xe7\xe3o, protocolo ou outro identificador da nota a depender da prefeitura."}}},"NfseSincronizacao":{"type":"object","properties":{"status":{"type":"string","description":"Situa\xe7\xe3o atual da sincroniza\xe7\xe3o.","enum":["pendente","sincronizado","erro"]},"mensagens":{"type":"array","items":{"$ref":"#/components/schemas/NfseMensagemRetorno"}}}},"DfeDebug":{"type":"object","properties":{"id":{"type":"string","description":"Identificador do documento fiscal."},"tipo":{"type":"string","description":"Tipo do documento: nfe, nfce, mdfe, nfse, etc."},"created_at":{"type":"string","format":"date-time","description":"Data e hora da cria\xe7\xe3o do documento, representada no formato UTC (Tempo Universal Coordenado).\\r\\nO valor \xe9 retornado no padr\xe3o ISO 8601, incluindo o deslocamento de fuso hor\xe1rio \'Z\' no final.\\r\\n\\r\\nExemplo: \\"2025-04-15T14:16:47.775Z\\""},"requisicoes":{"type":"array","description":"Lista de requisi\xe7\xf5es feitas ao autorizador durante o processamento.","items":{"$ref":"#/components/schemas/DfeRequisicaoDebug"}}}},"DfeRequisicaoDebug":{"type":"object","properties":{"created_at":{"type":"string","format":"date-time","description":"Data e hora da cria\xe7\xe3o da requisi\xe7\xe3o, representada no formato UTC (Tempo Universal Coordenado).\\r\\nO valor \xe9 retornado no padr\xe3o ISO 8601, incluindo o deslocamento de fuso hor\xe1rio \'Z\' no final.\\r\\n\\r\\nExemplo: \\"2025-04-15T14:16:47.775Z\\""},"tipo":{"type":"string","description":"Tipo da opera\xe7\xe3o realizada na requisi\xe7\xe3o para o autorizador.\\r\\nPode assumir um dos seguintes valores:\\r\\n- \'envio_lote\'      : envio do lote de documentos fiscais para autoriza\xe7\xe3o;\\r\\n- \'consulta_lote\'   : consulta do processamento do lote;\\r\\n- \'cons_sit_dfe\'    : consulta de situa\xe7\xe3o individual de um DFe.\\r\\n\\r\\nEsse campo indica a natureza da intera\xe7\xe3o com a SEFAZ ou prefeitura,\\r\\ne \xe9 \xfatil para fins de rastreamento e diagn\xf3stico do fluxo."},"lote_id":{"type":"string","description":"Identificador do lote vinculado \xe0 requisi\xe7\xe3o."},"codigo_status":{"type":"integer","description":"C\xf3digo de status retornado pela SEFAZ/prefeitura."},"motivo_status":{"type":"string","description":"Motivo associado ao status retornado."},"http_request":{"$ref":"#/components/schemas/HttpRequestDebug"}}},"HttpRequestDebug":{"type":"object","description":"Detalhes t\xe9cnicos da requisi\xe7\xe3o HTTP realizada ao autorizador.","properties":{"id":{"type":"string","description":"Identificador interno da requisi\xe7\xe3o HTTP.\\r\\n\\r\\nEsse identificador pode ser utilizado no endpoint\\r\\n<a href=\\"#tag/Debug/operation/DebugHttpRequestContent\\">Corpo da Requisi\xe7\xe3o HTTP</a> ou <a href=\\"#tag/Debug/operation/DebugHttpResponseContent\\">Corpo da Resposta HTTP</a>\\r\\npara obter o conte\xfado enviado ou recebido na comunica\xe7\xe3o com o autorizador."},"method":{"type":"string","description":"M\xe9todo HTTP utilizado (ex: \'POST\')."},"uri":{"type":"string","description":"URI do servi\xe7o externo (SEFAZ, prefeitura, etc.)."},"headers":{"type":"string","description":"Cabe\xe7alhos HTTP enviados na requisi\xe7\xe3o, no formato bruto."},"response_status_code":{"type":"integer","description":"C\xf3digo de status HTTP retornado (ex: 200, 403)."},"response_status_reason":{"type":"string","description":"Motivo ou descri\xe7\xe3o do status HTTP retornado."},"response_headers":{"type":"string","description":"Cabe\xe7alhos retornados na resposta, no formato bruto."},"response_time":{"type":"integer","description":"Tempo de resposta do servi\xe7o externo, em milissegundos."}}},"DcePedidoEmissao":{"type":"object","properties":{"infDCe":{"$ref":"#/components/schemas/DceSefazInfDCe"},"infSolicDCe":{"$ref":"#/components/schemas/DceSefazInfSolicDCe"},"ambiente":{"type":"string","description":"Identifica\xe7\xe3o do Ambiente.","enum":["homologacao","producao"]},"referencia":{"type":"string","description":"Seu identificador \xfanico para este documento. Opcional, ajuda a evitar o envio duplicado de um mesmo documento.","maxLength":50,"nullable":true}},"required":["ambiente","infSolicDCe","infDCe"]},"DceSefazInfDCe":{"type":"object","description":"Informa\xe7\xf5es da DCe.","properties":{"versao":{"type":"string","description":"Vers\xe3o do leiaute.","nullable":true},"Id":{"type":"string","description":"Identificador da tag a ser assinada.\\r\\nInformar a chave de acesso precedida do literal \\"DCe\\".\\r\\n\\r\\n*Geramos automaticamente quando nenhum valor \xe9 informado.*","nullable":true},"ide":{"$ref":"#/components/schemas/DceSefazIde"},"emit":{"$ref":"#/components/schemas/DceSefazEmit"},"Fisco":{"$ref":"#/components/schemas/DceSefazFisco"},"Marketplace":{"$ref":"#/components/schemas/DceSefazMarketplace"},"Transportadora":{"$ref":"#/components/schemas/DceSefazTransportadora"},"ECT":{"$ref":"#/components/schemas/DceSefazECT"},"dest":{"$ref":"#/components/schemas/DceSefazDest"},"autXML":{"type":"array","items":{"$ref":"#/components/schemas/DceSefazAutXML"},"maxItems":10},"det":{"type":"array","items":{"$ref":"#/components/schemas/DceSefazDet"},"maxItems":999,"minItems":1},"total":{"$ref":"#/components/schemas/DceSefazTotal"},"transp":{"$ref":"#/components/schemas/DceSefazTransp"},"infAdic":{"$ref":"#/components/schemas/DceSefazInfAdic"},"infDec":{"$ref":"#/components/schemas/DceSefazInfDec"}},"required":["transp","total","det","dest","emit","ide","versao"]},"DceSefazIde":{"type":"object","description":"Identifica\xe7\xe3o da DCe.","properties":{"cUF":{"type":"integer","description":"C\xf3digo da UF de emiss\xe3o e autoriza\xe7\xe3o da DCe.\\r\\nC\xf3digo da UF de emiss\xe3o e autoriza\xe7\xe3o do Documento Fiscal. Utilizar a\\r\\nTabela do IBGE de c\xf3digo de unidades da federa\xe7\xe3o.","nullable":true},"cDC":{"type":"string","description":"C\xf3digo num\xe9rico que comp\xf5e a Chave de Acesso.\\r\\nC\xf3digo aleat\xf3rio gerado pelo emitente, com o objetivo de evitar acessos indevidos ao documento.\\r\\n\\r\\n*Geramos automaticamente quando nenhum valor \xe9 informado.*","nullable":true},"mod":{"type":"integer","description":"Modelo da DCe.\\r\\nUtilizar o c\xf3digo 99 para identifica\xe7\xe3o da DCe.","nullable":true},"serie":{"type":"integer","description":"S\xe9rie do documento fiscal.\\r\\nInformar a s\xe9rie do documento fiscal (informar zero para s\xe9rie \xfanica).","maximum":999,"minimum":0,"nullable":true},"nDC":{"type":"integer","description":"N\xfamero do documento fiscal.\\r\\nN\xfamero que identifica o documento fiscal 1 a 999999999.","maximum":999999999,"minimum":1,"nullable":true},"dhEmi":{"type":"string","format":"date-time","description":"Data e hora de emiss\xe3o do documento fiscal.\\r\\nFormato UTC (AAAA-MM-DDThh:mm:ssTZD, onde TZD = +hh:mm ou -hh:mm).","nullable":true},"tpEmis":{"type":"integer","description":"Forma de emiss\xe3o do Documento Fiscal.\\r\\n* 1 - Normal (n\xe3o conting\xeancia)\\r\\n* 9 - Conting\xeancia off-line da DCe","nullable":true},"tpEmit":{"type":"integer","description":"Tipo do Emitente da DCe.\\r\\n* 0 - App Fisco\\r\\n* 1 - Marketplace\\r\\n* 2 - Emissor pr\xf3prio\\r\\n* 3 - Transportadora\\r\\n* 4 - ECT","maximum":4,"minimum":0,"nullable":true},"nSiteAutoriz":{"type":"integer","description":"Identifica\xe7\xe3o do n\xfamero do Site do Autorizador de recep\xe7\xe3o da DCe.\\r\\nSe o autorizador da DCe possuir apenas um site dever\xe1 ser informado com Zero (0), em caso de Autorizador trabalhar com m\xfaltiplos sites indicar o n\xfamero do site para qual foi endere\xe7ada a DCE (1 a 9).\\r\\nObserva\xe7\xe3o: o ambiente autorizador que trabalhar com mais de um Site dever\xe1 divulgar para cada endere\xe7o de site qual n\xfamero correspondente de nSiteAutoriz o contribuinte pode usar.","maximum":9,"minimum":0,"nullable":true},"cDV":{"type":"integer","description":"Digito verificador da chave de acesso.\\r\\nInformar o d\xedgito de controle da chave de acesso documento fiscal, que deve ser calculado com a aplica\xe7\xe3o do algoritmo m\xf3dulo 11 (base 2,9) da chave de acesso.\\r\\n\\r\\n*Geramos automaticamente quando nenhum valor \xe9 informado.*","maximum":9,"minimum":0,"nullable":true},"tpAmb":{"type":"integer","description":"Tipo do Ambiente:\\r\\n* 1 - Produ\xe7\xe3o\\r\\n* 2 - Homologa\xe7\xe3o","nullable":true},"verProc":{"type":"string","description":"Vers\xe3o do processo de emiss\xe3o.\\r\\nInformar a vers\xe3o do aplicativo emissor de DCe.","maxLength":20,"minLength":1,"nullable":true}},"required":["verProc","nSiteAutoriz","tpEmit","tpEmis","dhEmi","nDC","serie","cUF"]},"DceSefazEmit":{"type":"object","description":"Identifica\xe7\xe3o da DCe.","properties":{"CNPJ":{"type":"string","description":"N\xfamero do CNPJ do emitente.","nullable":true},"CPF":{"type":"string","description":"N\xfamero do CPF do emitente.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true},"xNome":{"type":"string","description":"Raz\xe3o social ou Nome do emitente.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":2,"nullable":true},"enderEmit":{"$ref":"#/components/schemas/DceSefazEndeEmi"}}},"DceSefazEndeEmi":{"type":"object","description":"Endere\xe7o do emitente.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","properties":{"xLgr":{"type":"string","description":"Logradouro.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":2,"nullable":true},"nro":{"type":"string","description":"N\xfamero.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":1,"nullable":true},"xCpl":{"type":"string","description":"Complemento.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":1,"nullable":true},"xBairro":{"type":"string","description":"Bairro.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":2,"nullable":true},"cMun":{"type":"string","description":"C\xf3digo do munic\xedpio (utilizar a tabela do IBGE).\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","nullable":true},"xMun":{"type":"string","description":"Nome do munic\xedpio.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","maxLength":60,"minLength":2,"nullable":true},"UF":{"type":"string","description":"Sigla da UF.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o do cadastro da empresa.*","nullable":true},"CEP":{"type":"string","description":"CEP.\\r\