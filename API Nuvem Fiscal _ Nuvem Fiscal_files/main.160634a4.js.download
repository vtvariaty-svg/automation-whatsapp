a sem hora definida.","properties":{"tpHor":{"type":"integer","description":"Tipo de hora.\\r\\n* 0 - Sem hora definida","nullable":true}},"required":["tpHor"]},"CteSefazComHora":{"type":"object","description":"Entrega com hora definida.","properties":{"tpHor":{"type":"integer","description":"Tipo de hora.\\r\\nPreencher com:\\r\\n* 1 - No hor\xe1rio\\r\\n* 2 - At\xe9 o hor\xe1rio\\r\\n* 3 - A partir do hor\xe1rio","nullable":true},"hProg":{"type":"string","description":"Hora programada.\\r\\nFormato HH:MM:SS.","nullable":true}},"required":["hProg","tpHor"]},"CteSefazNoInter":{"type":"object","description":"Entrega no intervalo de hor\xe1rio definido.","properties":{"tpHor":{"type":"integer","description":"Tipo de hora.\\r\\n* 4 - No intervalo de tempo","nullable":true},"hIni":{"type":"string","description":"Hora inicial.\\r\\nFormato HH:MM:SS.","nullable":true},"hFim":{"type":"string","description":"Hora final.\\r\\nFormato HH:MM:SS.","nullable":true}},"required":["hFim","hIni","tpHor"]},"CteSefazObsCont":{"type":"object","description":"Campo de uso livre do contribuinte.\\r\\nInformar o nome do campo no atributo xCampo e o conte\xfado do campo no XTexto.","properties":{"xCampo":{"type":"string","description":"Identifica\xe7\xe3o do campo.","maxLength":20,"minLength":1,"nullable":true},"xTexto":{"type":"string","description":"Conte\xfado do campo.","maxLength":160,"minLength":1,"nullable":true}},"required":["xTexto","xCampo"]},"CteSefazObsFisco":{"type":"object","description":"Campo de uso livre do contribuinte.\\r\\nInformar o nome do campo no atributo xCampo e o conte\xfado do campo no XTexto.","properties":{"xCampo":{"type":"string","description":"Identifica\xe7\xe3o do campo.","maxLength":20,"minLength":1,"nullable":true},"xTexto":{"type":"string","description":"Conte\xfado do campo.","maxLength":60,"minLength":1,"nullable":true}},"required":["xTexto","xCampo"]},"CteSefazEmit":{"type":"object","description":"Identifica\xe7\xe3o do Emitente do CT-e.","properties