t":"date-time","description":"Data e hora da emiss\xe3o do DPS. Data e hora no formato UTC (Universal Coordinated Time): AAAA-MM-DDThh:mm:ssTZD.","nullable":true},"verAplic":{"type":"string","description":"Vers\xe3o do aplicativo que gerou o DPS.","maxLength":20,"minLength":1,"nullable":true},"dCompet":{"type":"string","format":"date","description":"Data em que se iniciou a presta\xe7\xe3o do servi\xe7o: Dia, m\xeas e ano (AAAAMMDD). (AAAA-MM-DDThh:mm:ssTZD).\\r\\n\\r\\n\\r\\n*Geramos automaticamente quando nenhum valor \xe9 informado.*","nullable":true},"cMotivoEmisTI":{"type":"integer","description":"Motivo da Emiss\xe3o da DPS pelo Tomador/Intermedi\xe1rio:\\r\\n* 1 - Importa\xe7\xe3o de Servi\xe7o\\r\\n* 2 - Tomador/Intermedi\xe1rio obrigado a emitir NFS-e por legisla\xe7\xe3o municipal\\r\\n* 3 - Tomador/Intermedi\xe1rio emitindo NFS-e por recusa de emiss\xe3o pelo prestador\\r\\n* 4 - Tomador/Intermedi\xe1rio emitindo por rejeitar a NFS-e emitida pelo prestador","nullable":true},"chNFSeRej":{"type":"string","description":"Chave de Acesso da NFS-e rejeitada pelo Tomador/Intermedi\xe1rio.","maxLength":50,"nullable":true},"subst":{"$ref":"#/components/schemas/Substituicao"},"prest":{"$ref":"#/components/schemas/InfoPrestador"},"toma":{"$ref":"#/components/schemas/InfoTomador"},"interm":{"$ref":"#/components/schemas/InfoIntermediario"},"serv":{"$ref":"#/components/schemas/Serv"},"valores":{"$ref":"#/components/schemas/InfoValores"},"IBSCBS":{"$ref":"#/components/schemas/RTCInfoIBSCBS"}},"required":["valores","serv","prest","dhEmi"]},"Substituicao":{"type":"object","description":"Dados da NFS-e a ser substitu\xedda.","properties":{"chSubstda":{"type":"string","description":"Chave de acesso da NFS-e a ser substitu\xedda.","maxLength":50,"nullable":true},"cMotivo":{"type":"string","description":"C\xf3digo de justificativa para substitui\xe7\xe3o de NFS-e:\\r\\n* 01 - Desenquadramento de NFS-e do Simples Nacional\\r\\n* 02 - Enquadramento de NFS-e no Simples Nacional\\r\\n* 03 - Inclus\xe3o Retroativa de Imunidade/Isen\xe7\xe3o para NFS-e\\r\\n* 04 - Exclus\xe3o Retroativa de Imunidade/Isen\xe7\xe3o para NFS-e\\r\\n* 05 - Rejei\xe7\xe3o de NFS-e pelo tomador ou pelo intermedi\xe1rio se respons\xe1vel pelo recolhimento do tributo\\r\\n* 99 - Outros","nullable":true},"xMotivo":{"type":"string","description":"Descri\xe7\xe3o do motivo da substitui\xe7\xe3o da NFS-e.","maxLength":255,"minLength":15,"nullable":true}},"required":["cMotivo","chSubstda"]},"InfoPrestador":{"type":"object","description":"Grupo de informa\xe7\xf5es do DPS relativas ao Prestador de Servi\xe7os.","properties":{"CNPJ":{"type":"string","description":"N\xfamero do CNPJ.\\r\\nObrigat\xf3rio caso o emitente seja pessoa jur\xeddica.","maxLength":14,"nullable":true},"CPF":{"type":"string","description":"N\xfamero do CPF.\\r\\nObrigatorio caso o emitente seja pessoa f\xedsica.","maxLength":11,"nullable":true},"regTrib":{"$ref":"#/components/schemas/RegTrib"}}},"RegTrib":{"type":"object","description":"Grupo de informa\xe7\xf5es relativas aos regimes de tributa\xe7\xe3o do prestador de servi\xe7os.","properties":{"regEspTrib":{"type":"integer","description":"Regime Especial de Tributa\xe7\xe3o da Prefeitura.\\r\\n\\r\\nCampo opcional utilizado no momento da emiss\xe3o da NFS-e para informar\\r\\ndiretamente o c\xf3digo de regime especial de tributa\xe7\xe3o esperado pela\\r\\nprefeitura.\\r\\n\\r\\n**Comportamento:**\\r\\n- Ao preencher este campo, o valor ser\xe1 inserido diretamente no XML\\r\\n  da NFS-e, sem qualquer convers\xe3o pela API.\\r\\n- Esse campo sobrescreve o valor configurado previamente nas\\r\\n  configura\xe7\xf5es de NFS-e da empresa.\\r\\n- \xc9 especialmente \xfatil quando a prefeitura utiliza c\xf3digos pr\xf3prios que\\r\\n  n\xe3o existem no padr\xe3o nacional (como valores diferentes dos listados\\r\\n  de 0 a 6).\\r\\n\\r\\n**Cen\xe1rios de uso:**\\r\\n- Quando a prefeitura exige um c\xf3digo que n\xe3o pode ser representado\\r\\n  pelos valores do padr\xe3o nacional.\\r\\n- Quando houver necessidade de enviar o c\xf3digo exato esperado pela\\r\\n  prefeitura, sem depender da l\xf3gica de convers\xe3o autom\xe1tica da API.\\r\\n\\r\\n**Aten\xe7\xe3o**: Para emiss\xf5es pelo Sistema Nacional NFS-e, esse campo \xe9 ignorado.","nullable":true}}},"InfoTomador":{"type":"object","description":"Grupo de informa\xe7\xf5es do DPS relativas ao Tomador de Servi\xe7os.","properties":{"orgaoPublico":{"type":"boolean","description":"Indica se o tomador do servi\xe7o \xe9 um org\xe3o p\xfablico.\\r\\n\\r\\n**Aten\xe7\xe3o**: Para emiss\xf5es pelo Sistema Nacional NFS-e, esse campo \xe9 ignorado.","default":false,"nullable":true},"CNPJ":{"type":"string","description":"N\xfamero do CNPJ.","maxLength":14,"nullable":true},"CPF":{"type":"string","description":"N\xfamero do CPF.","maxLength":11,"nullable":true},"NIF":{"type":"string","description":"N\xfamero de Identifica\xe7\xe3o Fiscal fornecido por \xf3rg\xe3o de administra\xe7\xe3o tribut\xe1ria no exterior.","maxLength":40,"minLength":1,"nullable":true},"cNaoNIF":{"type":"integer","description":"Motivo para n\xe3o informa\xe7\xe3o do NIF:\\r\\n* 0 - N\xe3o informado na nota de origem\\r\\n* 1 - Dispensado do NIF\\r\\n* 2 - N\xe3o exig\xeancia do NIF","nullable":true},"CAEPF":{"type":"string","description":"N\xfamero do Cadastro de Atividade Econ\xf4mica da Pessoa F\xedsica (CAEPF) do tomador, intermedi\xe1rio ou fornecedor do servi\xe7o.","maxLength":14,"nullable":true},"IM":{"type":"string","description":"N\xfamero da inscri\xe7\xe3o municipal.","maxLength":15,"minLength":1,"nullable":true},"IE":{"type":"string","description":"N\xfamero da inscri\xe7\xe3o estadual.\\r\\n\\r\\n**Aten\xe7\xe3o**: Para emiss\xf5es pelo Sistema Nacional NFS-e, esse campo \xe9 ignorado.","nullable":true},"xNome":{"type":"string","description":"Nome/Nome Empresarial.","maxLength":300,"minLength":1,"nullable":true},"end":{"$ref":"#/components/schemas/Endereco"},"fone":{"type":"string","description":"N\xfamero do telefone do prestador:\\r\\nPreencher com o C\xf3digo DDD + n\xfamero do telefone.\\r\\nNas opera\xe7\xf5es com exterior \xe9 permitido informar o c\xf3digo do pa\xeds + c\xf3digo da localidade + n\xfamero do telefone).","nullable":true},"email":{"type":"string","description":"* E-mail","maxLength":80,"minLength":1,"nullable":true}},"required":["xNome"]},"Endereco":{"type":"object","description":"Dados de endere\xe7o do prestador.","properties":{"endNac":{"$ref":"#/components/schemas/EnderNac"},"endExt":{"$ref":"#/components/schemas/EnderExt"},"xLgr":{"type":"string","description":"Tipo e nome do logradouro da localiza\xe7\xe3o do im\xf3vel.","maxLength":255,"minLength":1,"nullable":true},"tpLgr":{"type":"string","description":"Tipo do Logradouro.\\r\\n\\r\\n**Aten\xe7\xe3o**: Para emiss\xf5es pelo Sistema Nacional NFS-e, esse campo \xe9 ignorado.","nullable":true},"nro":{"type":"string","description":"N\xfamero do im\xf3vel.","maxLength":60,"minLength":1,"nullable":true},"xCpl":{"type":"string","description":"Complemento do endere\xe7o.","maxLength":156,"minLength":1,"nullable":true},"xBairro":{"type":"string","description":"Bairro.","maxLength":60,"minLength":1,"nullable":true}}},"EnderNac":{"type":"object","description":"Grupo de informa\xe7\xf5es espec\xedficas de endere\xe7o nacional.","properties":{"cMun":{"type":"string","description":"C\xf3digo do munic\xedpio, conforme Tabela do IBGE.","nullable":true},"CEP":{"type":"string","description":"N\xfamero do CEP.","nullable":true}}},"EnderExt":{"type":"object","description":"Grupo de informa\xe7\xf5es espec\xedficas de endere\xe7o no exterior.","properties":{"cPais":{"type":"string","description":"C\xf3digo do pa\xeds (Tabela de Pa\xedses ISO).","nullable":true},"cEndPost":{"type":"string","description":"C\xf3digo alfanum\xe9rico do Endere\xe7amento Postal no exterior do prestador do servi\xe7o.","maxLength":11,"minLength":1,"nullable":true},"xCidade":{"type":"string","description":"Nome da cidade no exterior do prestador do servi\xe7o.","maxLength":60,"minLength":1,"nullable":true},"xEstProvReg":{"type":"string","description":"Estado, prov\xedncia ou regi\xe3o da cidade no exterior do prestador do servi\xe7o.","maxLength":60,"minLength":1,"nullable":true}},"required":["xEstProvReg","xCidade","cEndPost","cPais"]},"InfoIntermediario":{"type":"object","description":"Grupo de informa\xe7\xf5es do DPS relativas ao Intermedi\xe1rio de Servi\xe7os.","properties":{"CNPJ":{"type":"string","description":"N\xfamero do CNPJ.","maxLength":14,"nullable":true},"CPF":{"type":"string","description":"N\xfamero do CPF.","maxLength":11,"nullable":true},"NIF":{"type":"string","description":"N\xfamero de Identifica\xe7\xe3o Fiscal fornecido por \xf3rg\xe3o de administra\xe7\xe3o tribut\xe1ria no exterior.","maxLength":40,"minLength":1,"nullable":true},"cNaoNIF":{"type":"integer","description":"Motivo para n\xe3o informa\xe7\xe3o do NIF:\\r\\n* 0 - N\xe3o informado na nota de origem\\r\\n* 1 - Dispensado do NIF\\r\\n* 2 - N\xe3o exig\xeancia do NIF","nullable":true},"CAEPF":{"type":"string","description":"N\xfamero do Cadastro de Atividade Econ\xf4mica da Pessoa F\xedsica (CAEPF) do tomador, intermedi\xe1rio ou fornecedor do servi\xe7o.","maxLength":14,"nullable":true},"IM":{"type":"string","description":"N\xfamero da inscri\xe7\xe3o municipal.","maxLength":15,"minLength":1,"nullable":true},"IE":{"type":"string","description":"N\xfamero da inscri\xe7\xe3o estadual.\\r\\n\\r\\n**Aten\xe7\xe3o**: Para emiss\xf5es pelo Sistema Nacional NFS-e, esse campo \xe9 ignorado.","nullable":true},"xNome":{"type":"string","description":"Nome/Nome Empresarial.","maxLength":300,"minLength":1,"nullable":true},"end":{"$ref":"#/components/schemas/Endereco"},"fone":{"type":"string","description":"N\xfamero do telefone do prestador:\\r\\nPreencher com o C\xf3digo DDD + n\xfamero do telefone.\\r\\nNas opera\xe7\xf5es com exterior \xe9 permitido informar o c\xf3digo do pa\xeds + c\xf3digo da localidade + n\xfamero do telefone).","nullable":true},"email":{"type":"string","description":"* E-mail","maxLength":80,"minLength":1,"nullable":true}},"required":["xNome"]},"Serv":{"type":"object","description":"Grupo de informa\xe7\xf5es do DPS relativas ao Servi\xe7o Prestado.","properties":{"locPrest":{"$ref":"#/components/schemas/LocPrest"},"cServ":{"$ref":"#/components/schemas/CServ"},"comExt":{"$ref":"#/components/schemas/ComExterior"},"lsadppu":{"$ref":"#/components/schemas/LocacaoSublocacao"},"obra":{"$ref":"#/components/schemas/InfoObra"},"atvEvento":{"$ref":"#/components/schemas/AtvEvento"},"explRod":{"$ref":"#/components/schemas/ExploracaoRodoviaria"},"infoCompl":{"$ref":"#/components/schemas/InfoCompl"}},"required":["cServ"]},"LocPrest":{"type":"object","description":"Grupo de informa\xe7\xf5es relativas ao local da presta\xe7\xe3o do servi\xe7o.","properties":{"cLocPrestacao":{"type":"string","description":"C\xf3digo do munic\xedpio onde o servi\xe7o foi prestado (tabela do IBGE).\\r\\n\\r\\nCaso n\xe3o seja informado, ser\xe1 considerado o munic\xedpio do Prestador do servi\xe7o.","nullable":true},"cPaisPrestacao":{"type":"string","description":"C\xf3digo do pa\xeds onde o servi\xe7o foi prestado (Tabela de Pa\xedses ISO).","nullable":true}}},"CServ":{"type":"object","description":"Grupo de informa\xe7\xf5es relativas ao c\xf3digo do servi\xe7o prestado.","properties":{"cTribNac":{"type":"string","description":"C\xf3digo de tributa\xe7\xe3o nacional do ISSQN.\\r\\n**Ambiente Nacional**: O c\xf3digo deve conter exatamente 6 d\xedgitos num\xe9ricos, sendo 2 para Item (LC 116/2003), 2 para Subitem (LC 116/2003) e 2 para Desdobro Nacional. Exemplo: `010701`.\\r\\n**Envio direto para a Prefeitura**: Em muitos munic\xedpios, continua sendo exigido apenas o c\xf3digo conforme a LC 116/2003, totalizando 4 d\xedgitos num\xe9ricos (2 para Item e 2 para Subitem). Exemplo: `0107`.","nullable":true},"cTribMun":{"type":"string","description":"C\xf3digo de tributa\xe7\xe3o municipal do ISSQN.","nullable":true},"CNAE":{"type":"string","description":"C\xf3digo CNAE (Classifica\xe7\xe3o Nacional de Atividades Econ\xf4micas).","nullable":true},"xDescServ":{"type":"string","description":"Descri\xe7\xe3o completa do servi\xe7o prestado.\\r\\n\\r\\nOs caracteres acentuados poder\xe3o ser alterados para caracteres sem acentua\xe7\xe3o.","maxLength":2000,"minLength":1,"nullable":true},"cNBS":{"type":"string","description":"C\xf3digo NBS correspondente ao servi\xe7o prestado, seguindo a vers\xe3o 2.0, conforme Anexo B.","nullable":true},"cNatOp":{"type":"string","description":"C\xf3digo de natureza da opera\xe7\xe3o.\\r\\n\\r\\n**Aten\xe7\xe3o**: Para emiss\xf5es pelo Sistema Nacional NFS-e, esse campo \xe9 ignorado.","nullable":true},"cSitTrib":{"type":"string","description":"C\xf3digo de situa\xe7\xe3o tribut\xe1ria.\\r\\n\\r\\n**Aten\xe7\xe3o**: Para emiss\xf5es pelo Sistema Nacional NFS-e, esse campo \xe9 ignorado.","nullable":true}},"required":["xDescServ","cTribNac"]},"ComExterior":{"type":"object","description":"Grupo de informa\xe7\xf5es relativas \xe0 exporta\xe7\xe3o/importa\xe7\xe3o de servi\xe7o prestado.","properties":{"mdPrestacao":{"type":"integer","description":"Modo de Presta\xe7\xe3o:\\r\\n* 0 - Desconhecido (tipo n\xe3o informado na nota de origem)\\r\\n* 1 - Transfronteiri\xe7o\\r\\n* 2 - Consumo no Brasil\\r\\n* 3 - Movimento Tempor\xe1rio de Pessoas F\xedsicas\\r\\n* 4 - Consumo no Exterior","nullable":true},"vincPrest":{"type":"integer","description":"V\xednculo entre as partes no neg\xf3cio:\\r\\n* 0 - Sem v\xednculo com o Tomador/Prestador\\r\\n* 1 - Controlada\\r\\n* 2 - Controladora\\r\\n* 3 - Coligada\\r\\n* 4 - Matriz\\r\\n* 5 - Filial ou sucursal\\r\\n* 6 - Outro v\xednculo","nullable":true},"tpMoeda":{"type":"string","description":"Identifica a moeda da transa\xe7\xe3o comercial.","maxLength":3,"nullable":true},"vServMoeda":{"type":"number","description":"Valor do servi\xe7o prestado expresso em moeda estrangeira especificada em tpmoeda.","minimum":0,"nullable":true},"mecAFComexP":{"type":"string","description":"Mecanismo de apoio/fomento ao Com\xe9rcio Exterior utilizado pelo prestador do servi\xe7o:\\r\\n* 00 - Desconhecido (tipo n\xe3o informado na nota de origem)\\r\\n* 01 - Nenhum\\r\\n* 02 - ACC - Adiantamento sobre Contrato de C\xe2mbio - Redu\xe7\xe3o a Zero do IR e do IOF\\r\\n* 03 - ACE - Adiantamento sobre Cambiais Entregues - Redu\xe7\xe3o a Zero do IR e do IOF\\r\\n* 04 - BNDES-Exim P\xf3s-Embarque - Servi\xe7os\\r\\n* 05 - BNDES-Exim Pr\xe9-Embarque - Servi\xe7os\\r\\n* 06 - FGE - Fundo de Garantia \xe0 Exporta\xe7\xe3o\\r\\n* 07 - PROEX - EQUALIZA\xc7\xc3O\\r\\n* 08 - PROEX - Financiamento","nullable":true},"mecAFComexT":{"type":"string","description":"Mecanismo de apoio/fomento ao Com\xe9rcio Exterior utilizado pelo tomador do servi\xe7o:\\r\\n* 00 - Desconhecido (tipo n\xe3o informado na nota de origem)\\r\\n* 01 - Nenhum\\r\\n* 02 - Adm. P\xfablica e Repr. Internacional\\r\\n* 03 - Alugueis e Arrend. Mercantil de maquinas, equip., embarc. e aeronaves\\r\\n* 04 - Arrendamento Mercantil de aeronave para empresa de transporte a\xe9reo p\xfablico\\r\\n* 05 - Comiss\xe3o a agentes externos na exporta\xe7\xe3o\\r\\n* 06 - Despesas de armazenagem, mov. e transporte de carga no exterior\\r\\n* 07 - Eventos FIFA (subsidi\xe1ria)\\r\\n* 08 - Eventos FIFA\\r\\n* 09 - Fretes, arrendamentos de embarca\xe7\xf5es ou aeronaves e outros\\r\\n* 10 - Material Aeron\xe1utico\\r\\n* 11 - Promo\xe7\xe3o de Bens no Exterior\\r\\n* 12 - Promo\xe7\xe3o de Dest. Tur\xedsticos Brasileiros\\r\\n* 13 - Promo\xe7\xe3o do Brasil no Exterior\\r\\n* 14 - Promo\xe7\xe3o Servi\xe7os no Exterior\\r\\n* 15 - RECINE\\r\\n* 16 - RECOPA\\r\\n* 17 - Registro e Manuten\xe7\xe3o de marcas, patentes e cultivares\\r\\n* 18 - REICOMP\\r\\n* 19 - REIDI\\r\\n* 20 - REPENEC\\r\\n* 21 - REPES\\r\\n* 22 - RETAERO\\r\\n* 23 - RETID\\r\\n* 24 - Royalties, Assist\xeancia T\xe9cnica, Cient\xedfica e Assemelhados\\r\\n* 25 - Servi\xe7os de avalia\xe7\xe3o da conformidade vinculados aos Acordos da OMC\\r\\n* 26 - ZPE","nullable":true},"movTempBens":{"type":"integer","description":"V\xednculo da Opera\xe7\xe3o \xe0 Movimenta\xe7\xe3o Tempor\xe1ria de Bens:\\r\\n* 0 - Desconhecido (tipo n\xe3o informado na nota de origem)\\r\\n* 1 - N\xe3o\\r\\n* 2 - Vinculada - Declara\xe7\xe3o de Importa\xe7\xe3o\\r\\n* 3 - Vinculada - Declara\xe7\xe3o de Exporta\xe7\xe3o","nullable":true},"nDI":{"type":"string","description":"N\xfamero da Declara\xe7\xe3o de Importa\xe7\xe3o (DI/DSI/DA/DRI-E) averbado.","maxLength":12,"minLength":1,"nullable":true},"nRE":{"type":"string","description":"N\xfamero do Registro de Exporta\xe7\xe3o (RE) averbado.","maxLength":12,"minLength":1,"nullable":true},"mdic":{"type":"integer","description":"Compartilhar as informa\xe7\xf5es da NFS-e gerada a partir desta DPS com a Secretaria de Com\xe9rcio Exterior:\\r\\n* 0 - N\xe3o enviar para o MDIC\\r\\n* 1 - Enviar para o MDIC","nullable":true}},"required":["mdic","movTempBens","mecAFComexT","mecAFComexP","vServMoeda","tpMoeda","vincPrest","mdPrestacao"]},"LocacaoSublocacao":{"type":"object","description":"Grupo de informa\xe7\xf5es relativas a atividades de Loca\xe7\xe3o, subloca\xe7\xe3o, arrendamento, direito de passagem ou permiss\xe3o de uso, compartilhado ou n\xe3o, de ferrovia, rodovia, postes, cabos, dutos e condutos de qualquer natureza.","properties":{"categ":{"type":"integer","description":"Categoria do servi\xe7o.","nullable":true},"objeto":{"type":"integer","description":"Tipo de objetos da loca\xe7\xe3o, subloca\xe7\xe3o, arrendamento, direito de passagem ou permiss\xe3o de uso.","nullable":true},"extensao":{"type":"string","description":"Extens\xe3o total da ferrovia, rodovia, cabos, dutos ou condutos.","maxLength":5,"minLength":1,"nullable":true},"nPostes":{"type":"string","description":"N\xfamero total de postes.","maxLength":6,"minLength":1,"nullable":true}},"required":["nPostes","extensao","objeto","categ"]},"InfoObra":{"type":"object","description":"Grupo de informa\xe7\xf5es do DPS relativas \xe0 servi\xe7o de obra.","properties":{"inscImobFisc":{"type":"string","description":"Inscri\xe7\xe3o imobili\xe1ria fiscal (c\xf3digo fornecido pela Prefeitura Municipal para a identifica\xe7\xe3o da obra ou para fins de recolhimento do IPTU).","maxLength":30,"minLength":1,"nullable":true},"cObra":{"type":"string","description":"N\xfamero de identifica\xe7\xe3o da obra.\\r\\nCadastro Nacional de Obras (CNO) ou Cadastro Espec\xedfico do INSS (CEI).","maxLength":30,"minLength":1,"nullable":true},"cCIB":{"type":"string","description":"C\xf3digo do Cadastro Imobili\xe1rio Brasileiro - CIB.","maxLength":8,"nullable":true},"end":{"$ref":"#/components/schemas/EnderObraEvento"}}},"EnderObraEvento":{"type":"object","description":"Grupo de informa\xe7\xf5es do endere\xe7o da obra do servi\xe7o prestado.","properties":{"CEP":{"type":"string","description":"N\xfamero do CEP.","nullable":true},"endExt":{"$ref":"#/components/schemas/EnderExtSimples"},"xLgr":{"type":"string","description":"Tipo e nome do logradouro da localiza\xe7\xe3o do im\xf3vel.","maxLength":255,"minLength":1,"nullable":true},"tpLgr":{"type":"string","description":"Tipo do Logradouro.\\r\\n\\r\\n**Aten\xe7\xe3o**: Para emiss\xf5es pelo Sistema Nacional NFS-e, esse campo \xe9 ignorado.","nullable":true},"nro":{"type":"string","description":"N\xfamero do im\xf3vel.","maxLength":60,"minLength":1,"nullable":true},"xCpl":{"type":"string","description":"Complemento do endere\xe7o.","maxLength":156,"minLength":1,"nullable":true},"xBairro":{"type":"string","description":"Bairro.","maxLength":60,"minLength":1,"nullable":true}},"required":["xBairro","nro","xLgr"]},"EnderExtSimples":{"type":"object","description":"Grupo de informa\xe7\xf5es espec\xedficas de endere\xe7o no exterior.","properties":{"cEndPost":{"type":"string","description":"C\xf3digo alfanum\xe9rico do Endere\xe7amento Postal no exterior do prestado