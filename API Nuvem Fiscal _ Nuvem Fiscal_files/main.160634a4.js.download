rue},"tpMed":{"type":"string","description":"Tipo da Medida.\\r\\nInformar com:\\r\\n* 00 - Cubagem da NF-e\\r\\n* 01 - Cubagem Aferida pelo Transportador\\r\\n* 02 - Peso Bruto da NF-e\\r\\n* 03 - Peso Bruto Aferido pelo Transportador\\r\\n* 04 - Peso Cubado\\r\\n* 05 - Peso Base do C\xe1lculo do Frete\\r\\n* 06 - Peso para uso Operacional\\r\\n* 07 - Caixas\\r\\n* 08 - Paletes\\r\\n* 09 - Sacas\\r\\n* 10 - Containers\\r\\n* 11 - Rolos\\r\\n* 12 - Bombonas\\r\\n* 13 - Latas\\r\\n* 14 - Litragem\\r\\n* 15 - Milh\xe3o de BTU (British Thermal Units)\\r\\n* 99 - Outros","maxLength":2,"minLength":1,"nullable":true},"qCarga":{"type":"number","description":"Quantidade.","minimum":0,"nullable":true}},"required":["qCarga","tpMed","cUnid"]},"CteSimpSefazDetSimp":{"type":"object","description":"Detalhamento das entregas / presta\xe7\xf5es do CTe Simplificado.","properties":{"nItem":{"type":"integer","description":"N\xfamero identificador do item agrupador da presta\xe7\xe3o.","maximum":990,"minimum":1,"nullable":true},"cMunIni":{"type":"string","description":"C\xf3digo do Munic\xedpio de in\xedcio da presta\xe7\xe3o.\\r\\nUtilizar a tabela do IBGE. Informar 9999999 para opera\xe7\xf5es com o exterior.","nullable":true},"xMunIni":{"type":"string","description":"Nome do Munic\xedpio do in\xedcio da presta\xe7\xe3o.\\r\\nInformar \'EXTERIOR\' para opera\xe7\xf5es com o exterior.","maxLength":60,"minLength":2,"nullable":true},"cMunFim":{"type":"string","description":"C\xf3digo do Munic\xedpio de t\xe9rmino da presta\xe7\xe3o.\\r\\nUtilizar a tabela do IBGE. Informar 9999999 para opera\xe7\xf5es com o exterior.","nullable":true},"xMunFim":{"type":"string","description":"Nome do Munic\xedpio do t\xe9rmino da presta\xe7\xe3o.\\r\\nInformar \'EXTERIOR\' para opera\xe7\xf5es com o exterior.","maxLength":60,"minLength":2,"nullable":true},"vPrest":{"type":"number","description":"Valorl da Presta\xe7\xe3o do Servi\xe7o.\\r\\nPode conter zeros quando o CT-e for de complemento de ICMS.","minimum":0,"nullable":true},"vRec":{"type":"number","description":"Valor a Receber.","minimum":0,"nullable":true},"Comp":{"type":"array","items":{"$ref":"#/components/schemas/CteSimpSefazCompSimp"}},"infNFe":{"type":"array","items":{"$ref":"#/components/schemas/CteSimpSefazInfNFeSimp"}},"infDocAnt":{"type":"array","items":{"$ref":"#/components/schemas/CteSimpSefazInfDocAntSimp"}}},"required":["vRec","vPrest","xMunFim","cMunFim","xMunIni","cMunIni","nItem"]},"CteSimpSefazCompSimp":{"type":"object","description":"Componentes do Valor da Presta\xe7\xe3o.","properties":{"xNome":{"type":"string","description":"Nome do componente.\\r\\nExxemplos: FRETE PESO, FRETE VALOR, SEC/CAT, ADEME, AGENDAMENTO, etc.","maxLength":15,"minLength":1,"nullable":true},"vComp":{"type":"number","description":"Valor do componente.","minimum":0,"nullable":true}},"required":["vComp","xNome"]},"CteSimpSefazInfNFeSimp":{"type":"object","description":"Informa\xe7\xf5es das NF-e.","properties":{"chNFe":{"type":"string","description":"Chave de acesso da NF-e.","nullable":true},"PIN":{"type":"string","description":"PIN SUFRAMA.\\r\\nPIN atribu\xeddo pela SUFRAMA para a opera\xe7\xe3o.","maxLength":9,"minLength":2,"nullable":true},"dPrev":{"type":"string","format":"date","description":"Data prevista de entrega.\\r\\nFormato AAAA-MM-DD.","nullable":true},"infUnidCarga":{"type":"array","items":{"$ref":"#/components/schemas/CteSimpSefazUnidCargaSimp"}},"infUnidTransp":{"type":"array","items":{"$ref":"#/components/schemas/CteSimpSefazUnidadeTranspSimp"}}},"required":["chNFe"]},"CteSimpSefazUnidCargaSimp":{"type":"object","description":"Informa\xe7\xf5es das Unidades de Carga (Containeres/ULD/Outros).\\r\\nDispositivo de carga utilizada (Unit Load Device - ULD) significa todo tipo de cont\xeainer de carga, vag\xe3o, cont\xeainer de avi\xe3o, palete de aeronave com rede ou palete de aeronave com rede sobre um iglu.","properties":{"tpUnidCarga":{"type":"integer","description":"Tipo da Unidade de Carga.\\r\\n* 1 - Container\\r\\n* 2 - ULD\\r\\n* 3 - Pallet\\r\\n* 4 - Outros","nullable":true},"idUnidCarga":{"type":"string","description":"Identifica\xe7\xe3o da Unidade de Carga.\\r\\nInformar a identifica\xe7\xe3o da unidade de carga, por exemplo: n\xfamero do container.","maxLength":20,"minLength":1,"nullable":true},"lacUnidCarga":{"type":"array","items":{"$ref":"#/components/schemas/CteSimpSefazLacUnidCargaSimp"}},"qtdRat":{"type":"number","description":"Quantidade rateada (Peso,Volume).","minimum":0,"nullable":true}},"required":["idUnidCarga","tpUnidCarga"]},"CteSimpSefazLacUnidCargaSimp":{"type":"object","description":"Lacres das Unidades de Carga.","properties":{"nLacre":{"type":"string","description":"N\xfamero do lacre.","maxLength":20,"minLength":1,"nullable":true}},"required":["nLacre"]},"CteSimpSefazUnidadeTranspSimp":{"type":"object","description":"Informa\xe7\xf5es das Unidades de Transporte (Carreta/Reboque/Vag\xe3o).\\r\\nDeve ser preenchido com as informa\xe7\xf5es das unidades de transporte utilizadas.","properties":{"tpUnidTransp":{"type":"integer","description":"Tipo da Unidade de Transporte.\\r\\n* 1 - Rodovi\xe1rio Tra\xe7\xe3o\\r\\n* 2 - Rodovi\xe1rio Reboque\\r\\n* 3 - Navio\\r\\n* 4 - Balsa\\r\\n* 5 - Aeronave\\r\\n* 6 - Vag\xe3o\\r\\n* 7 - Outros","nullable":true},"idUnidTransp":{"type":"string","description":"Identifica\xe7\xe3o da Unidade de Transporte.\\r\\nInformar a identifica\xe7\xe3o conforme o tipo de unidade de transporte.\\r\\nPor exemplo: para rodovi\xe1rio tra\xe7\xe3o ou reboque dever\xe1 preencher com a placa do ve\xedculo.","maxLength":20,"minLength":1,"nullable":true},"lacUnidTransp":{"type":"array","items":{"$ref":"#/components/schemas/CteSimpSefazLacUnidTranspSimp"}},"infUnidCarga":{"type":"array","items":{"$ref":"#/components/schemas/CteSimpSefazUnidCargaSimp"}},"qtdRat":{"type":"number","description":"Quantidade rateada (Peso,Volume).","minimum":0,"nullable":true}},"required":["idUnidTransp","tpUnidTransp"]},"CteSimpSefazLacUnidTranspSimp":{"type":"object","description":"Lacres das Unidades de Transporte.","properties":{"nLacre":{"type":"string","description":"N\xfamero do lacre.","maxLength":20,"minLength":1,"nullable":true}},"required":["nLacre"]},"CteSimpSefazInfDocAntSimp":{"type":"object","description":"Documentos anteriores.","properties":{"chCTe":{"type":"string","description":"Chave de acesso do CT-e.","maxLength":44,"nullable":true},"tpPrest":{"type":"integer","description":"indica se a presta\xe7\xe3o \xe9 total ou parcial em rela\xe7\xe3o as notas do documento anterior.\\r\\nPreencher com:\\r\\n* 1 - Total\\r\\n* 2 - Parcial","nullable":true},"infNFeTranspParcial":{"type":"array","items":{"$ref":"#/components/schemas/CteSimpSefazInfNFeTranspParcialSimp"}}},"required":["tpPrest","chCTe"]},"CteSimpSefazInfNFeTranspParcialSimp":{"type":"object","properties":{"chNFe":{"type":"string","description":"Chave de acesso da NF-e.\\r\\nInformando o tpPrest com \u201c2 - Parcial\u201d deve-se informar as chaves de acesso das NF-e que acobertam a carga transportada.","maxLength":44,"nullable":true}},"required":["chNFe"]},"CteSimpSefazInfModalSimp":{"type":"object","description":"Informa\xe7\xf5es do modal.","properties":{"versaoModal":{"type":"string","description":"Vers\xe3o do leiaute espec\xedfico para o Modal.","nullable":true},"rodo":{"$ref":"#/components/schemas/CteSimpSefazRodoSimp"},"aereo":{"$ref":"#/components/schemas/CteSimpSefazAereoSimp"},"ferrov":{"$ref":"#/components/schemas/CteSimpSefazFerrovSimp"},"aquav":{"$ref":"#/components/schemas/CteSimpSefazAquavSimp"},"duto":{"$ref":"#/components/schemas/CteSimpSefazDutoSimp"},"multimodal":{"$ref":"#/components/schemas/CteSimpSefazMultimodalSimp"}},"required":["versaoModal"]},"CteSimpSefazRodoSimp":{"type":"object","description":"Informa\xe7\xf5es do modal Rodovi\xe1rio.","properties":{"RNTRC":{"type":"string","description":"Registro Nacional de Transportadores Rodovi\xe1rios de Carga.\\r\\nRegistro obrigat\xf3rio do emitente do CT-e junto \xe0 ANTT para exercer a atividade de transportador rodovi\xe1rio de cargas por conta de terceiros e mediante remunera\xe7\xe3o.","nullable":true},"occ":{"type":"array","items":{"$ref":"#/components/schemas/CteSimpSefazOccSimp"},"maxItems":10}},"required":["RNTRC"]},"CteSimpSefazOccSimp":{"type":"object","description":"Ordens de Coleta associados.","properties":{"serie":{"type":"string","description":"S\xe9rie da OCC.","maxLength":3,"minLength":1,"nullable":true},"nOcc":{"type":"integer","description":"N\xfamero da Ordem de coleta.","maximum":999999,"minimum":1,"nullable":true},"dEmi":{"type":"string","format":"date","description":"Data de emiss\xe3o da ordem de coleta.\\r\\nFormato AAAA-MM-DD.","nullable":true},"emiOcc":{"$ref":"#/components/schemas/CteSimpSefazEmiOccSimp"}},"required":["dEmi","nOcc"]},"CteSimpSefazEmiOccSimp":{"type":"object","properties":{"CNPJ":{"type":"string","description":"N\xfamero do CNPJ.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true},"cInt":{"type":"string","description":"C\xf3digo interno de uso da transportadora.\\r\\nUso intermo das transportadoras.","maxLength":10,"minLength":1,"nullable":true},"IE":{"type":"string","description":"Inscri\xe7\xe3o Estadual.","maxLength":14,"nullable":true},"UF":{"type":"string","description":"Sigla da UF.\\r\\nInformar EX para opera\xe7\xf5es com o exterior.","nullable":true},"fone":{"type":"string","description":"Telefone.","nullable":true}},"required":["UF","IE","CNPJ"]},"CteSimpSefazAereoSimp":{"type":"object","description":"Informa\xe7\xf5es do modal A\xe9reo.","properties":{"nMinu":{"type":"integer","description":"N\xfamero da Minuta.\\r\\nDocumento que precede o CT-e, assinado pelo expedidor, esp\xe9cie de pedido de servi\xe7o.","maximum":999999999,"minimum":0,"nullable":true},"nOCA":{"type":"string","description":"N\xfamero Operacional do Conhecimento A\xe9reo.\\r\\nRepresenta o n\xfamero de controle comumente utilizado pelo conhecimento a\xe9reo composto por uma sequ\xeancia num\xe9rica de onze d\xedgitos. Os tr\xeas primeiros d\xedgitos representam um c\xf3digo que os operadores de transporte a\xe9reo associados \xe0 IATA possuem. Em seguida um n\xfamero de s\xe9rie de sete d\xedgitos determinados pelo operador de transporte a\xe9reo. Para finalizar, um d\xedgito verificador, que \xe9 um sistema de m\xf3dulo sete imponderado o qual divide o n\xfamero de s\xe9rie do conhecimento a\xe9reo por sete e usa o resto como d\xedgito de verifica\xe7\xe3o.","nullable":true},"dPrevAereo":{"type":"string","format":"date","description":"Data prevista da entrega.\\r\\nFormato AAAA-MM-DD.","nullable":true},"natCarga":{"$ref":"#/components/schemas/CteSimpSefazNatCargaSimp"},"tarifa":{"$ref":"#/components/schemas/CteSimpSefazTarifaSimp"},"peri":{"type":"array","items":{"$ref":"#/components/schemas/CteSimpSefazPeriSimp"}}},"required":["tarifa","natCarga","dPrevAereo"]},"CteSimpSefazNatCargaSimp":{"type":"object","description":"Natureza da carga.","properties":{"xDime":{"type":"string","description":"Dimens\xe3o.\\r\\nFormato:1234X1234X1234 (cm). Esse campo deve sempre que poss\xedvel ser preenchido. Entretanto, quando for imposs\xedvel o preenchimento das dimens\xf5es, fica obrigat\xf3rio o preenchimento da cubagem em metro c\xfabico do leiaute do CT-e da estrutura gen\xe9rica (infQ).","maxLength":14,"minLength":5,"nullable":true},"cInfManu":{"type":"array","description":"Informa\xe7\xf5es de manuseio.\\r\\n* 01 - certificado do expedidor para embarque de animal vivo\\r\\n* 02 - artigo perigoso conforme Declara\xe7\xe3o do Expedidor anexa\\r\\n* 03 - somente em aeronave cargueira\\r\\n* 04 - artigo perigoso - declara\xe7\xe3o do expedidor n\xe3o requerida\\r\\n* 05 - artigo perigoso em quantidade isenta\\r\\n* 06 - gelo seco para refrigera\xe7\xe3o (especificar no campo observa\xe7\xf5es a quantidade)\\r\\n* 07 - n\xe3o restrito (especificar a Disposi\xe7\xe3o Especial no campo observa\xe7\xf5es)\\r\\n* 08 - artigo perigoso em carga consolidada (especificar a quantidade no campo observa\xe7\xf5es)\\r\\n* 09 - autoriza\xe7\xe3o da autoridade governamental anexa (especificar no campo observa\xe7\xf5es)\\r\\n* 10 - baterias de \xedons de l\xedtio em conformidade com a Se\xe7\xe3o II da PI965 - CAO\\r\\n* 11 - baterias de \xedons de l\xedtio em conformidade com a Se\xe7\xe3o II da PI966\\r\\n* 12 - baterias de \xedons de l\xedtio em conformidade com a Se\xe7\xe3o II da PI967\\r\\n* 13 - baterias de metal l\xedtio em conformidade com a Se\xe7\xe3o II da PI968 \u2014 CAO\\r\\n* 14 - baterias de metal l\xedtio em conformidade com a Se\xe7\xe3o II da PI969\\r\\n* 15 - baterias de metal l\xedtio em conformidade com a Se\xe7\xe3o II da PI970\\r\\n* 99 - outro (especificar no campo observa\xe7\xf5es)","items":{"type":"string"}}}},"CteSimpSefazTarifaSimp":{"type":"object","description":"Informa\xe7\xf5es de tarifa.","properties":{"CL":{"type":"string","description":"Classe.\\r\\nPreencher com:\\r\\n* M - Tarifa M\xednima\\r\\n* G - Tarifa Geral\\r\\n* E - Tarifa Espec\xedfica","maxLength":1,"nullable":true},"cTar":{"type":"string","description":"C\xf3digo da Tarifa.\\r\\nDever\xe3o ser inclu\xeddos os c\xf3digos de tr\xeas d\xedgitos, correspondentes \xe0 tarifa.","maxLength":4,"minLength":1,"nullable":true},"vTar":{"type":"number","description":"Valor da Tarifa.\\r\\nValor da tarifa por kg quando for o caso.","minimum":0,"nullable":true}},"required":["vTar","CL"]},"CteSimpSefazPeriSimp":{"type":"object","description":"Preenchido quando for  transporte de produtos classificados pela ONU como perigosos.\\r\\nO preenchimento desses campos n\xe3o desobriga a empresa a\xe9rea de emitir os demais documentos que constam na legisla\xe7\xe3o vigente.","properties":{"nONU":{"type":"string","description":"N\xfamero ONU/UN.\\r\\nVer a legisla\xe7\xe3o de transporte de produtos perigosos aplicadas ao modal.","nullable":true},"qTotEmb":{"type":"string","description":"Quantidade total de volumes contendo artigos perigosos.\\r\\nPreencher com o n\xfamero de volumes (unidades) de artigos perigosos, ou seja, cada embalagem devidamente marcada e etiquetada (por ex.: n\xfamero de caixas, de tambores, de bombonas, dentre outros). N\xe3o deve ser preenchido com o n\xfamero de ULD, pallets ou containers.","maxLength":20,"minLength":1,"nullable":true},"infTotAP":{"$ref":"#/components/schemas/CteSimpSefazInfTotAPSimp"}},"required":["infTotAP","qTotEmb","nONU"]},"CteSimpSefazInfTotAPSimp":{"type":"object","description":"Grupo de informa\xe7\xf5es das quantidades totais de artigos perigosos.\\r\\nPreencher conforme a legisla\xe7\xe3o de transporte de produtos perigosos aplicada ao modal.","properties":{"qTotProd":{"type":"number","description":"Quantidade total de artigos perigosos.\\r\\n15 posi\xe7\xf5es, sendo 11 inteiras e 4 decimais.\\r\\nDeve indicar a quantidade total do artigo perigoso, tendo como base a unidade referenciada na Tabela 3-1 do Doc 9284, por exemplo: litros\\r\\nquilogramas\\r\\nquilograma bruto etc. O preenchimento n\xe3o deve, entretanto, incluir a unidade de medida. No caso de transporte de material radioativo, deve-se indicar o somat\xf3rio dos \xcdndices de Transporte (TI). N\xe3o indicar a quantidade do artigo perigoso por embalagem.","minimum":0,"nullable":true},"uniAP":{"type":"integer","description":"Unidade de medida.\\r\\n* 1 - KG\\r\\n* 2 - KG G (quilograma bruto)\\r\\n* 3 - LITROS\\r\\n* 4 - TI (\xedndice de transporte para radioativos)\\r\\n* 5 - Unidades (apenas para artigos perigosos medidos em unidades que n\xe3o se enquadram nos itens acima. Exemplo: baterias, celulares, equipamentos, ve\xedculos, dentre outros)","nullable":true}},"required":["uniAP","qTotProd"]},"CteSimpSefazFerrovSimp":{"type":"object","description":"Informa\xe7\xf5es do modal Ferrovi\xe1rio.","properties":{"tpTraf":{"type":"integer","description":"Tipo de Tr\xe1fego.\\r\\nPreencher com:\\r\\n* 0 - Pr\xf3prio\\r\\n* 1 - M\xfatuo\\r\\n* 2 - Rodoferrovi\xe1rio\\r\\n* 3 - Rodovi\xe1rio","nullable":true},"trafMut":{"$ref":"#/components/schemas/CteSimpSefazTrafMutSimp"},"fluxo":{"type":"string","description":"Fluxo Ferrovi\xe1rio.\\r\\nTrata-se de um n\xfamero identificador do contrato firmado com o cliente.","maxLength":10,"minLength":1,"nullable":true}},"required":["fluxo","tpTraf"]},"CteSimpSefazTrafMutSimp":{"type":"object","description":"Detalhamento de informa\xe7\xf5es para o tr\xe1fego m\xfatuo.","properties":{"respFat":{"type":"integer","description":"Respons\xe1vel pelo Faturamento.\\r\\nPreencher com:\\r\\n* 1 - Ferrovia de origem\\r\\n* 2 - Ferrovia de destino","nullable":true},"ferrEmi":{"type":"integer","description":"Ferrovia Emitente do CTe.\\r\\nPreencher com:\\r\\n* 1 - Ferrovia de origem\\r\\n* 2 - Ferrovia de destino","nullable":true},"vFrete":{"type":"number","description":"Valor do Frete do Tr\xe1fego M\xfatuo.","minimum":0,"nullable":true},"chCTeFerroOrigem":{"type":"string","description":"Chave de acesso do CT-e emitido pelo ferrovia de origem.","maxLength":44,"nullable":true},"ferroEnv":{"type":"array","items":{"$ref":"#/components/schemas/CteSimpSefazFerroEnvSimp"}}},"required":["vFrete","ferrEmi","respFat"]},"CteSimpSefazFerroEnvSimp":{"type":"object","description":"Informa\xe7\xf5es das Ferrovias Envolvidas.","properties":{"CNPJ":{"type":"string","description":"N\xfamero do CNPJ.\\r\\nInformar o CNPJ da Ferrovia Envolvida. Caso a Ferrovia envolvida n\xe3o seja inscrita no CNPJ o campo dever\xe1 preenchido com zeros.\\r\\nInformar os zeros n\xe3o significativos.","nullable":true},"cInt":{"type":"string","description":"C\xf3digo interno da Ferrovia envolvida.\\r\\nUso da transportadora.","maxLength":10,"minLength":1,"nullable":true},"IE":{"type":"string","description":"Inscri\xe7\xe3o Estadual.","maxLength":14,"nullable":true},"xNome":{"type":"string","description":"Raz\xe3o Social ou Nome.","maxLength":60,"minLength":2,"nullable":true},"enderFerro":{"$ref":"#/components/schemas/CteSimpSefazEnderFerSimp"}},"required":["enderFerro","xNome","CNPJ