 comercial e documentos fiscais.","version":"2.70.0","title":"API Nuvem Fiscal"},"tags":[{"name":"Cep"},{"name":"Cnpj"},{"name":"Conta"},{"name":"Cte","description":"Conhecimento de Transporte Eletr\xf4nico."},{"name":"CteOs","description":"Conhecimento de Transporte Eletr\xf4nico - Outros servi\xe7os."},{"name":"Dce","description":"Declara\xe7\xe3o de Conte\xfado Eletr\xf4nica."},{"name":"Debug","description":"Endpoints auxiliares voltados \xe0 an\xe1lise t\xe9cnica e depura\xe7\xe3o de documentos fiscais.\\r\\nPermitem rastrear o processamento de DF-es na API, incluindo o conte\xfado\\r\\noriginal recebido e as requisi\xe7\xf5es realizadas aos servi\xe7os autorizadores (SEFAZ, prefeituras, etc)."},{"name":"Distribui\xe7\xe3o NF-e","description":"O processo de distribui\xe7\xe3o de DFe envolve a disponibiliza\xe7\xe3o dos\\r\\ndocumentos fiscais eletr\xf4nicos para os envolvidos na transa\xe7\xe3o (emitentes,\\r\\ndestinat\xe1rios e terceiros autorizados). Ele permite que os destinat\xe1rios\\r\\nrecebam as NF-e emitidas contra o seu CNPJ diretamente do Ambiente\\r\\nNacional, facilitando o controle e a gest\xe3o dos documentos recebidos."},{"name":"Email"},{"name":"Empresa","description":"Cadastre e administre todas as empresas vinculadas \xe0 sua conta."},{"name":"Mdfe","description":"Manifesto Eletr\xf4nico de Documentos Fiscais."},{"name":"Nfce","description":"Nota Fiscal de Consumidor Eletr\xf4nica."},{"name":"Nfcom","description":"Nota Fiscal Fatura de Servi\xe7o de Comunica\xe7\xe3o Eletr\xf4nica."},{"name":"Nfe","description":"Nota Fiscal Eletr\xf4nica."},{"name":"Nfse","description":"Nota Fiscal de Servi\xe7o Eletr\xf4nica."}],"paths":{"/cep/{Cep}":{"get":{"tags":["Cep"],"summary":"Consultar endere\xe7o atrav\xe9s do CEP","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#cep-consultas\\">cep-consultas</a>\\r\\n- Consumo: 1 unidade requisi\xe7\xe3o.","operationId":"ConsultarCep","parameters":[{"in":"path","name":"Cep","description":"CEP sem m\xe1scara.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CepEndereco"}}}}}}},"/cnpj":{"get":{"tags":["Cnpj"],"summary":"Listar estabelecimentos ativos a partir da base de CNPJ","description":"Retorna uma lista de estabelecimentos de acordo com os crit\xe9rios de busca utilizados.\\r\\nSomente ser\xe3o retornados estabelecimentos com situa\xe7\xe3o cadastral \\"Ativa\\".\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#cnpj-listagem\\">cnpj-listagem</a>\\r\\n- Consumo: 1 unidade por estabelecimento listado ou requisi\xe7\xe3o.","operationId":"ListarCnpj","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cnae_principal","description":"Filtro pelo c\xf3digo CNAE da atividade principal do estabelecimento.\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"municipio","description":"Filtro pelo c\xf3digo IBGE ou TOM (Tabela de \xd3rg\xe3os e Munic\xedpios) do munic\xedpio do estabelecimento.\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"natureza_juridica","description":"Filtro pela natureza jur\xeddica do estabelecimento\\r\\n Utilize o valor de quatro d\xedgitos sem m\xe1scara.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CnpjListagem"}}}}}}},"/cnpj/{Cnpj}":{"get":{"tags":["Cnpj"],"summary":"Consultar dados do CNPJ","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#cnpj-consultas\\">cnpj-consultas</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"ConsultarCnpj","parameters":[{"in":"path","name":"Cnpj","description":"CNPJ sem m\xe1scara.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CnpjEmpresa"}}}}}}},"/conta/cotas":{"get":{"tags":["Conta"],"summary":"Consultar os limites de uso e consumo de todas as cotas existentes.","operationId":"ListarCotasConta","responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ContaCotaListagem"}}}}}}},"/conta/cotas/{nome}":{"get":{"tags":["Conta"],"summary":"Consultar o limite de uso e o consumo de uma cota espec\xedfica.","operationId":"ConsultarCotaConta","parameters":[{"in":"path","name":"nome","description":"Nome da cota a ser consultada.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ContaCota"}}}}}}},"/cte":{"get":{"tags":["Cte"],"summary":"Listar CT-e","description":"Retorna a lista de CT-e de acordo com os crit\xe9rios de busca utilizados. Os CT-e s\xe3o retornados ordenados pela data da cria\xe7\xe3o, com os mais recentes aparecendo primeiro.","operationId":"ListarCte","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ do emitente.\\r\\n\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"referencia","description":"Seu identificador \xfanico para o documento.","schema":{"type":"string"}},{"in":"query","name":"ambiente","description":"Identifica\xe7\xe3o do Ambiente.\\r\\n\\r\\nValores aceitos: homologacao, producao","required":true,"schema":{"type":"string"}},{"in":"query","name":"chave","description":"Chave de acesso do DF-e.","schema":{"type":"string"}},{"in":"query","name":"serie","description":"S\xe9rie do DF-e.","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeListagem"}}}}}},"post":{"tags":["Cte"],"summary":"Emitir CT-e","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"EmitirCte","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CtePedidoEmissao"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Dfe"}}}}}}},"/cte/eventos/{id}":{"get":{"tags":["Cte"],"summary":"Consultar evento","operationId":"ConsultarEventoCte","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeEvento"}}}}}}},"/cte/eventos/{id}/pdf":{"get":{"tags":["Cte"],"summary":"Baixar PDF do evento","operationId":"BaixarPdfEventoCte","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cte/eventos/{id}/xml":{"get":{"tags":["Cte"],"summary":"Baixar XML do evento","operationId":"BaixarXmlEventoCte","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cte/sefaz/status":{"get":{"tags":["Cte"],"summary":"Consulta do Status do Servi\xe7o na SEFAZ Autorizadora","description":"Consulta do status do servi\xe7o prestado pelo Portal da Secretaria de Fazenda Estadual.\\r\\n\\r\\nA API mant\xe9m a \xfaltima consulta em cache por 5 minutos, evitando sobrecarregar desnecessariamente os servidores da SEFAZ (conforme orienta\xe7\xe3o do MOC - vers\xe3o 3.0.0a, item 4.6.3). Dessa forma, voc\xea poder\xe1 chamar esse endpoint quantas vezes quiser, sem preocupar-se em ter o seu CNPJ bloqueado por consumo indevido (Rejei\xe7\xe3o 656).","operationId":"ConsultarStatusSefazCte","parameters":[{"in":"query","name":"cpf_cnpj","description":"CPF/CNPJ do emitente.\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"autorizador","description":"Ambiente Autorizador.\\r\\n\\r\\nAutorizadores dispon\xedveis: `MT`, `MS`, `MG`, `PR`, `RS`, `SP`, `SVRS`, `SVSP`, `AN`.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o ambiente autorizador da UF do emitente.*","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeSefazStatus"}}}}}}},"/cte/simp":{"post":{"tags":["Cte"],"summary":"Emitir CT-e Simplificado","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"EmitirCteSimp","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CteSimpPedidoEmissao"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Dfe"}}}}}}},"/cte/{id}":{"get":{"tags":["Cte"],"summary":"Consultar CT-e","description":"Consulta os detalhes de um CT-e j\xe1 existente. Forne\xe7a o ID \xfanico obtido de uma requisi\xe7\xe3o de emiss\xe3o ou de listagem de CT-e e a API ir\xe1 retornar as informa\xe7\xf5es do CT-e correspondente.","operationId":"ConsultarCte","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Dfe"}}}}}}},"/cte/{id}/cancelamento":{"get":{"tags":["Cte"],"summary":"Consultar o cancelamento do CT-e","operationId":"ConsultarCancelamentoCte","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeCancelamento"}}}}}},"post":{"tags":["Cte"],"summary":"Cancelar um CT-e autorizado","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"CancelarCte","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e gerado pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CtePedidoCancelamento"}}}},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeCancelamento"}}}}}}},"/cte/{id}/cancelamento/pdf":{"get":{"tags":["Cte"],"summary":"Baixar PDF do cancelamento","operationId":"BaixarPdfCancelamentoCte","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cte/{id}/cancelamento/xml":{"get":{"tags":["Cte"],"summary":"Baixar XML do cancelamento","operationId":"BaixarXmlCancelamentoCte","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cte/{id}/carta-correcao":{"get":{"tags":["Cte"],"summary":"Consultar a solicita\xe7\xe3o de corre\xe7\xe3o do CT-e","operationId":"ConsultarCartaCorrecaoCte","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CteCartaCorrecao"}}}}}},"post":{"tags":["Cte"],"summary":"Solicitar corre\xe7\xe3o do CT-e","description":"\xc9 poss\xedvel enviar at\xe9 20 corre\xe7\xf5es diferentes, sendo que ser\xe1 v\xe1lido sempre a \xfaltima corre\xe7\xe3o enviada.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"CriarCartaCorrecaoCte","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e gerado pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CtePedidoCartaCorrecao"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CteCartaCorrecao"}}}}}}},"/cte/{id}/carta-correcao/pdf":{"get":{"tags":["Cte"],"summary":"Baixar PDF da carta de corre\xe7\xe3o","operationId":"BaixarPdfCartaCorrecaoCte","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cte/{id}/carta-correcao/xml":{"get":{"tags":["Cte"],"summary":"Baixar XML da carta de corre\xe7\xe3o","operationId":"BaixarXmlCartaCorrecaoCte","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cte/{id}/pdf":{"get":{"tags":["Cte"],"summary":"Baixar PDF do DACTE","operationId":"BaixarPdfCte","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e gerado pela API.","required":true,"schema":{"type":"string"}},{"in":"query","name":"logotipo","description":"Imprime o documento com logotipo, desde que esteja cadastrado na empresa.","schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cte/{id}/sincronizar":{"post":{"tags":["Cte"],"summary":"Sincroniza dados no CT-e a partir da SEFAZ","description":"Realiza a sincroniza\xe7\xe3o dos dados a partir da consulta da situa\xe7\xe3o atual da CT-e na Base de Dados do Portal da Secretaria de Fazenda Estadual.\\r\\n\\r\\n**Cen\xe1rios de uso**:\\r\\n* Sincronizar um CT-e que se encontra com o status `erro` na API, mas est\xe1 autorizado na SEFAZ (\xfatil em casos de erros de transmiss\xe3o com a SEFAZ, como instabilidades e timeouts).\\r\\n* Sincronizar um CT-e que se encontra com o status `autorizado`na API, mas est\xe1 cancelado na SEFAZ.\\r\\n* Sincronizar todos os eventos de Cancelamento e Carta de Corre\xe7\xe3o de um CT-e que porventura n\xe3o tenham sido feitos a partir da API.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por evento sincronizado ou requisi\xe7\xe3o.","operationId":"SincronizarCte","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeSincronizacao"}}}}}}},"/cte/{id}/xml":{"get":{"tags":["Cte"],"summary":"Baixar XML do CT-e processado","description":"Utilize esse endpoint para obter o XML do conhecimento enviado para a SEFAZ, complementado com a informa\xe7\xe3o do protocolo de autoriza\xe7\xe3o de uso (TAG raiz `cteProc`).\\r\\n\\r\\nO XML s\xf3 estar\xe1 dispon\xedvel nesse endpoint caso o conhecimento tenha sido autorizado pela SEFAZ. Para obter o XML nos demais casos, utilize o endpoint `GET /cte/{id}/xml/conhecimento`.","operationId":"BaixarXmlCte","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cte/{id}/xml/conhecimento":{"get":{"tags":["Cte"],"summary":"Baixar XML do CT-e","description":"Utilize esse endpoint para obter o XML do conhecimento enviado para a SEFAZ.\\r\\n\\r\\nO XML estar\xe1 dispon\xedvel nesse endpoint mesmo em casos que o conhecimento tenha sido rejeitado.","operationId":"BaixarXmlCteConhecimento","parameters":[{"in":"path","name":"id","description":"ID \xfanico da CT-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cte/{id}/xml/protocolo":{"get":{"tags":["Cte"],"summary":"Baixar XML do Protocolo da SEFAZ","operationId":"BaixarXmlCteProtocolo","parameters":[{"in":"path","name":"id","description":"ID \xfanico da CT-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cteos":{"get":{"tags":["CteOs"],"summary":"Listar CT-e OS","description":"Retorna a lista de CT-e OS de acordo com os crit\xe9rios de busca utilizados. Os CT-e OS s\xe3o retornados ordenados pela data da cria\xe7\xe3o, com os mais recentes aparecendo primeiro.","operationId":"ListarCteOs","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ do emitente.\\r\\n\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"referencia","description":"Seu identificador \xfanico para o documento.","schema":{"type":"string"}},{"in":"query","name":"ambiente","description":"Identifica\xe7\xe3o do Ambiente.\\r\\n\\r\\nValores aceitos: homologacao, producao","required":true,"schema":{"type":"string"}},{"in":"query","name":"chave","description":"Chave de acesso do DF-e.","schema":{"type":"string"}},{"in":"query","name":"serie","description":"S\xe9rie do DF-e.","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeListagem"}}}}}},"post":{"tags":["CteOs"],"summary":"Emitir CT-e OS","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"EmitirCteOs","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CteOsPedidoEmissao"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Dfe"}}}}}}},"/cteos/eventos/{id}":{"get":{"tags":["CteOs"],"summary":"Consultar evento","operationId":"ConsultarEventoCteOs","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeEvento"}}}}}}},"/cteos/eventos/{id}/pdf":{"get":{"tags":["CteOs"],"summary":"Baixar PDF do evento","operationId":"BaixarPdfEventoCteOs","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cteos/eventos/{id}/xml":{"get":{"tags":["CteOs"],"summary":"Baixar XML do evento","operationId":"BaixarXmlEventoCteOs","parameters":[{"in":"path","name":"id","description":"ID \xfanico do evento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cteos/sefaz/status":{"get":{"tags":["CteOs"],"summary":"Consulta do Status do Servi\xe7o na SEFAZ Autorizadora","description":"Consulta do status do servi\xe7o prestado pelo Portal da Secretaria de Fazenda Estadual.\\r\\n\\r\\nA API mant\xe9m a \xfaltima consulta em cache por 5 minutos, evitando sobrecarregar desnecessariamente os servidores da SEFAZ (conforme orienta\xe7\xe3o do MOC - vers\xe3o 3.0.0a, item 4.6.3). Dessa forma, voc\xea poder\xe1 chamar esse endpoint quantas vezes quiser, sem preocupar-se em ter o seu CNPJ bloqueado por consumo indevido (Rejei\xe7\xe3o 656).","operationId":"ConsultarStatusSefazCteOs","parameters":[{"in":"query","name":"cpf_cnpj","description":"CPF/CNPJ do emitente.\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"autorizador","description":"Ambiente Autorizador.\\r\\n\\r\\nAutorizadores dispon\xedveis: `MT`, `MS`, `MG`, `PR`, `RS`, `SP`, `SVRS`, `SVSP`, `AN`.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o ambiente autorizador da UF do emitente.*","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeSefazStatus"}}}}}}},"/cteos/{id}":{"get":{"tags":["CteOs"],"summary":"Consultar CT-e OS","description":"Consulta os detalhes de um CT-e OS j\xe1 existente. Forne\xe7a o ID \xfanico obtido de uma requisi\xe7\xe3o de emiss\xe3o ou de listagem de CT-e OS e a API ir\xe1 retornar as informa\xe7\xf5es do CT-e OS correspondente.","operationId":"ConsultarCteOs","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e OS gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Dfe"}}}}}}},"/cteos/{id}/cancelamento":{"get":{"tags":["CteOs"],"summary":"Consultar o cancelamento do CT-e OS","operationId":"ConsultarCancelamentoCteOs","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e OS gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeCancelamento"}}}}}},"post":{"tags":["CteOs"],"summary":"Cancelar um CT-e OS autorizado","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"CancelarCteOs","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e OS gerado pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CteOsPedidoCancelamento"}}}},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeCancelamento"}}}}}}},"/cteos/{id}/cancelamento/pdf":{"get":{"tags":["CteOs"],"summary":"Baixar PDF do cancelamento","operationId":"BaixarPdfCancelamentoCteOs","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e OS gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cteos/{id}/cancelamento/xml":{"get":{"tags":["CteOs"],"summary":"Baixar XML do cancelamento","operationId":"BaixarXmlCancelamentoCteOs","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e OS gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cteos/{id}/carta-correcao":{"get":{"tags":["CteOs"],"summary":"Consultar a solicita\xe7\xe3o de corre\xe7\xe3o do CT-e OS","operationId":"ConsultarCartaCorrecaoCteOs","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e OS gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CteOsCartaCorrecao"}}}}}},"post":{"tags":["CteOs"],"summary":"Solicitar corre\xe7\xe3o do CT-e OS","description":"\xc9 poss\xedvel enviar at\xe9 20 corre\xe7\xf5es diferentes, sendo que ser\xe1 v\xe1lido sempre a \xfaltima corre\xe7\xe3o enviada.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"CriarCartaCorrecaoCteOs","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e OS gerado pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CteOsPedidoCartaCorrecao"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CteOsCartaCorrecao"}}}}}}},"/cteos/{id}/carta-correcao/pdf":{"get":{"tags":["CteOs"],"summary":"Baixar PDF da carta de corre\xe7\xe3o","operationId":"BaixarPdfCartaCorrecaoCteOs","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e OS gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cteos/{id}/carta-correcao/xml":{"get":{"tags":["CteOs"],"summary":"Baixar XML da carta de corre\xe7\xe3o","operationId":"BaixarXmlCartaCorrecaoCteOs","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e OS gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cteos/{id}/pdf":{"get":{"tags":["CteOs"],"summary":"Baixar PDF do DACTE","operationId":"BaixarPdfCteOs","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e OS gerado pela API.","required":true,"schema":{"type":"string"}},{"in":"query","name":"logotipo","description":"Imprime o documento com logotipo, desde que esteja cadastrado na empresa.","schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cteos/{id}/sincronizar":{"post":{"tags":["CteOs"],"summary":"Sincroniza dados no CT-e OS a partir da SEFAZ","description":"Realiza a sincroniza\xe7\xe3o dos dados a partir da consulta da situa\xe7\xe3o atual do CT-e OS na Base de Dados do Portal da Secretaria de Fazenda Estadual.\\r\\n\\r\\n**Cen\xe1rios de uso**:\\r\\n* Sincronizar um CT-e OS que se encontra com o status `erro` na API, mas est\xe1 autorizado na SEFAZ (\xfatil em casos de erros de transmiss\xe3o com a SEFAZ, como instabilidades e timeouts).\\r\\n* Sincronizar um CT-e OS que se encontra com o status `autorizado`na API, mas est\xe1 cancelado na SEFAZ.\\r\\n* Sincronizar todos os eventos de Cancelamento e Carta de Corre\xe7\xe3o de um CT-e OS que porventura n\xe3o tenham sido feitos a partir da API.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por evento sincronizado ou requisi\xe7\xe3o.","operationId":"SincronizarCteOs","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e OS gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeSincronizacao"}}}}}}},"/cteos/{id}/xml":{"get":{"tags":["CteOs"],"summary":"Baixar XML do CT-e OS processado","description":"Utilize esse endpoint para obter o XML do conhecimento enviado para a SEFAZ, complementado com a informa\xe7\xe3o do protocolo de autoriza\xe7\xe3o de uso (TAG raiz `cteProc`).\\r\\n\\r\\nO XML s\xf3 estar\xe1 dispon\xedvel nesse endpoint caso o conhecimento tenha sido autorizado pela SEFAZ. Para obter o XML nos demais casos, utilize o endpoint `GET /cteos/{id}/xml/conhecimento`.","operationId":"BaixarXmlCteOs","parameters":[{"in":"path","name":"id","description":"ID \xfanico do CT-e OS gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cteos/{id}/xml/conhecimento":{"get":{"tags":["CteOs"],"summary":"Baixar XML do CT-e OS","description":"Utilize esse endpoint para obter o XML do conhecimento enviado para a SEFAZ.\\r\\n\\r\\nO XML estar\xe1 dispon\xedvel nesse endpoint mesmo em casos que o conhecimento tenha sido rejeitado.","operationId":"BaixarXmlCteOsConhecimento","parameters":[{"in":"path","name":"id","description":"ID \xfanico da CT-e OS gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/cteos/{id}/xml/protocolo":{"get":{"tags":["CteOs"],"summary":"Baixar XML do Protocolo da SEFAZ","operationId":"BaixarXmlCteOsProtocolo","parameters":[{"in":"path","name":"id","description":"ID \xfanico da CT-e OS gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/dce":{"get":{"tags":["Dce"],"summary":"Listar DC-e","description":"Retorna a lista de DC-e de acordo com os crit\xe9rios de busca utilizados. As DC-e s\xe3o retornadas ordenadas pela data da cria\xe7\xe3o, com as mais recentes aparecendo primeiro.","operationId":"ListarDce","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ do emitente.\\r\\n\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"referencia","description":"Seu identificador \xfanico para o documento.","schema":{"type":"string"}},{"in":"query","name":"ambiente","description":"Identifica\xe7\xe3o do Ambiente.\\r\\n\\r\\nValores aceitos: homologacao, producao","required":true,"schema":{"type":"string"}},{"in":"query","name":"chave","description":"Chave de acesso do DF-e.","schema":{"type":"string"}},{"in":"query","name":"serie","description":"S\xe9rie do DF-e.","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeListagem"}}}}}},"post":{"tags":["Dce"],"summary":"Emitir DC-e","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"EmitirDce","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DcePedidoEmissao"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Dfe"}}}}}}},"/dce/sefaz/status":{"get":{"tags":["Dce"],"summary":"Consulta do Status do Servi\xe7o na SEFAZ Autorizadora","description":"Consulta do status do servi\xe7o prestado pelo Portal da Secretaria de Fazenda Estadual.\\r\\n\\r\\nA API mant\xe9m a \xfaltima consulta em cache por 5 minutos, evitando sobrecarregar desnecessariamente os servidores da SEFAZ.","operationId":"ConsultarStatusSefazDce","parameters":[{"in":"query","name":"cpf_cnpj","description":"CPF/CNPJ do emitente.\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"autorizador","description":"Ambiente Autorizador.\\r\\n\\r\\nAutorizadores dispon\xedveis: `AN`.\\r\\n\\r\\n*Caso n\xe3o seja informado, ser\xe1 utilizado o ambiente autorizador da UF do emitente.*","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeSefazStatus"}}}}}}},"/dce/{id}":{"get":{"tags":["Dce"],"summary":"Consultar DC-e","description":"Consulta os detalhes de uma DC-e j\xe1 existente. Forne\xe7a o ID \xfanico obtido de uma requisi\xe7\xe3o de emiss\xe3o ou de listagem de DC-e e a API ir\xe1 retornar as informa\xe7\xf5es da DC-e correspondente.","operationId":"ConsultarDce","parameters":[{"in":"path","name":"id","description":"ID \xfanico da DC-e gerada pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Dfe"}}}}}}},"/dce/{id}/cancelamento":{"get":{"tags":["Dce"],"summary":"Consultar o cancelamento da DC-e","operationId":"ConsultarCancelamentoDce","parameters":[{"in":"path","name":"id","description":"ID \xfanico da DC-e gerada pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeCancelamento"}}}}}},"post":{"tags":["Dce"],"summary":"Cancelar uma DC-e autorizada","description":"**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"CancelarDce","parameters":[{"in":"path","name":"id","description":"ID \xfanico da DC-e gerada pela API.","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DcePedidoCancelamento"}}}},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeCancelamento"}}}}}}},"/dce/{id}/cancelamento/xml":{"get":{"tags":["Dce"],"summary":"Baixar XML do cancelamento","operationId":"BaixarXmlCancelamentoDce","parameters":[{"in":"path","name":"id","description":"ID \xfanico da DC-e gerada pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/dce/{id}/pdf":{"get":{"tags":["Dce"],"summary":"Baixar PDF do DACE","operationId":"BaixarPdfDce","parameters":[{"in":"path","name":"id","description":"ID \xfanico da DC-e gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/dce/{id}/xml":{"get":{"tags":["Dce"],"summary":"Baixar XML da DC-e processada","description":"Utilize esse endpoint para obter o XML da DC-e enviada para a SEFAZ, complementado com a informa\xe7\xe3o do protocolo de autoriza\xe7\xe3o de uso (TAG raiz `dceProc`).\\r\\n\\r\\nO XML s\xf3 estar\xe1 dispon\xedvel nesse endpoint caso a DC-e tenha sido autorizada pela SEFAZ. Para obter o XML nos demais casos, utilize o endpoint `GET /dce/{id}/xml/declaracao`.","operationId":"BaixarXmlDce","parameters":[{"in":"path","name":"id","description":"ID \xfanico da DC-e gerada pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/dce/{id}/xml/declaracao":{"get":{"tags":["Dce"],"summary":"Baixar XML da DC-e","description":"Utilize esse endpoint para obter o XML da DC-e enviada para a SEFAZ.\\r\\n\\r\\nO XML estar\xe1 dispon\xedvel nesse endpoint mesmo em casos que a declara\xe7\xe3o tenha sido rejeitada.","operationId":"BaixarXmlDceDeclaracao","parameters":[{"in":"path","name":"id","description":"ID \xfanico da DC-e gerada pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/dce/{id}/xml/protocolo":{"get":{"tags":["Dce"],"summary":"Baixar XML do Protocolo da SEFAZ","operationId":"BaixarXmlDceProtocolo","parameters":[{"in":"path","name":"id","description":"ID \xfanico da DC-e gerada pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/debug/http-requests/{id}/request-content":{"get":{"tags":["Debug"],"summary":"Corpo da requisi\xe7\xe3o HTTP","description":"Este endpoint retorna apenas o corpo da requisi\xe7\xe3o HTTP enviada ao autorizador,\\r\\npreservando o conte\xfado exatamente como foi armazenado pela API.\\r\\n\\r\\n**Informa\xe7\xf5es retornadas**:\\r\\n- Envelope SOAP da requisi\xe7\xe3o, possivelmente compactado.\\r\\n\\r\\n**Cen\xe1rios de uso**:\\r\\n- Verifica\xe7\xe3o do XML ou SOAP efetivamente enviado.\\r\\n- Encaminhamento ao suporte da SEFAZ ou prefeitura para an\xe1lise.\\r\\n- Diagn\xf3stico t\xe9cnico do conte\xfado de envio.","operationId":"DebugHttpRequestContent","parameters":[{"in":"path","name":"id","description":"ID da requisi\xe7\xe3o HTTP.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/debug/http-requests/{id}/response-content":{"get":{"tags":["Debug"],"summary":"Corpo da resposta HTTP","description":"Este endpoint retorna apenas o corpo da resposta HTTP recebida do autorizador,\\r\\npermitindo an\xe1lise t\xe9cnica da mensagem retornada pela SEFAZ ou prefeitura.\\r\\n\\r\\n**Informa\xe7\xf5es retornadas**:\\r\\n- Envelope SOAP da resposta, ou mensagem de erro (ex: HTML, XML), no formato original.\\r\\n\\r\\n**Cen\xe1rios de uso**:\\r\\n- Inspe\xe7\xe3o da resposta real retornada pelo autorizador.\\r\\n- Encaminhamento do conte\xfado ao suporte t\xe9cnico.\\r\\n- Diagn\xf3stico de rejei\xe7\xf5es, falhas de processamento ou erros de infraestrutura.","operationId":"DebugHttpResponseContent","parameters":[{"in":"path","name":"id","description":"ID da requisi\xe7\xe3o HTTP.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/debug/{id}":{"get":{"tags":["Debug"],"summary":"Debug de DF-e","description":"Este endpoint retorna informa\xe7\xf5es detalhadas de debug sobre o processamento de um documento fiscal eletr\xf4nico (DFe),\\r\\ncomo NF-e, NFC-e, MDF-e, CT-e, NFS-e, dentre outros. Ele permite inspecionar o conte\xfado original enviado \xe0 API e analisar\\r\\ntodas as intera\xe7\xf5es realizadas com os servi\xe7os autorizadores (SEFAZ ou prefeituras) durante o fluxo de emiss\xe3o.\\r\\n\\r\\n**Informa\xe7\xf5es retornadas**:\\r\\n- JSON original recebido no momento da cria\xe7\xe3o do documento.\\r\\n- Hist\xf3rico das etapas de envio e consulta.\\r\\n- Status e mensagens retornadas pelo autorizador.\\r\\n\\r\\n**Cen\xe1rios de uso**:\\r\\n- Diagn\xf3stico de falhas no processamento do documento.\\r\\n- Verifica\xe7\xe3o da resposta da SEFAZ ou prefeitura.\\r\\n- Apoio ao suporte t\xe9cnico e an\xe1lise de integra\xe7\xe3o.","operationId":"DebugDfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do documento fiscal gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DfeDebug"}}}}}}},"/debug/{id}/original-payload":{"get":{"tags":["Debug"],"summary":"Payload original recebido","description":"Este endpoint retorna o conte\xfado original recebido pela API no momento da cria\xe7\xe3o do documento fiscal.\\r\\n\\r\\n**Cen\xe1rios de uso**:\\r\\n- Inspe\xe7\xe3o detalhada dos dados enviados \xe0 API.\\r\\n- Verifica\xe7\xe3o de diverg\xeancias entre o payload fornecido e o processado.\\r\\n- Encaminhamento do conte\xfado original ao suporte da API.","operationId":"DebugDfeOriginalPayload","parameters":[{"in":"path","name":"id","description":"ID do documento fiscal gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/distribuicao/nfe":{"get":{"tags":["Distribui\xe7\xe3o NF-e"],"summary":"Listar distribui\xe7\xf5es","description":"Retorna a lista de distribui\xe7\xf5es de NF-e de acordo com os crit\xe9rios de busca utilizados. As distribui\xe7\xf5es s\xe3o retornadas ordenadas pela data da cria\xe7\xe3o, com as mais recentes aparecendo primeiro.","operationId":"ListarDistribuicaoNfe","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ da pessoa ou empresa interessada.\\r\\n\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"ambiente","description":"Identifica\xe7\xe3o do Ambiente.\\r\\n\\r\\nValores aceitos: homologacao, producao","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DistribuicaoNfeListagem"}}}}}},"post":{"tags":["Distribui\xe7\xe3o NF-e"],"summary":"Distribuir documentos","description":"Este endpoint permite que o destinat\xe1rio obtenha Documentos Fiscais\\r\\nEletr\xf4nicos (DF-e) emitidos contra o seu CNPJ ou CPF ou que seja de\\r\\nseu interesse. A distribui\xe7\xe3o pode ser feita de tr\xeas formas:\\r\\n*dist-nsu*, *cons-nsu* e *cons-chave*.\\r\\n\\r\\n**Formas de Consulta**:\\r\\n- *dist-nsu*: Consulta pelo \xfaltimo NSU recebido.\\r\\n- *cons-nsu*: Consulta por um NSU espec\xedfico.\\r\\n- *cons-chave*: Consulta pela chave de acesso da NF-e.\\r\\n\\r\\n**Retorno da Solicita\xe7\xe3o**\\r\\n\\r\\nA resposta da solicita\xe7\xe3o inclui a propriedade *status* no JSON, que\\r\\npode ter os seguintes valores:\\r\\n- *processando*: A solicita\xe7\xe3o est\xe1 em andamento.\\r\\n- *concluido*: A solicita\xe7\xe3o foi processada com sucesso.\\r\\n- *erro*: Ocorreu um erro no processamento da solicita\xe7\xe3o.\\r\\n\\r\\nSe o status retornado for *processando*, significa que a solicita\xe7\xe3o est\xe1\\r\\nsendo realizada de forma ass\xedncrona pela API. Nesse caso, o usu\xe1rio dever\xe1\\r\\nadotar um fluxo que consiste em requisitar periodicamente o endpoint\\r\\n<a href=\\"#tag/Distribuicao-NF-e/operation/ConsultarDistribuicaoNfe\\">consultar distribui\xe7\xe3o</a> at\xe9 que\\r\\na API retorne o pedido com um status indicando o fim do\\r\\nprocessamento (concluido ou erro).\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por documento distribu\xeddo (retornado) ou requisi\xe7\xe3o.","operationId":"GerarDistribuicaoNfe","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DistribuicaoNfePedido"}}},"required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DistribuicaoNfe"}}}}}}},"/distribuicao/nfe/documentos":{"get":{"tags":["Distribui\xe7\xe3o NF-e"],"summary":"Listar documentos","description":"Retorna a lista de documentos fiscais eletr\xf4nicos de interesse da pessoa ou empresa de acordo com os crit\xe9rios de busca utilizados. Os documentos s\xe3o retornadas ordenados pela data da cria\xe7\xe3o, com os mais recentes aparecendo primeiro.","operationId":"ListarDocumentoDistribuicaoNfe","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ da pessoa ou empresa interessada.\\r\\n\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"ambiente","description":"Identifica\xe7\xe3o do Ambiente.\\r\\n\\r\\nValores aceitos: homologacao, producao","required":true,"schema":{"type":"string"}},{"in":"query","name":"dist_nsu","description":"Filtrar por documentos a partir do NSU informado.","schema":{"type":"integer","format":"int64"}},{"in":"query","name":"tipo_documento","description":"Filtrar pelo tipo do documento de interesse da pessoa ou empresa.\\r\\n\\r\\nValores aceitos: `nota`, `evento`","schema":{"type":"string"}},{"in":"query","name":"forma_distribuicao","description":"Filtrar por documentos que foram distribu\xeddos em sua forma resumida ou completa.\\r\\n\\r\\nValores aceitos: `resumida`, `completa`","schema":{"type":"string"}},{"in":"query","name":"chave_acesso","description":"Filtrar pela chave de acesso da NF-e.","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DistribuicaoNfeDocumentoListagem"}}}}}}},"/distribuicao/nfe/documentos/{id}":{"get":{"tags":["Distribui\xe7\xe3o NF-e"],"summary":"Consultar documento","description":"Utilize esse endpoint para obter as informa\xe7\xf5es resumidas ou documento fiscal de interesse da pessoa ou empresa interessada.","operationId":"ConsultarDocumentoDistribuicaoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do documento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DistribuicaoNfeDocumento"}}}}}}},"/distribuicao/nfe/documentos/{id}/pdf":{"get":{"tags":["Distribui\xe7\xe3o NF-e"],"summary":"Baixar PDF do documento","description":"Utilize esse endpoint para obter o PDF do documento.\\r\\n\\r\\nSchemas suportados:\\r\\n* procNFe_v4.00.xsd","operationId":"BaixarPdfDocumentoDistribuicaoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do documento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/distribuicao/nfe/documentos/{id}/xml":{"get":{"tags":["Distribui\xe7\xe3o NF-e"],"summary":"Baixar XML do documento","description":"Utilize esse endpoint para obter o XML das informa\xe7\xf5es resumidas ou documento fiscal de interesse da pessoa ou empresa interessada.","operationId":"BaixarXmlDocumentoDistribuicaoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico do documento gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"*/*":{"schema":{"type":"string","format":"binary"}}}}}}},"/distribuicao/nfe/manifestacoes":{"get":{"tags":["Distribui\xe7\xe3o NF-e"],"summary":"Listar Manifesta\xe7\xf5es","description":"Retorna a lista de manifesta\xe7\xf5es de NF-e de acordo com os crit\xe9rios de busca utilizados. As manifesta\xe7\xf5es s\xe3o retornadas ordenadas pela data da cria\xe7\xe3o, com as mais recentes aparecendo primeiro.","operationId":"ListarManifestacaoNfe","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ do autor do evento.\\r\\n\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"ambiente","description":"Identifica\xe7\xe3o do Ambiente.\\r\\n\\r\\nValores aceitos: homologacao, producao","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ManifestacaoNfeListagem"}}}}}},"post":{"tags":["Distribui\xe7\xe3o NF-e"],"summary":"Manifestar nota","description":"O processo de manifesta\xe7\xe3o do destinat\xe1rio permite que os destinat\xe1rios\\r\\nde Notas Fiscais Eletr\xf4nicas (NF-e) registrem formalmente sua posi\xe7\xe3o em\\r\\nrela\xe7\xe3o \xe0s opera\xe7\xf5es descritas nesses documentos fiscais. Ele envolve\\r\\neventos que indicam se a opera\xe7\xe3o foi confirmada, desconhecida ou\\r\\nn\xe3o realizada.\\r\\n\\r\\nOs seguintes tipos de manifesta\xe7\xe3o s\xe3o suportados pela NF-e:\\r\\n* **Confirma\xe7\xe3o da Opera\xe7\xe3o (210200)**: Manifesta\xe7\xe3o do destinat\xe1rio confirmando que a opera\xe7\xe3o descrita na NF-e ocorreu exatamente como informado na NF-e. Esse evento libera a possibilidade de download da NF-e pelo destinat\xe1rio e impede que a empresa emitente cancele a NF-e ap\xf3s a confirma\xe7\xe3o.\\r\\n* **Ci\xeancia da Opera\xe7\xe3o (210210)**: Declara que o destinat\xe1rio tem ci\xeancia da exist\xeancia da NF-e, mas ainda n\xe3o possui elementos suficientes para manifestar-se conclusivamente. Este \xe9 um evento opcional que pode ser usado pelo destinat\xe1rio para indicar que est\xe1 ciente da NF-e enquanto coleta mais informa\xe7\xf5es. Esse evento libera a possibilidade de download da NF-e pelo destinat\xe1rio.\\r\\n* **Desconhecimento da Opera\xe7\xe3o (210220)**: Manifesta\xe7\xe3o do destinat\xe1rio declarando que a opera\xe7\xe3o descrita da NF-e n\xe3o foi por ele solicitada.\\r\\n* **Opera\xe7\xe3o n\xe3o Realizada (210240)**: Manifesta\xe7\xe3o do destinat\xe1rio reconhecendo sua participa\xe7\xe3o na opera\xe7\xe3o descrita na NF-e, mas declarando que a opera\xe7\xe3o n\xe3o ocorreu ou n\xe3o se efetivou como informado nesta NF-e.\\r\\n\\r\\n**Informa\xe7\xf5es adicionais**:\\r\\n- Cota: <a href=\\"/docs/limites#dfe-eventos\\">dfe-eventos</a>\\r\\n- Consumo: 1 unidade por requisi\xe7\xe3o.","operationId":"ManifestarNfe","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DistribuicaoNfePedidoManifestacao"}}},"description":"Cont\xe9m os dados do pedido para manifesta\xe7\xe3o do destinat\xe1rio.","required":true},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DistribuicaoNfeEvento"}}}}}}},"/distribuicao/nfe/manifestacoes/{id}":{"get":{"tags":["Distribui\xe7\xe3o NF-e"],"summary":"Consultar manifesta\xe7\xe3o","description":"Consulta os detalhes de uma manifesta\xe7\xe3o de NF-e j\xe1 existente. Forne\xe7a o ID \xfanico obtido de uma requisi\xe7\xe3o de manifesta\xe7\xe3o ou de listagem de manifesta\xe7\xf5es e a API ir\xe1 retornar as informa\xe7\xf5es da manifesta\xe7\xe3o correspondente.","operationId":"ConsultarManifestacaoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico da manifesta\xe7\xe3o gerado pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DistribuicaoNfeEvento"}}}}}}},"/distribuicao/nfe/notas-sem-manifestacao":{"get":{"tags":["Distribui\xe7\xe3o NF-e"],"summary":"Listar notas sem manifesta\xe7\xe3o","description":"No processo de distribui\xe7\xe3o de DF-e, as notas fiscais eletr\xf4nicas (NF-e)\\r\\ns\xe3o inicialmente disponibilizadas de forma resumida. Para obter o XML\\r\\ncompleto, o destinat\xe1rio deve manifestar a ci\xeancia da opera\xe7\xe3o e,\\r\\nposteriormente, uma manifesta\xe7\xe3o conclusiva dentro de um prazo legal.\\r\\n\\r\\nPara facilitar essa gest\xe3o e o cumprimento dos prazos legais de manifesta\xe7\xe3o,\\r\\na API permite listar as notas que ainda n\xe3o\\r\\npossuem manifesta\xe7\xe3o, ajudando os usu\xe1rios a identificar rapidamente as\\r\\nnotas que necessitam de a\xe7\xe3o.\\r\\n\\r\\nO usu\xe1rio pode optar por listar apenas as notas que n\xe3o possuem manifesta\xe7\xe3o\\r\\nconclusiva ou que n\xe3o possuem qualquer tipo de manifesta\xe7\xe3o. Essa flexibilidade\\r\\npermite um controle mais preciso e adequado \xe0s necessidades operacionais\\r\\nde cada empresa.\\r\\n\\r\\nOs documentos s\xe3o retornados ordenados decrescentemente pela data de\\r\\ndistribui\xe7\xe3o, permitindo uma visualiza\xe7\xe3o clara e organizada das notas\\r\\nmais recentes.\\r\\n\\r\\n**Cen\xe1rios de uso:**\\r\\n* Identificar rapidamente as notas que ainda precisam de manifesta\xe7\xe3o para obter o XML completo.\\r\\n* Listar todas as notas fiscais eletr\xf4nicas que foram registradas com ci\xeancia da opera\xe7\xe3o, mas ainda n\xe3o possuem uma manifesta\xe7\xe3o conclusiva (confirma\xe7\xe3o da opera\xe7\xe3o, desconhecimento da opera\xe7\xe3o ou opera\xe7\xe3o n\xe3o realizada).\\r\\n* Listar todas as notas fiscais eletr\xf4nicas que n\xe3o possuem nenhum tipo de manifesta\xe7\xe3o registrada (nem ci\xeancia da opera\xe7\xe3o, nem manifesta\xe7\xe3o conclusiva).","operationId":"ListarNfeSemManifestacao","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ da pessoa ou empresa interessada.\\r\\n\\r\\nUtilize o valor sem m\xe1scara.","required":true,"schema":{"type":"string"}},{"in":"query","name":"ambiente","description":"Identifica\xe7\xe3o do Ambiente.\\r\\n\\r\\nValores aceitos: homologacao, producao","required":true,"schema":{"type":"string"}},{"in":"query","name":"conclusiva","description":"Indica se ser\xe3o consideradas apenas as manifesta\xe7\xf5es conclusivas.\\r\\n\\r\\nValores:\\r\\n* `false`: ser\xe3o retornadas notas que n\xe3o possu\xedrem qualquer tipo de\\r\\n  manifesta\xe7\xe3o.\\r\\n\\r\\n* `true`: apenas as notas que n\xe3o possu\xedrem manifesta\xe7\xe3o conclusiva\\r\\n  ser\xe3o retornadas. Ou seja, notas que tenham sido manifestadas apenas\\r\\n  com Ci\xeancia da Opera\xe7\xe3o (210210) continuar\xe3o sendo retornadas por\\r\\n  esse endpoint at\xe9 que recebam uma manifesta\xe7\xe3o conclusiva.","schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DistribuicaoNfeNotaListagem"}}}}}}},"/distribuicao/nfe/{id}":{"get":{"tags":["Distribui\xe7\xe3o NF-e"],"summary":"Consultar distribui\xe7\xe3o","operationId":"ConsultarDistribuicaoNfe","parameters":[{"in":"path","name":"id","description":"ID \xfanico da distribui\xe7\xe3o de NF-e gerada pela API.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DistribuicaoNfe"}}}}}}},"/emails":{"get":{"tags":["Email"],"summary":"Listar e-mails","description":"Retorna a lista dos emails associadas \xe0 sua conta. Os e-emails s\xe3o\\r\\nretornados ordenados pela data da cria\xe7\xe3o, com os mais recentes\\r\\naparecendo primeiro.","operationId":"ListarEmails","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtra pelo CPF ou CNPJ da empresa.\\r\\n\\r\\n*Utilize o valor sem m\xe1scara*.","required":true,"schema":{"type":"string"}},{"in":"query","name":"undelivered","description":"Filtra apenas emails com problemas de entrega.","schema":{"type":"boolean"}},{"in":"query","name":"email","description":"Filtra pelo endere\xe7o de e-mail do destinat\xe1rio para qual o email foi enviado.","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EmailListagem"}}}}}}},"/emails/{id}":{"get":{"tags":["Email"],"summary":"Consultar e-mail","description":"Obt\xe9m informa\xe7\xf5es detalhadas sobre o envio de um email. Este endpoint\\r\\npermite rastrear todos os eventos relacionados ao email, como envio,\\r\\nentrega, falhas e outros eventos relevantes.\\r\\n\\r\\nCom este endpoint, \xe9 poss\xedvel ter uma vis\xe3o completa do ciclo de vida\\r\\nde um email enviado, permitindo que os usu\xe1rios acompanhem e analisem\\r\\no status e o hist\xf3rico de eventos do email. Isso \xe9 particularmente\\r\\n\xfatil para identificar problemas de entrega e entender o comportamento\\r\\ndo email ao longo do tempo.","operationId":"ConsultarEmail","parameters":[{"in":"path","name":"id","description":"ID \xfanico do e-mail.\\r\\n\\r\\nEsse par\xe2metro \xe9 obtido ap\xf3s o envio do email por qualquer endpoint da\\r\\nAPI que realize disparos de email.\\r\\n\\r\\nExemplos:\\r\\n* <a href=\\"#tag/Nfe/operation/EnviarEmailNfe\\">Envio de XML e PDF de NF-e</a>.\\r\\n* <a href=\\"#tag/Nfce/operation/EnviarEmailNfce\\">Envio de XML e PDF de NFC-e</a>.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Email"}}}}}}},"/empresas":{"get":{"tags":["Empresa"],"summary":"Listar empresas","description":"Retorna a lista das empresas associadas \xe0 sua conta. As empresas s\xe3o retornadas ordenadas pela data da cria\xe7\xe3o, com as mais recentes aparecendo primeiro.","operationId":"ListarEmpresas","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados pela API, entre 1 e 100.","schema":{"type":"integer","default":10}},{"in":"query","name":"$skip","description":"Quantidade de objetos que ser\xe3o ignorados antes da lista come\xe7ar a ser retornada.","schema":{"type":"integer","default":0}},{"in":"query","name":"$inlinecount","description":"Inclui no JSON de resposta, na propriedade `@count`, o n\xfamero total de registros que o filtro retornaria, independente dos filtros de pagina\xe7\xe3o.","schema":{"type":"boolean","default":false}},{"in":"query","name":"cpf_cnpj","description":"Filtrar pelo CPF ou CNPJ da empresa.\\r\\n\\r\\n*Utilize o valor sem m\xe1scara*.","schema":{"type":"string"}},{"in":"query","name":"nome_razao_social","description":"Filtrar pelo nome ou raz\xe3o social da empresa.\\r\\n\\r\\nEsse filtro realiza uma correspond\xeancia pelo in\xedcio do texto,\\r\\nretornando apenas empresas cujo nome ou raz\xe3o social come\xe7am com\\r\\no valor informado.\\r\\n\\r\\n*Caso o filtro pelo CPF ou CNPJ tamb\xe9m seja informado na requisi\xe7\xe3o,\\r\\neste filtro \xe9 ignorado*.","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EmpresaListagem"}}}}}},"post":{"tags":["Empresa"],"summary":"Cadastrar empresa","description":"Cadastre uma nova empresa (emitente ou prestador) \xe0 sua conta.","operationId":"CriarEmpresa","requestBody":{"$ref":"#/components/requestBodies/Empresa"},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Empresa"}}}}}}},"/empresas/certificados":{"get":{"tags":["Empresa"],"summary":"Listar certificados","description":"Retorna a lista dos certificados associadas \xe0 sua conta. Os certificados s\xe3o retornados ordenados pela data da cria\xe7\xe3o, com as mais recentes aparecendo primeiro.","operationId":"ListarCertificados","parameters":[{"in":"query","name":"$top","description":"Limite no n\xfamero de objetos a serem retornados 