resa desenvolvedora do sistema utilizado na emiss\xe3o do documento fiscal eletr\xf4nico. No caso de pessoa f\xedsica, informar o respectivo nome.","maxLength":60,"minLength":2,"nullable":true},"email":{"type":"string","description":"Email da pessoa jur\xeddica a ser contatada.","maxLength":60,"minLength":1,"nullable":true},"fone":{"type":"string","description":"Telefone da pessoa jur\xeddica a ser contatada.\\r\\nPreencher com o C\xf3digo DDD + n\xfamero do telefone.","nullable":true},"idCSRT":{"type":"integer","description":"Identificador do c\xf3digo de seguran\xe7a do respons\xe1vel t\xe9cnico.\\r\\nIdentificador do CSRT utilizado para gera\xe7\xe3o do hash.","maximum":999,"minimum":0,"nullable":true},"CSRT":{"type":"string","description":"C\xf3digo de Seguran\xe7a do Respons\xe1vel T\xe9cnico utilizado para montar o hash do CSRT.","nullable":true},"hashCSRT":{"type":"string","description":"Hash do token do c\xf3digo de seguran\xe7a do respons\xe1vel t\xe9cnico.\\r\\nO hashCSRT \xe9 o resultado das fun\xe7\xf5es SHA-1 e base64 do token CSRT fornecido pelo fisco + chave de acesso do DF-e. (Implementa\xe7\xe3o em futura NT)\\r\\nObserva\xe7\xe3o: 28 caracteres s\xe3o representados no schema como 20 bytes do tipo base64Binary.\\r\\n\\r\\n*Se n\xe3o informado, ser\xe1 calculado automaticamente, desde que os campos `idCSRT` e `CSRT` sejam fornecidos.*","maxLength":28,"nullable":true}},"required":["fone","email","xContato","CNPJ"]},"CteSefazInfSolicNFF":{"type":"object","description":"Grupo de informa\xe7\xf5es do pedido de emiss\xe3o da Nota Fiscal F\xe1cil.","properties":{"xSolic":{"type":"string","description":"Solicita\xe7\xe3o do pedido de emiss\xe3o da NFF.\\r\\nSer\xe1 preenchido com a totalidade de campos informados no aplicativo emissor serializado.","maxLength":8000,"minLength":2,"nullable":true}},"required":["xSolic"]},"CteSefazInfCTeSupl":{"type":"object","description":"Informa\xe7\xf5es suplementares do CT-e.","properties":{"qrCodCTe":{"type":"string","de