\xf5es.","properties":{"pesoBC":{"type":"number","description":"Peso Base de C\xe1lculo de Frete em Toneladas.","minimum":0,"nullable":true},"pesoR":{"type":"number","description":"Peso Real em Toneladas.","minimum":0,"nullable":true},"tpVag":{"type":"string","description":"Tipo de Vag\xe3o.","maxLength":3,"nullable":true},"serie":{"type":"string","description":"Serie de Identifica\xe7\xe3o do vag\xe3o.","maxLength":3,"nullable":true},"nVag":{"type":"integer","description":"N\xfamero de Identifica\xe7\xe3o do vag\xe3o.","maximum":99999999,"minimum":1,"nullable":true},"nSeq":{"type":"integer","description":"Sequencia do vag\xe3o na composi\xe7\xe3o.","maximum":999,"minimum":1,"nullable":true},"TU":{"type":"number","description":"Tonelada \xdatil.\\r\\nUnidade de peso referente \xe0 carga \xfatil (apenas o peso da carga transportada), expressa em toneladas.","nullable":true}},"required":["TU","nVag","serie","pesoR","pesoBC"]},"MdfeSefazInfDoc":{"type":"object","description":"Informa\xe7\xf5es dos Documentos fiscais vinculados ao manifesto.","properties":{"infMunDescarga":{"type":"array","items":{"$ref":"#/components/schemas/MdfeSefazInfMunDescarga"},"maxItems":1000,"minItems":1}},"required":["infMunDescarga"]},"MdfeSefazInfMunDescarga":{"type":"object","description":"Informa\xe7\xf5es dos Munic\xedpios de descarregamento.","properties":{"cMunDescarga":{"type":"string","description":"C\xf3digo do Munic\xedpio de Descarregamento.","nullable":true},"xMunDescarga":{"type":"string","description":"Nome do Munic\xedpio de Descarregamento.","maxLength":60,"minLength":2,"nullable":true},"infCTe":{"type":"array","items":{"$ref":"#/components/schemas/MdfeSefazInfCTe"},"maxItems":20000},"infNFe":{"type":"array","items":{"$ref":"#/components/schemas/MdfeSefazInfNFe"},"maxItems":20000},"infMDFeTransp":{"type":"array","items":{"$ref":"#/components/schemas/MdfeSefazInfMDFeTransp"},"maxItems":20000}},"required":["xMunDescarga","cMunDescarga"]},"MdfeSefazInfCTe":{"type":"object","descr