# ─── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=your-jwt-secret-min-32-chars

# ─── WhatsApp / Meta ──────────────────────────────────────────────────────────
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret-for-hmac

# ─── OpenAI (platform-level key — used for SupportCopilot fallback) ──────────
OPENAI_API_KEY=sk-...

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_STARTER=price_...

# ─── Asaas (transactional payments) ──────────────────────────────────────────
ASAAS_API_KEY=your-asaas-api-key
ASAAS_WEBHOOK_SECRET=your-asaas-webhook-secret
ASAAS_ENV=sandbox  # or production

# ─── OpenCrow Agent Orchestration ────────────────────────────────────────────
# Leave blank to disable OpenCrow — the system falls back to deterministic logic.
OPENCROW_BASE_URL=https://api.opencrow.ai
OPENCROW_API_KEY=your-opencrow-api-key
OPENCROW_PROJECT_ID=your-opencrow-project-id
# Timeout in ms for synchronous agent calls (default: 2800)
OPENCROW_TIMEOUT_MS=2800

# ─── Agent Gateway ────────────────────────────────────────────────────────────
# Public base URL of THIS app — used so OpenCrow can call back to agent tool routes.
AGENT_GATEWAY_BASE_URL=https://your-app.onrender.com
# Secret that OpenCrow sends in X-Agent-Secret header when calling agent tools.
# Generate with: openssl rand -hex 32
AGENT_GATEWAY_SECRET=your-32-char-random-secret

# ─── Circuit breaker (optional tuning) ───────────────────────────────────────
# Failures before opening circuit (default: 3)
AGENT_CB_FAILURE_THRESHOLD=3
# Cooldown in ms before half-open probe (default: 30000)
AGENT_CB_COOLDOWN_MS=30000

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ─── Crow AI Widget ──────────────────────────────────────────────────────────
# Set NEXT_PUBLIC_CROW_ENABLED=true to mount the Crow copilot in the dashboard.
NEXT_PUBLIC_CROW_ENABLED=false
# Product ID from usecrow.ai dashboard (already baked into CrowWidget.tsx as fallback)
NEXT_PUBLIC_CROW_PRODUCT_ID=user_3ByBdX8BL31d1keEC6Pej4d2F7y
# HMAC-SHA256 secret used at /api/crow-token to sign the userId for Crow identity.
# Copy from: usecrow.ai → Product → Settings → "Segredo de Verificação"
CROW_VERIFICATION_SECRET=your-crow-verification-secret
# Service key sent by Crow's MCP server in requests to your backend.
# Copy from: usecrow.ai → Product → Settings → "Chave de serviço"
MCP_SERVICE_KEY=your-crow-service-key

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.onrender.com
NEXTAUTH_URL=https://your-app.onrender.com
