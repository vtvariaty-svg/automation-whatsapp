  tenantId    String
  contactId   String // historically: phone string. After phase 1: may be Contact.id
  name        String?
  preferences String?  @db.Text
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // nullable FK → Contact (set during backfill / new creates)
  realContactId String?  @unique
  contact       Contact? @relation("ContactMemory", fields: [realContactId], references: [id], onDelete: SetNull)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contactId])
  @@map("customer_memories")
}

model SalesEvent {
  id          String   @id @default(uuid())
  tenantId    String
  contactId   String // Can point to a customer phone or a specific customer ID if applicable
  productId   String
  checkoutUrl String
  status      String   @default("created") // created, paid, cancelled
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId, status])
}

model SalesOpportunity {
  id            String   @id @default(uuid())
  tenantId      String
  contactId     String // WhatsApp phone or customer ID
  productId     String?
  value         Float?
  status        String   @default("novo_lead") // novo_lead, interessado, checkout_enviado, pago, pos_venda
  followUp1Sent Boolean  @default(false)
  followUp2Sent Boolean  @default(false)
  followUp3Sent Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([tenantId, status])
}

// ─── M1 Instagram ─────────────────────────────────────────────────────────────

model InstagramConnection {
  id             String    @id @default(uuid())
  tenantId       String    @unique
  pageId         String? // deprecated: not used in Instagram Login architecture
  accessToken    String? // encrypted IG user access token
  igAccountId    String? // IG user ID (runtime source of truth)
