generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String          @id @default(uuid())
  name                String
  businessDescription String?
  businessType        String?
  phone               String?
  whatsappPhoneNumberId String?
  whatsappPhoneId     String?
  whatsappBusinessAccountId String?
  whatsappToken       String?
  openaiKey           String?
  aiPrompt            String? @db.Text
  welcomeMessage      String? @db.Text
  businessHours       String?
  createdAt           DateTime        @default(now())
  users               User[]
  conversations       Conversation[]
  products            Product[]
  orders              Order[]
  appointments        Appointment[]
  businessConfig      BusinessConfig?
  subscription        Subscription?
}

model BusinessConfig {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  openingHours String?
  address      String?
  faqJson      String?  @db.Text
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  price       Float    @default(0.0)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String?
  email        String   @unique
  passwordHash String?
  facebookId   String?  @unique
  instagramId  String?  @unique
  role         String   @default("user")
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
}

model Conversation {
  id            String    @id @default(uuid())
  tenantId      String
  customerPhone String
  status        String    @default("ai")
  createdAt     DateTime  @default(now())
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  messages      Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Subscription {
  id                    String    @id @default(uuid())
  tenantId              String    @unique
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  plan                  String    @default("starter")
  status                String    @default("trialing")
  usageMessages         Int       @default(0)
  trialEnd              DateTime?
  currentPeriodEnd      DateTime?
  createdAt             DateTime  @default(now())
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
}

model Order {
  id            String   @id @default(uuid())
  tenantId      String
  customerPhone String
  customerName  String?
  product       String?
  price         Float    @default(0.0)
  status        String   @default("novo") // novo, confirmado, preparando, enviado, finalizado
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}

model Appointment {
  id            String   @id @default(uuid())
  tenantId      String
  customerPhone String
  customerName  String?
  service       String?
  date          String?  // YYYY-MM-DD
  time          String?  // HH:MM
  status        String   @default("agendado") // agendado, confirmado, cancelado, concluido
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}
