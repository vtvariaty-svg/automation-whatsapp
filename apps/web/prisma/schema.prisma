// ─── PAY1 — Transactional Payments ────────────────────────────────────────────

// Asaas credentials per tenant — never returned to frontend
model TenantPaymentConfig {
  id               String   @id @default(uuid())
  tenantId         String   @unique
  provider         String   @default("asaas")
  environment      String   @default("sandbox") // sandbox | production
  enabled          Boolean  @default(false)
  apiKey           String   // server-side only — never exposed to frontend
  webhookAuthToken String   // validated against asaas-access-token header
  webhookId        String?  // Asaas webhook registration ID (for update/delete)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_payment_configs")
}

// Individual charge (Asaas POST /v3/payments)
model Payment {
  id                 String    @id @default(uuid())
  tenantId           String
  // PAY-INT1: source type and traceability links
  sourceType         String    @default("standalone") // order | appointment | standalone
  orderId            String?
  appointmentId      String?
  contactId          String?   // traceability to Contact
  conversationId     String?   // traceability to originating Conversation
  provider           String    @default("asaas")
  providerPaymentId  String?   @unique // Asaas payment ID
  providerCustomerId String?   // Asaas customer ID — reused on future charges
  invoiceUrl         String?   // link sent to customer
  pixCopiaECola      String?   // pix copy-paste code (when billingType=PIX)
  pixQrCodeBase64    String?   // base64 QR code image (when billingType=PIX)
  // status: pending | confirmed | failed | refunded | canceled | overdue
  status             String    @default("pending")
  amount             Float
  currency           String    @default("BRL")
  description        String?
  customerName       String
  customerPhone      String
  customerEmail      String?
  customerCpfCnpj    String?
  dueDate            String    // YYYY-MM-DD
  // billingType: BOLETO | PIX | CREDIT_CARD | UNDEFINED (customer chooses)
  billingType        String    @default("UNDEFINED")
  paidAt             DateTime?
  failedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Payment → Order (find which order this payment is for)
  order       Order?       @relation("PaymentToOrder", fields: [orderId], references: [id], onDelete: SetNull)
  // Payment → Appointment (find which appointment this payment is for)
  appointment Appointment? @relation("PaymentToAppointment", fields: [appointmentId], references: [id], onDelete: SetNull)
  // PAY-INT1: traceability relations
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  // Back-relations (Order/Appointment → this Payment, via their paymentId FK)
  orderRef       Order?       @relation("OrderActivePayment")
  appointmentRef Appointment? @relation("AppointmentActivePayment")
  events         PaymentEvent[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, contactId])
  @@index([tenantId, conversationId])
  @@map("payments")
}

// Webhook event audit log — providerEventId unique = idempotency gate
model PaymentEvent {
  id               String   @id @default(uuid())
  paymentId        String
  tenantId         String
  providerEventId  String   @unique // Asaas event.id — insert failure = duplicate = skip
  eventType        String   // PAYMENT_RECEIVED | PAYMENT_CONFIRMED | PAYMENT_OVERDUE | PAYMENT_DELETED | PAYMENT_REFUNDED
  payload          Json     // full raw webhook body
  // processingStatus: processed | ignored_duplicate | failed
  processingStatus String   @default("processed")
  errorMessage     String?
  processedAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([tenantId, eventType])
  @@map("payment_events")
}

// ─── MOD1 — Feature Flags (superadmin kill switch global) ────────────────────
