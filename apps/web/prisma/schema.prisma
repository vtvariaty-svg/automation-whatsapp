  scenario   String // e.g. "comment_to_dm_flow"
  status     String    @default("pending") // pending, running, passed, failed, partial
  steps      Json // StepResult[]
  summary    String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([tenantId, createdAt])
  @@map("sandbox_runs")
}

// ─── TD1 Template Delivery (Broadcasts) ───────────────────────────────────────

model TemplateBroadcast {
  id              String    @id @default(uuid())
  tenantId        String
  templateName    String
  templateLang    String    @default("pt_BR")
  variables       Json?
  status          String    @default("draft") // draft|scheduled|processing|completed|partially_failed|failed|cancelled
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  totalRecipients Int       @default(0)
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  createdBy       String?
  source          String? // manual|automation|follow_up
  idempotencyKey  String?   @unique
  createdAt       DateTime  @default(now())

  tenant     Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients TemplateBroadcastRecipient[]

  @@index([tenantId, status])
  @@index([status, scheduledAt])
  @@map("template_broadcasts")
}

model TemplateBroadcastRecipient {
  id            String    @id @default(uuid())
  broadcastId   String
  phone         String
  customerName  String?
  variables     Json?
  status        String    @default("pending") // pending|accepted|sent|delivered|read|failed|skipped
  metaMessageId String? // wamid returned by Meta Graph API — used to correlate delivery webhook events
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  broadcast TemplateBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, phone])
  @@index([broadcastId, status])
  @@map("template_broadcast_recipients")
}

// ─── TD2 Custom Templates (tenant-managed, submitted to Meta for approval) ────

model CustomTemplate {
  id             String    @id @default(uuid())
  tenantId       String
  name           String // snake_case, unique per tenant
  category       String    @default("UTILITY") // UTILITY | MARKETING | AUTHENTICATION
  language       String    @default("pt_BR")
  body           String
  header         String?
  footer         String?
  exampleVars    String[]  @default([]) // example values for {{1}}, {{2}}... (required by Meta)
  metaTemplateId String? // ID returned by Meta after submission
  status         String    @default("DRAFT") // DRAFT | PENDING | APPROVED | REJECTED
  rejectedReason String?
  lastSyncAt     DateTime? // last successful sync with Meta provider
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("custom_templates")
}

// ─── Fiscal Integration Records ───────────────────────────────────────────────

model FiscalEmissionRecord {
  id                  String   @id @default(cuid())
  tenantId            String
  externalReferenceId String
  invoiceId           String?
  requestId           String?
  protocol            String?
  status              String // local FiscalDocumentStatus value (e.g. autorizado, emitido_mock)
  rawStatus           String? // original status string returned by NFE_WEB (e.g. AUTHORIZED) — preserved for traceability
  mode                String   @default("real") // "real" | "mock"
  tipo                String   @default("nfe")
  customerNome        String
  customerDocumento   String
  total               Float    @default(0)
  itensJson           String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, externalReferenceId])
  @@map("fiscal_emission_records")
}

// ─── Migration & Audit (Wave 2) ────────────────────────────────────────────────

model MigrationAudit {
  id             String               @id @default(cuid())
  tenantId       String
  mode           String // dry-run | apply
  status         String // running | completed | failed | rolled_back
  startedAt      DateTime             @default(now())
  finishedAt     DateTime?
  batchCount     Int                  @default(0)
  linkedCount    Int                  @default(0)
  ambiguousCount Int                  @default(0)
  orphanCount    Int                  @default(0)
  errorCount     Int                  @default(0)
  items          MigrationAuditItem[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("migration_audits")
}

model MigrationAuditItem {
  id            String   @id @default(cuid())
  auditId       String
  recordId      String // e.g. conversationId
  recordType    String   @default("conversation")
  previousValue String?
  newValue      String?
  action        String // linked | skipped_ambiguous | skipped_orphan
  createdAt     DateTime @default(now())

  audit MigrationAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([recordId])
  @@map("migration_audit_items")
}

// ─── PAY1 — Transactional Payments ────────────────────────────────────────────

// Asaas credentials per tenant — never returned to frontend
model TenantPaymentConfig {
  id               String   @id @default(uuid())
  tenantId         String   @unique
  provider         String   @default("asaas")
  environment      String   @default("sandbox") // sandbox | production
  enabled          Boolean  @default(false)
  apiKey           String // server-side only — never exposed to frontend
  webhookAuthToken String // validated against asaas-access-token header
  webhookId        String? // Asaas webhook registration ID (for update/delete)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_payment_configs")
}

// Individual charge (Asaas POST /v3/payments)
model Payment {
  id                 String    @id @default(uuid())
  tenantId           String
  // PAY-INT1: source type and traceability links
  sourceType         String    @default("standalone") // order | appointment | standalone
  orderId            String?
  appointmentId      String?
  contactId          String? // traceability to Contact
  conversationId     String? // traceability to originating Conversation
  provider           String    @default("asaas")
  providerPaymentId  String?   @unique // Asaas payment ID
  providerCustomerId String? // Asaas customer ID — reused on future charges
  invoiceUrl         String? // link sent to customer
  pixCopiaECola      String? // pix copy-paste code (when billingType=PIX)
  pixQrCodeBase64    String? // base64 QR code image (when billingType=PIX)
  // status: pending | confirmed | failed | refunded | canceled | overdue
  status             String    @default("pending")
  amount             Float
  currency           String    @default("BRL")
  description        String?
  customerName       String
  customerPhone      String
  customerEmail      String?
  customerCpfCnpj    String?
  dueDate            String // YYYY-MM-DD
  // billingType: BOLETO | PIX | CREDIT_CARD | UNDEFINED (customer chooses)
  billingType        String    @default("UNDEFINED")
  paidAt             DateTime?
  failedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Payment → Order (find which order this payment is for)
  order          Order?         @relation("PaymentToOrder", fields: [orderId], references: [id], onDelete: SetNull)
  // Payment → Appointment (find which appointment this payment is for)
  appointment    Appointment?   @relation("PaymentToAppointment", fields: [appointmentId], references: [id], onDelete: SetNull)
  // PAY-INT1: traceability relations
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  // Back-relations (Order/Appointment → this Payment, via their paymentId FK)
  orderRef       Order?         @relation("OrderActivePayment")
  appointmentRef Appointment?   @relation("AppointmentActivePayment")
  events         PaymentEvent[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, contactId])
  @@index([tenantId, conversationId])
  @@map("payments")
}

// Webhook event audit log — providerEventId unique = idempotency gate
model PaymentEvent {
  id               String   @id @default(uuid())
  paymentId        String
  tenantId         String
  providerEventId  String   @unique // Asaas event.id — insert failure = duplicate = skip
  eventType        String // PAYMENT_RECEIVED | PAYMENT_CONFIRMED | PAYMENT_OVERDUE | PAYMENT_DELETED | PAYMENT_REFUNDED
  payload          Json // full raw webhook body
  // processingStatus: processed | ignored_duplicate | failed
  processingStatus String   @default("processed")
  errorMessage     String?
  processedAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([tenantId, eventType])
  @@map("payment_events")
}

// ─── MOD1 — Feature Flags (superadmin kill switch global) ────────────────────
// Controle global de módulos/funções pelo superadmin.
// Ausência de registro = enabled por padrão.
model FeatureFlag {
  id              String   @id @default(cuid())
  moduleId        String
  scope           String   @default("module") // module | function
  parentModuleId  String? // preenchido quando scope = "function"
  enabled         Boolean  @default(true)
  hidden          Boolean  @default(false) // true = não aparece para tenant
  maintenanceNote String? // mensagem exibida no banner de manutenção
  updatedAt       DateTime @updatedAt
  updatedBy       String? // userId do superadmin que fez a alteração

  @@unique([moduleId, scope])
  @@index([parentModuleId])
  @@map("feature_flags")
}

// ─── LEAD1 — Prospecção IA ────────────────────────────────────────────────────

model LeadSearchRun {
  id                      String   @id @default(uuid())
  tenantId                String
  niche                   String
  city                    String?
  state                   String?
  radiusKm                Int?
  maxResults              Int      @default(50)
  minTicket               Float?
  minRating               Float?
  minReviews              Int?
  requiresWebsite         Boolean  @default(false)
  requiresCommercialPhone Boolean  @default(false)
  localB2BOnly            Boolean  @default(false)
  status                  String   @default("draft") // draft | queued | completed | failed
  totalCandidates         Int      @default(0)
  summary                 Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidates         LeadCandidate[]
  enrichmentAttempts LeadEnrichmentAttempt[]
  campaignDrafts     LeadCampaignDraft[]
  campaignExecutions LeadCampaignExecution[]
  operationalAlerts  LeadOperationalAlert[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("lead_search_runs")
}

model LeadCandidate {
  id                           String    @id @default(uuid())
  tenantId                     String
  searchRunId                  String
  companyName                  String
  tradeName                    String?
  placeId                      String?
  cnpj                         String?
  website                      String?
  email                        String?
  phone                        String?
  mobilePhone                  String?
  address                      String?
  city                         String?
  state                        String?
  category                     String?
  rating                       Float?
  reviewsCount                 Int?
  source                       String    @default("manual") // manual | google | import | unknown
  status                       String    @default("pending_review") // pending_review | approved | rejected | archived
  emailConsentStatus           String    @default("unknown") // unknown | granted | denied
  whatsappConsentStatus        String    @default("unknown") // unknown | granted | denied
  outreachStatus               String    @default("not_ready") // not_ready | ready_email | ready_whatsapp | ready_multichannel | blocked
  outreachBlockReason          String?
  lastReadinessCheckedAt       DateTime?
  // Pipeline fields (LEAD3)
  pipelineStage                String    @default("new") // new | contacted | interested | proposal_sent | negotiating | won | lost
  ownerUserId                  String?
  priority                     String    @default("normal") // low | normal | high
  nextActionAt                 DateTime?
  lastContactAt                DateTime?
  internalNotes                String?
  // Company registry (LEAD6)
  legalName                    String?
  cnpjStatus                   String? // active | inactive | unknown
  cnpjSource                   String? // brasilapi | manual | other
  registryConfidence           Int? // 0-100
  companyRegistryLastCheckedAt DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  tenant                   Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  searchRun                LeadSearchRun                 @relation(fields: [searchRunId], references: [id], onDelete: Cascade)
  score                    LeadScore?
  enrichmentAttempts       LeadEnrichmentAttempt[]
  campaignDrafts           LeadCampaignDraft[]
  executionItems           LeadCampaignExecutionItem[]
  suppressions             LeadSuppression[]
  followUpLogs             LeadFollowUpLog[]
  owner                    User?                         @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  operationalAlerts        LeadOperationalAlert[]
  companyRegistrySnapshots LeadCompanyRegistrySnapshot[]

  @@index([tenantId, searchRunId])
  @@index([tenantId, status])
  @@index([tenantId, pipelineStage])
  @@map("lead_candidates")
}

model LeadScore {
  id                       String   @id @default(uuid())
  tenantId                 String
  leadCandidateId          String   @unique
  overallScore             Int
  icpFitScore              Int      @default(0)
  commercialPotentialScore Int      @default(0)
  digitalMaturityScore     Int      @default(0)
  approachabilityScore     Int      @default(0)
  confidenceScore          Int      @default(0)
  verdict                  String // compensa | revisar | nao_compensa
  reasons                  Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadCandidate LeadCandidate @relation(fields: [leadCandidateId], references: [id], onDelete: Cascade)

  @@index([tenantId, verdict])
  @@map("lead_scores")
}

model LeadEnrichmentAttempt {
  id              String    @id @default(uuid())
  tenantId        String
  searchRunId     String?
  leadCandidateId String?
  provider        String
  status          String    @default("pending") // pending | success | failed
  requestedFields String[]  @default([])
  responseSummary Json?
  errorMessage    String?
  attemptedAt     DateTime  @default(now())
  completedAt     DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  searchRun     LeadSearchRun? @relation(fields: [searchRunId], references: [id], onDelete: SetNull)
  leadCandidate LeadCandidate? @relation(fields: [leadCandidateId], references: [id], onDelete: SetNull)

  @@index([tenantId, attemptedAt])
  @@index([tenantId, status])
  @@map("lead_enrichment_attempts")
}

model LeadCampaignDraft {
  id                String    @id @default(uuid())
  tenantId          String
  searchRunId       String
  leadCandidateId   String
  channel           String // email | whatsapp
  status            String    @default("draft") // draft | approved | rejected | sent | failed
  subject           String?
  messageBody       String    @db.Text
  personalization   Json?
  readinessSnapshot Json?
  approvedAt        DateTime?
  approvedBy        String?
  sentAt            DateTime?
  providerMessageId String?
  providerChannel   String?
  errorMessage      String?
  deliveryMeta      Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  searchRun      LeadSearchRun               @relation(fields: [searchRunId], references: [id], onDelete: Cascade)
  leadCandidate  LeadCandidate               @relation(fields: [leadCandidateId], references: [id], onDelete: Cascade)
  executionItems LeadCampaignExecutionItem[]

  @@index([tenantId, searchRunId])
  @@index([tenantId, channel])
  @@index([tenantId, status])
  @@map("lead_campaign_drafts")
}

model LeadCampaignExecution {
  id             String    @id @default(uuid())
  tenantId       String
  searchRunId    String
  channel        String // email | whatsapp
  status         String    @default("queued") // queued | running | completed | partial | failed
  requestedCount Int       @default(0)
  eligibleCount  Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  skippedCount   Int       @default(0)
  batchSize      Int       @default(10)
  notes          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant    Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  searchRun LeadSearchRun               @relation(fields: [searchRunId], references: [id], onDelete: Cascade)
  items     LeadCampaignExecutionItem[]

  @@index([tenantId, createdAt])
  @@index([tenantId, channel])
  @@index([tenantId, status])
  @@map("lead_campaign_executions")
}

model LeadCampaignExecutionItem {
  id                    String    @id @default(uuid())
  tenantId              String
  executionId           String
  draftId               String
  leadCandidateId       String
  channel               String
  status                String // sent | failed | skipped
  reason                String?
  providerMessageId     String?
  deliveredTo           String?
  processedAt           DateTime  @default(now())
  responseStatus        String    @default("unknown") // unknown | delivered | opened | replied | qualified | converted | lost | unsubscribed
  outcomeNotes          String?
  conversionValue       Float?
  respondedAt           DateTime?
  convertedAt           DateTime?
  outcomeUpdatedAt      DateTime?
  outcomeSource         String    @default("manual") // manual | provider_webhook
  lastProviderEventType String?
  lastProviderEventAt   DateTime?

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  execution         LeadCampaignExecution  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  draft             LeadCampaignDraft      @relation(fields: [draftId], references: [id], onDelete: Cascade)
  leadCandidate     LeadCandidate          @relation(fields: [leadCandidateId], references: [id], onDelete: Cascade)
  providerEventLogs LeadProviderEventLog[]

  @@index([tenantId, executionId])
  @@index([tenantId, status])
  @@index([executionId, processedAt])
  @@map("lead_campaign_execution_items")
}

model LeadSuppression {
  id              String   @id @default(uuid())
  tenantId        String
  leadCandidateId String
  channel         String // email | whatsapp | all
  reason          String
  source          String   @default("manual") // manual | unsubscribe | bounce | operator | compliance
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadCandidate LeadCandidate @relation(fields: [leadCandidateId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadCandidateId])
  @@index([tenantId, channel, active])
  @@index([leadCandidateId, active])
  @@map("lead_suppressions")
}

model LeadProviderEventLog {
  id                String    @id @default(uuid())
  tenantId          String?
  executionItemId   String?
  provider          String // resend
  channel           String // email
  externalEventId   String
  providerMessageId String?
  eventType         String
  processingStatus  String    @default("pending") // pending | processed | ignored_duplicate | ignored_unmatched | failed
  errorMessage      String?
  payload           Json
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?

  tenant        Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executionItem LeadCampaignExecutionItem? @relation(fields: [executionItemId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventId])
  @@index([tenantId, receivedAt])
  @@index([provider, channel])
  @@index([executionItemId, receivedAt])
  @@map("lead_provider_event_logs")
}

model LeadProspectingTemplate {
  id                      String   @id @default(uuid())
  tenantId                String
  name                    String
  niche                   String
  city                    String?
  state                   String?
  radiusKm                Int?
  maxResults              Int      @default(50)
  minTicket               Float?
  minRating               Float?
  minReviews              Int?
  requiresWebsite         Boolean  @default(false)
  requiresCommercialPhone Boolean  @default(false)
  localB2BOnly            Boolean  @default(false)
  preferredChannel        String? // email | whatsapp | multichannel | null
  notes                   String?
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, active])
  @@index([tenantId, niche])
  @@map("lead_prospecting_templates")
}

// LEAD3 — Pipeline follow-up log
model LeadFollowUpLog {
  id              String   @id @default(uuid())
  tenantId        String
  leadCandidateId String
  userId          String? // author, if known
  type            String // manual_contact | note | stage_change | auto_event
  content         String
  metadata        Json? // e.g. { from: 'new', to: 'contacted' }
  loggedAt        DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadCandidate LeadCandidate @relation(fields: [leadCandidateId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadCandidateId])
  @@index([tenantId, loggedAt])
  @@map("lead_follow_up_logs")
}

// LEAD5 — Operational alerts (escalation control)
model LeadOperationalAlert {
  id              String    @id @default(uuid())
  tenantId        String
  leadCandidateId String
  searchRunId     String?
  alertType       String // overdue_next_action | no_owner_high_priority | stalled_follow_up | replied_no_next_action | ready_no_activation
  severity        String    @default("medium") // low | medium | high | critical
  status          String    @default("open") // open | acknowledged | resolved
  title           String
  detail          String?
  ruleKey         String // "${alertType}::${leadCandidateId}" — unique per tenant
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadCandidate LeadCandidate  @relation(fields: [leadCandidateId], references: [id], onDelete: Cascade)
  searchRun     LeadSearchRun? @relation(fields: [searchRunId], references: [id], onDelete: SetNull)

  @@unique([tenantId, ruleKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, alertType, status])
  @@index([leadCandidateId, status])
  @@map("lead_operational_alerts")
}

// ─── LEAD6 — Company Registry / CNPJ Enrichment ──────────────────────────────

model LeadCompanyRegistrySnapshot {
  id              String   @id @default(uuid())
  tenantId        String
  leadCandidateId String
  provider        String // brasilapi | manual
  matched         Boolean  @default(false)
  confidence      Int? // 0-100
  cnpj            String?
  legalName       String?
  tradeName       String?
  companyType     String?
  mainActivity    String?
  city            String?
  state           String?
  cnpjStatus      String? // active | inactive | unknown
  rawSummary      String?
  notes           Json? // String[]
  createdAt       DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadCandidate LeadCandidate @relation(fields: [leadCandidateId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadCandidateId, createdAt])
  @@map("lead_company_registry_snapshots")
}

// ─── BW1 — Beauty Workspace ───────────────────────────────────────────────────

// BW-CONFIG — per-tenant workspace activation + settings
model BeautyWorkspaceConfig {
  id                    String   @id @default(uuid())
  tenantId              String   @unique
  status                String   @default("setup") // setup | active | paused
  businessSubtype       String? // salon | barbershop | aesthetics | nail | lash | massage | other
  defaultDepositPercent Float? // e.g. 30.0 = 30%
  depositRequired       Boolean  @default(false)
  reengagementDays      Int      @default(30) // days of inactivity before reengagement campaign fires
  confirmationLeadHours Int      @default(24) // hours before appointment to send confirmation
  reminderLeadHours     Int      @default(2) // hours before appointment to send reminder
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("beauty_workspace_configs")
}

// BW-SVC — per-service beauty enrichment (extends Service)
model BeautyServiceProfile {
  id              String   @id @default(uuid())
  tenantId        String
  serviceId       String   @unique
  category        String? // corte | coloracao | tratamento | estetica | unhas | sobrancelha | outros
  priceFrom       Float?
  priceTo         Float?
  requiresDeposit Boolean  @default(false)
  depositAmount   Float?
  popularityScore Int      @default(0) // incremented on each booking
  photoUrl        String?
  description     String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
  @@map("beauty_service_profiles")
}

// BW-CUST — per-customer beauty enrichment (extends Contact)
model BeautyCustomerProfile {
  id                    String    @id @default(uuid())
  tenantId              String
  contactId             String    @unique
  preferredProfessional String? // professionalId snapshot preference
  preferredServices     String[]  @default([]) // serviceId list
  notes                 String?   @db.Text
  lastServiceAt         DateTime?
  totalVisits           Int       @default(0)
  totalSpend            Float     @default(0)
  birthdayDate          String? // MM-DD for birthday campaigns (no year)
  loyaltyPoints         Int       @default(0)
  vipStatus             Boolean   @default(false)
  reengagementSentAt    DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact       Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  packageUsages CustomerBeautyPackage[]

  @@index([tenantId, lastServiceAt])
  @@index([tenantId, vipStatus])
  @@map("beauty_customer_profiles")
}

// BW-PROF — per-professional beauty enrichment (extends Professional)
model BeautyProfessionalProfile {
  id              String   @id @default(uuid())
  tenantId        String
  professionalId  String   @unique
  specialties     String[] @default([]) // e.g. ["coloracao", "corte_feminino"]
  commissionPct   Float? // percentage of service price
  photoUrl        String?
  bio             String?  @db.Text
  instagramHandle String?
  rating          Float? // 0-5 average
  totalReviews    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("beauty_professional_profiles")
}

// BW-PKG — service packages (e.g. 10-session bundle)
model BeautyPackage {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  description   String?  @db.Text
  totalSessions Int
  priceTotal    Float
  validityDays  Int      @default(90) // days from activation
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items        BeautyPackageItem[]
  customerPkgs CustomerBeautyPackage[]

  @@index([tenantId, active])
  @@map("beauty_packages")
}

// BW-PKG-ITEM — which services are included in a package
model BeautyPackageItem {
  id        String @id @default(uuid())
  packageId String
  serviceId String
  quantity  Int    @default(1)

  package BeautyPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
  @@map("beauty_package_items")
}

// BW-CUST-PKG — customer-owned package instance
model CustomerBeautyPackage {
  id              String    @id @default(uuid())
  tenantId        String
  contactId       String
  packageId       String
  beautyProfileId String
  sessionsTotal   Int
  sessionsUsed    Int       @default(0)
  activatedAt     DateTime  @default(now())
  expiresAt       DateTime?
  status          String    @default("active") // active | exhausted | expired | cancelled

  beautyProfile BeautyCustomerProfile @relation(fields: [beautyProfileId], references: [id], onDelete: Cascade)
  package       BeautyPackage         @relation(fields: [packageId], references: [id], onDelete: Restrict)
  usages        BeautyPackageUsage[]

  @@index([beautyProfileId, status])
  @@map("customer_beauty_packages")
}

// BW-PKG-USE — individual session usage record
model BeautyPackageUsage {
  id            String   @id @default(uuid())
  customerPkgId String
  appointmentId String?
  usedAt        DateTime @default(now())
  notes         String?

  customerPackage CustomerBeautyPackage @relation(fields: [customerPkgId], references: [id], onDelete: Cascade)

  @@index([customerPkgId])
  @@map("beauty_package_usages")
}

// BW-LOCK — optimistic slot lock during booking flow (prevents double-booking race)
model AppointmentLock {
  id              String   @id @default(uuid())
  tenantId        String
  professionalId  String?
  date            String // YYYY-MM-DD
  time            String // HH:MM
  durationMinutes Int
  sessionId       String // client session or WA conversation id holding lock
  expiresAt       DateTime // typically now() + 5 minutes
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date, time])
  @@index([expiresAt]) // for cleanup job
  @@map("appointment_locks")
}

// BW-WAIT — waitlist entries when no slots are available
model BeautyWaitlistEntry {
  id             String    @id @default(uuid())
  tenantId       String
  contactId      String?
  serviceId      String?
  professionalId String?
  preferredDate  String? // YYYY-MM-DD
  preferredTime  String? // HH:MM
  status         String    @default("waiting") // waiting | notified | booked | cancelled
  notifiedAt     DateTime?
  bookedAt       DateTime?
  createdAt      DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, preferredDate])
  @@map("beauty_waitlist_entries")
}

// BW-CAMP — reengagement / retention campaign rules
model BeautyCampaignRule {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  triggerType     String // inactivity | birthday | post_visit | package_expiring | loyalty_milestone
  inactivityDays  Int? // for triggerType = inactivity
  messageTemplate String   @db.Text
  channel         String   @default("whatsapp") // whatsapp | instagram
  active          Boolean  @default(true)
  cooldownDays    Int      @default(7) // min days between sends to same customer
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   BeautyCampaignRun[]

  @@index([tenantId, active])
  @@map("beauty_campaign_rules")
}

// BW-CAMP-RUN — execution log per customer per campaign
model BeautyCampaignRun {
  id        String    @id @default(uuid())
  tenantId  String
  ruleId    String
  contactId String?
  status    String    @default("sent") // sent | failed | replied | converted
  sentAt    DateTime  @default(now())
  repliedAt DateTime?
  notes     String?

  rule BeautyCampaignRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, sentAt])
  @@index([tenantId, sentAt])
  @@map("beauty_campaign_runs")
}

// ─── PHASE 5 — Public Vertical Pages: Clinic / Consultório ───────────────────

// PV-CLINIC-PROFILE — public page identity for a clinic or consultório
// One profile per tenant (@@unique on tenantId).
// slug is globally unique within this model; routes: /agendar/[slug]
model ClinicProfile {
  id            String   @id @default(uuid())
  tenantId      String
  slug          String   @unique
  displayName   String
  description   String?  @db.Text
  whatsappPhone String?
  address       String?
  city          String?
  state         String?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services            ClinicService[]
  professionals       ClinicProfessional[]
  availability        ClinicAvailability[]
  appointmentRequests AppointmentRequest[]
  bookingPageConfig   PublicBookingPageConfig?

  @@unique([tenantId]) // one profile per tenant for MVP
  @@index([isPublished])
  @@map("clinic_profiles")
}

// PV-CLINIC-SERVICE — services/procedures offered at the clinic
model ClinicService {
  id               String   @id @default(uuid())
  tenantId         String
  clinicProfileId  String
  name             String
  description      String?  @db.Text
  durationMinutes  Int?
  priceDescription String? // free text: "A partir de R$ 150"
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicProfile       ClinicProfile        @relation(fields: [clinicProfileId], references: [id], onDelete: Cascade)
  appointmentRequests AppointmentRequest[]

  @@index([tenantId])
  @@index([clinicProfileId])
  @@map("clinic_services")
}

// PV-CLINIC-PROF — professionals/specialists at the clinic (optional feature)
model ClinicProfessional {
  id              String   @id @default(uuid())
  tenantId        String
  clinicProfileId String
  name            String
  role            String? // "Dentista", "Fisioterapeuta"
  bio             String?  @db.Text
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicProfile       ClinicProfile        @relation(fields: [clinicProfileId], references: [id], onDelete: Cascade)
  availability        ClinicAvailability[]
  appointmentRequests AppointmentRequest[]

  @@index([tenantId])
  @@index([clinicProfileId])
  @@map("clinic_professionals")
}

// PV-CLINIC-AVAIL — simple recurring weekly availability windows
// dayOfWeek: 0=Sunday … 6=Saturday (matches JS Date convention)
model ClinicAvailability {
  id              String   @id @default(uuid())
  tenantId        String
  clinicProfileId String
  professionalId  String? // null = applies to whole clinic
  dayOfWeek       Int // 0–6
  startTime       String // HH:MM
  endTime         String // HH:MM
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicProfile ClinicProfile       @relation(fields: [clinicProfileId], references: [id], onDelete: Cascade)
  professional  ClinicProfessional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([clinicProfileId])
  @@map("clinic_availability")
}

// PV-APPT-REQUEST — administrative lead/booking request from the public page
// NOT a clinical record. No diagnosis, prescription, or clinical data.
// status: NEW | CONTACTED | SCHEDULED | CANCELED | ARCHIVED
model AppointmentRequest {
  id              String   @id @default(uuid())
  tenantId        String
  clinicProfileId String
  serviceId       String? // FK → ClinicService (optional)
  professionalId  String? // FK → ClinicProfessional (optional)
  customerName    String
  customerPhone   String
  customerEmail   String?
  preferredDate   String? // YYYY-MM-DD (user preference, not a confirmed slot)
  preferredTime   String? // HH:MM
  notes           String?  @db.Text
  status          String   @default("NEW") // NEW | CONTACTED | SCHEDULED | CANCELED | ARCHIVED
  source          String   @default("public_page") // public_page | whatsapp | manual
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicProfile ClinicProfile       @relation(fields: [clinicProfileId], references: [id], onDelete: Cascade)
  service       ClinicService?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  professional  ClinicProfessional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([clinicProfileId])
  @@index([tenantId, status])
  @@map("appointment_requests")
}

// PV-BOOKING-CFG — cosmetic configuration for the public booking page
model PublicBookingPageConfig {
  id                String   @id @default(uuid())
  tenantId          String
  clinicProfileId   String   @unique
  heroTitle         String?
  heroSubtitle      String?
  primaryCtaLabel   String?
  showPrices        Boolean  @default(true)
  showProfessionals Boolean  @default(true)
  showAddress       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicProfile ClinicProfile @relation(fields: [clinicProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("public_booking_page_configs")
}

// ─── PHASE 5 — Public Vertical Pages: Restaurant / Restaurante ───────────────

// PV-REST-PROFILE — public page identity for a restaurant
// One profile per tenant (@@unique on tenantId).
// slug is globally unique within this model; routes: /cardapio/[slug]
model RestaurantProfile {
  id                     String   @id @default(uuid())
  tenantId               String
  slug                   String   @unique
  displayName            String
  description            String?  @db.Text
  whatsappPhone          String?
  address                String?
  city                   String?
  state                  String?
  acceptsDelivery        Boolean  @default(true)
  acceptsPickup          Boolean  @default(true)
  deliveryFeeDescription String? // "Taxa de entrega: R$ 5,00"
  minimumOrderValue      Float?
  isPublished            Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories     FoodCategory[]
  products       FoodProduct[]
  addonGroups    FoodAddonGroup[]
  orders         FoodOrder[]
  menuPageConfig PublicMenuPageConfig?

  @@unique([tenantId]) // one profile per tenant for MVP
  @@index([isPublished])
  @@map("restaurant_profiles")
}

// PV-MENU-CFG — cosmetic configuration for the public menu page
model PublicMenuPageConfig {
  id                  String   @id @default(uuid())
  tenantId            String
  restaurantProfileId String   @unique
  heroTitle           String?
  heroSubtitle        String?
  primaryCtaLabel     String?
  showDeliveryInfo    Boolean  @default(true)
  showPickupInfo      Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurantProfile RestaurantProfile @relation(fields: [restaurantProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("public_menu_page_configs")
}

// PV-FOOD-CATEGORY — menu categories (e.g. "Entradas", "Pratos principais")
model FoodCategory {
  id                  String   @id @default(uuid())
  tenantId            String
  restaurantProfileId String
  name                String
  description         String?
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurantProfile RestaurantProfile @relation(fields: [restaurantProfileId], references: [id], onDelete: Cascade)
  products          FoodProduct[]

  @@index([tenantId])
  @@index([restaurantProfileId])
  @@map("food_categories")
}

// PV-FOOD-PRODUCT — individual menu item / product
model FoodProduct {
  id                  String   @id @default(uuid())
  tenantId            String
  restaurantProfileId String
  categoryId          String
  name                String
  description         String?  @db.Text
  price               Float
  imageUrl            String?
  isActive            Boolean  @default(true)
  isAvailable         Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurantProfile RestaurantProfile @relation(fields: [restaurantProfileId], references: [id], onDelete: Cascade)
  category          FoodCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  addonGroups       FoodAddonGroup[]
  orderItems        FoodOrderItem[]

  @@index([tenantId])
  @@index([restaurantProfileId])
  @@index([categoryId])
  @@map("food_products")
}

// PV-FOOD-ADDON-GROUP — a group of optional extras (e.g. "Molhos", "Ponto da carne")
// productId optional: null = applies to all products in the restaurant
model FoodAddonGroup {
  id                  String   @id @default(uuid())
  tenantId            String
  restaurantProfileId String
  productId           String? // null = restaurant-level group, linked per-product via relation
  name                String
  minSelect           Int      @default(0)
  maxSelect           Int      @default(1)
  isRequired          Boolean  @default(false)
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurantProfile RestaurantProfile @relation(fields: [restaurantProfileId], references: [id], onDelete: Cascade)
  product           FoodProduct?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  options           FoodAddonOption[]

  @@index([tenantId])
  @@index([restaurantProfileId])
  @@index([productId])
  @@map("food_addon_groups")
}

// PV-FOOD-ADDON-OPTION — individual option within an addon group
// priceDelta: price modifier (positive = extra cost, 0 = included, negative = discount)
model FoodAddonOption {
  id           String   @id @default(uuid())
  tenantId     String
  addonGroupId String
  name         String
  priceDelta   Float    @default(0)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addonGroup      FoodAddonGroup       @relation(fields: [addonGroupId], references: [id], onDelete: Cascade)
  orderItemAddons FoodOrderItemAddon[]

  @@index([tenantId])
  @@index([addonGroupId])
  @@map("food_addon_options")
}

// PV-FOOD-ORDER — a customer order submitted via the public menu page
// Payment is intentionally NOT modeled here — paymentMethodText is free text only.
// status: NEW | CONFIRMED | PREPARING | READY_FOR_PICKUP | OUT_FOR_DELIVERY | COMPLETED | CANCELED
// fulfillmentType: DELIVERY | PICKUP
model FoodOrder {
  id                  String   @id @default(uuid())
  tenantId            String
  restaurantProfileId String
  customerName        String
  customerPhone       String
  customerAddress     String?
  customerNotes       String?  @db.Text
  fulfillmentType     String // DELIVERY | PICKUP
  paymentMethodText   String? // "Pix na entrega", "Cartão na retirada", "Dinheiro"
  subtotal            Float    @default(0)
  deliveryFee         Float?
  total               Float    @default(0)
  status              String   @default("NEW") // NEW | CONFIRMED | PREPARING | READY_FOR_PICKUP | OUT_FOR_DELIVERY | COMPLETED | CANCELED
  source              String   @default("public_page") // public_page | whatsapp | manual
  whatsappMessage     String?  @db.Text // generated WhatsApp order summary (optional)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurantProfile RestaurantProfile @relation(fields: [restaurantProfileId], references: [id], onDelete: Cascade)
  items             FoodOrderItem[]

  @@index([tenantId])
  @@index([restaurantProfileId])
  @@index([tenantId, status])
  @@map("food_orders")
}

// PV-FOOD-ORDER-ITEM — individual line item in a food order
// productNameSnapshot preserves the name at order time (product may change later)
model FoodOrderItem {
  id                  String   @id @default(uuid())
  tenantId            String
  orderId             String
  productId           String? // nullable: product may be deleted post-order
  productNameSnapshot String // name captured at order time
  quantity            Int      @default(1)
  unitPrice           Float
  notes               String?
  total               Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   FoodOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product FoodProduct?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  addons  FoodOrderItemAddon[]

  @@index([tenantId])
  @@index([orderId])
  @@index([productId])
  @@map("food_order_items")
}

// PV-FOOD-ORDER-ITEM-ADDON — addon options selected for a specific order item
// addonNameSnapshot preserves the name at order time
model FoodOrderItemAddon {
  id                String   @id @default(uuid())
  tenantId          String
  orderItemId       String
  addonOptionId     String? // nullable: option may be deleted post-order
  addonNameSnapshot String // name captured at order time
  priceDelta        Float    @default(0)
  quantity          Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItem   FoodOrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addonOption FoodAddonOption? @relation(fields: [addonOptionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([orderItemId])
  @@map("food_order_item_addons")
}
