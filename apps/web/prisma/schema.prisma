generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String          @id @default(uuid())
  name                String
  businessDescription String?
  businessType        String?
  phone               String?
  whatsappPhoneNumberId String?
  whatsappPhoneId     String?
  whatsappBusinessAccountId String?
  whatsappToken       String?
  openaiKey           String?
  aiPrompt            String? @db.Text
  welcomeMessage      String? @db.Text
  businessHours       String?
  setupStep           Int             @default(1)
  setupCompleted      Boolean         @default(false)
  createdAt           DateTime        @default(now())
  // M0 – omnichannel
  enabledChannels     String?         // comma-separated: "whatsapp,instagram"
  // L4 – kill switch (comma-separated channels manually paused by operator)
  channelKillSwitch   String?
  // R1 – demo tenant flag
  isDemo              Boolean         @default(false)
  // G1 – operational status
  operationalStatus   String          @default("setup") // setup | ready | live | paused | blocked
  // R5 – agency/reseller
  agencyId            String?
  agencyBranding      Boolean         @default(false)
  agency              Agency?         @relation(fields: [agencyId], references: [id])
  // M1 – Instagram
  instagramPageId     String?
  instagramToken      String?
  instagramAccountId  String?
  // M4 – Facebook
  facebookPageId      String?
  facebookToken       String?
  facebookConnection  FacebookConnection?
  users               User[]
  conversations       Conversation[]
  products            Product[]
  orders              Order[]
  appointments        Appointment[]
  businessConfig      BusinessConfig?
  subscription        Subscription?
  automationRules     AutomationRule[]
  services            Service[]
  aiUsages            AiUsage[]
  whatsappConnection  WhatsAppConnection?
  instagramConnection InstagramConnection?
  salesEvents         SalesEvent[]
  salesOpportunities  SalesOpportunity[]
  customerMemories    CustomerMemory[]
  conversationInsights ConversationInsight[]
  // M2
  instagramCommentRules    InstagramCommentRule[]
  instagramModerationItems InstagramModerationItem[]
  // M3
  conversionSequences ConversionSequence[]
  conversionLeads     ConversionLead[]
  // G4 Referral
  referralCodes       ReferralCode[]
  // G6 Expansion
  expansionEvents     ExpansionEvent[]
  // G3 Churn
  churnSignals        ChurnSignal[]
  churnPlaybooks      ChurnPlaybook[]
  // G2 Attribution
  leadAttributions    LeadAttribution[]
  // R6 Health
  healthScore         TenantHealthScore?
  // SC1 Support Copilot
  supportCopilotLogs  SupportCopilotLog[]
}

model BusinessConfig {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  openingHours String?
  address      String?
  faqJson      String?  @db.Text
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  category    String?
  price       Float    @default(0.0)
  currency    String   @default("BRL")
  stock       Int?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesEvents SalesEvent[]
  salesOpportunities SalesOpportunity[]

  @@index([tenantId])
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String?
  email        String   @unique
  passwordHash String?
  facebookId   String?  @unique
  instagramId  String?  @unique
  role         String   @default("user")
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Conversation {
  id            String    @id @default(uuid())
  tenantId      String
  customerPhone String
  status        String    @default("open")
  lastMessageAt DateTime  @default(now())
  assignedUser  String?
  createdAt     DateTime  @default(now())
  channel       String    @default("whatsapp") // M0
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([tenantId, status])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, customerPhone, channel])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  direction      String       @default("inbound")
  content        String
  aiGenerated    Boolean      @default(true)
  createdAt      DateTime     @default(now())
  channel        String       @default("whatsapp") // M0
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Subscription {
  id                    String    @id @default(uuid())
  tenantId              String    @unique
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  planId                String?
  plan                  String    @default("starter")
  status                String    @default("trialing")
  usageMessages         Int       @default(0)
  trialEnd              DateTime?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  createdAt             DateTime  @default(now())
  // L2 – per-tenant admin override (partial PlanEntitlements JSON)
  entitlementsOverride  Json?
  // R2 – churn reason on cancel
  churnReason           String?

  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planRel               Plan?     @relation(fields: [planId], references: [id])
}

model Plan {
  id               String   @id @default(uuid())
  name             String
  monthlyAiLimit   Int
  price            Float
  createdAt        DateTime @default(now())
  
  subscriptions    Subscription[]
  
  @@map("plans")
}

model AiUsage {
  id             String   @id @default(uuid())
  tenantId       String
  totalTokens    Int      @default(0)
  createdAt      DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("ai_usage")
}

model Order {
  id            String   @id @default(uuid())
  tenantId      String
  customerPhone String
  customerName  String?
  product       String?
  price         Float    @default(0.0)
  status        String   @default("novo") // novo, confirmado, preparando, enviado, finalizado
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model Appointment {
  id            String   @id @default(uuid())
  tenantId      String
  customerPhone String
  customerName  String?
  service       String?
  date          String?  // YYYY-MM-DD
  time          String?  // HH:MM
  status        String   @default("agendado") // agendado, confirmado, cancelado, concluido
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model AutomationRule {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  triggerType   String   // keyword, contains
  triggerValue  String
  matchType     String   // exact, contains
  responseType  String   // text, template
  responseText  String   @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

model Service {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  durationMinutes Int      @default(30)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model WhatsAppConnection {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  wabaId          String?
  phoneNumberId   String?
  displayPhone    String?
  accessToken     String?
  status          String   @default("connected")
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_connections")
}

model ProcessedMessage {
  id        String   @id @default(uuid())
  messageId String   @unique  // wamid from Meta webhook
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("processed_messages")
}

model SuperAdminLog {
  id             String   @id @default(uuid())
  adminUserId    String
  action         String   // "impersonate", "view_billing", "view_plan_usage"
  targetTenantId String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([adminUserId])
  @@index([createdAt])
  @@map("superadmin_logs")
}

model RevokedToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_tokens")
}

model ConversationInsight {
  id          String   @id @default(uuid())
  tenantId    String
  period      String   // "7days" | "30days"
  report      Json
  generatedAt DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@map("conversation_insights")
}

model CustomerMemory {
  id          String   @id @default(uuid())
  tenantId    String
  contactId   String
  name        String?
  preferences String?  @db.Text
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contactId])
  @@map("customer_memories")
}

model SalesEvent {
  id          String   @id @default(uuid())
  tenantId    String
  contactId   String   // Can point to a customer phone or a specific customer ID if applicable
  productId   String
  checkoutUrl String
  status      String   @default("created") // created, paid, cancelled
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([tenantId, status])
}

model SalesOpportunity {
  id          String   @id @default(uuid())
  tenantId    String
  contactId   String   // WhatsApp phone or customer ID
  productId   String?
  value       Float?
  status      String   @default("novo_lead") // novo_lead, interessado, checkout_enviado, pago, pos_venda
  followUp1Sent Boolean  @default(false)
  followUp2Sent Boolean  @default(false)
  followUp3Sent Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([tenantId, status])
}

// ─── M1 Instagram ─────────────────────────────────────────────────────────────

model InstagramConnection {
  id          String   @id @default(uuid())
  tenantId    String   @unique
  pageId      String?
  accessToken String?
  igAccountId String?
  username    String?
  status      String   @default("connected")
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("instagram_connections")
}

// ─── M2 Instagram Comments ────────────────────────────────────────────────────

model InstagramCommentRule {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  scope        String   @default("global") // global, post
  postId       String?
  triggerType  String   // keyword, contains, ai_intent
  triggerValue String
  matchType    String   @default("contains") // exact, contains
  actions      Json     // { reply_text?, hide?, send_dm?, dm_text?, start_sequence? }
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@map("instagram_comment_rules")
}

model InstagramModerationItem {
  id              String   @id @default(uuid())
  tenantId        String
  commentId       String   @unique
  postId          String
  from            String
  fromUsername    String?
  text            String   @db.Text
  status          String   @default("pending") // pending, replied, hidden, dismissed
  ruleTriggeredId String?
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("instagram_moderation_queue")
}

// ─── M3 Conversion Sequences ──────────────────────────────────────────────────

model ConversionSequence {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  trigger      String   // comment, dm_keyword, manual
  triggerValue String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps        ConversionSequenceStep[]
  leads        ConversionLead[]

  @@index([tenantId, active])
  @@map("conversion_sequences")
}

model ConversionSequenceStep {
  id             String   @id @default(uuid())
  sequenceId     String
  order          Int
  delayMinutes   Int      @default(0)
  messageText    String   @db.Text
  condition      String?  // no_reply, has_replied, always
  action         String   @default("send_dm") // send_dm, send_offer, handoff
  actionData     Json?

  sequence       ConversionSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId, order])
  @@map("conversion_sequence_steps")
}

model ConversionLead {
  id          String    @id @default(uuid())
  tenantId    String
  sequenceId  String
  contactId   String
  channel     String    @default("whatsapp")
  currentStep Int       @default(0)
  status      String    @default("active") // active, converted, lost, paused
  nextStepAt  DateTime?
  lastStepAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sequence    ConversionSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  events      ConversionLeadEvent[]

  @@unique([sequenceId, contactId])
  @@index([tenantId, status, nextStepAt])
  @@map("conversion_leads")
}

model ConversionLeadEvent {
  id        String   @id @default(uuid())
  leadId    String
  stepOrder Int
  action    String
  result    String   // sent, skipped, error
  createdAt DateTime @default(now())

  lead      ConversionLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("conversion_lead_events")
}

// ─── M4 Facebook Messenger ────────────────────────────────────────────────────

model FacebookConnection {
  id          String   @id @default(uuid())
  tenantId    String   @unique
  pageId      String?
  pageName    String?
  accessToken String?
  status      String   @default("connected")
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("facebook_connections")
}

// ─── L4 Production Hardening ──────────────────────────────────────────────────

model DeadLetterEvent {
  id         String    @id @default(uuid())
  tenantId   String?
  channel    String?
  event      String    // e.g. "send_message", "sequence_step"
  payload    Json
  error      String    @db.Text
  attempts   Int       @default(1)
  status     String    @default("failed") // failed, resolved
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, status])
  @@index([createdAt])
  @@map("dead_letter_events")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String   // e.g. "instagram.connect", "conversation.takeover"
  resource   String?
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ─── G5 Backup + Compliance Ops ───────────────────────────────────────────────

model OpsCheck {
  id          String   @id @default(uuid())
  name        String   // e.g. "neon_backup", "audit_log_ok", "dead_letter_clear"
  category    String   // backup | recovery | audit | compliance | incident
  status      String   @default("unknown") // ok | warning | critical | unknown
  detail      String?
  checkedAt   DateTime @default(now())
  checkedBy   String?  // userId or "system"

  @@index([category, status])
  @@map("ops_checks")
}

model IncidentLog {
  id          String   @id @default(uuid())
  title       String
  severity    String   @default("medium") // low | medium | high | critical
  status      String   @default("open")  // open | investigating | resolved
  description String   @db.Text
  resolvedAt  DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, severity])
  @@map("incident_logs")
}

// ─── G4 Referral Engine ───────────────────────────────────────────────────────

model ReferralCode {
  id              String   @id @default(uuid())
  tenantId        String
  userId          String?  // optional — if user-level code
  code            String   @unique
  rewardType      String   @default("discount") // discount | credit | commission
  rewardValue     Float    @default(0)    // % for discount/commission, R$ for credit
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversions     ReferralConversion[]

  @@index([tenantId])
  @@map("referral_codes")
}

model ReferralConversion {
  id              String    @id @default(uuid())
  referralCodeId  String
  referredTenantId String   // the new tenant that signed up
  status          String    @default("registered") // registered | trialing | paid
  paidAt          DateTime?
  rewardApplied   Boolean   @default(false)
  rewardAppliedAt DateTime?
  createdAt       DateTime  @default(now())

  code            ReferralCode @relation(fields: [referralCodeId], references: [id])

  @@index([referralCodeId])
  @@index([referredTenantId])
  @@map("referral_conversions")
}

// ─── G6 Expansion Ops ─────────────────────────────────────────────────────────

model ExpansionEvent {
  id          String   @id @default(uuid())
  tenantId    String
  trigger     String   // limit_hit | wants_multichannel | high_lead_volume | premium_blocked | multi_agent
  currentPlan String?
  suggestedPlan String?
  detail      String?
  shown       Boolean  @default(false)
  converted   Boolean  @default(false)
  convertedAt DateTime?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, converted])
  @@index([trigger, converted])
  @@map("expansion_events")
}

// ─── G3 Churn Prevention ──────────────────────────────────────────────────────

model ChurnSignal {
  id          String   @id @default(uuid())
  tenantId    String
  signal      String   // no_channel | no_automation | usage_drop | trial_expiring | paid_inactive
  severity    String   @default("medium") // low | medium | high
  detail      String?
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, resolved])
  @@index([severity, resolved])
  @@map("churn_signals")
}

model ChurnPlaybook {
  id          String   @id @default(uuid())
  tenantId    String
  signal      String   // which signal triggered this
  action      String   // nudge_shown | support_invited | template_suggested | reconnect_prompted
  status      String   @default("pending") // pending | sent | dismissed | converted
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("churn_playbooks")
}

// ─── G2 Attribution ───────────────────────────────────────────────────────────

model LeadAttribution {
  id              String   @id @default(uuid())
  tenantId        String
  contactId       String   // phone or external id
  // touch points
  firstSource     String?  // instagram_dm | instagram_comment | facebook_dm | whatsapp | manual | template
  firstMedium     String?  // organic | paid | referral | direct
  firstCampaign   String?
  lastSource      String?
  lastMedium      String?
  lastCampaign    String?
  // linked entities
  conversationId  String?
  opportunityId   String?
  appointmentId   String?
  orderId         String?
  // outcome
  converted       Boolean  @default(false)
  convertedAt     DateTime?
  revenueAmount   Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contactId])
  @@index([tenantId, firstSource])
  @@index([tenantId, converted])
  @@map("lead_attributions")
}

// ─── R5 Agency / Reseller ─────────────────────────────────────────────────────

model Agency {
  id              String   @id @default(uuid())
  name            String
  ownerTenantId   String   @unique  // The agency's own tenant account
  logoUrl         String?
  primaryColor    String?  @default("#4f46e5")
  billingMode     String   @default("separate") // separate | consolidated
  createdAt       DateTime @default(now())

  tenants         Tenant[]
  members         AgencyMember[]

  @@map("agencies")
}

model AgencyMember {
  id         String   @id @default(uuid())
  agencyId   String
  userId     String   // User id from the agency's tenant
  role       String   @default("viewer") // owner | manager | viewer
  createdAt  DateTime @default(now())

  agency     Agency   @relation(fields: [agencyId], references: [id])

  @@unique([agencyId, userId])
  @@map("agency_members")
}

// ─── R3 Support Notes ─────────────────────────────────────────────────────────

model SupportNote {
  id         String   @id @default(uuid())
  tenantId   String
  authorId   String   // superadmin user id
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("support_notes")
}

// ─── R4 Product Feedback ──────────────────────────────────────────────────────

model FeedbackItem {
  id          String   @id @default(uuid())
  tenantId    String
  category    String   // bug, suggestion, onboarding, integration, billing
  body        String   @db.Text
  route       String?
  channel     String?
  plan        String?
  score       Int?     // 1-5 satisfaction score
  status      String   @default("new") // new, reviewing, planned, resolved
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
  @@index([tenantId])
  @@map("feedback_items")
}

// ─── R6 Tenant Health / Retention ─────────────────────────────────────────────

model TenantHealthScore {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  score           Int      @default(0) // 0-100
  riskLevel       String   @default("unknown") // healthy, at_risk, churning
  expansionSignal Boolean  @default(false)
  breakdown       Json?    // per-metric breakdown
  computedAt      DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_health_scores")
}

// ─── SC1 Support Copilot Logs ─────────────────────────────────────────────────

model SupportCopilotLog {
  id             String   @id @default(uuid())
  tenantId       String
  question       String   @db.VarChar(500)
  answer         String   @db.Text
  route          String?  @db.VarChar(100)
  plan           String?
  role           String?
  confidence     String?  // high | medium | low
  fallbackNeeded Boolean  @default(false)
  source         String?  // faq | ai
  helpful        Boolean?
  createdAt      DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([fallbackNeeded, createdAt])
  @@map("support_copilot_logs")
}

// ─── L3 Sandbox / E2E QA ──────────────────────────────────────────────────────

model SandboxRun {
  id         String   @id @default(uuid())
  tenantId   String
  scenario   String   // e.g. "comment_to_dm_flow"
  status     String   @default("pending") // pending, running, passed, failed, partial
  steps      Json     // StepResult[]
  summary    String?
  createdAt  DateTime @default(now())
  finishedAt DateTime?

  @@index([tenantId, createdAt])
  @@map("sandbox_runs")
}
