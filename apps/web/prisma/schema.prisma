generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                        String                    @id @default(uuid())
  name                      String
  businessDescription       String?
  businessType              String?
  phone                     String?
  whatsappPhoneNumberId     String?
  whatsappPhoneId           String?
  whatsappBusinessAccountId String?
  whatsappToken             String?
  openaiKey                 String?
  aiPrompt                  String?                   @db.Text
  welcomeMessage            String?                   @db.Text
  businessHours             String?
  setupStep                 Int                       @default(1)
  setupCompleted            Boolean                   @default(false)
  activeBotKey              String?                   // bot ativo via marketplace (fonte de verdade)
  createdAt                 DateTime                  @default(now())
  // M0 – omnichannel
  enabledChannels           String? // comma-separated: "whatsapp,instagram"
  // L4 – kill switch (comma-separated channels manually paused by operator)
  channelKillSwitch         String?
  // R1 – demo tenant flag
  isDemo                    Boolean                   @default(false)
  // G1 – operational status
  operationalStatus         String                    @default("setup") // setup | ready | live | paused | blocked
  // R5 – agency/reseller
  agencyId                  String?
  agencyBranding            Boolean                   @default(false)
  agency                    Agency?                   @relation(fields: [agencyId], references: [id])
  // M1 – Instagram
  instagramPageId           String?
  instagramToken            String?
  instagramAccountId        String?
  // M4 – Facebook
  facebookPageId            String?
  facebookToken             String?
  facebookConnection        FacebookConnection?
  users                     User[]
  contacts                  Contact[]
  conversations             Conversation[]
  products                  Product[]
  orders                    Order[]
  appointments              Appointment[]
  businessConfig            BusinessConfig?
  subscription              Subscription?
  automationRules           AutomationRule[]
  services                  Service[]
  aiUsages                  AiUsage[]
  whatsappConnection        WhatsAppConnection?
  instagramConnection       InstagramConnection?
  salesEvents               SalesEvent[]
  salesOpportunities        SalesOpportunity[]
  customerMemories          CustomerMemory[]
  conversationInsights      ConversationInsight[]
  // M2
  instagramCommentRules     InstagramCommentRule[]
  instagramModerationItems  InstagramModerationItem[]
  // M3
  conversionSequences       ConversionSequence[]
  conversionLeads           ConversionLead[]
  // G4 Referral
  referralCodes             ReferralCode[]
  // G6 Expansion
  expansionEvents           ExpansionEvent[]
  // G3 Churn
  churnSignals              ChurnSignal[]
  churnPlaybooks            ChurnPlaybook[]
  // G2 Attribution
  leadAttributions          LeadAttribution[]
  // R6 Health
  healthScore               TenantHealthScore?
  // SC1 Support Copilot
  supportCopilotLogs        SupportCopilotLog[]
  // AG1 Availability
  availabilityBlocks        AvailabilityBlock[]
  // AG5 Professionals
  professionals             Professional[]
  // TD1 Template Delivery
  templateBroadcasts        TemplateBroadcast[]
  customTemplates           CustomTemplate[]
  // Fiscal Integration
  fiscalEmissionRecords     FiscalEmissionRecord[]
  // V2 Identity Support
  contactIdentifiers        ContactIdentifier[]
  migrationAudits           MigrationAudit[]
  // Shadow Read Config
  shadowReadEnabled         Boolean                   @default(false)
  shadowReadSampleRate      Int                       @default(5) // 0-100
  // PAY1 — transactional payments
  paymentConfig             TenantPaymentConfig?
  payments                  Payment[]
  // HANDOFF1 — operator alert / escalation config
  handoffConfig             HandoffConfig?
  // MOD1 — workspace module preferences (array of module IDs)
  pinnedModules             String[]                  @default([])
  // LEAD1 — Prospecção IA
  leadSearchRuns            LeadSearchRun[]
  leadCandidates            LeadCandidate[]
  leadScores                LeadScore[]
  leadEnrichmentAttempts    LeadEnrichmentAttempt[]
  leadCampaignDrafts        LeadCampaignDraft[]
}

// ─── Contacts Module (Phase 1) ────────────────────────────────────────────────

model Contact {
  id                String    @id @default(uuid())
  tenantId          String
  phone             String?
  normalizedPhone   String?
  email             String?
  name              String?
  firstName         String?
  lastName          String?
  waId              String?
  username          String?
  parentUserId      String?
  instagramScopedId String?
  facebookScopedId  String?
  // status: active | new_lead | engaged | customer | inactive | archived | blocked
  status            String    @default("active")
  source            String? // whatsapp | instagram | facebook | manual | import | order | appointment
  notes             String?   @db.Text
  lastInteractionAt DateTime?
  lastChannelUsed   String?

  // Soft Merge control
  isMerged            Boolean             @default(false)
  mergedIntoContactId String?
  mergedIntoContact   Contact?            @relation("ResolvedMerge", fields: [mergedIntoContactId], references: [id], onDelete: SetNull)
  mergedAlias         Contact[]           @relation("ResolvedMerge")
  identifiers         ContactIdentifier[]

  // Phase 2 additions
  tags         String[] @default([])
  customFields Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations    Conversation[]
  orders           Order[]
  appointments     Appointment[]
  payments         Payment[]       // PAY-INT1
  memory           CustomerMemory? @relation("ContactMemory")
  events           ContactEvent[]
  mergesAsSurvivor ContactMerge[]  @relation("MergeSurvivor")
  mergesAsMerged   ContactMerge[]  @relation("MergeMerged")

  @@unique([tenantId, normalizedPhone])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, lastInteractionAt])
  @@index([tenantId, waId])
  @@index([tenantId, instagramScopedId])
  @@index([tenantId, facebookScopedId])
  @@index([tenantId, source])
  @@map("contacts")
}

model ContactIdentifier {
  id          String   @id @default(uuid())
  tenantId    String
  contactId   String
  kind        String // WA_ID | BSUID | PHONE_NORMALIZED
  value       String
  source      String // whatsapp, manual, import
  isPrimary   Boolean  @default(false)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now()) @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, value])
  @@index([contactId])
  @@map("contact_identifiers")
}

model ContactEvent {
  id         String   @id @default(uuid())
  tenantId   String
  contactId  String
  // type: conversation_started | order_created | order_paid | order_cancelled | order_completed
  //        appointment_created | appointment_confirmed | appointment_cancelled
  //        contact_created | contact_merged | tag_added | note_updated
  type       String
  title      String
  metadata   Json?
  occurredAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, occurredAt])
  @@index([tenantId, type])
  @@map("contact_events")
}

model ContactMerge {
  id         String   @id @default(uuid())
  tenantId   String
  survivorId String
  mergedId   String
  mergedBy   String? // userId
  createdAt  DateTime @default(now())

  survivor Contact @relation("MergeSurvivor", fields: [survivorId], references: [id])
  merged   Contact @relation("MergeMerged", fields: [mergedId], references: [id])

  @@index([tenantId, survivorId])
  @@index([tenantId, mergedId])
  @@map("contact_merges")
}

model BusinessConfig {
  id                       String   @id @default(uuid())
  tenantId                 String   @unique
  openingHours             String? // "HH:MM - HH:MM" single range, same every open day
  address                  String?
  faqJson                  String?  @db.Text
  createdAt                DateTime @default(now())
  // AG1 — availability engine
  timezone                 String   @default("America/Sao_Paulo")
  bufferBetweenMinutes     Int      @default(0) // gap forced between any two appointments
  slotStrideMinutes        Int      @default(0) // 0 = use service duration as stride
  closedWeekdays           String   @default("") // comma-separated weekday numbers 0=Sun…6=Sat
  // AG6 — Templates Mapping WhatsApp
  templateBookingConfirmed String?
  templateReminder24h      String?
  templateReminder2h       String?
  // Fiscal — UUID da empresa emissora padrão no NFE_WEB (por tenant)
  nfeCompanyId             String?
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// HANDOFF1 — per-tenant operator alert / human escalation configuration
model HandoffConfig {
  id                        String   @id @default(uuid())
  tenantId                  String   @unique
  enabled                   Boolean  @default(false)
  alertPhone                String?  // operator WhatsApp number for alerts (international format)
  clientMessage             String?  @db.Text // message sent to client when handoff triggers
  operatorMessage           String?  @db.Text // template for operator alert
  cooldownMinutes           Int      @default(60) // min gap between alerts for the same conversation
  maxAlertsPerConversation  Int      @default(3)  // hard cap on alerts per conversation
  autoSetHuman              Boolean  @default(true)  // auto-set conversation.status = 'human'
  triggerOnLowConfidence    Boolean  @default(true)  // trigger when AI response indicates uncertainty
  triggerOnExplicitRequest  Boolean  @default(true)  // trigger when customer explicitly asks for human
  triggerOnRepetition       Boolean  @default(false) // trigger after N repeated unanswered intents
  triggerOnCheckoutError    Boolean  @default(false) // trigger when checkout generation fails
  triggerOnNoProduct        Boolean  @default(false) // trigger when no matching product found
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("handoff_configs")
}

model Product {
  id                 String             @id @default(uuid())
  tenantId           String
  name               String
  description        String?
  category           String?
  price              Float              @default(0.0)
  currency           String             @default("BRL")
  stock              Int?
  // PAY1 — product type for transactional payments
  type               String             @default("product") // product | service
  durationMinutes    Int?               // only for type=service
  // CAT1 — published in catalog (bot + checkout see only active=true)
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  // COMM1 — commercial orchestrator fields
  salesMode          String             @default("none") // none | dynamic_checkout | external_link
  salesCtaText       String?            // CTA sent in offer message (ex: "Clique aqui para comprar")
  salesShortText     String?            // short name/alias for AI disambiguation
  externalSalesUrl   String?            // used when salesMode = external_link
  aliases            String[]           @default([]) // explicit tenant-configured aliases for AI matching
  salesPriority      Int                @default(0)  // higher = shown first when multiple products match
  requiresHumanApproval Boolean         @default(false) // if true, orchestrator returns handoff_human
  // COMM1 — optional link to a Service (1 Service → N Products: avulso, pacote, premium)
  serviceId          String?
  service            Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesEvents        SalesEvent[]
  salesOpportunities SalesOpportunity[]
  orderItems         OrderItem[]        @relation("ProductOrderItems")

  @@index([tenantId])
  @@index([tenantId, active])
  @@index([tenantId, serviceId])
}

model User {
  id                 String       @id @default(uuid())
  tenantId           String
  name               String?
  email              String       @unique
  emailVerifiedAt    DateTime?
  passwordHash       String?
  facebookId         String?      @unique
  instagramId        String?      @unique
  role               String       @default("user")
  isActive           Boolean      @default(true)
  lastLoginAt        DateTime?
  forcePasswordReset Boolean      @default(false)
  sessionVersion     Int          @default(1)
  createdAt          DateTime     @default(now())
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loginEvents        LoginEvent[]
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("login_events")
}

model VerificationToken {
  id         String    @id @default(uuid())
  identifier String // Email do usuário
  tokenHash  String    @unique // Hash do token para não expor url gerada no banco
  type       String // "EMAIL_VERIFICATION" | "PASSWORD_RESET"
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  usedAt     DateTime? // Null significa que não foi usado ainda

  @@index([identifier, type])
  @@map("verification_tokens")
}

model Conversation {
  id            String    @id @default(uuid())
  tenantId      String
  customerPhone String
  status        String    @default("open")
  lastMessageAt DateTime  @default(now())
  assignedUser  String?
  createdAt     DateTime  @default(now())
  channel       String    @default("whatsapp") // M0
  contactId     String? // nullable FK → Contact (phase 1)
  // COMM1 — commercial orchestrator state (JSON, TTL 24h, managed by commercialStateService)
  commercialState       Json?
  // HANDOFF1 — anti-spam counters for operator alerts
  handoffAlertCount     Int       @default(0)
  lastHandoffAlertAt    DateTime?
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages      Message[]
  payments      Payment[] // PAY-INT1

  @@index([tenantId, status])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, customerPhone, channel])
  @@index([tenantId, contactId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  direction      String       @default("inbound")
  content        String
  aiGenerated    Boolean      @default(true)
  createdAt      DateTime     @default(now())
  channel        String       @default("whatsapp") // M0
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Subscription {
  id                   String    @id @default(uuid())
  tenantId             String    @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  planId               String?
  plan                 String    @default("starter")
  status               String    @default("trialing")
  usageMessages        Int       @default(0)
  trialEnd             DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  // L2 – per-tenant admin override (partial PlanEntitlements JSON)
  entitlementsOverride Json?
  // R2 – churn reason on cancel
  churnReason          String?

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planRel Plan?  @relation(fields: [planId], references: [id])
}

model Plan {
  id             String   @id @default(uuid())
  name           String
  monthlyAiLimit Int
  price          Float
  createdAt      DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model AiUsage {
  id          String   @id @default(uuid())
  tenantId    String
  totalTokens Int      @default(0)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("ai_usage")
}

model Order {
  id                 String               @id @default(uuid())
  tenantId           String
  customerPhone      String
  customerName       String?
  product            String?
  price              Float                @default(0.0)
  status             String               @default("draft") // draft, pending_payment, paid, processing, completed, cancelled, refunded, failed
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  // ORDERS_V2 — extended fields
  contactId          String? // FK → Contact (real UUID, set by contactService)
  conversationId     String? // link to the originating conversation
  origin             String               @default("manual") // manual, whatsapp, instagram, facebook, checkout, agenda
  subtotal           Float                @default(0.0)
  discount           Float                @default(0.0)
  currency           String               @default("BRL")
  externalPaymentRef String?              @unique // Stripe session ID for idempotency
  cancelReason       String?
  notes              String?              @db.Text // internal notes
  paidAt             DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  refundedAt         DateTime?
  // PAY1 — link to transactional payment (separate from externalPaymentRef/Stripe)
  paymentId          String?   @unique
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact            Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  payment            Payment?             @relation("OrderActivePayment", fields: [paymentId], references: [id], onDelete: SetNull)
  linkedPayments     Payment[]            @relation("PaymentToOrder")
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, contactId])
  @@index([externalPaymentRef])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  productId  String?
  name       String
  quantity   Int      @default(1)
  unitPrice  Float    @default(0.0)
  totalPrice Float    @default(0.0)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation("ProductOrderItems", fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String   @id @default(uuid())
  orderId    String
  fromStatus String
  toStatus   String
  changedBy  String? // userId
  reason     String?
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Appointment {
  id                     String                    @id @default(uuid())
  tenantId               String
  customerPhone          String
  customerName           String?
  service                String?
  date                   String? // YYYY-MM-DD
  time                   String? // HH:MM
  status                 String                    @default("agendado") // agendado, confirmado, cancelado, concluido, no_show
  createdAt              DateTime                  @default(now())
  // AG1 — availability engine
  durationMinutes        Int? // snapshot of service duration at booking time
  notes                  String?                   @db.Text
  cancelledAt            DateTime?
  confirmedAt            DateTime?
  // AG2 — conversational booking origin
  source                 String                    @default("manual") // manual | whatsapp | instagram | facebook
  conversationId         String?
  reminderSentAt         DateTime?
  // AG3 — confirmations & no-show
  confirmationReceivedAt DateTime? // when customer replied confirming presence
  // AG4 — cancellation & reschedule
  cancelReason           String?
  // AG5 — professional assignment
  professionalId         String?
  professionalName       String? // snapshot at booking time
  // Contacts Module — FK → Contact (nullable, phase 1)
  contactId              String?
  // PAY1 — payment state (separate from operational status)
  paymentId              String?   @unique
  paymentStatus          String?                   // null | payment_pending | payment_confirmed | payment_failed
  tenant                 Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional           Professional?             @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  contact                Contact?                  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  payment                Payment?                  @relation("AppointmentActivePayment", fields: [paymentId], references: [id], onDelete: SetNull)
  linkedPayments         Payment[]                 @relation("PaymentToAppointment")
  notifications          AppointmentNotification[]

  @@index([tenantId, status])
  @@index([tenantId, date])
  @@index([tenantId, contactId])
}

// AG3 — full history of notifications sent per appointment
model AppointmentNotification {
  id            String   @id @default(uuid())
  appointmentId String
  tenantId      String
  type          String // booking_confirmed | reminder_24h | reminder_2h | noshow_followup
  channel       String   @default("whatsapp")
  status        String   @default("sent") // sent | failed
  sentAt        DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, type])
  @@index([tenantId, type, sentAt])
  @@map("appointment_notifications")
}

model AutomationRule {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  triggerType  String // keyword, contains, order_status
  triggerValue String
  matchType    String // exact, contains
  responseType String // text, template
  responseText String   @db.Text
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  // COMM1 — extended action (null = legacy text/template behavior)
  actionType   String?  // send_checkout | send_external_link | handoff_human | send_offer
  actionConfig Json?    // arbitrary config: { productId, message, phone, url, ... }

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs   AutomationLog[]

  @@index([tenantId, active])
}

model AutomationLog {
  id           String   @id @default(uuid())
  tenantId     String
  ruleId       String
  orderId      String?
  triggerType  String
  triggerValue String
  contactPhone String
  success      Boolean  @default(false)
  errorMessage String?
  sentAt       DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([tenantId, sentAt])
  @@index([orderId, triggerValue])
}

model Service {
  id                  String   @id @default(uuid())
  tenantId            String
  name                String
  durationMinutes     Int      @default(30)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  // AG1 — per-service buffers (override global)
  bufferBeforeMinutes Int      @default(0)
  bufferAfterMinutes  Int      @default(0)

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // AG5 — professionals assigned to this service
  professionals ProfessionalService[]
  // COMM1 — products linked to this service (1 service → N commercial products)
  products      Product[]

  @@index([tenantId])
}

// ─── AG5 Professionals ────────────────────────────────────────────────────────

model Professional {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  active         Boolean  @default(true)
  // Optional own schedule — overrides BusinessConfig when set
  openingHours   String? // "HH:MM - HH:MM"
  closedWeekdays String   @default("") // comma-separated 0=Sun…6=Sat
  createdAt      DateTime @default(now())

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services     ProfessionalService[]
  appointments Appointment[]

  @@index([tenantId])
  @@map("professionals")
}

model ProfessionalService {
  id             String @id @default(uuid())
  professionalId String
  serviceId      String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
  @@map("professional_services")
}

// AG1 — blocks specific dates or time windows (holidays, lunch, maintenance)
model AvailabilityBlock {
  id        String   @id @default(uuid())
  tenantId  String
  date      String // YYYY-MM-DD
  startTime String? // HH:MM — null = full-day block
  endTime   String? // HH:MM — null = full-day block
  reason    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@map("availability_blocks")
}

model WhatsAppConnection {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  wabaId        String?
  phoneNumberId String?
  displayPhone  String?
  accessToken   String?
  status        String   @default("connected")
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_connections")
}

model ProcessedMessage {
  id        String   @id @default(uuid())
  messageId String   @unique // wamid from Meta webhook
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("processed_messages")
}

model SuperAdminLog {
  id             String   @id @default(uuid())
  adminUserId    String
  targetUserId   String?
  targetTenantId String?
  action         String
  entityType     String?
  entityId       String?
  beforeJson     Json?
  afterJson      Json?
  ipAddress      String?
  userAgent      String?
  status         String   @default("success") // success, failed
  createdAt      DateTime @default(now())

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([targetTenantId])
  @@index([createdAt])
  @@map("superadmin_logs")
}

model RevokedToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_tokens")
}

model ConversationInsight {
  id          String   @id @default(uuid())
  tenantId    String
  period      String // "7days" | "30days"
  report      Json
  generatedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@map("conversation_insights")
}

model CustomerMemory {
  id          String   @id @default(uuid())
  tenantId    String
  contactId   String // historically: phone string. After phase 1: may be Contact.id
