  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidates          LeadCandidate[]
  enrichmentAttempts  LeadEnrichmentAttempt[]
  campaignDrafts      LeadCampaignDraft[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("lead_search_runs")
}

model LeadCandidate {
  id           String  @id @default(uuid())
  tenantId     String
  searchRunId  String
  companyName  String
  tradeName    String?
  placeId      String?
  cnpj         String?
  website      String?
  email        String?
  phone        String?
  mobilePhone  String?
  address      String?
  city         String?
  state        String?
  category     String?
  rating       Float?
  reviewsCount Int?
  source       String  @default("manual") // manual | google | import | unknown
  status       String  @default("pending_review") // pending_review | approved | rejected | archived
  emailConsentStatus String @default("unknown") // unknown | granted | denied
  whatsappConsentStatus String @default("unknown") // unknown | granted | denied
  outreachStatus String @default("not_ready") // not_ready | ready_email | ready_whatsapp | ready_multichannel | blocked
  outreachBlockReason String?
  lastReadinessCheckedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  searchRun          LeadSearchRun           @relation(fields: [searchRunId], references: [id], onDelete: Cascade)
  score              LeadScore?
  enrichmentAttempts LeadEnrichmentAttempt[]
  campaignDrafts     LeadCampaignDraft[]

  @@index([tenantId, searchRunId])
  @@index([tenantId, status])
  @@map("lead_candidates")
}

model LeadScore {
  id                       String   @id @default(uuid())
  tenantId                 String
  leadCandidateId          String   @unique
  overallScore             Int
  icpFitScore              Int      @default(0)
  commercialPotentialScore Int      @default(0)
  digitalMaturityScore     Int      @default(0)
  approachabilityScore     Int      @default(0)
  confidenceScore          Int      @default(0)
  verdict                  String   // compensa | revisar | nao_compensa
  reasons                  Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadCandidate LeadCandidate @relation(fields: [leadCandidateId], references: [id], onDelete: Cascade)

  @@index([tenantId, verdict])
  @@map("lead_scores")
}

model LeadEnrichmentAttempt {
  id                String    @id @default(uuid())
  tenantId          String
  searchRunId       String?
  leadCandidateId   String?
  provider          String
  status            String    @default("pending") // pending | success | failed
  requestedFields   String[]  @default([])
  responseSummary   Json?
  errorMessage      String?
  attemptedAt       DateTime  @default(now())
  completedAt       DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  searchRun     LeadSearchRun? @relation(fields: [searchRunId], references: [id], onDelete: SetNull)
  leadCandidate LeadCandidate? @relation(fields: [leadCandidateId], references: [id], onDelete: SetNull)

  @@index([tenantId, attemptedAt])
  @@index([tenantId, status])
  @@map("lead_enrichment_attempts")
}

model LeadCampaignDraft {
  id              String   @id @default(uuid())
  tenantId        String
  searchRunId     String
  leadCandidateId String
  channel         String   // email | whatsapp
  status          String   @default("draft") // draft | approved | rejected | sent | failed
  subject         String?
  messageBody     String   @db.Text
  personalization Json?
  readinessSnapshot Json?
  approvedAt      DateTime?
  approvedBy      String?
  sentAt          DateTime?
  providerMessageId String?
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  searchRun     LeadSearchRun @relation(fields: [searchRunId], references: [id], onDelete: Cascade)
  leadCandidate LeadCandidate @relation(fields: [leadCandidateId], references: [id], onDelete: Cascade)

  @@index([tenantId, searchRunId])
  @@index([tenantId, channel])
  @@index([tenantId, status])
  @@map("lead_campaign_drafts")
}

