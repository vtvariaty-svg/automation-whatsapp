generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String          @id @default(uuid())
  name                String
  businessDescription String?
  businessType        String?
  phone               String?
  whatsappPhoneNumberId String?
  whatsappPhoneId     String?
  whatsappBusinessAccountId String?
  whatsappToken       String?
  openaiKey           String?
  aiPrompt            String? @db.Text
  welcomeMessage      String? @db.Text
  businessHours       String?
  setupStep           Int             @default(1)
  setupCompleted      Boolean         @default(false)
  createdAt           DateTime        @default(now())
  users               User[]
  conversations       Conversation[]
  products            Product[]
  orders              Order[]
  appointments        Appointment[]
  businessConfig      BusinessConfig?
  subscription        Subscription?
  automationRules     AutomationRule[]
  services            Service[]
  aiUsages            AiUsage[]
  whatsappConnection  WhatsAppConnection?
  salesEvents       SalesEvent[]
  salesOpportunities SalesOpportunity[]
  customerMemories    CustomerMemory[]
  conversationInsights ConversationInsight[]
}

model BusinessConfig {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  openingHours String?
  address      String?
  faqJson      String?  @db.Text
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  category    String?
  price       Float    @default(0.0)
  currency    String   @default("BRL")
  stock       Int?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  salesEvents SalesEvent[]
  salesOpportunities SalesOpportunity[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String?
  email        String   @unique
  passwordHash String?
  facebookId   String?  @unique
  instagramId  String?  @unique
  role         String   @default("user")
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
}

model Conversation {
  id            String    @id @default(uuid())
  tenantId      String
  customerPhone String
  status        String    @default("open")
  lastMessageAt DateTime  @default(now())
  assignedUser  String?
  createdAt     DateTime  @default(now())
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  messages      Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  direction      String       @default("inbound")
  content        String
  aiGenerated    Boolean      @default(true)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Subscription {
  id                    String    @id @default(uuid())
  tenantId              String    @unique
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  planId                String?
  plan                  String    @default("starter")
  status                String    @default("trialing")
  usageMessages         Int       @default(0)
  trialEnd              DateTime?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  createdAt             DateTime  @default(now())
  
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  planRel               Plan?     @relation(fields: [planId], references: [id])
}

model Plan {
  id               String   @id @default(uuid())
  name             String
  monthlyAiLimit   Int
  price            Float
  createdAt        DateTime @default(now())
  
  subscriptions    Subscription[]
  
  @@map("plans")
}

model AiUsage {
  id             String   @id @default(uuid())
  tenantId       String
  totalTokens    Int      @default(0)
  createdAt      DateTime @default(now())
  
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("ai_usage")
}

model Order {
  id            String   @id @default(uuid())
  tenantId      String
  customerPhone String
  customerName  String?
  product       String?
  price         Float    @default(0.0)
  status        String   @default("novo") // novo, confirmado, preparando, enviado, finalizado
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}

model Appointment {
  id            String   @id @default(uuid())
  tenantId      String
  customerPhone String
  customerName  String?
  service       String?
  date          String?  // YYYY-MM-DD
  time          String?  // HH:MM
  status        String   @default("agendado") // agendado, confirmado, cancelado, concluido
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}

model AutomationRule {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  triggerType   String   // keyword, contains
  triggerValue  String
  matchType     String   // exact, contains
  responseType  String   // text, template
  responseText  String   @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}

model Service {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  durationMinutes Int      @default(30)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
}

model WhatsAppConnection {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  wabaId          String?
  phoneNumberId   String?
  displayPhone    String?
  accessToken     String?
  status          String   @default("connected")
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@map("whatsapp_connections")
}

model SuperAdminLog {
  id             String   @id @default(uuid())
  adminUserId    String
  action         String   // "impersonate", "view_billing", "view_plan_usage"
  targetTenantId String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([adminUserId])
  @@index([createdAt])
  @@map("superadmin_logs")
}

model RevokedToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_tokens")
}

model ConversationInsight {
  id          String   @id @default(uuid())
  tenantId    String
  period      String   // "7days" | "30days"
  report      Json
  generatedAt DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, period])
  @@map("conversation_insights")
}

model CustomerMemory {
  id          String   @id @default(uuid())
  tenantId    String
  contactId   String
  name        String?
  preferences String?  @db.Text
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, contactId])
  @@map("customer_memories")
}

model SalesEvent {
  id          String   @id @default(uuid())
  tenantId    String
  contactId   String   // Can point to a customer phone or a specific customer ID if applicable
  productId   String
  checkoutUrl String
  status      String   @default("created") // created, paid, cancelled
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
}

model SalesOpportunity {
  id          String   @id @default(uuid())
  tenantId    String
  contactId   String   // WhatsApp phone or customer ID
  productId   String?
  value       Float?
  status      String   @default("novo_lead") // novo_lead, interessado, checkout_enviado, pago, pos_venda
  followUp1Sent Boolean  @default(false)
  followUp2Sent Boolean  @default(false)
  followUp3Sent Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  product     Product? @relation(fields: [productId], references: [id])
}
