}

// ─── L4 Production Hardening ──────────────────────────────────────────────────

model DeadLetterEvent {
  id         String    @id @default(uuid())
  tenantId   String?
  channel    String?
  event      String // e.g. "send_message", "sequence_step"
  payload    Json
  error      String    @db.Text
  attempts   Int       @default(1)
  status     String    @default("failed") // failed, resolved
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, status])
  @@index([createdAt])
